---
import Layout from '../layouts/Layout.astro';
import { astrophotographyGear, breadcrumbList, shortenDescription, titleWith } from '../lib/seo';
import type { Lang } from '../i18n';
import { copy, equipmentHref, homeHref, withBase } from '../i18n';
import type { EquipmentGroupId } from '../data/equipment';
import { equipmentGroupLinks, equipmentGroups, equipmentUi, groupHref, itemHref } from '../data/equipment';

interface Props { lang: Lang; groupId: EquipmentGroupId; }
const { lang, groupId } = Astro.props;
const base = import.meta.env.BASE_URL;
const group = equipmentGroups.find((candidate) => candidate.id === groupId)!;
const ui = equipmentUi[lang];
const countLabel = group.items.length === 1 ? ui.component : ui.components;
// SEO: «Grupo: resumen. Componentes: …» en lugar del resumen corto solo.
const lowerFirst = (value: string) => /^\p{Lu}\p{Ll}/u.test(value) ? value.charAt(0).toLocaleLowerCase(lang) + value.slice(1) : value;
const itemNames = group.items.map((entry) => entry.title[lang]);
const seoDescription = shortenDescription({
	ca: `${group.title[lang]}: ${lowerFirst(group.summary[lang])}. Components de l’equip d’astrofotografia de Juan José Romero: ${itemNames.join(', ')}.`,
	es: `${group.title[lang]}: ${lowerFirst(group.summary[lang])}. Componentes del equipo de astrofotografía de Juan José Romero: ${itemNames.join(', ')}.`,
	en: `${group.title[lang]}: ${lowerFirst(group.summary[lang])}. Components of Juan José Romero’s astrophotography gear: ${itemNames.join(', ')}.`,
}[lang]);
const structuredData = { '@context': 'https://schema.org', ...breadcrumbList([[copy[lang].home, homeHref(lang, base)], [copy[lang].myEquipment, equipmentHref(lang, base)], [group.title[lang], groupHref(lang, group, base)]], base) };
---

<Layout minimal compact lang={lang} title={titleWith(group.title[lang], astrophotographyGear[lang])} description={seoDescription} structuredData={structuredData} languageLinks={equipmentGroupLinks(group, base)} backLink={{ href: equipmentHref(lang, base), label: ui.backEquipment }}>
	<section class="equipment-catalog" aria-labelledby="equipment-category-heading">
		<div class="page-heading equipment-catalog__heading">
			<h1 id="equipment-category-heading">{group.title[lang]}</h1>
			<p>{group.summary[lang]}</p>
			<p class="equipment-catalog__count">{group.items.length} {countLabel}</p>
		</div>
		{group.image && group.imageAlt && (
			<figure class="equipment-image equipment-catalog__image">
				<img src={withBase(group.image, base)} alt={group.imageAlt[lang]} />
			</figure>
		)}
		<div class="photo-grid equipment-catalog-grid">
			{group.items.map((equipmentItem) => (
				<article class="photo-card equipment-card">
					<a href={itemHref(lang, group, equipmentItem, base)} aria-label={`${ui.viewDetails} ${equipmentItem.title[lang]}`}>
						{equipmentItem.image && equipmentItem.imageAlt ? (
							<div class:list={['equipment-image', 'equipment-card__image', { 'equipment-provisional-image': equipmentItem.imageProvisional }]} data-watermark={equipmentItem.imageProvisional ? ui.provisionalImage : undefined}>
								<img src={withBase(equipmentItem.image, base)} alt={equipmentItem.imageAlt[lang]} loading="lazy" />
							</div>
						) : (
							<div class="equipment-ghost" aria-hidden="true">
								<span class="equipment-ghost__number">{equipmentItem.number}</span>
								<span class="equipment-ghost__label">{ui.photoPending}</span>
							</div>
						)}
						<div class="photo-card__body">
							<p class="equipment-card__kicker">{equipmentItem.kicker[lang]}</p>
							<h2>{equipmentItem.title[lang]}</h2>
							<p>{equipmentItem.summary[lang]}</p>
						</div>
					</a>
				</article>
			))}
		</div>
	</section>
</Layout>
