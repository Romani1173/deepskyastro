---
import type { CollectionEntry } from 'astro:content';
import type { Lang } from '../i18n';
import { languageLinks, photoHref, planningHref, visibilityGuideHref, withBase } from '../i18n';
import { photoText } from '../photoTranslations';
import { formatCatalogDesignations } from '../lib/catalog-formatting.mjs';
import Layout from '../layouts/Layout.astro';
import visibility from '../data/visibility.generated.json';

interface Props { lang: Lang; fotos: CollectionEntry<'fotos'>[]; showPending?: boolean; }
const { lang, fotos, showPending = true } = Astro.props;
const base = import.meta.env.BASE_URL;
const texts = {
  ca: { title: 'Què podem fotografiar aquesta setmana?', intro: 'Descobreix i compara molts objectes des d’una ubicació de referència al centre de Catalunya. Quan n’hagis escollit un, Planificació permet estudiar-lo des de la teva ubicació.', location: 'Centre de Catalunya · 41° N, 1,5° E · Nit astronòmica: Sol per sota de −18° · Hores: hora local', guide: 'Com funciona Visibilitat', guideTooltip: 'Guia per interpretar les gràfiques i planificar una nit', analysed: (count: number) => `${count} objectes astronòmics analitzats`, week: 'Setmana de l’any', minimumVisibility: 'Visibilitat mínima', photographed: 'Fotografiats', pending: 'Pendents', all: 'Tots', photos: 'Amb fotos', list: 'Llista', display: 'Visualització dels objectes fotografiats', selectedObject: 'objecte seleccionat', selectedObjects: 'objectes seleccionats', noResults: 'No hi ha objectes que compleixin els criteris aquesta setmana.', pendingTarget: 'Objectiu pendent', pendingNote: 'Pendent de fotografiar', choosePending: 'Selecciona un objectiu pendent', maxAltitude: 'Altura màxima', bestTime: 'Millor hora', localTime: 'hora local', usefulTime: 'Temps sobre 30°', above: 'sobre', view: 'Veure fotografia', viewChart: 'Veure gràfica', plan: 'Planificar', annual: 'Anual', selectedNight: 'Nit seleccionada', annualChart: 'Visibilitat anual · 00:00 UTC', nightChart: 'Altura durant la nit astronòmica', darkness: 'Foscor astronòmica', selectedWeek: 'Setmana seleccionada', close: 'Tancar', night: 'Nit del màxim', objectCurve: 'Objecte', moonCurve: 'Lluna', selectedDay: 'Nit de la setmana', moonPhases: ['Lluna nova', 'Creixent fina', 'Quart creixent', 'Gibosa creixent', 'Lluna plena', 'Gibosa minvant', 'Quart minvant', 'Minvant fina'], dayShort: ['Dl', 'Dt', 'Dc', 'Dj', 'Dv', 'Ds', 'Dg'], qualities: { excellent: 'Excel·lent', good: 'Bona' } },
  es: { title: '¿Qué podemos fotografiar esta semana?', intro: 'Descubre y compara muchos objetos desde una ubicación de referencia en el centro de Cataluña. Cuando elijas uno, Planificación permite estudiarlo desde tu ubicación.', location: 'Centro de Cataluña · 41° N, 1,5° E · Noche astronómica: Sol por debajo de −18° · Horas: hora local', guide: 'Cómo funciona Visibilidad', guideTooltip: 'Guía para interpretar las gráficas y planificar una noche', analysed: (count: number) => `${count} objetos astronómicos analizados`, week: 'Semana del año', minimumVisibility: 'Visibilidad mínima', photographed: 'Fotografiados', pending: 'Pendientes', all: 'Todos', photos: 'Con fotos', list: 'Lista', display: 'Visualización de los objetos fotografiados', selectedObject: 'objeto seleccionado', selectedObjects: 'objetos seleccionados', noResults: 'No hay objetos que cumplan los criterios esta semana.', pendingTarget: 'Objetivo pendiente', pendingNote: 'Pendiente de fotografiar', choosePending: 'Selecciona un objetivo pendiente', maxAltitude: 'Altura máxima', bestTime: 'Mejor hora', localTime: 'hora local', usefulTime: 'Tiempo sobre 30°', above: 'sobre', view: 'Ver fotografía', viewChart: 'Ver gráfica', plan: 'Planificar', annual: 'Anual', selectedNight: 'Noche seleccionada', annualChart: 'Visibilidad anual · 00:00 UTC', nightChart: 'Altura durante la noche astronómica', darkness: 'Oscuridad astronómica', selectedWeek: 'Semana seleccionada', close: 'Cerrar', night: 'Noche del máximo', objectCurve: 'Objeto', moonCurve: 'Luna', selectedDay: 'Noche de la semana', moonPhases: ['Luna nueva', 'Creciente fina', 'Cuarto creciente', 'Gibosa creciente', 'Luna llena', 'Gibosa menguante', 'Cuarto menguante', 'Menguante fina'], dayShort: ['L', 'M', 'X', 'J', 'V', 'S', 'D'], qualities: { excellent: 'Excelente', good: 'Buena' } },
  en: { title: 'What can we photograph this week?', intro: 'Discover and compare many objects from a reference location in central Catalonia. Once you choose one, Planning lets you study it from your own location.', location: 'Central Catalonia · 41° N, 1.5° E · Astronomical night: Sun below −18° · Times: local time', analysed: (count: number) => `${count} astronomical objects analysed`, week: 'Week of the year', minimumVisibility: 'Minimum visibility', photographed: 'Photographed', pending: 'Pending', all: 'All', photos: 'With photos', list: 'List', display: 'Photographed objects display', selectedObject: 'selected object', selectedObjects: 'selected objects', noResults: 'No objects meet the criteria this week.', pendingTarget: 'Pending target', pendingNote: 'Waiting to be photographed', choosePending: 'Select a pending target', maxAltitude: 'Maximum altitude', bestTime: 'Best time', localTime: 'local time', usefulTime: 'Time above 30°', above: 'above', view: 'View photograph', viewChart: 'View chart', plan: 'Plan', annual: 'Annual', selectedNight: 'Selected night', annualChart: 'Annual visibility · 00:00 UTC', nightChart: 'Altitude during astronomical night', darkness: 'Astronomical darkness', selectedWeek: 'Selected week', close: 'Close', night: 'Night of maximum', objectCurve: 'Object', moonCurve: 'Moon', selectedDay: 'Night of the week', moonPhases: ['New moon', 'Waxing crescent', 'First quarter', 'Waxing gibbous', 'Full moon', 'Waning gibbous', 'Last quarter', 'Waning crescent'], dayShort: ['M', 'T', 'W', 'T', 'F', 'S', 'S'], qualities: { excellent: 'Excellent', good: 'Good' } },
} as const;
const t = texts[lang];
const enhancedVisibility = lang !== 'en';
const publicIntro = {
  ca: 'Descobreix i compara els objectes fotografiats d’aquesta web des d’una ubicació de referència al centre de Catalunya. Quan n’hagis escollit un, Planificació permet estudiar-lo des de la teva ubicació.',
  es: 'Descubre y compara los objetos fotografiados de esta web desde una ubicación de referencia en el centro de Cataluña. Cuando elijas uno, Planificación permite estudiarlo desde tu ubicación.',
  en: 'Discover and compare photographed objects from this website from a reference location in central Catalonia. Once you choose one, Planning lets you study it from your own location.',
}[lang];
const latestByObject = new Map<string, CollectionEntry<'fotos'>>();
for (const foto of [...fotos].sort((a, b) => b.data.entorn.data.valueOf() - a.data.entorn.data.valueOf())) {
  if (foto.data.objecte_astronomic && !latestByObject.has(foto.data.objecte_astronomic)) latestByObject.set(foto.data.objecte_astronomic, foto);
}
const photographedAlias = (catalogName: string, localizedName: string) => {
  const escapedCatalog = [...catalogName.replace(/\s+/g, '')]
    .map((character) => character.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'))
    .join('\\s*');
  const withoutCatalog = localizedName
    .replace(new RegExp(`^\\s*${escapedCatalog}(?:\\s*\\((?:HOO|SHO|Hα|NN)\\))?\\s*(?:[–—,:-]\\s*)?`, 'i'), '')
    .trim();
  if (withoutCatalog) return withoutCatalog;
  const compact = (value: string) => value.replace(/\s+/g, '').toLocaleLowerCase();
  return compact(localizedName) === compact(catalogName) ? undefined : localizedName;
};
const cards = Object.entries(visibility.objects).map(([id, object]) => {
  const foto = latestByObject.get(id);
  const commonName = object.commonNames?.[lang];
  const text = foto ? photoText(foto, lang) : undefined;
  const displayAlias = formatCatalogDesignations(commonName ?? (text ? photographedAlias(object.catalogName, text.objecte) : undefined));
  return { id, object, displayAlias, displayCatalogName: formatCatalogDesignations(object.catalogName), foto, text };
});
const photographedCount = cards.filter(({ object }) => object.status === 'photographed').length;
const pendingCount = cards.filter(({ object }) => object.status === 'pending').length;
const visibleCards = showPending ? cards : cards.filter(({ object }) => object.status === 'photographed');
const today = new Date();
const isoWeekParts = (date: Date) => {
  const day = new Date(Date.UTC(date.getUTCFullYear(), date.getUTCMonth(), date.getUTCDate()));
  day.setUTCDate(day.getUTCDate() + 4 - (day.getUTCDay() || 7));
  const year = day.getUTCFullYear();
  const yearStart = new Date(Date.UTC(year, 0, 1));
  return { year, week: Math.ceil((((day.getTime() - yearStart.getTime()) / 86400000) + 1) / 7) };
};
const currentIso = isoWeekParts(today);
const januaryFourth = new Date(Date.UTC(currentIso.year, 0, 4));
const firstMonday = new Date(januaryFourth.getTime() - ((januaryFourth.getUTCDay() || 7) - 1) * 86400000);
const weekCount = cards[0]?.object.nightWeeks.length ?? 52;
const currentWeek = currentIso.week;
const yearOptions = Array.from({ length: 5 }, (_, index) => currentIso.year - 1 + index);
const dateLocale = { ca: 'ca-ES', es: 'es-ES', en: 'en-GB' }[lang];
const weekRange = (week: number) => {
  const start = new Date(firstMonday.getTime() + (week - 1) * 7 * 86400000);
  const end = new Date(start.getTime() + 6 * 86400000);
  const startMonth = new Intl.DateTimeFormat(dateLocale, { month: 'short', timeZone: 'UTC' }).format(start).replace('.', '');
  const endMonth = new Intl.DateTimeFormat(dateLocale, { month: 'short', timeZone: 'UTC' }).format(end).replace('.', '');
  return startMonth === endMonth
    ? `${start.getUTCDate()}–${end.getUTCDate()} ${endMonth}`
    : `${start.getUTCDate()} ${startMonth}–${end.getUTCDate()} ${endMonth}`;
};
---

<Layout title={t.title} lang={lang} languageLinks={languageLinks.visibility(base)} focused>
  <section class="visibility-planner" aria-labelledby="visibility-title">
    <header class="visibility-planner__header">
      <div class="visibility-planner__meta"><p class="visibility-planner__eyebrow">{t.analysed(visibleCards.length)}</p><p class="visibility-planner__location">⌖ {t.location}</p></div>
      <h1 id="visibility-title">{t.title}</h1>
      <p>{showPending ? t.intro : publicIntro}</p>
      {enhancedVisibility && <a class="visibility-guide-link" href={visibilityGuideHref(lang, base)} title={t.guideTooltip}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3.5 5.5c3.2-.8 5.9-.3 8.5 1.6v12c-2.6-1.9-5.3-2.4-8.5-1.6zM20.5 5.5c-3.2-.8-5.9-.3-8.5 1.6v12c2.6-1.9 5.3-2.4 8.5-1.6z" /></svg>
        <span>{t.guide}</span>
      </a>}
    </header>

    <div class="visibility-toolbar"><div class="visibility-toolbar__selectors"><div class="week-control">
      <label for="visibility-week">{t.week}</label>
      <div class="week-control__row">
        <button type="button" data-week-step="-1" aria-label="−1">−</button>
        <select id="visibility-week">
          {Array.from({ length: weekCount }, (_, index) => <option value={index + 1} selected={index + 1 === currentWeek}>{index + 1}  {weekRange(index + 1)}</option>)}
        </select>
        <button type="button" data-week-step="1" aria-label="+1">+</button>
        <select id="visibility-year" aria-label={lang === 'ca' ? 'Any' : lang === 'es' ? 'Año' : 'Year'}>
          {yearOptions.map((year) => <option value={year} selected={year === currentIso.year}>{year}</option>)}
        </select>
      </div>
    </div>
    {enhancedVisibility && <label class="hours-control" for="visibility-hours"><span>{t.minimumVisibility}</span><select id="visibility-hours">{[2, 3, 4, 5, 6].map((hours) => <option value={hours} selected={hours === 4}>{hours} h</option>)}</select></label>}
    </div>

    <nav class="visibility-layout" aria-label={t.display} data-visibility-layout-controls>
      <button type="button" data-visibility-layout="photos" aria-pressed="true">{t.photos}</button>
      <button type="button" data-visibility-layout="list" aria-pressed="false">{t.list}</button>
    </nav>

    {showPending && <nav class="visibility-filters" aria-label={t.title}>
      <button type="button" data-visibility-filter="photographed" aria-pressed="true">{t.photographed} <span>{photographedCount}</span></button>
      <button type="button" data-visibility-filter="pending" aria-pressed="false">{t.pending} <span>{pendingCount}</span></button>
    </nav>}</div>

    <p class="visibility-results" aria-live="polite"><strong data-visible-count>—</strong> <span data-visible-label>{t.selectedObjects}</span></p>
    <p class="visibility-empty" data-visibility-empty hidden>{t.noResults}</p>

    {showPending && <section class="pending-explorer" data-pending-explorer hidden>
      <div class="pending-explorer__list"><h2>{t.choosePending}</h2><div data-pending-list>
        {cards.filter(({ object }) => object.status === 'pending').map(({ id, object, displayAlias, displayCatalogName }) => <button type="button" data-pending-select data-object-id={id} data-object-name={displayAlias ? `${displayCatalogName} · ${displayAlias}` : displayCatalogName} data-ra={object.raDeg} data-dec={object.decDeg} data-status="pending" data-chart-values={JSON.stringify(object.weeks.map((week) => week.altitudeDeg))} data-weeks={JSON.stringify(object.nightWeeks.map((week) => [week.maxAltitudeDeg, week.bestTimeUtc, week.hoursAbove['30'], week.quality, week.representativeNight]))}><span>{displayCatalogName}{displayAlias && <small class="pending-explorer__alias">{displayAlias}</small>}</span><small data-pending-altitude>—</small></button>)}
      </div></div>
      <div class="pending-explorer__chart"><p>{t.annualChart}</p><h2 data-pending-chart-title></h2><div class="visibility-chart__plot" data-pending-chart-plot></div><p class="visibility-chart__selection"><span></span> <b data-pending-chart-week></b></p><button type="button" class="pending-explorer__detail" data-open-pending-chart>{t.viewChart} →</button></div>
    </section>}

    <div class="visibility-grid" data-visibility-grid>
      {visibleCards.map(({ id, object, displayAlias, displayCatalogName, foto, text }) => {
        const compactWeeks = object.nightWeeks.map((week) => [week.maxAltitudeDeg, week.bestTimeUtc, week.hoursAbove['30'], week.quality, week.representativeNight]);
        return <article class:list={{ 'visibility-card': true, 'visibility-card--pending': object.status === 'pending' }} data-visibility-card data-object-id={id} data-object-name={displayAlias ? `${displayCatalogName} · ${displayAlias}` : displayCatalogName} data-ra={object.raDeg} data-dec={object.decDeg} data-status={object.status} data-weeks={JSON.stringify(compactWeeks)} data-chart-values={JSON.stringify(object.weeks.map((week) => week.altitudeDeg))}>
          {foto && text
            ? <a class="visibility-card__image" data-photo-link href={photoHref(lang, foto.id, base)}><img src={withBase(`imagenes/cielo-profundo/${foto.data.imatge}`, base)} alt={text.objecte} loading="lazy" /></a>
            : <button class="visibility-card__image visibility-card__image--pending" type="button" data-open-chart aria-label={`${t.viewChart}: ${displayCatalogName}`}><span aria-hidden="true">P</span></button>}
          <div class="visibility-card__body">
            <div class="visibility-card__heading">
              <div><p>{foto ? foto.data.constellacio : t.pendingTarget}</p><h2>{displayCatalogName}</h2>{displayAlias && <p class="visibility-card__alias">{displayAlias}</p>}</div>
              <div class="visibility-card__badges">{object.status === 'pending' && <span class="pending-badge">{t.pending}</span>}<span data-quality></span></div>
            </div>
            <dl>
              <div class="visibility-card__primary"><dt>{t.maxAltitude}</dt><dd data-altitude>—</dd></div>
              <div><dt>{t.bestTime}</dt><dd><span data-best-time>—</span> <small>{t.localTime}</small></dd></div>
              <div><dt>{t.usefulTime}</dt><dd data-hours>—</dd></div>
              <div><dt>{t.night}</dt><dd data-night>—</dd></div>
            </dl>
            <div class="visibility-card__actions">
              {foto ? <a class="visibility-card__link" data-photo-link href={photoHref(lang, foto.id, base)}>{t.view}<span aria-hidden="true">→</span></a> : <p class="visibility-card__pending-note">{t.pendingNote}</p>}
              <button type="button" class="visibility-card__chart-link" data-open-chart aria-label={`${t.viewChart}: ${displayCatalogName}`}>{t.viewChart}</button>
              <a class="visibility-card__plan-link" data-planning-link href={`${planningHref(lang, base)}?object=${encodeURIComponent(id)}&from=visibility`}>{t.plan}<span aria-hidden="true">→</span></a>
            </div>
          </div>
        </article>;
      })}
    </div>
    <dialog class="visibility-chart" data-visibility-chart>
      <div class="visibility-chart__header"><div><p data-chart-kicker>{t.annualChart}</p><h2 data-chart-title></h2></div><button type="button" data-close-chart aria-label={t.close}>×</button></div>
      <nav class="visibility-chart__tabs" data-chart-tabs hidden><button type="button" data-chart-mode="annual" aria-pressed="true">{t.annual}</button><button type="button" data-chart-mode="night" aria-pressed="false">{t.selectedNight}</button></nav>
      {enhancedVisibility && <div class="night-controls" data-night-controls hidden><span>{t.selectedDay}</span><div class="night-controls__days" role="group" aria-label={t.selectedDay}>{t.dayShort.map((day, index) => <button type="button" data-night-day={index} aria-pressed={index === 3}>{day}</button>)}</div><div class="night-legend"><span class="night-legend__object">— {t.objectCurve}</span><span class="night-legend__moon">┄ {t.moonCurve}</span><strong data-moon-phase><span data-moon-phase-icon aria-hidden="true"></span><span data-moon-phase-label></span></strong></div></div>}
      <div class="visibility-chart__plot" data-chart-plot></div>
      <p class="visibility-chart__selection"><span></span> <b data-chart-week></b></p>
    </dialog>
  </section>
</Layout>

<script define:vars={{ t, lang, showPending, enhancedVisibility }}>
  const selector = document.querySelector('#visibility-week');
  const yearSelector = document.querySelector('#visibility-year');
  const hoursSelector = document.querySelector('#visibility-hours');
  const grid = document.querySelector('[data-visibility-grid]');
  const cards = [...document.querySelectorAll('[data-visibility-card]')];
  const filterButtons = [...document.querySelectorAll('[data-visibility-filter]')];
  const layoutButtons = [...document.querySelectorAll('[data-visibility-layout]')];
  const layoutControls = document.querySelector('[data-visibility-layout-controls]');
  const visibleCount = document.querySelector('[data-visible-count]');
  const visibleLabel = document.querySelector('[data-visible-label]');
  const emptyMessage = document.querySelector('[data-visibility-empty]');
  const pendingExplorer = document.querySelector('[data-pending-explorer]');
  const pendingButtons = [...document.querySelectorAll('[data-pending-select]')];
  const chartDialog = document.querySelector('[data-visibility-chart]');
  const chartTabs = document.querySelector('[data-chart-tabs]');
  const chartModeButtons = [...document.querySelectorAll('[data-chart-mode]')];
  const nightControls = document.querySelector('[data-night-controls]');
  const nightDayButtons = [...document.querySelectorAll('[data-night-day]')];
  let currentChartSource;
  let selectedNightDay = 3;
  const locale = { ca: 'ca-ES', es: 'es-ES', en: 'en-GB' }[lang];
  const millisecondsPerDay = 86400000;
  const firstIsoMonday = (year) => {
    const januaryFourth = new Date(Date.UTC(year, 0, 4));
    return new Date(januaryFourth.getTime() - ((januaryFourth.getUTCDay() || 7) - 1) * millisecondsPerDay);
  };
  const isoWeeksInYear = (year) => Math.round((firstIsoMonday(year + 1).getTime() - firstIsoMonday(year).getTime()) / (7 * millisecondsPerDay));
  const isoDate = (year, week, day = 0) => new Date(firstIsoMonday(year).getTime() + ((week - 1) * 7 + day) * millisecondsPerDay);
  const formatWeekRange = (year, week) => {
    const start = isoDate(year, week), end = isoDate(year, week, 6);
    const month = (date) => new Intl.DateTimeFormat(locale, { month: 'short', timeZone: 'UTC' }).format(date).replace('.', '');
    return month(start) === month(end)
      ? `${start.getUTCDate()}–${end.getUTCDate()} ${month(end)}`
      : `${start.getUTCDate()} ${month(start)}–${end.getUTCDate()} ${month(end)}`;
  };
  const ensureYearOption = (year) => {
    if ([...yearSelector.options].some((option) => Number(option.value) === year)) return;
    yearSelector.add(new Option(String(year), String(year)));
    [...yearSelector.options].sort((a, b) => Number(a.value) - Number(b.value)).forEach((option) => yearSelector.add(option));
  };
  const rebuildWeekOptions = (year, preferredWeek = Number(selector.value)) => {
    const count = isoWeeksInYear(year);
    selector.replaceChildren(...Array.from({ length: count }, (_, index) => {
      const week = index + 1;
      return new Option(`${week}\u2003\u2003${formatWeekRange(year, week)}`, String(week));
    }));
    selector.value = String(Math.max(1, Math.min(count, preferredWeek || 1)));
  };
  const requestedView = new URL(window.location.href).searchParams.get('view');
  let currentView = showPending && requestedView === 'pending' ? 'pending' : 'photographed';
  const requestedLayout = new URL(window.location.href).searchParams.get('layout');
  let currentLayout = ['photos', 'list'].includes(requestedLayout) ? requestedLayout : 'photos';
  const weekStorageKey = 'deepskyastro.visibility.week';
  const yearStorageKey = 'deepskyastro.visibility.year';
  const requestedWeek = Number(new URL(window.location.href).searchParams.get('week'));
  const requestedYear = Number(new URL(window.location.href).searchParams.get('year'));
  const storedWeek = Number(window.sessionStorage.getItem(weekStorageKey));
  const storedYear = Number(window.sessionStorage.getItem(yearStorageKey));
  const initialYear = Number.isInteger(requestedYear) && requestedYear >= 1900 && requestedYear <= 2200
    ? requestedYear
    : Number.isInteger(storedYear) && storedYear >= 1900 && storedYear <= 2200 ? storedYear : Number(yearSelector.value);
  ensureYearOption(initialYear);
  yearSelector.value = String(initialYear);
  rebuildWeekOptions(initialYear, requestedWeek || storedWeek || Number(selector.value));
  const initialWeek = Number.isInteger(requestedWeek) && requestedWeek >= 1 && requestedWeek <= selector.options.length
    ? requestedWeek
    : storedWeek;
  if (Number.isInteger(initialWeek) && initialWeek >= 1 && initialWeek <= selector.options.length) {
    selector.value = String(initialWeek);
  }
  const requestedHours = Number(new URL(window.location.href).searchParams.get('hours'));
  if (hoursSelector && [2, 3, 4, 5, 6].includes(requestedHours)) hoursSelector.value = String(requestedHours);
  const update = () => {
    const week = Number(selector.value);
    const year = Number(yearSelector.value);
    window.sessionStorage.setItem(weekStorageKey, String(week));
    window.sessionStorage.setItem(yearStorageKey, String(year));
    const minimumHours = hoursSelector ? Number(hoursSelector.value) : 4;
    const currentUrl = new URL(window.location.href);
    currentUrl.searchParams.set('week', String(week));
    currentUrl.searchParams.set('year', String(year));
    currentUrl.searchParams.set('view', currentView);
    currentUrl.searchParams.set('layout', currentLayout);
    if (hoursSelector) currentUrl.searchParams.set('hours', String(minimumHours));
    window.history.replaceState(null, '', currentUrl);
    document.querySelectorAll('[data-photo-link]').forEach((link) => {
      const photoUrl = new URL(link.href);
      photoUrl.searchParams.set('from', 'visibility');
      photoUrl.searchParams.set('week', String(week));
      photoUrl.searchParams.set('year', String(year));
      photoUrl.searchParams.set('view', currentView);
      photoUrl.searchParams.set('layout', currentLayout);
      if (hoursSelector) photoUrl.searchParams.set('hours', String(minimumHours));
      link.href = `${photoUrl.pathname}${photoUrl.search}`;
    });
    document.querySelectorAll('[data-planning-link]').forEach((link) => {
      const planningUrl = new URL(link.href);
      planningUrl.searchParams.set('object', link.closest('[data-visibility-card]').dataset.objectId);
      planningUrl.searchParams.set('from', 'visibility');
      planningUrl.searchParams.set('week', String(week));
      planningUrl.searchParams.set('year', String(year));
      link.href = `${planningUrl.pathname}${planningUrl.search}`;
    });
    document.querySelectorAll('.language-selector a').forEach((link) => {
      const languageUrl = new URL(link.href);
      languageUrl.searchParams.set('week', String(week));
      languageUrl.searchParams.set('year', String(year));
      languageUrl.searchParams.set('view', currentView);
      languageUrl.searchParams.set('layout', currentLayout);
