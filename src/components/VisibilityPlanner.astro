---
import type { CollectionEntry } from 'astro:content';
import type { Lang } from '../i18n';
import { languageLinks, photoHref, withBase } from '../i18n';
import { photoText } from '../photoTranslations';
import Layout from '../layouts/Layout.astro';
import visibility from '../data/visibility.generated.json';

interface Props { lang: Lang; fotos: CollectionEntry<'fotos'>[]; }
const { lang, fotos } = Astro.props;
const base = import.meta.env.BASE_URL;
const texts = {
  ca: { title: 'Què podem fotografiar aquesta setmana?', intro: 'Selecció dels objectes fotografiats d’aquesta web i dels objectius pendents que es poden observar durant la setmana escollida.', location: 'Centre de Catalunya · 41° N, 1,5° E · Nit astronòmica: Sol per sota de −18°', analysed: (count: number) => `${count} objectes astronòmics analitzats`, week: 'Setmana de l’any', photographed: 'Fotografiats', pending: 'Pendents', all: 'Tots', pendingTarget: 'Objectiu pendent', pendingNote: 'Pendent de fotografiar', choosePending: 'Selecciona un objectiu pendent', maxAltitude: 'Altura màxima', bestTime: 'Millor hora', localTime: 'hora local', usefulTime: 'Temps útil', above: 'sobre', view: 'Veure fotografia', viewChart: 'Veure gràfica V', annualChart: 'Visibilitat anual · 00:00 UTC', selectedWeek: 'Setmana seleccionada · 00:00 UTC', close: 'Tancar', night: 'Nit de referència', qualities: { excellent: 'Excel·lent', good: 'Bona', low: 'Baixa', 'very-low': 'Molt baixa', 'not-visible': 'No visible' } },
  es: { title: '¿Qué podemos fotografiar esta semana?', intro: 'Selección de los objetos fotografiados de esta web y de los objetivos pendientes que pueden observarse durante la semana elegida.', location: 'Centro de Cataluña · 41° N, 1,5° E · Noche astronómica: Sol por debajo de −18°', analysed: (count: number) => `${count} objetos astronómicos analizados`, week: 'Semana del año', photographed: 'Fotografiados', pending: 'Pendientes', all: 'Todos', pendingTarget: 'Objetivo pendiente', pendingNote: 'Pendiente de fotografiar', choosePending: 'Selecciona un objetivo pendiente', maxAltitude: 'Altura máxima', bestTime: 'Mejor hora', localTime: 'hora local', usefulTime: 'Tiempo útil', above: 'sobre', view: 'Ver fotografía', viewChart: 'Ver gráfica V', annualChart: 'Visibilidad anual · 00:00 UTC', selectedWeek: 'Semana seleccionada · 00:00 UTC', close: 'Cerrar', night: 'Noche de referencia', qualities: { excellent: 'Excelente', good: 'Buena', low: 'Baja', 'very-low': 'Muy baja', 'not-visible': 'No visible' } },
  en: { title: 'What can we photograph this week?', intro: 'A selection of photographed objects from this website and pending targets that can be observed during the chosen week.', location: 'Central Catalonia · 41° N, 1.5° E · Astronomical night: Sun below −18°', analysed: (count: number) => `${count} astronomical objects analysed`, week: 'Week of the year', photographed: 'Photographed', pending: 'Pending', all: 'All', pendingTarget: 'Pending target', pendingNote: 'Waiting to be photographed', choosePending: 'Select a pending target', maxAltitude: 'Maximum altitude', bestTime: 'Best time', localTime: 'local time', usefulTime: 'Useful time', above: 'above', view: 'View photograph', viewChart: 'View V chart', annualChart: 'Annual visibility · 00:00 UTC', selectedWeek: 'Selected week · 00:00 UTC', close: 'Close', night: 'Reference night', qualities: { excellent: 'Excellent', good: 'Good', low: 'Low', 'very-low': 'Very low', 'not-visible': 'Not visible' } },
} as const;
const t = texts[lang];
const latestByObject = new Map<string, CollectionEntry<'fotos'>>();
for (const foto of [...fotos].sort((a, b) => b.data.entorn.data.valueOf() - a.data.entorn.data.valueOf())) {
  if (foto.data.objecte_astronomic && !latestByObject.has(foto.data.objecte_astronomic)) latestByObject.set(foto.data.objecte_astronomic, foto);
}
const cards = Object.entries(visibility.objects).map(([id, object]) => {
  const foto = latestByObject.get(id);
  return { id, object, foto, text: foto ? photoText(foto, lang) : undefined };
});
const photographedCount = cards.filter(({ object }) => object.status === 'photographed').length;
const pendingCount = cards.filter(({ object }) => object.status === 'pending').length;
const today = new Date();
const referenceYear = visibility.observatory.referenceYear;
const januaryFourth = new Date(Date.UTC(referenceYear, 0, 4));
const firstMonday = new Date(januaryFourth.getTime() - ((januaryFourth.getUTCDay() || 7) - 1) * 86400000);
const weekCount = cards[0]?.object.nightWeeks.length ?? 52;
const currentWeek = Math.max(1, Math.min(weekCount, Math.floor((Date.UTC(today.getUTCFullYear(), today.getUTCMonth(), today.getUTCDate()) - firstMonday.getTime()) / (7 * 86400000)) + 1));
const dateLocale = { ca: 'ca-ES', es: 'es-ES', en: 'en-GB' }[lang];
const weekRange = (week: number) => {
  const start = new Date(firstMonday.getTime() + (week - 1) * 7 * 86400000);
  const end = new Date(start.getTime() + 6 * 86400000);
  const startMonth = new Intl.DateTimeFormat(dateLocale, { month: 'short', timeZone: 'UTC' }).format(start).replace('.', '');
  const endMonth = new Intl.DateTimeFormat(dateLocale, { month: 'short', timeZone: 'UTC' }).format(end).replace('.', '');
  return startMonth === endMonth
    ? `${start.getUTCDate()}–${end.getUTCDate()} ${endMonth}`
    : `${start.getUTCDate()} ${startMonth}–${end.getUTCDate()} ${endMonth}`;
};
---

<Layout title={t.title} lang={lang} languageLinks={languageLinks.visibility(base)}>
  <section class="visibility-planner" aria-labelledby="visibility-title">
    <header class="visibility-planner__header">
      <p class="visibility-planner__eyebrow">{t.analysed(cards.length)}</p>
      <h1 id="visibility-title">{t.title}</h1>
      <p>{t.intro}</p>
      <p class="visibility-planner__location">⌖ {t.location}</p>
    </header>

    <div class="week-control">
      <label for="visibility-week">{t.week}</label>
      <div class="week-control__row">
        <button type="button" data-week-step="-1" aria-label="−1">−</button>
        <div class="week-control__select">
          <select id="visibility-week">
            {Array.from({ length: weekCount }, (_, index) => <option value={index + 1} selected={index + 1 === currentWeek}>{index + 1}  {weekRange(index + 1)}</option>)}
          </select>
        </div>
        <button type="button" data-week-step="1" aria-label="+1">+</button>
      </div>
    </div>

    <nav class="visibility-filters" aria-label={t.title}>
      <button type="button" data-visibility-filter="photographed" aria-pressed="true">{t.photographed} <span>{photographedCount}</span></button>
      <button type="button" data-visibility-filter="pending" aria-pressed="false">{t.pending} <span>{pendingCount}</span></button>
      <button type="button" data-visibility-filter="all" aria-pressed="false">{t.all} <span>{cards.length}</span></button>
    </nav>

    <section class="pending-explorer" data-pending-explorer hidden>
      <div class="pending-explorer__list"><h2>{t.choosePending}</h2><div data-pending-list>
        {cards.filter(({ object }) => object.status === 'pending').map(({ object }) => <button type="button" data-pending-select data-object-name={object.catalogName} data-chart-values={JSON.stringify(object.weeks.map((week) => week.altitudeDeg))} data-weeks={JSON.stringify(object.nightWeeks.map((week) => [week.maxAltitudeDeg, week.quality]))}><span>{object.catalogName}</span><small data-pending-altitude>—</small></button>)}
      </div></div>
      <div class="pending-explorer__chart"><p>{t.annualChart}</p><h2 data-pending-chart-title></h2><div class="visibility-chart__plot" data-pending-chart-plot></div><p class="visibility-chart__selection"><span></span> <b data-pending-chart-week></b></p></div>
    </section>

    <div class="visibility-grid" data-visibility-grid>
      {cards.map(({ object, foto, text }) => {
        const compactWeeks = object.nightWeeks.map((week) => [week.maxAltitudeDeg, week.bestTimeUtc, week.hoursAbove['20'], week.hoursAbove['25'], week.hoursAbove['30'], week.quality, week.representativeNight]);
        return <article class:list={{ 'visibility-card': true, 'visibility-card--pending': object.status === 'pending' }} data-visibility-card data-object-name={object.catalogName} data-status={object.status} data-weeks={JSON.stringify(compactWeeks)} data-chart-values={JSON.stringify(object.weeks.map((week) => week.altitudeDeg))}>
          {foto && text
            ? <a class="visibility-card__image" href={photoHref(lang, foto.id, base)}><img src={withBase(`imagenes/cielo-profundo/${foto.data.imatge}`, base)} alt={text.objecte} loading="lazy" /></a>
            : <button class="visibility-card__image visibility-card__image--pending" type="button" data-open-chart aria-label={`${t.viewChart}: ${object.catalogName}`}><span aria-hidden="true">P</span></button>}
          <div class="visibility-card__body">
            <div class="visibility-card__heading">
              <div><p>{foto ? foto.data.constellacio : t.pendingTarget}</p><h2>{object.catalogName}</h2></div>
              <div class="visibility-card__badges">{object.status === 'pending' && <span class="pending-badge">{t.pending}</span>}<span data-quality></span></div>
            </div>
            <dl>
              <div class="visibility-card__primary"><dt>{t.maxAltitude}</dt><dd data-altitude>—</dd></div>
              <div><dt>{t.bestTime}</dt><dd><span data-best-time>—</span> <small>{t.localTime}</small></dd></div>
              <div><dt>{t.usefulTime}</dt><dd data-hours>—</dd></div>
              <div><dt>{t.night}</dt><dd data-night>—</dd></div>
            </dl>
            <div class="visibility-card__actions">
              {foto ? <a class="visibility-card__link" href={photoHref(lang, foto.id, base)}>{t.view} →</a> : <p class="visibility-card__pending-note">{t.pendingNote}</p>}
              <button type="button" class="visibility-card__chart-link" data-open-chart><b aria-hidden="true">V</b>{t.viewChart}</button>
            </div>
          </div>
        </article>;
      })}
    </div>
    <dialog class="visibility-chart" data-visibility-chart>
      <div class="visibility-chart__header"><div><p>{t.annualChart}</p><h2 data-chart-title></h2></div><button type="button" data-close-chart aria-label={t.close}>×</button></div>
      <div class="visibility-chart__plot" data-chart-plot></div>
      <p class="visibility-chart__selection"><span></span> <b data-chart-week></b></p>
    </dialog>
  </section>
</Layout>

<script define:vars={{ t, lang }}>
  const selector = document.querySelector('#visibility-week');
  const grid = document.querySelector('[data-visibility-grid]');
  const cards = [...document.querySelectorAll('[data-visibility-card]')];
  const filterButtons = [...document.querySelectorAll('[data-visibility-filter]')];
  const pendingExplorer = document.querySelector('[data-pending-explorer]');
  const pendingButtons = [...document.querySelectorAll('[data-pending-select]')];
  const chartDialog = document.querySelector('[data-visibility-chart]');
  const locale = { ca: 'ca-ES', es: 'es-ES', en: 'en-GB' }[lang];
  const requestedView = new URL(window.location.href).searchParams.get('view');
  let currentView = ['photographed', 'pending', 'all'].includes(requestedView) ? requestedView : 'photographed';
  const requestedWeek = Number(new URL(window.location.href).searchParams.get('week'));
  if (Number.isInteger(requestedWeek) && requestedWeek >= 1 && requestedWeek <= selector.options.length) {
    selector.value = String(requestedWeek);
  }
  const update = () => {
    const week = Number(selector.value);
    const currentUrl = new URL(window.location.href);
    currentUrl.searchParams.set('week', String(week));
    currentUrl.searchParams.set('view', currentView);
    window.history.replaceState(null, '', currentUrl);
    document.querySelectorAll('.language-selector a').forEach((link) => {
      const languageUrl = new URL(link.href);
      languageUrl.searchParams.set('week', String(week));
      languageUrl.searchParams.set('view', currentView);
      link.href = `${languageUrl.pathname}${languageUrl.search}${languageUrl.hash}`;
    });
    cards.forEach((card) => {
      card.hidden = currentView !== 'all' && card.dataset.status !== currentView;
      const value = JSON.parse(card.dataset.weeks)[week - 1];
      const [altitude, bestTimeUtc, hours20, hours25, hours30, qualityCode, representativeNight] = value;
      card.dataset.altitude = altitude;
      card.querySelector('[data-altitude]').textContent = `${altitude.toLocaleString(locale)}°`;
      card.querySelector('[data-best-time]').textContent = new Intl.DateTimeFormat(locale, { timeZone: 'Europe/Madrid', hour: '2-digit', minute: '2-digit' }).format(new Date(bestTimeUtc));
      card.querySelector('[data-hours]').textContent = `>${30}°: ${hours30.toLocaleString(locale)} h · >${25}°: ${hours25.toLocaleString(locale)} h · >${20}°: ${hours20.toLocaleString(locale)} h`;
      card.querySelector('[data-night]').textContent = new Intl.DateTimeFormat(locale, { day: 'numeric', month: 'short' }).format(new Date(`${representativeNight}T12:00:00Z`));
      const quality = card.querySelector('[data-quality]');
      quality.textContent = t.qualities[qualityCode];
      quality.className = `quality quality--${qualityCode}`;
    });
    grid.hidden = currentView === 'pending';
    pendingExplorer.hidden = currentView !== 'pending';
    pendingButtons.forEach((button) => {
      const [altitude, quality] = JSON.parse(button.dataset.weeks)[week - 1];
      button.dataset.altitude = altitude;
      button.querySelector('[data-pending-altitude]').textContent = `${altitude.toLocaleString(locale)}° · ${t.qualities[quality]}`;
    });
    pendingButtons.sort((a, b) => Number(b.dataset.altitude) - Number(a.dataset.altitude));
    document.querySelector('[data-pending-list]').append(...pendingButtons);
    filterButtons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.visibilityFilter === currentView)));
    cards.sort((a, b) => Number(b.dataset.altitude) - Number(a.dataset.altitude));
    grid.append(...cards);
    const selectedPending = pendingButtons.find((button) => button.getAttribute('aria-pressed') === 'true') ?? pendingButtons[0];
    if (selectedPending) selectPending(selectedPending);
  };
  selector?.addEventListener('change', update);
  filterButtons.forEach((button) => button.addEventListener('click', () => {
    currentView = button.dataset.visibilityFilter;
    update();
  }));
  document.querySelectorAll('[data-week-step]').forEach((button) => button.addEventListener('click', () => {
    selector.value = String(Math.max(1, Math.min(selector.options.length, Number(selector.value) + Number(button.dataset.weekStep))));
    update();
  }));
  const renderChart = (source, plot, title, weekLabel) => {
    const values = JSON.parse(source.dataset.chartValues);
    const selected = Number(selector.value) - 1;
    const width = 760, height = 360, left = 48, right = 18, top = 22, bottom = 42;
    const x = (index) => left + index * (width - left - right) / (values.length - 1);
    const y = (altitude) => top + (90 - Math.max(-60, Math.min(90, altitude))) * (height - top - bottom) / 150;
    const points = values.map((altitude, index) => `${x(index).toFixed(1)},${y(altitude).toFixed(1)}`).join(' ');
    const gridLines = [-60, -30, 0, 20, 30, 60, 90].map((altitude) => `<g><line x1="${left}" y1="${y(altitude)}" x2="${width-right}" y2="${y(altitude)}"/><text x="${left-9}" y="${y(altitude)+4}" text-anchor="end">${altitude}°</text></g>`).join('');
    const weekLabels = [1, 13, 26, 39, values.length].map((week) => `<text x="${x(week-1)}" y="${height-14}" text-anchor="middle">${week}</text>`).join('');
    title.textContent = source.dataset.objectName;
    weekLabel.textContent = `${t.selectedWeek}: ${selected + 1} · ${values[selected].toLocaleString(locale)}°`;
    plot.innerHTML = `<svg viewBox="0 0 ${width} ${height}" role="img" aria-label="${t.annualChart}: ${source.dataset.objectName}"><g class="chart-grid">${gridLines}</g><line class="chart-threshold chart-threshold--20" x1="${left}" y1="${y(20)}" x2="${width-right}" y2="${y(20)}"/><line class="chart-threshold" x1="${left}" y1="${y(30)}" x2="${width-right}" y2="${y(30)}"/><polyline class="chart-line" points="${points}"/><line class="chart-selected" x1="${x(selected)}" y1="${top}" x2="${x(selected)}" y2="${height-bottom}"/><circle class="chart-point" cx="${x(selected)}" cy="${y(values[selected])}" r="6"/><g class="chart-weeks">${weekLabels}</g></svg>`;
  };
  const selectPending = (button) => {
    pendingButtons.forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
    renderChart(button, document.querySelector('[data-pending-chart-plot]'), document.querySelector('[data-pending-chart-title]'), document.querySelector('[data-pending-chart-week]'));
  };
  const drawChart = (card) => {
    renderChart(card, chartDialog.querySelector('[data-chart-plot]'), chartDialog.querySelector('[data-chart-title]'), chartDialog.querySelector('[data-chart-week]'));
    chartDialog.showModal();
  };
  pendingButtons.forEach((button) => button.addEventListener('click', () => selectPending(button)));
  document.querySelectorAll('[data-open-chart]').forEach((button) => button.addEventListener('click', () => drawChart(button.closest('[data-visibility-card]'))));
  document.querySelector('[data-close-chart]')?.addEventListener('click', () => chartDialog.close());
  chartDialog?.addEventListener('click', (event) => { if (event.target === chartDialog) chartDialog.close(); });
  update();
</script>

<style>
  .visibility-planner { padding: 1.5rem 0 3rem; }
  .visibility-planner__header { max-width: 52rem; margin-bottom: 1.5rem; }
  .visibility-planner__eyebrow { color: var(--color-accent); font-family: var(--font-mono); font-size: .75rem; letter-spacing: .08em; text-transform: uppercase; }
  .visibility-planner h1 { margin: .25rem 0 .65rem; font-size: clamp(2rem, 5vw, 3.6rem); line-height: 1.05; }
  .visibility-planner__header > p:not(.visibility-planner__eyebrow) { color: var(--color-muted); }
  .visibility-planner__location { display: inline-flex; margin-top: .6rem; padding: .55rem .75rem; border: 1px solid var(--color-border); border-radius: .45rem; background: var(--color-surface); font-family: var(--font-mono); font-size: .78rem; }
  .week-control { display: flex; align-items: end; justify-content: space-between; gap: 1rem; margin: 1.75rem 0 1.25rem; padding: 1rem; border: 1px solid var(--color-border); border-radius: .8rem; background: linear-gradient(135deg, rgba(224,106,69,.12), var(--color-surface)); }
  .week-control label { font-weight: 700; }
  .week-control__row { display: flex; gap: .5rem; }
  .week-control select, .week-control button { min-height: 2.7rem; border: 1px solid var(--color-border); border-radius: .45rem; background: #0d121c; color: var(--color-text); font: 700 1rem var(--font-mono); }
  .week-control__select { display: grid; gap: .18rem; }
  .week-control select { min-width: 11rem; padding: 0 .8rem; }
  .week-control button { width: 2.7rem; cursor: pointer; }
  .visibility-filters { display: flex; gap: .5rem; margin: 0 0 1.25rem; overflow-x: auto; scrollbar-width: none; }
  .visibility-filters::-webkit-scrollbar { display: none; }
  .visibility-filters button { padding: .55rem .75rem; border: 1px solid var(--color-border); border-radius: 999px; background: transparent; color: var(--color-muted); cursor: pointer; font: 700 .78rem var(--font-sans); white-space: nowrap; }
  .visibility-filters button span { margin-left: .3rem; color: inherit; font-family: var(--font-mono); font-size: .68rem; }
  .visibility-filters button[aria-pressed="true"] { border-color: var(--color-accent); background: rgba(224,106,69,.13); color: var(--color-text); }
  [hidden] { display: none !important; }
  .pending-explorer { grid-template-columns: minmax(12rem, 15rem) minmax(0, 1fr); gap: 1rem; }
  .pending-explorer:not([hidden]) { display: grid; }
  .pending-explorer__list, .pending-explorer__chart { border: 1px solid var(--color-border); border-radius: .8rem; background: var(--color-surface); }
  .pending-explorer__list { padding: .85rem; }
  .pending-explorer__list h2 { margin: 0 0 .7rem; font-size: .9rem; }
  .pending-explorer__list > div { display: grid; gap: .35rem; }
  .pending-explorer__list button { display: grid; gap: .12rem; padding: .58rem .65rem; border: 1px solid transparent; border-radius: .45rem; background: transparent; color: var(--color-text); cursor: pointer; text-align: left; }
  .pending-explorer__list button:hover, .pending-explorer__list button[aria-pressed="true"] { border-color: rgba(85,217,179,.45); background: rgba(85,217,179,.1); }
  .pending-explorer__list button span { font-weight: 700; }
  .pending-explorer__list button small { color: var(--color-muted); font-family: var(--font-mono); }
  .pending-explorer__chart { min-width: 0; padding: 1rem; }
  .pending-explorer__chart > p:first-child { margin: 0 0 .15rem; color: #78e8c7; font: .72rem var(--font-mono); text-transform: uppercase; }
  .pending-explorer__chart h2 { margin: 0; }
  .visibility-grid { display: grid; gap: 1rem; }
  .visibility-card { display: grid; grid-template-columns: minmax(10rem, 28%) 1fr; overflow: hidden; border: 1px solid var(--color-border); border-radius: .8rem; background: var(--color-surface); }
  .visibility-card__image img { width: 100%; height: 100%; min-height: 15rem; object-fit: cover; }
  .visibility-card__image--pending { display: grid; width: 100%; min-height: 15rem; padding: 0; place-items: center; border: 0; background: radial-gradient(circle at 30% 30%, rgba(85,217,179,.12), transparent 35%), linear-gradient(145deg, #111925, #090d14); cursor: pointer; }
  .visibility-card__image--pending span { display: grid; width: 4.5rem; height: 4.5rem; place-items: center; border: 1px solid rgba(85,217,179,.5); border-radius: 50%; color: #78e8c7; font: 700 2rem var(--font-mono); }
  .visibility-card--pending { border-color: rgba(85,217,179,.28); }
  .visibility-card__body { padding: 1.1rem 1.25rem; }
  .visibility-card__heading { display: flex; align-items: start; justify-content: space-between; gap: 1rem; }
  .visibility-card__heading p { margin: 0 0 .15rem; color: var(--color-muted); font: .72rem var(--font-mono); text-transform: uppercase; }
  .visibility-card__badges { display: flex; flex-wrap: wrap; justify-content: end; gap: .4rem; }
  .visibility-card h2 { margin: 0; font-size: 1.45rem; }
  .quality { padding: .35rem .55rem; border-radius: 999px; font-size: .72rem; font-weight: 700; white-space: nowrap; }
  .quality--excellent { background: rgba(85,217,179,.16); color: #78e8c7; }
  .quality--good { background: rgba(102,170,255,.16); color: #8bbcff; }
  .quality--low, .quality--very-low { background: rgba(239,177,73,.16); color: #f1c36e; }
  .quality--not-visible { background: rgba(255,255,255,.08); color: var(--color-muted); }
  .pending-badge { padding: .35rem .55rem; border-radius: 999px; background: rgba(85,217,179,.16); color: #78e8c7; font-size: .72rem; font-weight: 700; white-space: nowrap; }
  .visibility-card dl { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .8rem; margin: 1rem 0; }
  .visibility-card dl div { padding: .75rem; border: 1px solid var(--color-border); border-radius: .55rem; }
  .visibility-card dl .visibility-card__primary { grid-row: span 2; }
  .visibility-card dt { color: var(--color-muted); font-size: .72rem; }
  .visibility-card dd { margin: .25rem 0 0; font-family: var(--font-mono); }
  .visibility-card__primary dd { color: var(--color-accent); font-size: 2rem; }
  .visibility-card__link { font-weight: 700; }
  .visibility-card__pending-note { margin: 0; color: #78e8c7; font-size: .82rem; font-weight: 700; }
  .visibility-card__actions { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .visibility-card__chart-link { display: inline-flex; align-items: center; gap: .45rem; padding: 0; border: 0; background: transparent; color: var(--color-text); cursor: pointer; font: 700 .82rem var(--font-sans); }
  .visibility-card__chart-link b { display: grid; width: 1.8rem; height: 1.8rem; place-items: center; border: 1px solid #55d9b3; border-radius: 50%; color: #78e8c7; font: 700 .78rem var(--font-mono); }
