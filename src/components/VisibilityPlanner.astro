---
import type { CollectionEntry } from 'astro:content';
import type { Lang } from '../i18n';
import { languageLinks, photoHref, withBase } from '../i18n';
import { photoText } from '../photoTranslations';
import Layout from '../layouts/Layout.astro';
import visibility from '../data/visibility.generated.json';

interface Props { lang: Lang; fotos: CollectionEntry<'fotos'>[]; showPending?: boolean; }
const { lang, fotos, showPending = true } = Astro.props;
const base = import.meta.env.BASE_URL;
const texts = {
  ca: { title: 'Què podem fotografiar aquesta setmana?', intro: 'Selecció dels objectes fotografiats d’aquesta web i dels objectius pendents que es poden observar durant la setmana escollida.', location: 'Centre de Catalunya · 41° N, 1,5° E · Nit astronòmica: Sol per sota de −18°', analysed: (count: number) => `${count} objectes astronòmics analitzats`, week: 'Setmana de l’any', photographed: 'Fotografiats', pending: 'Pendents', all: 'Tots', photos: 'Amb fotos', list: 'Llista', display: 'Visualització dels objectes fotografiats', selectedObject: 'objecte seleccionat', selectedObjects: 'objectes seleccionats', noResults: 'No hi ha objectes que compleixin els criteris aquesta setmana.', pendingTarget: 'Objectiu pendent', pendingNote: 'Pendent de fotografiar', choosePending: 'Selecciona un objectiu pendent', maxAltitude: 'Altura màxima', bestTime: 'Millor hora', localTime: 'hora local', usefulTime: 'Temps sobre 30°', above: 'sobre', view: 'Veure fotografia', viewChart: 'Veure gràfica V', annual: 'Anual', selectedNight: 'Nit seleccionada', annualChart: 'Visibilitat anual · 00:00 UTC', nightChart: 'Altura durant la nit astronòmica', darkness: 'Foscor astronòmica', selectedWeek: 'Setmana seleccionada', close: 'Tancar', night: 'Nit del màxim', qualities: { excellent: 'Excel·lent', good: 'Bona' } },
  es: { title: '¿Qué podemos fotografiar esta semana?', intro: 'Selección de los objetos fotografiados de esta web y de los objetivos pendientes que pueden observarse durante la semana elegida.', location: 'Centro de Cataluña · 41° N, 1,5° E · Noche astronómica: Sol por debajo de −18°', analysed: (count: number) => `${count} objetos astronómicos analizados`, week: 'Semana del año', photographed: 'Fotografiados', pending: 'Pendientes', all: 'Todos', photos: 'Con fotos', list: 'Lista', display: 'Visualización de los objetos fotografiados', selectedObject: 'objeto seleccionado', selectedObjects: 'objetos seleccionados', noResults: 'No hay objetos que cumplan los criterios esta semana.', pendingTarget: 'Objetivo pendiente', pendingNote: 'Pendiente de fotografiar', choosePending: 'Selecciona un objetivo pendiente', maxAltitude: 'Altura máxima', bestTime: 'Mejor hora', localTime: 'hora local', usefulTime: 'Tiempo sobre 30°', above: 'sobre', view: 'Ver fotografía', viewChart: 'Ver gráfica V', annual: 'Anual', selectedNight: 'Noche seleccionada', annualChart: 'Visibilidad anual · 00:00 UTC', nightChart: 'Altura durante la noche astronómica', darkness: 'Oscuridad astronómica', selectedWeek: 'Semana seleccionada', close: 'Cerrar', night: 'Noche del máximo', qualities: { excellent: 'Excelente', good: 'Buena' } },
  en: { title: 'What can we photograph this week?', intro: 'A selection of photographed objects from this website and pending targets that can be observed during the chosen week.', location: 'Central Catalonia · 41° N, 1.5° E · Astronomical night: Sun below −18°', analysed: (count: number) => `${count} astronomical objects analysed`, week: 'Week of the year', photographed: 'Photographed', pending: 'Pending', all: 'All', photos: 'With photos', list: 'List', display: 'Photographed objects display', selectedObject: 'selected object', selectedObjects: 'selected objects', noResults: 'No objects meet the criteria this week.', pendingTarget: 'Pending target', pendingNote: 'Waiting to be photographed', choosePending: 'Select a pending target', maxAltitude: 'Maximum altitude', bestTime: 'Best time', localTime: 'local time', usefulTime: 'Time above 30°', above: 'above', view: 'View photograph', viewChart: 'View V chart', annual: 'Annual', selectedNight: 'Selected night', annualChart: 'Annual visibility · 00:00 UTC', nightChart: 'Altitude during astronomical night', darkness: 'Astronomical darkness', selectedWeek: 'Selected week', close: 'Close', night: 'Night of maximum', qualities: { excellent: 'Excellent', good: 'Good' } },
} as const;
const t = texts[lang];
const publicIntro = {
  ca: 'Selecció dels objectes fotografiats d’aquesta web que es poden observar durant la setmana escollida.',
  es: 'Selección de los objetos fotografiados de esta web que pueden observarse durante la semana elegida.',
  en: 'A selection of photographed objects from this website that can be observed during the chosen week.',
}[lang];
const latestByObject = new Map<string, CollectionEntry<'fotos'>>();
for (const foto of [...fotos].sort((a, b) => b.data.entorn.data.valueOf() - a.data.entorn.data.valueOf())) {
  if (foto.data.objecte_astronomic && !latestByObject.has(foto.data.objecte_astronomic)) latestByObject.set(foto.data.objecte_astronomic, foto);
}
const cards = Object.entries(visibility.objects).map(([id, object]) => {
  const foto = latestByObject.get(id);
  const commonName = object.commonNames?.[lang];
  return { id, object, commonName, foto, text: foto ? photoText(foto, lang) : undefined };
});
const photographedCount = cards.filter(({ object }) => object.status === 'photographed').length;
const pendingCount = cards.filter(({ object }) => object.status === 'pending').length;
const visibleCards = showPending ? cards : cards.filter(({ object }) => object.status === 'photographed');
const today = new Date();
const referenceYear = visibility.observatory.referenceYear;
const januaryFourth = new Date(Date.UTC(referenceYear, 0, 4));
const firstMonday = new Date(januaryFourth.getTime() - ((januaryFourth.getUTCDay() || 7) - 1) * 86400000);
const weekCount = cards[0]?.object.nightWeeks.length ?? 52;
const currentWeek = Math.max(1, Math.min(weekCount, Math.floor((Date.UTC(today.getUTCFullYear(), today.getUTCMonth(), today.getUTCDate()) - firstMonday.getTime()) / (7 * 86400000)) + 1));
const dateLocale = { ca: 'ca-ES', es: 'es-ES', en: 'en-GB' }[lang];
const weekRange = (week: number) => {
  const start = new Date(firstMonday.getTime() + (week - 1) * 7 * 86400000);
  const end = new Date(start.getTime() + 6 * 86400000);
  const startMonth = new Intl.DateTimeFormat(dateLocale, { month: 'short', timeZone: 'UTC' }).format(start).replace('.', '');
  const endMonth = new Intl.DateTimeFormat(dateLocale, { month: 'short', timeZone: 'UTC' }).format(end).replace('.', '');
  return startMonth === endMonth
    ? `${start.getUTCDate()}–${end.getUTCDate()} ${endMonth}`
    : `${start.getUTCDate()} ${startMonth}–${end.getUTCDate()} ${endMonth}`;
};
---

<Layout title={t.title} lang={lang} languageLinks={languageLinks.visibility(base)} focused>
  <section class="visibility-planner" aria-labelledby="visibility-title">
    <header class="visibility-planner__header">
      <div class="visibility-planner__meta"><p class="visibility-planner__eyebrow">{t.analysed(visibleCards.length)}</p><p class="visibility-planner__location">⌖ {t.location}</p></div>
      <h1 id="visibility-title">{t.title}</h1>
      <p>{showPending ? t.intro : publicIntro}</p>
    </header>

    <div class="visibility-toolbar"><div class="week-control">
      <label for="visibility-week">{t.week}</label>
      <div class="week-control__row">
        <button type="button" data-week-step="-1" aria-label="−1">−</button>
        <div class="week-control__select">
          <select id="visibility-week">
            {Array.from({ length: weekCount }, (_, index) => <option value={index + 1} selected={index + 1 === currentWeek}>{index + 1}  {weekRange(index + 1)}</option>)}
          </select>
        </div>
        <button type="button" data-week-step="1" aria-label="+1">+</button>
      </div>
    </div>

    <nav class="visibility-layout" aria-label={t.display} data-visibility-layout-controls>
      <button type="button" data-visibility-layout="photos" aria-pressed="true">{t.photos}</button>
      <button type="button" data-visibility-layout="list" aria-pressed="false">{t.list}</button>
    </nav>

    {showPending && <nav class="visibility-filters" aria-label={t.title}>
      <button type="button" data-visibility-filter="photographed" aria-pressed="true">{t.photographed} <span>{photographedCount}</span></button>
      <button type="button" data-visibility-filter="pending" aria-pressed="false">{t.pending} <span>{pendingCount}</span></button>
    </nav>}</div>

    <p class="visibility-results" aria-live="polite"><strong data-visible-count>—</strong> <span data-visible-label>{t.selectedObjects}</span></p>
    <p class="visibility-empty" data-visibility-empty hidden>{t.noResults}</p>

    {showPending && <section class="pending-explorer" data-pending-explorer hidden>
      <div class="pending-explorer__list"><h2>{t.choosePending}</h2><div data-pending-list>
        {cards.filter(({ object }) => object.status === 'pending').map(({ object, commonName }) => <button type="button" data-pending-select data-object-name={commonName ? `${object.catalogName} · ${commonName}` : object.catalogName} data-chart-values={JSON.stringify(object.weeks.map((week) => week.altitudeDeg))} data-weeks={JSON.stringify(object.nightWeeks.map((week) => [week.maxAltitudeDeg, week.bestTimeUtc, week.hoursAbove['30'], week.quality, week.representativeNight]))}><span>{object.catalogName}{commonName && <small class="pending-explorer__alias">{commonName}</small>}</span><small data-pending-altitude>—</small></button>)}
      </div></div>
      <div class="pending-explorer__chart"><p>{t.annualChart}</p><h2 data-pending-chart-title></h2><div class="visibility-chart__plot" data-pending-chart-plot></div><p class="visibility-chart__selection"><span></span> <b data-pending-chart-week></b></p></div>
    </section>}

    <div class="visibility-grid" data-visibility-grid>
      {visibleCards.map(({ id, object, commonName, foto, text }) => {
        const compactWeeks = object.nightWeeks.map((week) => [week.maxAltitudeDeg, week.bestTimeUtc, week.hoursAbove['30'], week.quality, week.representativeNight]);
        return <article class:list={{ 'visibility-card': true, 'visibility-card--pending': object.status === 'pending' }} data-visibility-card data-object-id={id} data-object-name={object.catalogName} data-ra={object.raDeg} data-dec={object.decDeg} data-status={object.status} data-weeks={JSON.stringify(compactWeeks)} data-chart-values={JSON.stringify(object.weeks.map((week) => week.altitudeDeg))}>
          {foto && text
            ? <a class="visibility-card__image" data-photo-link href={photoHref(lang, foto.id, base)}><img src={withBase(`imagenes/cielo-profundo/${foto.data.imatge}`, base)} alt={text.objecte} loading="lazy" /></a>
            : <button class="visibility-card__image visibility-card__image--pending" type="button" data-open-chart aria-label={`${t.viewChart}: ${object.catalogName}`}><span aria-hidden="true">P</span></button>}
          <div class="visibility-card__body">
            <div class="visibility-card__heading">
              <div><p>{foto ? foto.data.constellacio : t.pendingTarget}</p><h2>{object.catalogName}</h2>{commonName && <p class="visibility-card__alias">{commonName}</p>}</div>
              <div class="visibility-card__badges">{object.status === 'pending' && <span class="pending-badge">{t.pending}</span>}<span data-quality></span></div>
            </div>
            <dl>
              <div class="visibility-card__primary"><dt>{t.maxAltitude}</dt><dd data-altitude>—</dd></div>
              <div><dt>{t.bestTime}</dt><dd><span data-best-time>—</span> <small>{t.localTime}</small></dd></div>
              <div><dt>{t.usefulTime}</dt><dd data-hours>—</dd></div>
              <div><dt>{t.night}</dt><dd data-night>—</dd></div>
            </dl>
            <div class="visibility-card__actions">
              {foto ? <a class="visibility-card__link" data-photo-link href={photoHref(lang, foto.id, base)}>{t.view} →</a> : <p class="visibility-card__pending-note">{t.pendingNote}</p>}
              <button type="button" class="visibility-card__chart-link" data-open-chart aria-label={`${t.viewChart}: ${object.catalogName}`}><b aria-hidden="true">V</b><span class="visibility-card__chart-label">{t.viewChart}</span></button>
            </div>
          </div>
        </article>;
      })}
    </div>
    <dialog class="visibility-chart" data-visibility-chart>
      <div class="visibility-chart__header"><div><p data-chart-kicker>{t.annualChart}</p><h2 data-chart-title></h2></div><button type="button" data-close-chart aria-label={t.close}>×</button></div>
      <nav class="visibility-chart__tabs" data-chart-tabs hidden><button type="button" data-chart-mode="annual" aria-pressed="true">{t.annual}</button><button type="button" data-chart-mode="night" aria-pressed="false">{t.selectedNight}</button></nav>
      <div class="visibility-chart__plot" data-chart-plot></div>
      <p class="visibility-chart__selection"><span></span> <b data-chart-week></b></p>
    </dialog>
  </section>
</Layout>

<script define:vars={{ t, lang, referenceYear, showPending }}>
  const selector = document.querySelector('#visibility-week');
  const grid = document.querySelector('[data-visibility-grid]');
  const cards = [...document.querySelectorAll('[data-visibility-card]')];
  const filterButtons = [...document.querySelectorAll('[data-visibility-filter]')];
  const layoutButtons = [...document.querySelectorAll('[data-visibility-layout]')];
  const layoutControls = document.querySelector('[data-visibility-layout-controls]');
  const chartLabels = [...document.querySelectorAll('.visibility-card__chart-label')];
  const visibleCount = document.querySelector('[data-visible-count]');
  const visibleLabel = document.querySelector('[data-visible-label]');
  const emptyMessage = document.querySelector('[data-visibility-empty]');
  const pendingExplorer = document.querySelector('[data-pending-explorer]');
  const pendingButtons = [...document.querySelectorAll('[data-pending-select]')];
  const chartDialog = document.querySelector('[data-visibility-chart]');
  const chartTabs = document.querySelector('[data-chart-tabs]');
  const chartModeButtons = [...document.querySelectorAll('[data-chart-mode]')];
  let currentChartSource;
  const locale = { ca: 'ca-ES', es: 'es-ES', en: 'en-GB' }[lang];
  const isoJanuaryFourth = new Date(Date.UTC(referenceYear, 0, 4));
  const isoFirstMonday = new Date(isoJanuaryFourth.getTime() - ((isoJanuaryFourth.getUTCDay() || 7) - 1) * 86400000);
  const requestedView = new URL(window.location.href).searchParams.get('view');
  let currentView = showPending && requestedView === 'pending' ? 'pending' : 'photographed';
  const requestedLayout = new URL(window.location.href).searchParams.get('layout');
  let currentLayout = ['photos', 'list'].includes(requestedLayout) ? requestedLayout : 'photos';
  const requestedWeek = Number(new URL(window.location.href).searchParams.get('week'));
  if (Number.isInteger(requestedWeek) && requestedWeek >= 1 && requestedWeek <= selector.options.length) {
    selector.value = String(requestedWeek);
  }
  const update = () => {
    const week = Number(selector.value);
    const currentUrl = new URL(window.location.href);
    currentUrl.searchParams.set('week', String(week));
    currentUrl.searchParams.set('view', currentView);
    currentUrl.searchParams.set('layout', currentLayout);
    window.history.replaceState(null, '', currentUrl);
    document.querySelectorAll('[data-photo-link]').forEach((link) => {
      const photoUrl = new URL(link.href);
      photoUrl.searchParams.set('from', 'visibility');
      photoUrl.searchParams.set('week', String(week));
      photoUrl.searchParams.set('view', currentView);
      photoUrl.searchParams.set('layout', currentLayout);
      link.href = `${photoUrl.pathname}${photoUrl.search}`;
    });
    document.querySelectorAll('.language-selector a').forEach((link) => {
      const languageUrl = new URL(link.href);
      languageUrl.searchParams.set('week', String(week));
      languageUrl.searchParams.set('view', currentView);
      languageUrl.searchParams.set('layout', currentLayout);
      link.href = `${languageUrl.pathname}${languageUrl.search}${languageUrl.hash}`;
    });
    cards.forEach((card) => {
      const value = JSON.parse(card.dataset.weeks)[week - 1];
      const [altitude, bestTimeUtc, hours30, qualityCode, representativeNight] = value;
      card.dataset.selected = String(Boolean(qualityCode));
      card.hidden = card.dataset.status !== currentView || !qualityCode;
      card.dataset.altitude = altitude;
      card.querySelector('[data-altitude]').textContent = `${altitude.toLocaleString(locale)}°`;
      card.querySelector('[data-best-time]').textContent = new Intl.DateTimeFormat(locale, { timeZone: 'Europe/Madrid', hour: '2-digit', minute: '2-digit' }).format(new Date(bestTimeUtc));
      card.querySelector('[data-hours]').textContent = `${hours30.toLocaleString(locale)} h`;
      card.querySelector('[data-night]').textContent = new Intl.DateTimeFormat(locale, { day: 'numeric', month: 'short' }).format(new Date(`${representativeNight}T12:00:00Z`));
      const quality = card.querySelector('[data-quality]');
      quality.hidden = !qualityCode;
      quality.textContent = qualityCode ? t.qualities[qualityCode] : '';
      quality.className = qualityCode ? `quality quality--${qualityCode}` : '';
    });
    grid.hidden = currentView === 'pending';
    grid.classList.toggle('visibility-grid--list', currentLayout === 'list');
    chartLabels.forEach((label) => { label.hidden = currentLayout === 'list'; });
    layoutControls.hidden = currentView !== 'photographed';
    layoutButtons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.visibilityLayout === currentLayout)));
    if (pendingExplorer) pendingExplorer.hidden = currentView !== 'pending';
    pendingButtons.forEach((button) => {
      const [altitude, , , quality] = JSON.parse(button.dataset.weeks)[week - 1];
      button.dataset.altitude = altitude;
      button.hidden = !quality;
      button.querySelector('[data-pending-altitude]').textContent = `${altitude.toLocaleString(locale)}°${quality ? ` · ${t.qualities[quality]}` : ''}`;
    });
    pendingButtons.sort((a, b) => Number(b.dataset.altitude) - Number(a.dataset.altitude));
    document.querySelector('[data-pending-list]')?.append(...pendingButtons);
    const counts = Object.fromEntries(['photographed', 'pending'].map((status) => [status, cards.filter((card) => card.dataset.status === status && card.dataset.selected === 'true').length]));
    filterButtons.forEach((button) => {
      button.setAttribute('aria-pressed', String(button.dataset.visibilityFilter === currentView));
      button.querySelector('span').textContent = String(counts[button.dataset.visibilityFilter]);
    });
    const currentCount = counts[currentView];
    visibleCount.textContent = String(currentCount);
    visibleLabel.textContent = currentCount === 1 ? t.selectedObject : t.selectedObjects;
    emptyMessage.hidden = currentCount !== 0;
    cards.sort((a, b) => Number(b.dataset.altitude) - Number(a.dataset.altitude));
    grid.append(...cards);
    const visiblePendingButtons = pendingButtons.filter((button) => !button.hidden);
    const selectedPending = visiblePendingButtons.find((button) => button.getAttribute('aria-pressed') === 'true') ?? visiblePendingButtons[0];
    const pendingChart = document.querySelector('.pending-explorer__chart');
    if (pendingChart) pendingChart.hidden = !selectedPending;
    if (selectedPending) selectPending(selectedPending);
  };
  selector?.addEventListener('change', update);
  filterButtons.forEach((button) => button.addEventListener('click', () => {
    currentView = button.dataset.visibilityFilter;
    update();
  }));
  layoutButtons.forEach((button) => button.addEventListener('click', () => {
    currentLayout = button.dataset.visibilityLayout;
    update();
  }));
  document.querySelectorAll('[data-week-step]').forEach((button) => button.addEventListener('click', () => {
    selector.value = String(Math.max(1, Math.min(selector.options.length, Number(selector.value) + Number(button.dataset.weekStep))));
    update();
  }));
  const renderChart = (source, plot, title, weekLabel) => {
    const values = JSON.parse(source.dataset.chartValues);
    const selected = Number(selector.value) - 1;
    const weekData = JSON.parse(source.dataset.weeks)[selected];
    const middleDate = new Date(isoFirstMonday.getTime() + (selected * 7 + 3) * 86400000);
    const maximumDate = new Intl.DateTimeFormat(locale, { day: 'numeric', month: 'short', timeZone: 'UTC' }).format(middleDate);
    const width = 760, height = 360, left = 48, right = 18, top = 22, bottom = 62;
    const x = (index) => left + index * (width - left - right) / (values.length - 1);
    const y = (altitude) => top + (90 - Math.max(-60, Math.min(90, altitude))) * (height - top - bottom) / 150;
    const points = values.map((altitude, index) => `${x(index).toFixed(1)},${y(altitude).toFixed(1)}`).join(' ');
    const gridLines = [-60, -30, 0, 20, 30, 60, 90].map((altitude) => `<g><line x1="${left}" y1="${y(altitude)}" x2="${width-right}" y2="${y(altitude)}"/><text x="${left-9}" y="${y(altitude)+4}" text-anchor="end">${altitude}°</text></g>`).join('');
    const weekLabels = [1, 13, 26, 39, values.length].map((week) => `<text x="${x(week-1)}" y="${height-14}" text-anchor="middle">${week}</text>`).join('');
    title.textContent = source.dataset.objectName;
    weekLabel.textContent = `${t.selectedWeek}: ${selected + 1} · 00:00 UTC · ${values[selected].toLocaleString(locale)}°`;
    plot.innerHTML = `<svg viewBox="0 0 ${width} ${height}" role="img" aria-label="${t.annualChart}: ${source.dataset.objectName}"><g class="chart-grid">${gridLines}</g><line class="chart-threshold" x1="${left}" y1="${y(30)}" x2="${width-right}" y2="${y(30)}"/><polyline class="chart-line" points="${points}"/><line class="chart-selected" x1="${x(selected)}" y1="${top}" x2="${x(selected)}" y2="${height-bottom}"/><circle class="chart-point" cx="${x(selected)}" cy="${y(values[selected])}" r="6"/><text class="chart-maximum-date" x="${x(selected)}" y="${height-bottom+20}" text-anchor="middle">${maximumDate}</text><g class="chart-weeks">${weekLabels}</g></svg>`;
  };
  const selectPending = (button) => {
    pendingButtons.forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
    renderChart(button, document.querySelector('[data-pending-chart-plot]'), document.querySelector('[data-pending-chart-title]'), document.querySelector('[data-pending-chart-week]'));
  };
  const drawChart = (card) => {
    currentChartSource = card;
    chartTabs.hidden = card.dataset.status !== 'photographed';
    chartModeButtons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.chartMode === 'annual')));
    chartDialog.querySelector('[data-chart-kicker]').textContent = t.annualChart;
    renderChart(card, chartDialog.querySelector('[data-chart-plot]'), chartDialog.querySelector('[data-chart-title]'), chartDialog.querySelector('[data-chart-week]'));
    chartDialog.showModal();
  };
  const normalizeDegrees = (value) => ((value % 360) + 360) % 360;
  const altitudeAt = (date, raDeg, decDeg) => {
    const days = date.getTime() / 86400000 + 2440587.5 - 2451545;
    const hourAngle = normalizeDegrees(normalizeDegrees(280.46061837 + 360.98564736629 * days) + 1.5 - raDeg + 180) - 180;
    const rad = Math.PI / 180, latitude = 41 * rad, declination = decDeg * rad, angle = hourAngle * rad;
    return Math.asin(Math.sin(latitude) * Math.sin(declination) + Math.cos(latitude) * Math.cos(declination) * Math.cos(angle)) / rad;
  };
  const sunPosition = (date) => {
    const days = date.getTime() / 86400000 + 2440587.5 - 2451545;
    const meanLongitude = normalizeDegrees(280.46 + .9856474 * days);
    const anomaly = normalizeDegrees(357.528 + .9856003 * days) * Math.PI / 180;
    const longitude = normalizeDegrees(meanLongitude + 1.915 * Math.sin(anomaly) + .02 * Math.sin(2 * anomaly)) * Math.PI / 180;
    const obliquity = (23.439 - .0000004 * days) * Math.PI / 180;
    return { ra: normalizeDegrees(Math.atan2(Math.cos(obliquity) * Math.sin(longitude), Math.cos(longitude)) * 180 / Math.PI), dec: Math.asin(Math.sin(obliquity) * Math.sin(longitude)) * 180 / Math.PI };
  };
  const renderNightChart = (source) => {
    const middleDate = new Date(isoFirstMonday.getTime() + ((Number(selector.value) - 1) * 7 + 3) * 86400000);
    const date = middleDate.toISOString().slice(0, 10);
    const dayStart = Date.parse(`${date}T12:00:00Z`), darkMinutes = [];
    for (let time = dayStart; time < dayStart + 86400000; time += 60000) {
      const instant = new Date(time), sun = sunPosition(instant);
      if (altitudeAt(instant, sun.ra, sun.dec) <= -18) darkMinutes.push(time);
    }
    const darknessStart = darkMinutes[0], darknessEnd = darkMinutes[darkMinutes.length - 1];
    const samples = [];
    for (let time = darknessStart; time <= darknessEnd; time += 300000) {
      const instant = new Date(time);
      samples.push({ instant, altitude: altitudeAt(instant, Number(source.dataset.ra), Number(source.dataset.dec)) });
    }
    if (samples.at(-1).instant.getTime() !== darknessEnd) {
      const instant = new Date(darknessEnd);
      samples.push({ instant, altitude: altitudeAt(instant, Number(source.dataset.ra), Number(source.dataset.dec)) });
    }
    const width = 760, height = 360, left = 48, right = 18, top = 22, bottom = 62;
    const x = (index) => left + index * (width - left - right) / Math.max(1, samples.length - 1);
    const y = (altitude) => top + (90 - Math.max(-60, Math.min(90, altitude))) * (height - top - bottom) / 150;
    const points = samples.map((sample, index) => `${x(index).toFixed(1)},${y(sample.altitude).toFixed(1)}`).join(' ');
    const gridLines = [-60, -30, 0, 20, 30, 60, 90].map((altitude) => `<g><line x1="${left}" y1="${y(altitude)}" x2="${width-right}" y2="${y(altitude)}"/><text x="${left-9}" y="${y(altitude)+4}" text-anchor="end">${altitude}°</text></g>`).join('');
    const labelIndexes = [0, .25, .5, .75, 1].map((part) => Math.round((samples.length - 1) * part));
    const timeLabels = labelIndexes.map((index) => `<text x="${x(index)}" y="${height-14}" text-anchor="middle">${new Intl.DateTimeFormat(locale, { timeZone: 'Europe/Madrid', hour: '2-digit', minute: '2-digit' }).format(samples[index].instant)}</text>`).join('');
    const best = samples.reduce((current, sample) => sample.altitude > current.altitude ? sample : current);
    const usefulHours = samples.filter((sample) => sample.altitude >= 30).length / 12;
    chartDialog.querySelector('[data-chart-title]').textContent = source.dataset.objectName;
    chartDialog.querySelector('[data-chart-plot]').innerHTML = `<svg viewBox="0 0 ${width} ${height}" role="img" aria-label="${t.nightChart}: ${source.dataset.objectName}"><g class="chart-grid">${gridLines}</g><line class="chart-night-boundary" x1="${left}" y1="${top}" x2="${left}" y2="${height-bottom}"/><line class="chart-night-boundary" x1="${width-right}" y1="${top}" x2="${width-right}" y2="${height-bottom}"/><line class="chart-threshold" x1="${left}" y1="${y(30)}" x2="${width-right}" y2="${y(30)}"/><polyline class="chart-line" points="${points}"/><g class="chart-weeks">${timeLabels}</g></svg>`;
    const bestTime = new Intl.DateTimeFormat(locale, { timeZone: 'Europe/Madrid', hour: '2-digit', minute: '2-digit' }).format(best.instant);
    const timeFormat = new Intl.DateTimeFormat(locale, { timeZone: 'Europe/Madrid', hour: '2-digit', minute: '2-digit' });
    chartDialog.querySelector('[data-chart-week]').textContent = `${date} · ${t.darkness}: ${timeFormat.format(new Date(darknessStart))}–${timeFormat.format(new Date(darknessEnd))} · ${t.maxAltitude}: ${best.altitude.toLocaleString(locale, { maximumFractionDigits: 1 })}° (${bestTime}) · ${usefulHours.toLocaleString(locale, { maximumFractionDigits: 1 })} h ${t.above} 30°`;
  };
  chartModeButtons.forEach((button) => button.addEventListener('click', () => {
    if (!currentChartSource) return;
    chartModeButtons.forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
    const nightMode = button.dataset.chartMode === 'night';
    chartDialog.querySelector('[data-chart-kicker]').textContent = nightMode ? t.nightChart : t.annualChart;
    if (nightMode) renderNightChart(currentChartSource);
    else renderChart(currentChartSource, chartDialog.querySelector('[data-chart-plot]'), chartDialog.querySelector('[data-chart-title]'), chartDialog.querySelector('[data-chart-week]'));
  }));
  pendingButtons.forEach((button) => button.addEventListener('click', () => selectPending(button)));
  document.querySelectorAll('[data-open-chart]').forEach((button) => button.addEventListener('click', () => drawChart(button.closest('[data-visibility-card]'))));
  document.querySelector('[data-close-chart]')?.addEventListener('click', () => chartDialog.close());
  chartDialog?.addEventListener('click', (event) => { if (event.target === chartDialog) chartDialog.close(); });
  update();
</script>

