---
import Layout from '../layouts/Layout.astro';
import SiteMapIcon from './SiteMapIcon.astro';
import type { Lang } from '../i18n';
import { articlesHref, copy, equipmentAnalyzerHref, equipmentHref, galleryHref, homeHref, languageLinks, planningHref, sessionPreparationHref, visibilityHref } from '../i18n';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const base = import.meta.env.BASE_URL;
const t = {
ca:{title:'Mapa de la web',intro:'Tria una branca per desplegar-ne l’organigrama. Cada node final obre la secció corresponent.',start:'Punt de partida',explore:'Explorar el cel',exploreHelp:'Fotografies, objectes i fitxes de la galeria.',prepare:'Preparar una sessió',prepareHelp:'Descoberta, enquadrament i planificació astronòmica.',learn:'Conèixer el projecte',learnHelp:'Equip utilitzat i contingut publicat.',galleryHelp:'Cerca per objecte, filtra per categoria i obre les fitxes.',photo:'Fitxa fotogràfica',photoHelp:'Amplia la imatge i revisa les dades de captura.',sessionHelp:'Punt d’entrada de les tres eines de preparació.',visibilityHelp:'Descobreix i compara objectes durant una setmana.',analyserHelp:'Comprova l’enquadrament amb el teu equip.',planningHelp:'Estudia un objecte durant set nits.',equipmentHelp:'Explora el tren òptic, el guiatge i la muntura.',articlesHelp:'Llegeix contingut pràctic sobre astrofotografia.',continue:'Continua el recorregut',discoverRoute:'Troba un objecte i decideix quan fotografiar-lo',frameRoute:'Comprova si encaixa en el teu equip',planRoute:'Passa al càlcul detallat',open:'Obrir',display:'Branques del mapa'},
es:{title:'Mapa de la web',intro:'Selecciona una rama para desplegar su organigrama. Cada nodo final abre la sección correspondiente.',start:'Punto de partida',explore:'Explorar el cielo',exploreHelp:'Fotografías, objetos y fichas de la galería.',prepare:'Preparar una sesión',prepareHelp:'Descubrimiento, encuadre y planificación astronómica.',learn:'Conocer el proyecto',learnHelp:'Equipo utilizado y contenido publicado.',galleryHelp:'Busca por objeto, filtra por categoría y abre las fichas.',photo:'Ficha fotográfica',photoHelp:'Amplía la imagen y revisa los datos de captura.',sessionHelp:'Punto de entrada de las tres herramientas de preparación.',visibilityHelp:'Descubre y compara objetos durante una semana.',analyserHelp:'Comprueba el encuadre con tu equipo.',planningHelp:'Estudia un objeto durante siete noches.',equipmentHelp:'Explora el tren óptico, el guiado y la montura.',articlesHelp:'Lee contenido práctico sobre astrofotografía.',continue:'Continúa el recorrido',discoverRoute:'Encuentra un objeto y decide cuándo fotografiarlo',frameRoute:'Comprueba si encaja en tu equipo',planRoute:'Pasa al cálculo detallado',open:'Abrir',display:'Ramas del mapa'},
en:{title:'Site map',intro:'Select a branch to expand its organisation chart. Each final node opens the corresponding section.',start:'Starting point',explore:'Explore the sky',exploreHelp:'Photographs, objects and gallery pages.',prepare:'Prepare a session',prepareHelp:'Astronomical discovery, framing and planning.',learn:'Discover the project',learnHelp:'Equipment used and published content.',galleryHelp:'Search by object, filter by category and open its page.',photo:'Photograph page',photoHelp:'Enlarge the image and review capture details.',sessionHelp:'Entry point for the three preparation tools.',visibilityHelp:'Discover and compare objects over a week.',analyserHelp:'Check the framing with your equipment.',planningHelp:'Study one object over seven nights.',equipmentHelp:'Explore the imaging train, guiding and mount.',articlesHelp:'Read practical astrophotography content.',continue:'Continue the journey',discoverRoute:'Find an object and decide when to photograph it',frameRoute:'Check whether it fits your equipment',planRoute:'Move to detailed calculation',open:'Open',display:'Map branches'}
}[lang];
const nightText={ca:{title:'La meva nit',help:'Futur espai per reunir la preparació d’una nit.',status:'En construcció'},es:{title:'Mi noche',help:'Futuro espacio para reunir la preparación de una noche.',status:'En construcción'},en:{title:'My night',help:'Future space bringing one night’s preparation together.',status:'Under construction'}}[lang];
const branches=[{id:'explore',icon:'gallery' as const,title:t.explore,help:t.exploreHelp},{id:'prepare',icon:'route' as const,title:t.prepare,help:t.prepareHelp},{id:'learn',icon:'equipment' as const,title:t.learn,help:t.learnHelp},{id:'night',icon:'construction' as const,title:nightText.title,help:nightText.help}];
---
<Layout title={t.title} description={t.intro} lang={lang} languageLinks={languageLinks.siteMap(base)} minimal>
<article class="org-map" aria-labelledby="org-map-title" data-org-map data-open="false">
<header class="org-map__header"><h1 id="org-map-title">{t.title}</h1><span>{t.intro}</span></header>
<div class="org-origin"><span>{t.start}</span><a class="node node--home" href={homeHref(lang,base)}><SiteMapIcon name="home"/><strong>{copy[lang].home}</strong><b>{t.open} →</b></a></div>
<nav class="branch-tabs" aria-label={t.display}>{branches.map(branch=><button type="button" data-branch={branch.id} aria-pressed="false"><SiteMapIcon name={branch.icon} size="lg"/><span><strong>{branch.title}</strong><small>{branch.help}</small></span><b aria-hidden="true">⌄</b></button>)}</nav>
<div class="branch-stage" aria-live="polite">
<section data-panel="explore" hidden><h2>{t.explore}</h2><div class="tree tree--chain"><a class="node node--gallery" href={galleryHref(lang,base)}><SiteMapIcon name="gallery"/><strong>{copy[lang].catalogue}</strong><span>{t.galleryHelp}</span><b>{t.open} →</b></a><i aria-hidden="true"></i><a class="node node--photo" href={galleryHref(lang,base)}><SiteMapIcon name="photo"/><strong>{t.photo}</strong><span>{t.photoHelp}</span><b>{t.open} →</b></a></div><aside class="route-handoff"><span>{t.continue}</span><div class="route-handoff__links"><a href={visibilityHref(lang,base)}><SiteMapIcon name="route"/><strong>{copy[lang].catalogue} → {copy[lang].visibilityPlanner}</strong><small>{t.discoverRoute}</small></a><a href={equipmentAnalyzerHref(lang,base)}><SiteMapIcon name="route"/><strong>{copy[lang].catalogue} → {copy[lang].equipmentAnalyzer}</strong><small>{t.frameRoute}</small></a></div></aside></section>
<section data-panel="prepare" hidden><h2>{t.prepare}</h2><div class="tree"><a class="node node--session tree__parent" href={sessionPreparationHref(lang,base)}><SiteMapIcon name="route"/><strong>{copy[lang].homeSessionPreparation}</strong><span>{t.sessionHelp}</span><b>{t.open} →</b></a><div class="tree__children tree__children--three"><a class="node node--visibility" href={visibilityHref(lang,base)}><SiteMapIcon name="visibility"/><strong>{copy[lang].visibilityPlanner}</strong><span>{t.visibilityHelp}</span><b>{t.open} →</b></a><a class="node node--analyser" href={equipmentAnalyzerHref(lang,base)}><SiteMapIcon name="analyser"/><strong>{copy[lang].equipmentAnalyzer}</strong><span>{t.analyserHelp}</span><b>{t.open} →</b></a><a class="node node--planning" href={planningHref(lang,base)}><SiteMapIcon name="planning"/><strong>{copy[lang].planning}</strong><span>{t.planningHelp}</span><b>{t.open} →</b></a></div></div><aside class="route-handoff route-handoff--single"><span>{t.continue}</span><div class="route-handoff__links"><a href={planningHref(lang,base)}><SiteMapIcon name="route"/><strong>{copy[lang].visibilityPlanner} → {copy[lang].planning}</strong><small>{t.planRoute}</small></a></div></aside></section>
<section data-panel="learn" hidden><h2>{t.learn}</h2><div class="tree tree--simple"><div class="tree__children tree__children--two"><a class="node node--equipment" href={equipmentHref(lang,base)}><SiteMapIcon name="equipment"/><strong>{copy[lang].myEquipment}</strong><span>{t.equipmentHelp}</span><b>{t.open} →</b></a><a class="node node--articles" href={articlesHref(lang,base)}><SiteMapIcon name="articles"/><strong>{copy[lang].articles}</strong><span>{t.articlesHelp}</span><b>{t.open} →</b></a></div></div></section>
<section data-panel="night" hidden><h2>{nightText.title}</h2><div class="tree tree--simple"><div class="node node--construction"><SiteMapIcon name="construction" size="lg"/><strong>{nightText.title}</strong><span>{nightText.help}</span><b>{nightText.status}</b></div></div></section>
</div>
</article></Layout>
<script>document.querySelectorAll<HTMLElement>('[data-org-map]').forEach(root=>{const buttons=[...root.querySelectorAll<HTMLButtonElement>('[data-branch]')],panels=[...root.querySelectorAll<HTMLElement>('[data-panel]')];buttons.forEach(button=>button.addEventListener('click',()=>{const closing=button.getAttribute('aria-pressed')==='true';root.dataset.open=String(!closing);buttons.forEach(item=>item.setAttribute('aria-pressed',String(!closing&&item===button)));panels.forEach(panel=>panel.hidden=closing||panel.dataset.panel!==button.dataset.branch)}))});</script>
<style>
.org-map{width:min(100%,72rem);margin:.5rem auto 0}.org-map__header{max-width:48rem;margin:0 auto 2rem;text-align:center}.org-map__header p{margin:0 0 .35rem;color:var(--color-accent);font:.68rem var(--font-technical);letter-spacing:.14em;text-transform:uppercase}.org-map__header h1{margin:0;font-size:clamp(2rem,5vw,3.25rem);letter-spacing:-.05em;line-height:1}.org-map__header span{display:block;margin:.85rem auto 0;color:var(--color-muted);font-size:.95rem;line-height:1.6}.org-origin{position:relative;display:grid;justify-items:center;margin-bottom:2.6rem}.org-origin>span{margin-bottom:.45rem;color:var(--color-muted);font:.66rem var(--font-technical);letter-spacing:.08em;text-transform:uppercase}.org-origin::after{position:absolute;top:100%;width:1px;height:2.6rem;background:linear-gradient(var(--color-accent),var(--color-border));content:''}
.node{--tone:#8593a8;--rgb:133,147,168;position:relative;display:grid;grid-template-columns:auto 1fr auto;gap:.3rem .65rem;min-width:0;padding:.85rem;border:1px solid rgba(var(--rgb),.44);border-radius:.65rem;background:radial-gradient(circle at 94% 8%,rgba(var(--rgb),.15),transparent 42%),rgba(9,14,24,.88);color:var(--color-text);text-decoration:none;transition:.18s ease}.node::before{position:absolute;inset:0 auto 0 0;width:2px;border-radius:.65rem 0 0 .65rem;background:var(--tone);content:''}.node :global(.site-map-icon){color:var(--tone)}.node strong{align-self:center;font-size:.92rem}.node span{grid-column:1/-1;color:var(--color-muted);font-size:.73rem;line-height:1.45}.node b{align-self:center;color:var(--tone);font-size:.66rem}.node:hover,.node:focus-visible{border-color:var(--tone);transform:translateY(-2px)}.node--home{--tone:#c95f56;--rgb:201,95,86;width:min(100%,16rem)}.node--gallery,.node--photo{--tone:#d6e55e;--rgb:214,229,94}.node--session{--tone:#ddd8c9;--rgb:221,216,201}.node--visibility{--tone:#5da9ba;--rgb:93,169,186}.node--analyser{--tone:#55bda4;--rgb:85,189,164}.node--planning{--tone:#d49b4d;--rgb:212,155,77}.node--equipment{--tone:#dc775e;--rgb:220,119,94}.node--articles{--tone:#ddd8c9;--rgb:221,216,201}
.branch-tabs{position:relative;display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}.branch-tabs::before{position:absolute;right:16.66%;bottom:100%;left:16.66%;height:1px;background:var(--color-border);content:''}.branch-tabs button{position:relative;display:grid;grid-template-columns:auto 1fr auto;gap:.65rem;align-items:start;padding:1rem;border:1px solid var(--color-border);border-radius:.75rem;background:rgba(17,24,39,.66);color:var(--color-muted);cursor:pointer;text-align:left}.branch-tabs button::before{position:absolute;bottom:100%;left:50%;width:1px;height:1.25rem;background:var(--color-border);content:''}.branch-tabs button>:global(.site-map-icon){color:var(--color-accent)}.branch-tabs button span{display:grid;gap:.25rem}.branch-tabs button strong{color:var(--color-text);font-size:.95rem}.branch-tabs button small{font-size:.7rem;line-height:1.4}.branch-tabs button b{transition:transform .18s}.branch-tabs button[aria-pressed=true]{border-color:var(--color-accent);background:rgba(228,198,106,.09);color:var(--color-text)}.branch-tabs button[aria-pressed=true] b{color:var(--color-accent);transform:rotate(180deg)}
.branch-stage{position:relative;margin-top:1.25rem;padding-top:1.35rem}.branch-stage::before{position:absolute;top:0;left:50%;width:1px;height:1.35rem;background:var(--color-border);content:''}.branch-stage>section{padding:1rem;border:1px solid var(--color-border);border-radius:.85rem;background:rgba(17,24,39,.5)}.branch-stage>section[hidden]{display:none}.branch-stage h2{margin:0 0 1.2rem;text-align:center;font-size:1rem}.tree{display:grid;justify-items:center}.tree--chain .node,.tree__parent{width:min(100%,24rem)}.tree--chain i{width:1px;height:2rem;background:var(--color-border)}.tree__parent{margin-bottom:3rem}.tree__children{position:relative;display:grid;width:100%;gap:1rem}.tree__children::before{position:absolute;right:16.66%;bottom:calc(100% + 1.5rem);left:16.66%;height:1px;background:var(--color-border);content:''}.tree__children .node::after{position:absolute;bottom:100%;left:50%;width:1px;height:1.5rem;background:var(--color-border);content:''}.tree__children--three{grid-template-columns:repeat(3,1fr)}.tree__children--two{grid-template-columns:repeat(2,1fr);width:min(100%,48rem)}.tree__children--two::before{right:25%;left:25%}.tree--simple{padding-top:1.5rem}
.route-handoff{position:relative;width:min(100%,48rem);margin:2.4rem auto 0;padding-top:1.25rem}.route-handoff::before{position:absolute;top:0;left:50%;height:1rem;border-left:1px dashed var(--color-accent);content:''}.route-handoff>span{display:block;margin-bottom:.6rem;color:var(--color-muted);font:.66rem var(--font-technical);letter-spacing:.08em;text-align:center;text-transform:uppercase}.route-handoff__links{display:grid;grid-template-columns:repeat(2,1fr);gap:.75rem}.route-handoff__links a{display:grid;grid-template-columns:auto 1fr;gap:.25rem .55rem;padding:.7rem .8rem;border:1px dashed rgba(228,198,106,.52);border-radius:.6rem;background:rgba(228,198,106,.035);color:var(--color-text);text-decoration:none}.route-handoff__links a>:global(.site-map-icon){grid-row:1/3;color:var(--color-accent)}.route-handoff__links strong{font-size:.76rem}.route-handoff__links small{color:var(--color-muted);font-size:.68rem;line-height:1.4}.route-handoff__links a:hover,.route-handoff__links a:focus-visible{border-color:var(--color-accent);background:rgba(228,198,106,.08)}.route-handoff--single{width:min(100%,24rem)}.route-handoff--single .route-handoff__links{grid-template-columns:1fr}
.node--construction{--tone:#8b99ad;--rgb:139,153,173;width:min(100%,24rem);border-style:dashed;cursor:default}.node--construction::before{display:none}.node--construction b{padding:.2rem .4rem;border:1px dashed currentColor;border-radius:.3rem;text-transform:uppercase}.branch-tabs{grid-template-columns:repeat(4,1fr)}.branch-tabs::before{right:12.5%;left:12.5%}.branch-tabs button[data-branch="night"]{border-style:dashed}.branch-tabs button b{align-self:center;font-size:1.15rem;line-height:1}.org-map[data-open="false"] .branch-stage{display:none}
@media(max-width:760px){.branch-tabs{grid-template-columns:1fr}.branch-tabs::before{display:none}.branch-tabs button::before{left:1.5rem;height:1rem}.branch-stage::before{left:1.5rem}.tree__children--three,.tree__children--two{grid-template-columns:1fr}.tree__parent{margin-bottom:2rem}.tree__children::before{display:none}.tree__children .node::after{left:1.5rem;height:1rem}.tree--simple{padding-top:0}.route-handoff__links{grid-template-columns:1fr}}@media(max-width:620px){.org-map__header{text-align:left}.org-origin{justify-items:start;margin-left:.8rem}.org-origin::after{left:1.5rem}.branch-stage>section{padding:.8rem}}
</style>
