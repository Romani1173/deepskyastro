---
import { render, type CollectionEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import type { Lang } from '../i18n';
import { articleHref, articlesHref, homeHref, localeFor, withBase } from '../i18n';

interface Props {
	lang: Lang;
	article: CollectionEntry<'articulos'>;
	allArticles: CollectionEntry<'articulos'>[];
}

const { lang, article, allArticles } = Astro.props;
const base = import.meta.env.BASE_URL;
const labels = {
	ca: { home: 'Inici', articles: 'Articles', contents: "Contingut de l'article", test: 'Prova parcial: introducció i dos primers capítols' },
	es: { home: 'Inicio', articles: 'Artículos', contents: 'Contenido del artículo', test: 'Prueba parcial: introducción y dos primeros capítulos' },
	en: { home: 'Home', articles: 'Articles', contents: 'Article contents', test: 'Partial preview: introduction and first two chapters' },
}[lang];
const translations = allArticles.filter((candidate) => candidate.data.translationKey === article.data.translationKey);
const languageLinks = {
	ca: translations.find((candidate) => candidate.data.idioma === 'ca')
		? articleHref('ca', translations.find((candidate) => candidate.data.idioma === 'ca')!.data.slug, base)
		: articlesHref('ca', base),
	es: translations.find((candidate) => candidate.data.idioma === 'es')
		? articleHref('es', translations.find((candidate) => candidate.data.idioma === 'es')!.data.slug, base)
		: articlesHref('es', base),
	en: translations.find((candidate) => candidate.data.idioma === 'en')
		? articleHref('en', translations.find((candidate) => candidate.data.idioma === 'en')!.data.slug, base)
		: articlesHref('en', base),
};
const { Content, headings } = await render(article);
const date = new Intl.DateTimeFormat(localeFor(lang), { month: 'long', year: 'numeric', timeZone: 'UTC' }).format(article.data.fecha);
const cover = withBase(`imagenes/articulos/sol/${article.data.translationKey}/${article.data.portada}`, base);
---

<Layout title={article.data.titulo} description={article.data.resumen} minimal lang={lang} languageLinks={languageLinks}>
	<article class="article-detail">
		<nav class="article-breadcrumb" aria-label="Breadcrumb">
			<a href={homeHref(lang, base)}>{labels.home}</a>
			<span aria-hidden="true">/</span>
			<a href={articlesHref(lang, base)}>{labels.articles}</a>
		</nav>
		<header class="article-detail__header">
			<p class="article-detail__kicker">{article.data.tema} · {date}</p>
			<h1>{article.data.titulo}</h1>
			<p class="article-detail__summary">{article.data.resumen}</p>
			<p class="article-detail__author">{article.data.autor}</p>
			{article.data.prueba && <span class="article-test-badge">{labels.test}</span>}
		</header>
		<figure class="article-detail__cover"><img src={cover} alt="" /></figure>
		{headings.length > 0 && (
			<nav class="article-toc" aria-label={labels.contents}>
				<strong>{labels.contents}</strong>
				<ul>{headings.filter((heading) => heading.depth === 2).map((heading) => <li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ul>
			</nav>
		)}
		<div class="article-prose"><Content /></div>
	</article>
</Layout>
