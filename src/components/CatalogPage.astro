---
import type { CollectionEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import CatalogHeader from './CatalogHeader.astro';
import PhotoCard from './PhotoCard.astro';
import PhotoFeaturePreview from './PhotoFeaturePreview.astro';
import type { Lang } from '../i18n';
import { copy, languageLinks } from '../i18n';
import { photoText } from '../photoTranslations';

interface Props { lang: Lang; fotos: CollectionEntry<'fotos'>[]; }
const { lang, fotos } = Astro.props;
const base = import.meta.env.BASE_URL;
const t = copy[lang];
const searchableText = (value: string) => value.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLocaleLowerCase();
const constellations = [...new Set(fotos.map((foto) => foto.data.constellacio))].sort((a, b) => a.localeCompare(b, lang, { sensitivity: 'base' }));
---

<Layout title={t.catalogue} focused lang={lang} languageLinks={languageLinks.gallery(base)}>
	<section class="gallery-theme" aria-labelledby="collection-heading">
		<div class="catalog-controls">
			<CatalogHeader lang={lang} catalogue />
			<h1 class="sr-only" id="collection-heading">{t.catalogue}</h1>
			<div class="catalog-controls__search">
				<div class="search catalog-search">
					<label class="sr-only" for="buscador">{t.search}</label>
					<div class="catalog-search__field">
						<svg aria-hidden="true" viewBox="0 0 24 24"><path d="m21 21-4.4-4.4m2.4-5.1a7.5 7.5 0 1 1-15 0 7.5 7.5 0 0 1 15 0Z" /></svg>
						<input id="buscador" type="search" placeholder={t.searchPlaceholder} autocomplete="off" />
					</div>
				</div>
				<div class="catalog-order">
					<label for="ordre">{t.order}</label>
					<select id="ordre"><option value="date">{t.recent}</option><option value="name">{t.name}</option></select>
				</div>
				<div class="catalog-order">
					<label for="constellacio">{t.constellation}</label>
					<select id="constellacio"><option value="">{t.allConstellations}</option>{constellations.map((constellation) => <option value={constellation}>{constellation}</option>)}</select>
				</div>
				<p
					class="catalog-count"
					id="recompte-fotos"
					aria-live="polite"
					data-singular={t.object}
					data-plural={t.objects}
				>{fotos.length} {fotos.length === 1 ? t.object : t.objects}</p>
			</div>
		</div>
		<div class="photo-grid" id="grid-fotos">
			{fotos.map((foto) => {
				const text = photoText(foto, lang);
				const searchIndex = searchableText([foto.id, text.objecte, foto.data.constellacio, foto.data.categoria].join(' '));
				return <div data-card data-search={searchIndex} data-constellation={foto.data.constellacio} data-name={text.objecte} data-date={foto.data.entorn.data.valueOf()}><PhotoCard foto={foto} lang={lang} /></div>;
			})}
			<p class="empty-state" id="sense-resultats" hidden>{t.noResults}</p>
		</div>
	</section>
	<PhotoFeaturePreview lang={lang} />
</Layout>

<script>
	const search = document.querySelector<HTMLInputElement>('#buscador');
	const order = document.querySelector<HTMLSelectElement>('#ordre');
	const constellation = document.querySelector<HTMLSelectElement>('#constellacio');
	const grid = document.querySelector<HTMLElement>('#grid-fotos');
	const cards = [...document.querySelectorAll<HTMLElement>('[data-card]')];
	const empty = document.querySelector<HTMLElement>('#sense-resultats');
	const count = document.querySelector<HTMLElement>('#recompte-fotos');
	const collator = new Intl.Collator(document.documentElement.lang, { numeric: true, sensitivity: 'base' });
	const updateCount = (visible: number) => {
		if (!count) return;
		const label = visible === 1 ? count.dataset.singular : count.dataset.plural;
		count.textContent = `${visible} ${label ?? ''}`.trim();
	};

	const applyFilters = () => {
		const term = search?.value.normalize('NFD').replace(/[\u0300-\u036f]/g, '').trim().toLocaleLowerCase() ?? '';
		const selectedConstellation = constellation?.value ?? '';
		let visible = 0;
		cards.forEach((card) => {
			const matchesSearch = card.dataset.search?.includes(term) ?? false;
			const matchesConstellation = !selectedConstellation || card.dataset.constellation === selectedConstellation;
			const matches = matchesSearch && matchesConstellation;
			card.hidden = !matches;
			if (matches) visible += 1;
		});
		if (empty) empty.hidden = visible !== 0;
		updateCount(visible);
	};
	search?.addEventListener('input', applyFilters);
	constellation?.addEventListener('change', applyFilters);

	order?.addEventListener('change', () => {
		const sorted = [...cards].sort((a, b) => order.value === 'name'
			? collator.compare(a.dataset.name ?? '', b.dataset.name ?? '')
			: Number(b.dataset.date) - Number(a.dataset.date));
		grid?.append(...sorted);
	});
</script>
