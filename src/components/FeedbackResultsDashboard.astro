---
import Layout from '../layouts/Layout.astro';
import type { Lang } from '../i18n';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const paths = {
  ca: `${base}/laboratori/resultats-valoracio/`,
  es: `${base}/es/laboratorio/resultados-valoracion/`,
  en: `${base}/en/lab/feedback-results/`,
};
const copy = {
  ca: {
    title: 'Resultats de valoració', eyebrow: 'Analitzador local privat',
    intro: 'Resumeix les respostes de prova desades en aquest navegador per a les quatre eines.',
    localNotice: 'Aquest prototip encara no rep dades d’altres persones. En producció, les respostes s’enviaran a un magatzem privat i aquesta pantalla quedarà protegida.',
    total: 'Respostes', positive: 'Positives', negative: 'Negatives', coverage: 'Eines valorades',
    detail: 'Detall per eina', tool: 'Eina', result: 'Resultat', reason: 'Motiu', comment: 'Comentari', date: 'Data local',
    noResponse: 'Sense resposta', noReason: '—', noComment: '—', yes: 'Positiva', no: 'Negativa',
    reasons: 'Motius de millora', comments: 'Comentaris rebuts', emptyReasons: 'Encara no hi ha motius negatius.', emptyComments: 'Encara no hi ha comentaris.',
    updated: 'Lectura actualitzada', refresh: 'Actualitza', csv: 'Exporta CSV',
    tools: { visibility: 'Visibilitat', planning: 'Planificació', analyser: 'Analitzador', 'my-night': 'La meva nit' },
    reasonLabels: { confusing: 'El resultat no és clar', missing: 'Falta una funció', broken: 'No ha funcionat com esperava', other: 'Un altre motiu' },
  },
  es: {
    title: 'Resultados de valoración', eyebrow: 'Analizador local privado',
    intro: 'Resume las respuestas de prueba guardadas en este navegador para las cuatro herramientas.',
    localNotice: 'Este prototipo todavía no recibe datos de otras personas. En producción, las respuestas se enviarán a un almacén privado y esta pantalla quedará protegida.',
    total: 'Respuestas', positive: 'Positivas', negative: 'Negativas', coverage: 'Herramientas valoradas',
    detail: 'Detalle por herramienta', tool: 'Herramienta', result: 'Resultado', reason: 'Motivo', comment: 'Comentario', date: 'Fecha local',
    noResponse: 'Sin respuesta', noReason: '—', noComment: '—', yes: 'Positiva', no: 'Negativa',
    reasons: 'Motivos de mejora', comments: 'Comentarios recibidos', emptyReasons: 'Todavía no hay motivos negativos.', emptyComments: 'Todavía no hay comentarios.',
    updated: 'Lectura actualizada', refresh: 'Actualizar', csv: 'Exportar CSV',
    tools: { visibility: 'Visibilidad', planning: 'Planificación', analyser: 'Analizador', 'my-night': 'Mi noche' },
    reasonLabels: { confusing: 'El resultado no está claro', missing: 'Falta una función', broken: 'No funcionó como esperaba', other: 'Otro motivo' },
  },
  en: {
    title: 'Feedback results', eyebrow: 'Private local analyser',
    intro: 'Summarises the test responses stored in this browser for the four tools.',
    localNotice: 'This prototype does not receive data from other people yet. In production, responses will be sent to private storage and this screen will be protected.',
    total: 'Responses', positive: 'Positive', negative: 'Negative', coverage: 'Tools rated',
    detail: 'Detail by tool', tool: 'Tool', result: 'Result', reason: 'Reason', comment: 'Comment', date: 'Local date',
    noResponse: 'No response', noReason: '—', noComment: '—', yes: 'Positive', no: 'Negative',
    reasons: 'Improvement reasons', comments: 'Comments received', emptyReasons: 'There are no negative reasons yet.', emptyComments: 'There are no comments yet.',
    updated: 'Reading updated', refresh: 'Refresh', csv: 'Export CSV',
    tools: { visibility: 'Visibility', planning: 'Planning', analyser: 'Equipment analyser', 'my-night': 'My night' },
    reasonLabels: { confusing: 'The result is unclear', missing: 'A feature is missing', broken: 'It did not work as expected', other: 'Another reason' },
  },
}[lang];
---

<Layout title={copy.title} description={copy.intro} lang={lang} languageLinks={paths} focused>
  <section class="feedback-results" data-feedback-results data-lang={lang}>
    <header class="feedback-results__header">
      <div><p>{copy.eyebrow}</p><h1>{copy.title}</h1><span>{copy.intro}</span></div>
      <div class="feedback-results__actions">
        <button type="button" data-results-refresh>{copy.refresh}</button>
        <button type="button" data-results-export="csv">{copy.csv}</button>
      </div>
    </header>

    <aside class="feedback-results__notice"><strong>Local</strong><span>{copy.localNotice}</span></aside>

    <div class="feedback-results__metrics">
      <article><span>{copy.total}</span><strong data-metric="total">0</strong></article>
      <article class="is-positive"><span>{copy.positive}</span><strong data-metric="positive">0</strong></article>
      <article class="is-negative"><span>{copy.negative}</span><strong data-metric="negative">0</strong></article>
      <article><span>{copy.coverage}</span><strong><span data-metric="coverage">0</span>/4</strong></article>
    </div>

    <section class="feedback-results__panel">
      <div class="feedback-results__panel-heading"><h2>{copy.detail}</h2><small><span>{copy.updated}</span> <time data-results-updated>—</time></small></div>
      <div class="feedback-results__table-wrap">
        <table>
          <thead><tr><th>{copy.tool}</th><th>{copy.result}</th><th>{copy.reason}</th><th>{copy.comment}</th><th>{copy.date}</th></tr></thead>
          <tbody data-results-table></tbody>
        </table>
      </div>
    </section>

    <div class="feedback-results__lower-grid">
      <section class="feedback-results__panel"><h2>{copy.reasons}</h2><div class="feedback-results__reason-list" data-results-reasons></div><p data-results-no-reasons>{copy.emptyReasons}</p></section>
      <section class="feedback-results__panel"><h2>{copy.comments}</h2><ul class="feedback-results__comments" data-results-comments></ul><p data-results-no-comments>{copy.emptyComments}</p></section>
    </div>
  </section>
</Layout>

<script define:vars={{ copy, lang }}>
  const storageKey = 'deepskyastro-feedback-demo-v1';
  const toolIds = ['visibility', 'planning', 'analyser', 'my-night'];
  const reasonIds = ['confusing', 'missing', 'broken', 'other'];
  const root = document.querySelector('[data-feedback-results]');
  const readVotes = () => {
    try {
      const value = JSON.parse(localStorage.getItem(storageKey) ?? '{}');
      return value && typeof value === 'object' && !Array.isArray(value) ? value : {};
    } catch { return {}; }
  };
  const download = (content, filename, type) => {
    const url = URL.createObjectURL(new Blob([content], { type }));
    const link = document.createElement('a');
    link.href = url; link.download = filename; link.click();
    window.setTimeout(() => URL.revokeObjectURL(url), 2000);
  };
  const csvCell = (value) => `"${String(value ?? '').replaceAll('"', '""')}"`;
  const render = () => {
    const votes = readVotes();
    const responses = toolIds.map((tool) => ({ tool, ...votes[tool] })).filter((item) => item.vote);
    const positives = responses.filter((item) => item.vote === 'up');
    const negatives = responses.filter((item) => item.vote === 'down');
    root.querySelector('[data-metric="total"]').textContent = String(responses.length);
    root.querySelector('[data-metric="positive"]').textContent = String(positives.length);
    root.querySelector('[data-metric="negative"]').textContent = String(negatives.length);
    root.querySelector('[data-metric="coverage"]').textContent = String(responses.length);
    root.querySelector('[data-results-updated]').textContent = new Intl.DateTimeFormat(lang, { dateStyle: 'short', timeStyle: 'medium' }).format(new Date());

    const tbody = root.querySelector('[data-results-table]');
    tbody.replaceChildren(...toolIds.map((tool) => {
      const vote = votes[tool];
      const row = document.createElement('tr');
      const result = vote ? (vote.vote === 'up' ? copy.yes : copy.no) : copy.noResponse;
      const reason = vote?.reason ? copy.reasonLabels[vote.reason] ?? vote.reason : copy.noReason;
      const date = vote?.createdAt ? new Intl.DateTimeFormat(lang, { dateStyle: 'short', timeStyle: 'short' }).format(new Date(vote.createdAt)) : copy.noReason;
      [copy.tools[tool], result, reason, vote?.comment || copy.noComment, date].forEach((value, index) => {
        const cell = document.createElement(index === 0 ? 'th' : 'td');
        cell.textContent = value;
        if (index === 1 && vote) cell.className = vote.vote === 'up' ? 'is-positive' : 'is-negative';
        row.append(cell);
      });
      return row;
    }));

    const reasonList = root.querySelector('[data-results-reasons]');
    reasonList.replaceChildren(...reasonIds.map((reason) => {
      const count = negatives.filter((item) => item.reason === reason).length;
      const item = document.createElement('div');
      const label = document.createElement('span'); label.textContent = copy.reasonLabels[reason];
      const bar = document.createElement('i'); bar.style.setProperty('--reason-width', `${negatives.length ? count / negatives.length * 100 : 0}%`);
      const number = document.createElement('strong'); number.textContent = String(count);
      item.append(label, bar, number); return item;
    }));
    root.querySelector('[data-results-no-reasons]').hidden = negatives.length > 0;
    reasonList.hidden = negatives.length === 0;

    const comments = responses.filter((item) => item.comment);
    const commentsList = root.querySelector('[data-results-comments]');
    commentsList.replaceChildren(...comments.map((item) => {
      const li = document.createElement('li');
      const strong = document.createElement('strong'); strong.textContent = copy.tools[item.tool];
      const quote = document.createElement('q'); quote.textContent = item.comment;
      li.append(strong, quote); return li;
    }));
    root.querySelector('[data-results-no-comments]').hidden = comments.length > 0;
    commentsList.hidden = comments.length === 0;
  };
  root.querySelector('[data-results-refresh]').addEventListener('click', render);
  root.querySelectorAll('[data-results-export]').forEach((button) => button.addEventListener('click', () => {
    const votes = readVotes();
    const rows = [[copy.tool, copy.result, copy.reason, copy.comment, 'createdAt'], ...toolIds.map((tool) => {
      const vote = votes[tool];
      return [copy.tools[tool], vote?.vote ?? '', vote?.reason ?? '', vote?.comment ?? '', vote?.createdAt ?? ''];
    })];
    download('\ufeff' + rows.map((row) => row.map(csvCell).join(',')).join('\n'), 'deepskyastro-feedback-local.csv', 'text/csv;charset=utf-8');
  }));
  window.addEventListener('storage', render);
  document.addEventListener('visibilitychange', () => { if (!document.hidden) render(); });
  render();
</script>

<style is:global>
  .feedback-results{width:min(1120px,100%);margin:0 auto 4rem}.feedback-results__header{display:flex;justify-content:space-between;gap:1.5rem;align-items:flex-end;margin-bottom:1rem}.feedback-results__header p{margin:0 0 .35rem;color:#eef879;font:700 .7rem var(--font-technical);letter-spacing:.12em;text-transform:uppercase}.feedback-results__header h1{margin:0 0 .4rem;font-size:clamp(1.8rem,4vw,3rem);line-height:1}.feedback-results__header span{color:var(--color-muted)}.feedback-results__actions{display:flex;flex-wrap:wrap;justify-content:flex-end;gap:.5rem}.feedback-results button{padding:.58rem .75rem;border:1px solid rgba(224,239,88,.62);border-radius:.52rem;background:rgba(224,239,88,.08);color:#eef879;font:700 .74rem var(--font-body);cursor:pointer}.feedback-results button:hover,.feedback-results button:focus-visible{border-color:#eef879;background:rgba(224,239,88,.18);color:#f7ffad}.feedback-results__notice{display:flex;gap:.75rem;align-items:flex-start;margin-bottom:1rem;padding:.8rem 1rem;border:1px solid rgba(224,239,88,.28);border-radius:.65rem;background:rgba(224,239,88,.05);color:#b7c1d1;font-size:.78rem;line-height:1.45}.feedback-results__notice strong{flex:0 0 auto;color:#eef879;font-family:var(--font-technical)}.feedback-results__metrics{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:.75rem;margin-bottom:1rem}.feedback-results__metrics article{padding:1rem;border:1px solid #344156;border-radius:.72rem;background:linear-gradient(145deg,rgba(18,27,43,.95),rgba(9,14,24,.95))}.feedback-results__metrics span{display:block;color:#9da8b9;font-size:.7rem}.feedback-results__metrics strong{display:block;margin-top:.35rem;color:#e9edf4;font:700 1.55rem var(--font-technical)}.feedback-results__metrics strong span{display:inline;color:inherit;font:inherit}.feedback-results__metrics .is-positive strong{color:#74e2ba}.feedback-results__metrics .is-negative strong{color:#ff9696}.feedback-results__panel{padding:1rem;border:1px solid #344156;border-radius:.72rem;background:rgba(12,18,30,.9)}.feedback-results__panel h2{margin:0 0 .85rem;font-size:1rem}.feedback-results__panel>p{margin:.5rem 0 0;color:#8793a6;font-size:.75rem}.feedback-results__panel-heading{display:flex;justify-content:space-between;gap:1rem;align-items:baseline}.feedback-results__panel-heading small{color:#8793a6;font-size:.68rem}.feedback-results__table-wrap{overflow-x:auto}table{width:100%;border-collapse:collapse;font-size:.76rem}th,td{padding:.72rem .65rem;border-top:1px solid #293448;text-align:left;vertical-align:top}thead th{padding-top:.3rem;border-top:0;color:#8f9cad;font-size:.65rem;text-transform:uppercase}tbody th{color:#e9edf4}td{color:#aeb8c7}td.is-positive{color:#74e2ba;font-weight:700}td.is-negative{color:#ff9696;font-weight:700}.feedback-results__lower-grid{display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-top:1rem}.feedback-results__reason-list{display:grid;gap:.7rem}.feedback-results__reason-list>div{display:grid;grid-template-columns:minmax(9rem,1fr) minmax(5rem,1fr) auto;gap:.65rem;align-items:center;color:#aeb8c7;font-size:.73rem}.feedback-results__reason-list i{position:relative;height:.42rem;overflow:hidden;border-radius:999px;background:#273248}.feedback-results__reason-list i::after{position:absolute;inset:0 auto 0 0;width:var(--reason-width);border-radius:inherit;background:#ff9696;content:''}.feedback-results__reason-list strong{color:#e9edf4;font-family:var(--font-technical)}.feedback-results__comments{display:grid;gap:.65rem;margin:0;padding:0;list-style:none}.feedback-results__comments li{display:grid;gap:.25rem;padding:.7rem;border:1px solid #293448;border-radius:.5rem;background:#090e18}.feedback-results__comments strong{color:#eef879;font-size:.68rem}.feedback-results__comments q{color:#c2cad5;font-size:.76rem;line-height:1.45}.feedback-results [hidden]{display:none!important}@media(max-width:760px){.feedback-results__header{align-items:stretch;flex-direction:column}.feedback-results__actions{justify-content:flex-start}.feedback-results__metrics{grid-template-columns:1fr 1fr}.feedback-results__lower-grid{grid-template-columns:1fr}}@media(max-width:460px){.feedback-results__metrics{grid-template-columns:1fr}.feedback-results__notice{display:grid}}
</style>
