---
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import type { Lang } from '../i18n';
import { categoryByValue, categoryHref, copy, languageLinks, localeFor, photoHref, visibilityHref, withBase } from '../i18n';
import { additionalImageText, photoText } from '../photoTranslations';
import { photoTechnicalText, technicalValue } from '../technicalTranslations';

interface Props { foto: CollectionEntry<'fotos'>; lang: Lang; }
const { foto, lang } = Astro.props;
const base = import.meta.env.BASE_URL;
const t = copy[lang];
const text = photoText(foto, lang);
const technical = photoTechnicalText(foto, lang);
const category = categoryByValue(foto.data.categoria);
const categoryLabel = category.labels[lang];
const categoryPhotos = (await getCollection('fotos'))
	.filter((entry) => entry.data.categoria === foto.data.categoria)
	.sort((a, b) => b.data.entorn.data.getTime() - a.data.entorn.data.getTime() || a.id.localeCompare(b.id, undefined, { numeric: true }));
const currentIndex = categoryPhotos.findIndex((entry) => entry.id === foto.id);
const previousPhoto = currentIndex > 0 ? categoryPhotos[currentIndex - 1] : undefined;
const nextPhoto = currentIndex >= 0 && currentIndex < categoryPhotos.length - 1 ? categoryPhotos[currentIndex + 1] : undefined;
const previousText = previousPhoto ? photoText(previousPhoto, lang) : undefined;
const nextText = nextPhoto ? photoText(nextPhoto, lang) : undefined;
const dateFormatter = new Intl.DateTimeFormat(localeFor(lang), { dateStyle: 'long' });
const sessionDateFormatter = new Intl.DateTimeFormat(localeFor(lang), { dateStyle: 'medium' });
const date = dateFormatter.format(foto.data.entorn.data);
const sessions = foto.data.entorn.sessions.map((session) => {
	const interval = session.fi
		? `${sessionDateFormatter.format(session.inici)} – ${sessionDateFormatter.format(session.fi)}`
		: sessionDateFormatter.format(session.inici);
	const details = [
		session.captura ? technicalValue(session.captura, lang) : undefined,
		session.lloc ? technicalValue(session.lloc, lang) : undefined,
	].filter(Boolean);
	return details.length > 0 ? `${interval} — ${details.join(' · ')}` : interval;
});
const photoUrl = new URL(photoHref(lang, foto.id, base), Astro.site).toString();
const imageUrl = new URL(withBase(`imagenes/cielo-profundo/${foto.data.imatge}`, base), Astro.site).toString();
const seoDescription = {
	ca: `${text.objecte}, fotografia de cel profund de Juan José Romero a ${technical.constellacio}.`,
	es: `${text.objecte}, fotografía de cielo profundo de Juan José Romero en ${technical.constellacio}.`,
	en: `${text.objecte}, deep-sky photograph by Juan José Romero in ${technical.constellacio}.`,
}[lang];
const structuredData = {
	'@context': 'https://schema.org',
	'@type': 'ImageObject',
	name: text.objecte,
	description: seoDescription,
	contentUrl: imageUrl,
	url: photoUrl,
	creator: { '@type': 'Person', name: 'Juan José Romero' },
	copyrightHolder: { '@type': 'Person', name: 'Juan José Romero' },
	dateCreated: foto.data.entorn.data.toISOString().slice(0, 10),
};
---

<Layout title={text.objecte} description={seoDescription} image={withBase(`imagenes/cielo-profundo/${foto.data.imatge}`, base)} structuredData={structuredData} minimal lang={lang} languageLinks={languageLinks.photo(foto.id, base)}>
	<article class="photo-detail">
		<a class="back-link" data-photo-back href={categoryHref(lang, category.key, base)} data-visibility-href={visibilityHref(lang, base)} data-visibility-label={t.visibilityPlanner}>← {t.backToCategory(categoryLabel)}</a>
		<header class="page-heading"><h1>{text.objecte}</h1></header>
		<div class="photo-detail__image">
			<button class="image-zoom-trigger" type="button" data-lightbox-src={withBase(`imagenes/cielo-profundo/${foto.data.imatge}`, base)} data-lightbox-alt={`${t.astroPhoto} ${text.objecte}`} data-lightbox-group="primary" aria-label={`${t.enlarge}: ${text.objecte}`}>
				<img src={withBase(`imagenes/cielo-profundo/${foto.data.imatge}`, base)} alt={`${t.astroPhoto} ${text.objecte}`} fetchpriority="high" />
				<span aria-hidden="true">{t.enlarge} ↗</span>
			</button>
		</div>
		<p class="photo-detail__summary">{text.caracteristiques}</p>
		<div class="data-grid">
			<section class="data-panel" aria-labelledby="general"><h2 id="general">{t.generalInfo}</h2><dl class="data-list"><div><dt>{t.constellation}</dt><dd>{technical.constellacio}</dd></div><div><dt>{t.category}</dt><dd>{categoryLabel}</dd></div><div><dt>{t.date}</dt><dd>{date}</dd></div>{sessions.length > 0 && <div><dt>{t.captureSessions}</dt><dd>{sessions.map((session, index) => <span>{session}{index < sessions.length - 1 && <br />}</span>)}</dd></div>}</dl></section>
			<section class="data-panel" aria-labelledby="capture"><h2 id="capture">{t.capture}</h2><dl class="data-list"><div><dt>{t.totalTime}</dt><dd>{technical.tempsTotal}</dd></div><div><dt>{t.subframes}</dt><dd>{technical.subframes}</dd></div><div><dt>{t.gainOffset}</dt><dd>{technical.gain} / {technical.offset}</dd></div><div><dt>{t.calibration}</dt><dd>{technical.calibratge}</dd></div></dl></section>
			<section class="data-panel" aria-labelledby="equipment"><h2 id="equipment">{t.equipment}</h2><dl class="data-list"><div><dt>{t.telescope}</dt><dd>{technical.ota}</dd></div><div><dt>{t.camera}</dt><dd>{technical.camera}</dd></div><div><dt>{t.filters}</dt><dd>{technical.filtres}</dd></div><div><dt>{t.mount}</dt><dd>{technical.muntura}</dd></div><div><dt>{t.guiding}</dt><dd>{technical.guiat}</dd></div>{foto.data.equip.enfocador !== 'N/A' && <div><dt>{t.focuser}</dt><dd>{technical.enfocador}</dd></div>}{foto.data.equip.roda_filtres !== 'N/A' && <div><dt>{t.filterWheel}</dt><dd>{technical.rodaFiltres}</dd></div>}</dl></section>
			<section class="data-panel" aria-labelledby="process"><h2 id="process">{t.processingEnvironment}</h2><dl class="data-list"><div><dt>{t.processing}</dt><dd>{technical.processat}</dd></div>{foto.data.tractament.adquisicio !== 'N/A' && <div><dt>{t.acquisition}</dt><dd>{technical.adquisicio}</dd></div>}<div><dt>{t.place}</dt><dd>{technical.lloc}</dd></div><div><dt>{t.sky}</dt><dd>Bortle {foto.data.entorn.bortle}</dd></div></dl></section>
		</div>
		{foto.data.visibilitat && (
			<section class="annual-visibility" aria-labelledby="annual-visibility-heading">
				<h2 id="annual-visibility-heading">{t.annualVisibility}</h2>
				<button class="image-zoom-trigger" type="button" data-lightbox-src={withBase(`imagenes/visibilidad/${foto.data.visibilitat.imatge}`, base)} data-lightbox-alt={`${t.visibilityChart} ${text.objecte}`} data-lightbox-group="visibility" aria-label={`${t.enlarge}: ${t.annualVisibility}`}>
					<img src={withBase(`imagenes/visibilidad/${foto.data.visibilitat.imatge}`, base)} alt={`${t.visibilityChart} ${text.objecte}`} loading="lazy" decoding="async" />
					<span aria-hidden="true">{t.enlarge} ↗</span>
				</button>
				<p>{t.visibilityCaption(foto.data.visibilitat.dies_sobre_30)}</p>
			</section>
		)}
		{foto.data.imatges_addicionals.length > 0 && (
			<section class="additional-images" aria-labelledby="additional-images-heading">
				<h2 id="additional-images-heading">{t.additionalVersions}</h2>
				<div class="additional-images__grid">
					{foto.data.imatges_addicionals.map((imatge) => {
						const imageText = additionalImageText(imatge, lang);
						return <figure>
							<button class="image-zoom-trigger" type="button" data-lightbox-src={withBase(`imagenes/cielo-profundo/${imatge.fitxer}`, base)} data-lightbox-alt={`${imageText.titol}: ${text.objecte}`} data-lightbox-group="additional" data-lightbox-title={imageText.titol} aria-label={`${t.enlarge}: ${imageText.titol}`}>
								<img src={withBase(`imagenes/cielo-profundo/${imatge.fitxer}`, base)} alt={`${imageText.titol}: ${text.objecte}`} loading="lazy" decoding="async" />
								<span aria-hidden="true">{t.enlarge} ↗</span>
							</button>
							<figcaption><strong>{imageText.titol}</strong>{imageText.descripcio && <span>{imageText.descripcio}</span>}</figcaption>
						</figure>;
					})}
				</div>
			</section>
		)}
		{(previousPhoto || nextPhoto) && (
			<nav class="photo-navigation" aria-label={t.photoNavigation}>
				{previousPhoto ? <a class="photo-navigation__previous" href={photoHref(lang, previousPhoto.id, base)}><span>← {t.previousObject}</span><strong>{previousText?.objecte}</strong></a> : <span />}
				{nextPhoto ? <a class="photo-navigation__next" href={photoHref(lang, nextPhoto.id, base)}><span>{t.nextObject} →</span><strong>{nextText?.objecte}</strong></a> : <span />}
			</nav>
		)}
	</article>
	<dialog class="image-lightbox" aria-label={t.enlargedImage}>
		<div class="image-lightbox__stage">
			<button class="image-lightbox__close" type="button" aria-label={t.closeImage}>×</button>
			<button class="image-lightbox__nav image-lightbox__nav--previous" type="button" aria-label={t.previousImage} hidden>‹</button>
			<img alt="" />
			<button class="image-lightbox__nav image-lightbox__nav--next" type="button" aria-label={t.nextImage} hidden>›</button>
		</div>
		<div class="image-lightbox__meta" aria-live="polite" hidden>
			<strong></strong>
			<span></span>
		</div>
	</dialog>
</Layout>

<script>
	const photoBackLink = document.querySelector<HTMLAnchorElement>('[data-photo-back]');
	const photoParams = new URL(window.location.href).searchParams;
	if (photoBackLink && photoParams.get('from') === 'visibility') {
		const returnUrl = new URL(photoBackLink.dataset.visibilityHref!, window.location.origin);
		for (const key of ['week', 'view']) {
			const value = photoParams.get(key);
			if (value) returnUrl.searchParams.set(key, value);
		}
		photoBackLink.href = `${returnUrl.pathname}${returnUrl.search}`;
		photoBackLink.textContent = `← ${photoBackLink.dataset.visibilityLabel}`;
	}
	const lightbox = document.querySelector<HTMLDialogElement>('.image-lightbox');
	const lightboxImage = lightbox?.querySelector<HTMLImageElement>('img');
	const closeButton = lightbox?.querySelector<HTMLButtonElement>('.image-lightbox__close');
	const previousButton = lightbox?.querySelector<HTMLButtonElement>('.image-lightbox__nav--previous');
	const nextButton = lightbox?.querySelector<HTMLButtonElement>('.image-lightbox__nav--next');
	const lightboxMeta = lightbox?.querySelector<HTMLElement>('.image-lightbox__meta');
	const lightboxTitle = lightboxMeta?.querySelector<HTMLElement>('strong');
	const lightboxCounter = lightboxMeta?.querySelector<HTMLElement>('span');
	const lightboxStage = lightbox?.querySelector<HTMLElement>('.image-lightbox__stage');
	const triggers = Array.from(document.querySelectorAll<HTMLButtonElement>('.image-zoom-trigger'));
	const additionalTriggers = triggers.filter((trigger) => trigger.dataset.lightboxGroup === 'additional');
	let currentAdditionalIndex = -1;
	let touchStartX = 0;
	let touchStartY = 0;

	const displayTrigger = (trigger: HTMLButtonElement) => {
		if (!lightboxImage) return;
		lightboxImage.src = trigger.dataset.lightboxSrc ?? '';
		lightboxImage.alt = trigger.dataset.lightboxAlt ?? '';
		currentAdditionalIndex = additionalTriggers.indexOf(trigger);
		const isAdditional = currentAdditionalIndex >= 0;
		const canNavigate = isAdditional && additionalTriggers.length > 1;
		lightbox?.classList.toggle('image-lightbox--additional', isAdditional);
		if (previousButton) previousButton.hidden = !canNavigate;
		if (nextButton) nextButton.hidden = !canNavigate;
		if (lightboxMeta) lightboxMeta.hidden = !isAdditional;
		if (lightboxTitle) lightboxTitle.textContent = isAdditional ? trigger.dataset.lightboxTitle ?? '' : '';
		if (lightboxCounter) lightboxCounter.textContent = isAdditional ? `${currentAdditionalIndex + 1} / ${additionalTriggers.length}` : '';
	};

	const navigateAdditional = (step: number) => {
		if (currentAdditionalIndex < 0 || additionalTriggers.length < 2) return;
		currentAdditionalIndex = (currentAdditionalIndex + step + additionalTriggers.length) % additionalTriggers.length;
		displayTrigger(additionalTriggers[currentAdditionalIndex]);
	};

	triggers.forEach((trigger) => {
		trigger.addEventListener('click', () => {
			if (!lightbox) return;
			displayTrigger(trigger);
			lightbox.showModal();
		});
	});
	previousButton?.addEventListener('click', () => navigateAdditional(-1));
	nextButton?.addEventListener('click', () => navigateAdditional(1));
	closeButton?.addEventListener('click', () => lightbox?.close());
	lightbox?.addEventListener('click', (event) => { if (event.target === lightbox) lightbox.close(); });
	document.addEventListener('keydown', (event) => {
		if (!lightbox?.open || currentAdditionalIndex < 0) return;
		if (event.key === 'ArrowLeft') {
			event.preventDefault();
			navigateAdditional(-1);
		}
		if (event.key === 'ArrowRight') {
			event.preventDefault();
			navigateAdditional(1);
		}
	});
	lightboxStage?.addEventListener('touchstart', (event) => {
		const touch = event.changedTouches[0];
		touchStartX = touch.clientX;
		touchStartY = touch.clientY;
	}, { passive: true });
	lightboxStage?.addEventListener('touchend', (event) => {
		if (currentAdditionalIndex < 0) return;
		const touch = event.changedTouches[0];
		const horizontalDistance = touch.clientX - touchStartX;
		const verticalDistance = touch.clientY - touchStartY;
		if (Math.abs(horizontalDistance) < 50 || Math.abs(horizontalDistance) <= Math.abs(verticalDistance)) return;
		navigateAdditional(horizontalDistance < 0 ? 1 : -1);
	}, { passive: true });
</script>
