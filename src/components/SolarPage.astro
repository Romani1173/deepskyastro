---
import type { CollectionEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import CatalogHeader from './CatalogHeader.astro';
import type { Lang } from '../i18n';
import { imageSizes, optimizedImage } from '../lib/optimized-images';
import { categoryHref, copy, homeHref, languageLinks, localeFor, withBase } from '../i18n';
import { author, breadcrumbList, publicUrl, shortenDescription } from '../lib/seo';

interface Props {
	lang: Lang;
	fotos: CollectionEntry<'sol'>[];
}

const { lang, fotos } = Astro.props;
const base = import.meta.env.BASE_URL;
const labels = {
	ca: { title: 'Sol', description: 'Fotografies del Sol ordenades de més recent a més antiga.', photo: 'fotografia solar', photos: 'fotografies solars', enlarge: 'Ampliar fotografia', close: 'Tancar' },
	es: { title: 'Sol', description: 'Fotografías del Sol ordenadas de más reciente a más antigua.', photo: 'fotografía solar', photos: 'fotografías solares', enlarge: 'Ampliar fotografía', close: 'Cerrar' },
	en: { title: 'Sun', description: 'Photographs of the Sun, ordered from newest to oldest.', photo: 'solar photograph', photos: 'solar photographs', enlarge: 'Enlarge photograph', close: 'Close' },
}[lang];
const sortedFotos = [...fotos].sort((a, b) => b.data.fecha.getTime() - a.data.fecha.getTime());
const sunHref = (id: string) => lang === 'ca' ? withBase(`sol/${id}/`, base) : withBase(`${lang}/${lang === 'en' ? 'sun' : 'sol'}/${id}/`, base);
const seoDescription = shortenDescription({
	ca: `${fotos.length} fotografies del Sol de Juan José Romero: taques solars, regions actives, imatges en color i l’eclipsi total del 12 d’agost del 2026.`,
	es: `${fotos.length} fotografías del Sol de Juan José Romero: manchas solares, regiones activas, imágenes en color y el eclipse total del 12 de agosto de 2026.`,
	en: `${fotos.length} photographs of the Sun by Juan José Romero: sunspots, active regions, colour images and the total solar eclipse of 12 August 2026.`,
}[lang]);
const structuredData = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'CollectionPage', name: labels.title, description: seoDescription, url: publicUrl(categoryHref(lang, 'sun', base), base), inLanguage: lang, author,
			mainEntity: { '@type': 'ItemList', numberOfItems: sortedFotos.length, itemListElement: sortedFotos.map((foto, index) => ({ '@type': 'ListItem', position: index + 1, url: publicUrl(sunHref(foto.id), base) })) },
		},
		breadcrumbList([[copy[lang].home, homeHref(lang, base)], [labels.title, categoryHref(lang, 'sun', base)]], base),
	],
};
const groupedYears = Array.from(
	sortedFotos.reduce((years, foto) => {
		const year = foto.data.fecha.getUTCFullYear();
		const month = foto.data.fecha.getUTCMonth();
		if (!years.has(year)) years.set(year, new Map<number, CollectionEntry<'sol'>[]>());
		const months = years.get(year)!;
		if (!months.has(month)) months.set(month, []);
		months.get(month)!.push(foto);
		return years;
	}, new Map<number, Map<number, CollectionEntry<'sol'>[]>>()),
	([year, months]) => ({ year, months: Array.from(months, ([month, entries]) => ({ month, entries })) }),
);
---

<Layout title={{ ca: 'Sol – Astrofotografia solar', es: 'Sol – Astrofotografía solar', en: 'Sun – Solar astrophotography' }[lang]} description={seoDescription} structuredData={structuredData} focused lang={lang} languageLinks={languageLinks.category('sun', base)}>
	<section aria-labelledby="solar-heading">
		<div class="catalog-controls"><CatalogHeader lang={lang} currentCategory="sun" /></div>
		<div class="page-heading solar-heading">
			<h1 id="solar-heading">{labels.title}</h1>
			<p>{labels.description}</p>
			<p class="catalog-count">{fotos.length} {fotos.length === 1 ? labels.photo : labels.photos}</p>
		</div>
		<div class="solar-archive">
			{groupedYears.map(({ year, months }, yearIndex) => (
				<details class="solar-year" open={yearIndex === 0}>
					<summary><span>{year}</span><small>{months.reduce((total, item) => total + item.entries.length, 0)} {labels.photos}</small></summary>
					<div class="solar-months">
						{months.map(({ month, entries }, monthIndex) => {
							const monthName = new Intl.DateTimeFormat(localeFor(lang), { month: 'long', timeZone: 'UTC' }).format(new Date(Date.UTC(year, month, 1)));
							return (
								<details class="solar-month" open={yearIndex === 0 && monthIndex === 0}>
									<summary><span>{monthName}</span><small>{entries.length}</small></summary>
									<div class="solar-grid">
										{entries.map((foto) => {
											const date = new Intl.DateTimeFormat(localeFor(lang), { dateStyle: 'long', timeZone: 'UTC' }).format(foto.data.fecha);
											const image = optimizedImage(`sol/${foto.data.imagen}`, base, 960);
											const detailUrl = lang === 'ca'
												? withBase(`sol/${foto.id}/`, base)
												: withBase(`${lang}/${lang === 'en' ? 'sun' : 'sol'}/${foto.id}/`, base);
											return (
												<article class="solar-card">
													<a class="solar-card__image" href={detailUrl}>
														<img src={image.src} srcset={image.srcset} sizes={imageSizes.card} alt={`${labels.photo}, ${date}`} loading="lazy" decoding="async" />
													</a>
													<div class="solar-card__body">
														<time datetime={foto.data.fecha.toISOString().slice(0, 10)}>{date}</time>
													</div>
												</article>
											);
										})}
									</div>
								</details>
							);
						})}
					</div>
				</details>
			))}
		</div>
	</section>
</Layout>
