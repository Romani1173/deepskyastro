x1',cx-6);crossX.setAttribute('x2',cx+6);crossX.setAttribute('y1',cy);crossX.setAttribute('y2',cy);crossY.setAttribute('x1',cx);crossY.setAttribute('x2',cx);crossY.setAttribute('y1',cy-6);crossY.setAttribute('y2',cy+6);crossX.hidden=!tiny;crossY.hidden=!tiny;const fit=Math.max(reference.widthDeg/fieldW,reference.heightDeg/fieldH),verdict=fit>1?fovText.outside:fit>.58?fovText.tight:fit<.12?fovText.small:fovText.roomy;panel.querySelector('[data-fov-verdict]').textContent=verdict;panel.querySelector('[data-fov-field]').textContent=`${fovText.field}: ${fmt(fieldW)}° × ${fmt(fieldH)}°`;panel.querySelector('[data-fov-size]').textContent=`${fovText.object}: ${angularSize(reference.widthDeg)} × ${angularSize(reference.heightDeg)}`}
root.querySelector('[data-fov-select]').addEventListener('change',renderFov);root.querySelector('[data-fov-style]').addEventListener('change',renderFov);root.querySelector('[data-fov-rotate]').addEventListener('click',()=>{fovRotated=!fovRotated;renderFov()});
root.querySelectorAll('[data-mode]').forEach(button=>button.addEventListener('click',()=>{mode=button.dataset.mode;root.querySelectorAll('[data-mode]').forEach(item=>item.setAttribute('aria-pressed',String(item===button)));blocks.forEach(item=>item.hidden=mode!=='components');smartBlock.hidden=mode!=='smart';update();renderTubeResult()}));q('cameraProfile').addEventListener('change',()=>{const p=cameraProfiles.find(x=>x.id===q('cameraProfile').value),el=root.querySelector('[data-camera-source]');el.hidden=!p;if(p){q('pixel').value=p.pixel;q('width').value=p.width;q('height').value=p.height;el.innerHTML=`<a href="${p.source}" target="_blank" rel="noreferrer">${sourceText(p)}</a>`}update()});q('guiding').addEventListener('change',()=>{root.querySelector('[data-guiding]').hidden=!q('guiding').checked;update()});q('seeingCategory').addEventListener('change',()=>{if(q('seeingCategory').value)q('seeing').value='';update()});q('seeing').addEventListener('input',()=>{if(q('seeing').value)q('seeingCategory').value='';update()});function syncFocal(){const aperture=num('aperture');if(q('focalMode').value==='ratio'){const ratio=num('nativeRatio');q('focal').value=Number.isFinite(aperture)&&Number.isFinite(ratio)?String(Math.round(aperture*ratio*100)/100):''}else{const focal=num('focal');q('nativeRatio').value=Number.isFinite(aperture)&&aperture>0&&Number.isFinite(focal)?String(Math.round(focal/aperture*1000)/1000):''}}function renderTubeResult(){let aperture,focal;if(mode==='smart'){const p=smartProfiles.find(x=>x.id===q('smartProfile').value);aperture=p.aperture;focal=p.focal}else{syncFocal();aperture=num('aperture');focal=num('focal')*num('factor')}const valid=Number.isFinite(aperture)&&Number.isFinite(focal)&&aperture>0&&focal>0;root.querySelector('[data-result="effectiveFocal"]').textContent=valid?`${fmt(focal)} mm`:'—';const preview=root.querySelector('[data-tube-result]');if(preview)preview.querySelector('strong').textContent=valid?`${fmt(focal)} mm · f/${fmt(focal/apertu