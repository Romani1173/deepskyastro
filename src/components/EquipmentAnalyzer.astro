}[lang];
const photos = await getCollection('fotos');
const photoByObject = new Map<string, (typeof photos)[number]>();
for (const photo of photos) {
  const objectId = photo.data.objecte_astronomic;
  if (!objectId || excludedCompositeObjectIds.has(objectId)) continue;
  const current = photoByObject.get(objectId);
  if (!current || photo.id.toLowerCase() === objectId || photo.id.length < current.id.length) photoByObject.set(objectId, photo);
}
const photographedAlias = (catalogName: string, localizedName: string) => {
  const escapedCatalog = [...catalogName.replace(/\s+/g, '')]
    .map((character) => character.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'))
    .join('\\s*');
  const withoutCatalog = localizedName
    .replace(new RegExp(`^\\s*${escapedCatalog}(?:\\s*\\((?:HOO|SHO|Hα|NN)\\))?\\s*(?:[–—,:-]\\s*)?`, 'i'), '')
    .trim();
  if (withoutCatalog) return withoutCatalog;
  const compact = (value: string) => value.replace(/\s+/g, '').toLocaleLowerCase();
  return compact(localizedName) === compact(catalogName) ? undefined : localizedName;
};
const catalogFovReferences = astronomicalObjects
  .filter((object) => !excludedCompositeObjectIds.has(object.id) && fovObjectSizes[object.id])
  .map((object) => {
    const size = fovObjectSizes[object.id];
    const photo = object.status === 'photographed' ? photoByObject.get(object.id) : undefined;
    const commonName = object.commonNames?.[lang] ?? (photo ? photographedAlias(object.catalogName, photoText(photo, lang).objecte) : undefined);
    return {
      id: object.id,
      name: `${formatCatalogDesignations(object.catalogName)}${commonName ? ` · ${formatCatalogDesignations(commonName)}` : ''}`,
      widthDeg: size.widthArcmin / 60,
      heightDeg: size.heightArcmin / 60,
      shape: size.shape ?? 'ellipse',
      image: photo ? withBase(`imagenes/cielo-profundo/${photo.data.imatge}`, base) : undefined,
      status: object.status,
    };
  })
  .sort((a, b) => a.name.localeCompare(b.name, lang, { numeric: true }));
const fovReferences = [
  ...familiarFovReferences.filter((reference) => reference.id === 'moon' || reference.id === 'jupiter').map((reference) => ({ ...reference, name: fovText[reference.id], status: 'familiar' })),
  ...catalogFovReferences,
];
---
<Layout title={t.title} description={t.intro} lang={lang} languageLinks={languageLinks.equipmentAnalyzer(base)} focused>
<section class="equipment-analyser" data-analyser data-lang={lang}>
  <SessionToolLink lang={lang} href={sessionPreparationHref(lang, base)} />
  <header class="equipment-analyser__header"><h1>{t.title}</h1><p>{t.intro}</p><a class="analyser-guide-link" href={equipmentAnalyzerGuideHref(lang, base)} title={guideLinkText.tooltip}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3.5 5.5c3.2-.8 5.9-.3 8.5 1.6v12c-2.6-1.9-5.3-2.4-8.5-1.6zM20.5 5.5c-3.2-.8-5.9-.3-8.5 1.6v12c2.6-1.9 5.3-2.4 8.5-1.6z" /></svg><span>{guideLinkText.label}</span></a></header>
  <section class="analyser-entry" data-entry aria-labelledby={`analyser-entry-${lang}`}>
    <header><h2 id={`analyser-entry-${lang}`}>{entryText.question}</h2><p>{entryText.intro}</p></header>
    <div class="analyser-entry__choices" role="group" aria-label={entryText.question}>
      <button type="button" data-path="analyse" aria-pressed="false"><strong>{entryText.analyse}</strong><small>{entryText.analyseHelp}</small></button>
      <button type="button" data-path="known" aria-pressed="false"><strong>{entryText.known}</strong><small>{entryText.knownHelp}</small></button>
    </div>
  </section>
  <button class="analyser-back" type="button" data-path-back hidden>← {entryText.back}</button>
  <div class="analyser-mode" data-equipment-mode role="group" aria-label={t.title} hidden><button type="button" data-mode="components" aria-pressed="true"><strong>{t.components}</strong><small>{entryText.componentsHelp}</small></button><button type="button" data-mode="smart" aria-pressed="false"><strong>{t.smart}</strong><small>{entryText.smartHelp}</small></button></div>
  <form class="analyser-form" novalidate hidden>
    <section class="analyser-panel known-fov-input" data-known-fov hidden>
      <header><h2>{entryText.knownTitle}</h2><p>{entryText.knownIntro}</p></header>
      <div class="analyser-fields analyser-fields--known-fov">
        <label>{entryText.fieldWidth}<span><input name="knownFovWidth" type="number" min="0.01" step="any" value="1.91" inputmode="decimal" /></span></label>
        <label>{entryText.fieldHeight}<span><input name="knownFovHeight" type="number" min="0.01" step="any" value="1.3" inputmode="decimal" /></span></label>
        <label>{entryText.unit}<select name="knownFovUnit"><option value="degrees">{entryText.degrees} (°)</option><option value="arcminutes">{entryText.arcminutes} (′)</option></select></label>
      </div>
    </section>
    <div class="equipment-inputs" data-equipment-inputs>
    <details class="analyser-panel analyser-step" data-step="scope" data-components>
      <summary><span class="step-number">01</span><span class="step-title">{t.scope}</span><button class="step-reset" type="button" data-reset-step="scope" title={resetSectionText.hint}>{resetSectionText.action}</button><span class="step-status" data-step-status>{workflowText.pending}</span></summary>
      <div class="step-content">
        <div class="analyser-fields analyser-fields--four">
          <label>{t.aperture}<span><input name="aperture" type="number" min="1" step="any" value="102" inputmode="decimal" /> mm</span></label>
          <label>{tubeText.input}<select name="focalMode"><option value="mm">{t.focal} (mm)</option><option value="ratio">f/…</option></select></label>
          <label data-focal-mm>{t.focal}<span><input name="focal" type="number" min="1" step="any" value="714" inputmode="decimal" /> mm</span></label>
          <label data-focal-ratio>{tubeText.ratio}<span>f/ <input name="nativeRatio" type="number" min="0.1" step="0.1" value="7" inputmode="decimal" /></span></label>
        </div>
        <div class="factor-result-row">
          <label>{factorText.label}<span><input name="factor" type="number" min="0.1" max="10" step="0.01" value="0.8" inputmode="decimal" /></span><small>{factorText.help}</small></label>
          <p class="tube-result tube-result--field" data-tube-result><span>{tubeText.resulting}</span><strong>—</strong></p>
          <button class="step-next" type="button" data-next-step="camera">{workflowText.continue} →</button>
        </div>
      </div>
    </details>
    <details class="analyser-panel analyser-step" data-step="smart" data-smart hidden><summary><span class="step-number">01</span><span class="step-title">{t.smart}</span><button class="step-reset" type="button" data-reset-step="smart" title={resetSectionText.hint}>{resetSectionText.action}</button><span class="step-status step-status--complete" data-step-status>{workflowText.complete}</span></summary><div class="step-content"><label class="analyser-select smart-profile-field"><span class="sr-only">{t.smart}</span><select class="smart-profile-select" name="smartProfile"><option value="">{resetSectionText.smartEmpty}</option>{smartProfiles.map((p, index) => <option value={p.id} selected={index === 0}>{p.name}</option>)}</select><small>{t.smartHelp}</small></label><p class="preset-source" data-smart-source></p></div></details>
    <details class="analyser-panel analyser-step" data-step="camera" data-components><summary><span class="step-number">02</span><span class="step-title">{t.camera}</span><button class="step-reset" type="button" data-reset-step="camera" title={resetSectionText.hint}>{resetSectionText.action}</button><span class="step-status" data-step-status>{workflowText.pending}</span></summary><div class="step-content"><label class="analyser-select"><span>{t.chooseCamera}</span><select name="cameraProfile"><option value="manual">{t.manual}</option>{cameraProfiles.map((p) => <option value={p.id} selected={p.id === 'asi294mm-bin2'}>{p.name}</option>)}</select></label><div class="analyser-fields analyser-fields--three"><label>{t.pixel}<span><input name="pixel" type="number" min="0.1" step="any" value="4.6" inputmode="decimal" /> µm</span></label><label>{t.width}<span><input name="width" type="number" min="1" step="1" value="4144" inputmode="numeric" /> px</span></label><label>{t.height}<span><input name="height" type="number" min="1" step="1" value="2822" inputmode="numeric" /> px</span></label></div><p class="preset-source" data-camera-source hidden></p><button class="step-next" type="button" data-next-step="guiding">{workflowText.continue} →</button></div></details>
    <details class="analyser-panel analyser-step analyser-optional" data-step="guiding" data-components>
      <summary><span class="step-number">03</span><span class="step-title">{t.guiding}</span><button class="step-reset" type="button" data-reset-step="guiding" title={resetSectionText.hint}>{resetSectionText.action}</button><span class="step-status" data-step-status>{workflowText.optional}</span></summary>
      <div class="step-content"><label class="analyser-check"><input name="guiding" type="checkbox" checked /> {t.guidingToggle}</label><div class="guiding-setup" data-guiding>
        <fieldset><legend>{guideText.scope}</legend><div class="analyser-fields guide-tube-grid">
          <label>{t.aperture}<span><input name="guideAperture" type="number" min="1" step="any" value="60" inputmode="decimal" /> mm</span></label>
          <label>{tubeText.input}<select name="guideFocalMode"><option value="mm">{t.focal} (mm)</option><option value="ratio">f/…</option></select></label>
          <label data-guide-focal-mm>{t.focal}<span><input name="guideFocal" type="number" min="1" step="any" value="240" inputmode="decimal" /> mm</span></label>
          <label data-guide-focal-ratio>{tubeText.ratio}<span>f/ <input name="guideNativeRatio" type="number" min="0.1" step="0.1" value="4" inputmode="decimal" /></span></label>
          <p class="tube-result tube-result--field" data-guide-tube-result><span>{guideText.scopeResult}</span><strong>240 mm · f/4</strong></p>
        </div></fieldset>
        <fieldset><legend>{guideText.camera}</legend><label class="analyser-select"><span>{guideText.cameraChoice}</span><select name="guideCameraProfile"><option value="manual">{t.manual}</option>{guideCameraProfiles.map((p) => <option value={p.id} selected={p.id === 'asi220mm-mini'}>{p.name}</option>)}</select></label><div class="analyser-fields analyser-fields--three"><label>{t.guidePixel}<span><input name="guidePixel" type="number" min="0.1" step="any" value="4" inputmode="decimal" /> µm</span></label><label>{t.width}<span><input name="guideWidth" type="number" min="1" step="1" value="1920" inputmode="numeric" /> px</span></label><label>{t.height}<span><input name="guideHeight" type="number" min="1" step="1" value="1080" inputmode="numeric" /> px</span></label></div><p class="preset-source" data-guide-camera-source hidden></p></fieldset>
      </div></div>
    </details>
    <details class="analyser-panel analyser-step analyser-optional" data-step="conditions"><summary><span class="step-number">04</span><span class="step-title">{t.conditions}</span><span class="step-status" data-step-status>{workflowText.optional}</span></summary><div class="step-content"><div class="analyser-fields analyser-fields--conditions"><label>{t.seeingCategory}<select name="seeingCategory"><option value="">{t.seeingNone}</option><option value="1">{t.excellent}</option><option value="2">{t.good}</option><option value="3">{t.average}</option><option value="4">{t.poor}</option></select></label><label>{t.seeingExact}<span><input name="seeing" type="number" min="0.2" max="10" step="0.1" inputmode="decimal" /> ″</span></label><label>{t.sqm}<span><input name="sqm" type="number" min="14" max="23" step="0.1" inputmode="decimal" /> mag/arcsec²</span></label><label>{conditionsText.bortle}<select name="bortle"><option value="">{conditionsText.none}</option>{Array.from({ length: 9 }, (_, index) => <option value={index + 1}>Bortle {index + 1}</option>)}</select></label></div><p class="conditions-note">{conditionsText.note}</p></div></details>
    </div>
  </form>
  <details class="analyser-results" data-results aria-label={t.results} hidden>
    <summary class="results-summary"><span class="results-summary__heading"><span class="step-title">{t.results}</span><small data-analysis-only>{resultsIntroText}</small></span><span class="step-status" data-results-status>{workflowText.complete}</span></summary>
    <div class="results-content">
    <header data-analysis-only><h2 id="analyser-results-title" data-result-title>{t.components}</h2></header>
    <p data-incomplete data-analysis-only hidden>{t.incomplete}</p>
    <div class="analyser-metrics" data-metrics data-analysis-only><article><span>{tubeText.effectiveFocal}</span><strong data-result="effectiveFocal">—</strong></article><article><span>{t.effectiveRatio}</span><strong data-result="ratio">—</strong></article><article><span>{t.imageScale}</span><strong data-result="scale">—</strong></article><article><span>{t.field}</span><strong data-result="field">—</strong></article><article><span>{t.diffraction}</span><strong data-result="dawes">—</strong></article></div>
    <details class="fov-comparison" data-fov hidden>
      <summary class="fov-comparison__summary"><span><b data-fov-step-number>05 ·</b> {fovText.step}</span><small>{fovIntroText}</small></summary>
      <div class="fov-controls"><label>{fovText.choose}<select data-fov-select><optgroup label={fovPhotoText.familiar}>{fovReferences.filter((reference) => reference.status === 'familiar').map((reference) => <option value={reference.id}>{reference.name}</option>)}</optgroup><optgroup label={fovPhotoText.gallery}>{fovReferences.filter((reference) => reference.status === 'photographed').map((reference) => <option value={reference.id}>{reference.name}</option>)}</optgroup><optgroup label={fovPhotoText.pending}>{fovReferences.filter((reference) => reference.status === 'pending').map((reference) => <option value={reference.id}>{reference.name}</option>)}</optgroup></select></label><button type="button" data-fov-rotate>{fovText.rotate}</button></div>
      <div class="fov-visual-grid">
      <div class="fov-field-visual"><strong>Field of View (FOV)</strong><div class="fov-stage"><svg viewBox="0 0 600 320" role="img" aria-labelledby="fov-svg-title"><title id="fov-svg-title">{fovText.title}</title><defs><clipPath id={`fov-clip-${lang}`}><rect data-fov-clip /></clipPath><clipPath id={`fov-object-clip-${lang}`}><ellipse data-fov-object-clip /></clipPath><radialGradient id={`fov-object-gradient-${lang}`}><stop offset="0" stop-color="#fff4bd" stop-opacity=".95"/><stop offset=".45" stop-color="#e4c66a" stop-opacity=".55"/><stop offset="1" stop-color="#7ca0d8" stop-opacity=".08"/></radialGradient></defs><rect class="fov-frame" data-fov-frame/><g clip-path={`url(#fov-clip-${lang})`}><ellipse class="fov-object" data-fov-object fill={`url(#fov-object-gradient-${lang})`}/><image class="fov-gallery-image" data-fov-image preserveAspectRatio="xMidYMid slice" clip-path={`url(#fov-object-clip-${lang})`}/><ellipse class="fov-object-ring" data-fov-ring/></g><line class="fov-cross" data-fov-cross-x/><line class="fov-cross" data-fov-cross-y/></svg></div></div>
      <aside class="fov-photo-reference" data-fov-photo hidden><strong>{fovPhotoText.title}</strong><div class="fov-photo-canvas"><div class="fov-photo-frame" data-fov-photo-frame><img data-fov-reference-photo alt="" /><span class="fov-no-photo" data-fov-no-photo hidden>{fovPhotoText.noPhoto}</span></div></div><small data-fov-photo-note>{fovPhotoText.note}</small></aside>
      </div>
      <div class="fov-caption"><strong data-fov-verdict></strong><span data-fov-field></span><span data-fov-size></span></div>
    </details>
    <div class="analyser-reading" data-analysis-only><h3>{interpretationText.title}</h3><p data-result="mainScale" hidden></p><p data-result="sampling"></p><p data-result="sky" hidden></p><p data-result="guiding" hidden></p><p data-result="guideAssessment" hidden></p><p data-result="guidePrecision" hidden></p><div class="guide-scale-meter" data-guide-meter hidden><strong>{guideMeterText.title}</strong><div class="guide-scale-meter__bar" aria-hidden="true"><span class="guide-scale-meter__marker" data-guide-meter-marker></span></div><div class="guide-scale-meter__labels"><span>{guideMeterText.good}<small>≤ 3×</small></span><span>{guideMeterText.fair}<small>3–5×</small></span><span>{guideMeterText.wide}<small>&gt; 5×</small></span></div><b data-guide-meter-value></b><small>{guideMeterText.note}</small></div><details class="scale-calculation" data-scale-calculation hidden><summary>{scaleCalculationText.title}</summary><p>{scaleCalculationText.formula}</p><code data-scale-main></code><code data-scale-guide hidden></code><small>{scaleCalculationText.note}</small></details></div><p class="analyser-disclaimer" data-analysis-only>{t.disclaimer}</p><div class="analyser-actions" data-analysis-only><button type="button" data-copy title={transferText.copyHint}>{transferText.copy}</button><button type="button" data-pdf data-download title={transferText.downloadHint}>{transferText.download}</button></div><small class="analyser-print-help" data-analysis-only>{transferText.help}</small>
    </div>
  </details>
</section>
</Layout>
<script define:vars={{ cameraProfiles, fovReferences, guideCameraProfiles, smartProfiles, t, tubeText, guideText, workflowText, fovText, transferText, interpretationText, scaleCalculationText, guideMeterText, conditionsText }}>
const root=document.querySelector('[data-analyser]'),form=root.querySelector('form'),q=(name)=>form.elements.namedItem(name),blocks=[...root.querySelectorAll('[data-components]')],smartBlock=root.querySelector('[data-smart]');let journey='choice',mode='components',summary='',currentFov={width:0,height:0},fovRotated=false,fovMode='outline',knownFovUnit='degrees';const num=(name)=>Number.parseFloat(q(name).value),fmt=(v,d=2)=>new Intl.NumberFormat(root.dataset.lang,{maximumFractionDigits:d}).format(v),sourceText=(p)=>`${t.source}: ${p.name} · ${t.verified} ${p.checked}`;
function syncFovStep(){const number=root.querySelector('[data-fov-step-number]');number.hidden=journey==='known';number.textContent=mode==='smart'?'03 ·':'05 ·'}
function update(){syncFovStep();let aperture,focal,pixel,width,height,title,source;if(mode==='smart'){const p=smartProfiles.find(x=>x.id===q('smartProfile').value);if(p){({aperture,focal,pixel,width,height}=p);title=p.name;source=p}else title=t.smart}else{aperture=num('aperture');focal=num('focal')*num('factor');pixel=num('pixel');width=num('width');height=num('height')}root.querySelector('[data-result-title]').textContent=mode==='smart'?title:t.components;const valid=[aperture,focal,pixel,width,height].every(v=>Number.isFinite(v)&&v>0),fovPanel=root.querySelector('[data-fov]'),resultStatus=root.querySelector('[data-results-status]');resultStatus.textContent=valid?workflowText.complete:workflowText.pending;resultStatus.classList.toggle('step-status--complete',valid);root.querySelector('[data-incomplete]').hidden=valid;root.querySelector('[data-metrics]').hidden=!valid;fovPanel.hidden=!valid;root.querySelector('[data-copy]').disabled=!valid;root.querySelector('[data-pdf]').disabled=!valid;if(!valid){currentFov={width:0,height:0};return}const ratio=focal/aperture,scale=206.265*pixel/focal,sensorW=pixel*width/1000,sensorH=pixel*height/1000,fovW=2*Math.atan(sensorW/(2*focal))*180/Math.PI,fovH=2*Math.atan(sensorH/(2*focal))*180/Math.PI,dawes=116/aperture;currentFov={width:fovW,height:fovH};renderFov();root.querySelector('[data-result="ratio"]').textContent=`f/${fmt(ratio)}`;root.querySelector('[data-result="scale"]').textContent=`${fmt(scale)} ″/px`;root.querySelector('[data-result="field"]').textContent=`${fmt(fovW)}° × ${fmt(fovH)}°`;root.querySelector('[data-result="dawes"]').textContent=`${fmt(dawes)} ″`;const exact=num('seeing'),seeing=Number.isFinite(exact)?exact:num('seeingCategory'),sampling=Number.isFinite(seeing)?(seeing/scale<1.5?t.under:seeing/scale<=3.5?t.balanced:t.over):t.noSeeing;root.querySelector('[data-result="sampling"]').textContent=sampling;const sqm=num('sqm'),sky=root.querySelector('[data-result="sky"]');sky.hidden=!Number.isFinite(sqm);if(Number.isFinite(sqm))sky.textContent=`${t.sky}: ${sqm>=21.5?t.sqmDark:sqm>=20.5?t.sqmRural:sqm>=19?t.sqmSuburban:t.sqmBright}`;const guide=root.querySelector('[data-result="guiding"]'),guideScale=206.265*num('guidePixel')/num('guideFocal'),showGuide=mode==='components'&&q('guiding').checked&&Number.isFinite(guideScale);guide.hidden=!showGuide;if(showGuide)guide.textContent=`${t.guideScale}: ${fmt(guideScale)} ″/px · ${t.guideRatio}: ${fmt(guideScale/scale,1)}×`;summary=`${t.title}\n${mode==='smart'?title:t.components}\n${t.aperture}: ${fmt(aperture)} mm · ${t.focal}: ${fmt(focal)} mm\n${t.effectiveRatio}: f/${fmt(ratio)}\n${t.imageScale}: ${fmt(scale)} ″/px\n${t.field}: ${fmt(fovW)}° × ${fmt(fovH)}°\n${t.diffraction}: ${fmt(dawes)} ″\n${t.sampling}: ${sampling}${Number.isFinite(sqm)?`\n${sky.textContent}`:''}${showGuide?`\n${guide.textContent}`:''}\n${t.disclaimer}${source?`\n${sourceText(source)}: ${source.source}`:''}`;const smartSource=root.querySelector('[data-smart-source]');smartSource.hidden=!source;if(source)smartSource.innerHTML=`<a href="${source.source}" target="_blank" rel="noreferrer">${sourceText(source)}</a>`}
function renderGuideAssessment(){const assessment=root.querySelector('[data-result="guideAssessment"]'),precision=root.querySelector('[data-result="guidePrecision"]'),mainScaleReading=root.querySelector('[data-result="mainScale"]'),meter=root.querySelector('[data-guide-meter]'),mainFocal=mode==='smart'?smartProfiles.find(item=>item.id===q('smartProfile').value)?.focal:num('focal')*num('factor'),mainPixel=mode==='smart'?smartProfiles.find(item=>item.id===q('smartProfile').value)?.pixel:num('pixel'),mainScale=206.265*mainPixel/mainFocal,guideScale=206.265*num('guidePixel')/num('guideFocal'),ratio=guideScale/mainScale,hasMainScale=Number.isFinite(mainScale)&&mainScale>0,show=mode==='components'&&q('guiding').checked&&Number.isFinite(ratio)&&ratio>0;mainScaleReading.hidden=!hasMainScale;if(hasMainScale)mainScaleReading.textContent=`${interpretationText.mainScale}: ${fmt(mainScale)} ″/px`;assessment.hidden=!show;precision.hidden=!show;meter.hidden=!show;if(show){const verdict=ratio<=3?interpretationText.guideGood:ratio<=5?interpretationText.guideFair:interpretationText.guideWide;assessment.textContent=`${interpretationText.ratioLabel}: ${fmt(ratio,1)}×. ${verdict} ${interpretationText.pixelMeaningStart} ${fmt(ratio,1)} ${interpretationText.pixelMeaningEnd} ${interpretationText.centroidStart} ${fmt(ratio*.1,2)} ${interpretationText.centroidEnd}`;precision.textContent=interpretationText.guidePrecision;meter.style.setProperty('--guide-position',`${Math.min(ratio,6)/6*100}%`);meter.querySelector('[data-guide-meter-value]').textContent=`▲ ${guideMeterText.current}: ${fmt(ratio,1)}×`;meter.setAttribute('aria-label',`${guideMeterText.title}: ${fmt(ratio,1)}×`)}}
function renderScaleCalculation(){const smart=mode==='smart'?smartProfiles.find(item=>item.id===q('smartProfile').value):null,mainFocal=smart?.focal??num('focal')*num('factor'),mainPixel=smart?.pixel??num('pixel'),mainScale=206.265*mainPixel/mainFocal,panel=root.querySelector('[data-scale-calculation]'),valid=Number.isFinite(mainScale)&&mainScale>0;panel.hidden=!valid;if(!valid)return;panel.querySelector('[data-scale-main]').textContent=`${scaleCalculationText.main}: ${fmt(206.265,3)} × ${fmt(mainPixel)} ÷ ${fmt(mainFocal)} = ${fmt(mainScale)} ″/px`;const guideLine=panel.querySelector('[data-scale-guide]'),guideFocal=num('guideFocal'),guidePixel=num('guidePixel'),guideScale=206.265*guidePixel/guideFocal,showGuide=mode==='components'&&q('guiding').checked&&Number.isFinite(guideScale)&&guideScale>0;guideLine.hidden=!showGuide;if(showGuide)guideLine.textContent=`${scaleCalculationText.guide}: ${fmt(206.265,3)} × ${fmt(guidePixel)} ÷ ${fmt(guideFocal)} = ${fmt(guideScale)} ″/px`}
function renderSkyConditions(){const sqm=num('sqm'),bortle=num('bortle'),sky=root.querySelector('[data-result="sky"]');sky.hidden=!Number.isFinite(sqm)&&!Number.isFinite(bortle);if(Number.isFinite(sqm))sky.textContent=`${t.sky}: ${sqm>=21.5?t.sqmDark:sqm>=20.5?t.sqmRural:sqm>=19?t.sqmSuburban:t.sqmBright}`;else if(Number.isFinite(bortle))sky.textContent=`${conditionsText.bortleResult}: ${fmt(bortle,0)}`}
