---
import type { Lang } from '../i18n';
import { languageLinks } from '../i18n';
import Layout from '../layouts/Layout.astro';
import { cameraProfiles, fovReferences, guideCameraProfiles, smartProfiles } from '../data/equipment-analyzer';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const base = import.meta.env.BASE_URL;
const texts = {
  ca: { title: "Analitzador d’equip", eyebrow: 'Laboratori', intro: "Introdueix només les dades essencials i obtén una lectura orientativa del teu conjunt òptic. Tot es calcula en aquest dispositiu i no es desa cap dada.", components: 'Equip per components', smart: 'Telescopi intel·ligent', scope: 'Tub òptic', aperture: 'Obertura', focal: 'Distància focal', factor: 'Factor òptic', factorHelp: '1 sense reductor o Barlow; 0,8 amb un reductor 0,8×.', camera: 'Càmera', chooseCamera: 'Selecciona una càmera', manual: 'Entrada manual', pixel: 'Mida de píxel', width: 'Amplada', height: 'Alçada', conditions: 'Condicions opcionals', seeingExact: 'Seeing en segons d’arc', seeingCategory: 'Seeing per categoria', seeingNone: 'Sense indicar', excellent: 'Excel·lent (~1″)', good: 'Bo (~2″)', average: 'Mitjà (~3″)', poor: 'Dolent (~4″)', sqm: 'SQM', sqmHelp: 'mag/arcsec². No equival de manera exacta a una classe Bortle.', guiding: 'Guiat opcional', guidingToggle: 'Afegir equip de guiat', guidePixel: 'Píxel de la càmera guia', guideFocal: 'Focal del tub guia', results: 'Resultat', effectiveRatio: 'Relació focal efectiva', imageScale: 'Escala d’imatge', field: 'Camp de visió', diffraction: 'Resolució teòrica (Dawes)', sampling: 'Mostreig', sky: 'Lectura del cel', guideScale: 'Escala de guiat', guideRatio: 'Relació guia/principal', incomplete: 'Completa els camps essencials per veure el resultat.', copy: 'Copia el resum', copied: 'Resum copiat', pdf: 'Desa com a PDF', printHelp: 'S’obrirà el diàleg d’impressió; tria “Desa com a PDF”.', source: 'Font oficial', verified: 'verificada', disclaimer: 'Estimació geomètrica i orientativa. El rendiment real també depèn de l’atmosfera, el focus, el seguiment, els filtres i el processament.', under: 'Mostreig probablement gros per a aquest seeing: prioritza camp i sensibilitat davant del detall fi.', balanced: 'Mostreig raonablement equilibrat per al seeing indicat.', over: 'Mostreig fi per al seeing indicat; part del detall pot quedar limitat per l’atmosfera.', noSeeing: 'Sense seeing no hi ha un veredicte únic: compara l’escala amb el teu seeing habitual (aprox. 2–3 píxels per FWHM).', sqmDark: 'Cel molt fosc segons la lectura SQM.', sqmRural: 'Cel fosc o rural segons la lectura SQM.', sqmSuburban: 'Cel periurbà segons la lectura SQM.', sqmBright: 'Cel brillant segons la lectura SQM.', smartHelp: 'Perfils basats en l’òptica teleobjectiu principal.' },
  es: { title: 'Analizador de equipo', eyebrow: 'Laboratorio', intro: 'Introduce solo los datos esenciales y obtén una lectura orientativa de tu conjunto óptico. Todo se calcula en este dispositivo y no se guarda ningún dato.', components: 'Equipo por componentes', smart: 'Telescopio inteligente', scope: 'Tubo óptico', aperture: 'Apertura', focal: 'Distancia focal', factor: 'Factor óptico', factorHelp: '1 sin reductor ni Barlow; 0,8 con un reductor 0,8×.', camera: 'Cámara', chooseCamera: 'Selecciona una cámara', manual: 'Entrada manual', pixel: 'Tamaño de píxel', width: 'Anchura', height: 'Altura', conditions: 'Condiciones opcionales', seeingExact: 'Seeing en segundos de arco', seeingCategory: 'Seeing por categoría', seeingNone: 'Sin indicar', excellent: 'Excelente (~1″)', good: 'Bueno (~2″)', average: 'Medio (~3″)', poor: 'Malo (~4″)', sqm: 'SQM', sqmHelp: 'mag/arcsec². No equivale de forma exacta a una clase Bortle.', guiding: 'Guiado opcional', guidingToggle: 'Añadir equipo de guiado', guidePixel: 'Píxel de la cámara guía', guideFocal: 'Focal del tubo guía', results: 'Resultado', effectiveRatio: 'Relación focal efectiva', imageScale: 'Escala de imagen', field: 'Campo de visión', diffraction: 'Resolución teórica (Dawes)', sampling: 'Muestreo', sky: 'Lectura del cielo', guideScale: 'Escala de guiado', guideRatio: 'Relación guía/principal', incomplete: 'Completa los campos esenciales para ver el resultado.', copy: 'Copiar resumen', copied: 'Resumen copiado', pdf: 'Guardar como PDF', printHelp: 'Se abrirá el diálogo de impresión; elige “Guardar como PDF”.', source: 'Fuente oficial', verified: 'verificada', disclaimer: 'Estimación geométrica y orientativa. El rendimiento real también depende de la atmósfera, el enfoque, el seguimiento, los filtros y el procesado.', under: 'Muestreo probablemente grueso para este seeing: prioriza campo y sensibilidad frente al detalle fino.', balanced: 'Muestreo razonablemente equilibrado para el seeing indicado.', over: 'Muestreo fino para el seeing indicado; parte del detalle puede quedar limitado por la atmósfera.', noSeeing: 'Sin seeing no hay un veredicto único: compara la escala con tu seeing habitual (aprox. 2–3 píxeles por FWHM).', sqmDark: 'Cielo muy oscuro según la lectura SQM.', sqmRural: 'Cielo oscuro o rural según la lectura SQM.', sqmSuburban: 'Cielo periurbano según la lectura SQM.', sqmBright: 'Cielo brillante según la lectura SQM.', smartHelp: 'Perfiles basados en la óptica teleobjetivo principal.' },
  en: { title: 'Equipment analyser', eyebrow: 'Lab', intro: 'Enter only the essential data for a practical reading of your optical setup. Everything is calculated on this device and no data is stored.', components: 'Component setup', smart: 'Smart telescope', scope: 'Optical tube', aperture: 'Aperture', focal: 'Focal length', factor: 'Optical factor', factorHelp: '1 with no reducer or Barlow; 0.8 with a 0.8× reducer.', camera: 'Camera', chooseCamera: 'Select a camera', manual: 'Manual entry', pixel: 'Pixel size', width: 'Width', height: 'Height', conditions: 'Optional conditions', seeingExact: 'Seeing in arcseconds', seeingCategory: 'Seeing by category', seeingNone: 'Not specified', excellent: 'Excellent (~1″)', good: 'Good (~2″)', average: 'Average (~3″)', poor: 'Poor (~4″)', sqm: 'SQM', sqmHelp: 'mag/arcsec². This does not map exactly to a Bortle class.', guiding: 'Optional guiding', guidingToggle: 'Add guiding setup', guidePixel: 'Guide camera pixel', guideFocal: 'Guide scope focal length', results: 'Result', effectiveRatio: 'Effective focal ratio', imageScale: 'Image scale', field: 'Field of view', diffraction: 'Theoretical resolution (Dawes)', sampling: 'Sampling', sky: 'Sky reading', guideScale: 'Guiding scale', guideRatio: 'Guide/main ratio', incomplete: 'Complete the essential fields to see the result.', copy: 'Copy summary', copied: 'Summary copied', pdf: 'Save as PDF', printHelp: 'The print dialog will open; choose “Save as PDF”.', source: 'Official source', verified: 'checked', disclaimer: 'Geometric, indicative estimate. Real performance also depends on the atmosphere, focus, tracking, filters and processing.', under: 'Sampling is probably coarse for this seeing: it favours field and sensitivity over fine detail.', balanced: 'Sampling is reasonably balanced for the stated seeing.', over: 'Sampling is fine for the stated seeing; some detail may be limited by the atmosphere.', noSeeing: 'Without seeing there is no single verdict: compare the scale with your usual seeing (about 2–3 pixels per FWHM).', sqmDark: 'Very dark sky according to the SQM reading.', sqmRural: 'Dark or rural sky according to the SQM reading.', sqmSuburban: 'Peri-urban sky according to the SQM reading.', sqmBright: 'Bright sky according to the SQM reading.', smartHelp: 'Profiles use the main telephoto optics.' },
} as const;
const t = texts[lang];
const tubeText = {
  ca: { input: 'Dada disponible', ratio: 'Relació focal', effectiveFocal: 'Distància focal efectiva', resulting: 'Resultat amb el factor' },
  es: { input: 'Dato disponible', ratio: 'Relación focal', effectiveFocal: 'Distancia focal efectiva', resulting: 'Resultado con el factor' },
  en: { input: 'Available value', ratio: 'Focal ratio', effectiveFocal: 'Effective focal length', resulting: 'Result with factor' },
}[lang];
const guideText = {
  ca: { scope: 'Tub de guiat', camera: 'Càmera de guiat', scopeResult: 'Tub de guiat', cameraChoice: 'Selecciona una càmera de guiat' },
  es: { scope: 'Tubo de guiado', camera: 'Cámara de guiado', scopeResult: 'Tubo de guiado', cameraChoice: 'Selecciona una cámara de guiado' },
  en: { scope: 'Guide scope', camera: 'Guide camera', scopeResult: 'Guide scope', cameraChoice: 'Select a guide camera' },
}[lang];
const workflowText = {
  ca: { pending: 'Falten dades', complete: 'Completat', optional: 'Opcional', missing: 'Per obtenir les conclusions falta:', scope: 'completar el tub òptic', camera: 'completar la càmera', continue: 'Continua amb el pas següent' },
  es: { pending: 'Faltan datos', complete: 'Completado', optional: 'Opcional', missing: 'Para obtener las conclusiones falta:', scope: 'completar el tubo óptico', camera: 'completar la cámara', continue: 'Continuar con el paso siguiente' },
  en: { pending: 'Missing data', complete: 'Complete', optional: 'Optional', missing: 'To obtain conclusions, you still need to:', scope: 'complete the optical tube', camera: 'complete the camera', continue: 'Continue to the next step' },
}[lang];
const fovText = {
  ca: { title: 'Què cap en el teu enquadrament?', intro: 'Comparació geomètrica a la mateixa escala; no representa la brillantor ni el detall visible.', choose: 'Objecte de referència', view: 'Representació', outline: 'Perímetre', image: 'Imatge de la galeria', rotate: 'Gira el sensor', field: 'Camp representat', object: 'Mida aparent aproximada', roomy: 'Hi cap amb marge.', tight: 'Hi cap, amb un enquadrament ajustat.', outside: 'No hi cap complet.', small: 'Apareixerà petit dins del camp.', moon: 'Lluna', m13: 'M13 · cúmul globular', m42: 'M42 · nebulosa d’Orió', m101: 'M101 · galàxia', m31: 'M31 · galàxia d’Andròmeda', jupiter: 'Júpiter · planeta' },
  es: { title: '¿Qué cabe en tu encuadre?', intro: 'Comparación geométrica a la misma escala; no representa el brillo ni el detalle visible.', choose: 'Objeto de referencia', view: 'Representación', outline: 'Perímetro', image: 'Imagen de la galería', rotate: 'Girar el sensor', field: 'Campo representado', object: 'Tamaño aparente aproximado', roomy: 'Cabe con margen.', tight: 'Cabe, con un encuadre ajustado.', outside: 'No cabe completo.', small: 'Aparecerá pequeño dentro del campo.', moon: 'Luna', m13: 'M13 · cúmulo globular', m42: 'M42 · nebulosa de Orión', m101: 'M101 · galaxia', m31: 'M31 · galaxia de Andrómeda', jupiter: 'Júpiter · planeta' },
  en: { title: 'What fits in your frame?', intro: 'Geometric comparison at the same scale; it does not represent visible brightness or detail.', choose: 'Reference object', view: 'Representation', outline: 'Outline', image: 'Gallery image', rotate: 'Rotate sensor', field: 'Displayed field', object: 'Approximate apparent size', roomy: 'Fits with room to spare.', tight: 'Fits, with a tight frame.', outside: 'Does not fit in full.', small: 'Will appear small within the field.', moon: 'Moon', m13: 'M13 · globular cluster', m42: 'M42 · Orion Nebula', m101: 'M101 · galaxy', m31: 'M31 · Andromeda Galaxy', jupiter: 'Jupiter · planet' },
}[lang];
---
<Layout title={t.title} description={t.intro} lang={lang} languageLinks={languageLinks.equipmentAnalyzer(base)} focused>
<section class="equipment-analyser" data-analyser data-lang={lang}>
  <header class="equipment-analyser__header"><p>{t.eyebrow}</p><h1>{t.title}</h1><p>{t.intro}</p></header>
  <div class="analyser-mode" role="group" aria-label={t.title}><button type="button" data-mode="components" aria-pressed="true">{t.components}</button><button type="button" data-mode="smart" aria-pressed="false">{t.smart}</button></div>
  <form class="analyser-form" novalidate>
    <details class="analyser-panel analyser-step" data-step="scope" data-components open>
      <summary><span class="step-number">01</span><span class="step-title">{t.scope}</span><span class="step-status" data-step-status>{workflowText.pending}</span></summary>
      <div class="step-content">
        <div class="analyser-fields analyser-fields--four">
          <label>{t.aperture}<span><input name="aperture" type="number" min="1" step="any" inputmode="decimal" /> mm</span></label>
          <label>{tubeText.input}<select name="focalMode"><option value="mm">{t.focal} (mm)</option><option value="ratio">f/…</option></select></label>
          <label data-focal-mm>{t.focal}<span><input name="focal" type="number" min="1" step="any" inputmode="decimal" /> mm</span></label>
          <label data-focal-ratio>{tubeText.ratio}<span>f/ <input name="nativeRatio" type="number" min="0.1" step="0.1" inputmode="decimal" /></span></label>
        </div>
        <div class="factor-result-row">
          <label>{t.factor}<span><input name="factor" type="number" min="0.1" max="10" step="0.01" value="1" inputmode="decimal" /> ×</span><small>{t.factorHelp}</small></label>
          <p class="tube-result tube-result--field" data-tube-result><span>{tubeText.resulting}</span><strong>—</strong></p>
        </div>
        <button class="step-next" type="button" data-next-step="camera">{workflowText.continue} →</button>
      </div>
    </details>
    <details class="analyser-panel analyser-step" data-step="smart" data-smart hidden open><summary><span class="step-number">01</span><span class="step-title">{t.smart}</span><span class="step-status step-status--complete">{workflowText.complete}</span></summary><div class="step-content"><label class="analyser-select"><span>{t.smart}</span><select name="smartProfile">{smartProfiles.map((p) => <option value={p.id}>{p.name}</option>)}</select><small>{t.smartHelp}</small></label><p class="preset-source" data-smart-source></p></div></details>
    <details class="analyser-panel analyser-step" data-step="camera" data-components><summary><span class="step-number">02</span><span class="step-title">{t.camera}</span><span class="step-status" data-step-status>{workflowText.pending}</span></summary><div class="step-content"><label class="analyser-select"><span>{t.chooseCamera}</span><select name="cameraProfile"><option value="manual">{t.manual}</option>{cameraProfiles.map((p) => <option value={p.id}>{p.name}</option>)}</select></label><div class="analyser-fields analyser-fields--three"><label>{t.pixel}<span><input name="pixel" type="number" min="0.1" step="any" inputmode="decimal" /> µm</span></label><label>{t.width}<span><input name="width" type="number" min="1" step="1" inputmode="numeric" /> px</span></label><label>{t.height}<span><input name="height" type="number" min="1" step="1" inputmode="numeric" /> px</span></label></div><p class="preset-source" data-camera-source hidden></p><button class="step-next" type="button" data-next-step="conditions">{workflowText.continue} →</button></div></details>
    <details class="analyser-panel analyser-step analyser-optional" data-step="conditions"><summary><span class="step-number">03</span><span class="step-title">{t.conditions}</span><span class="step-status" data-step-status>{workflowText.optional}</span></summary><div class="step-content"><div class="analyser-fields analyser-fields--three"><label>{t.seeingCategory}<select name="seeingCategory"><option value="">{t.seeingNone}</option><option value="1">{t.excellent}</option><option value="2">{t.good}</option><option value="3">{t.average}</option><option value="4">{t.poor}</option></select></label><label>{t.seeingExact}<span><input name="seeing" type="number" min="0.2" max="10" step="0.1" inputmode="decimal" /> ″</span></label><label>{t.sqm}<span><input name="sqm" type="number" min="14" max="23" step="0.1" inputmode="decimal" /> mag/arcsec²</span><small>{t.sqmHelp}</small></label></div></div></details>
    <details class="analyser-panel analyser-step analyser-optional" data-step="guiding" data-components>
      <summary><span class="step-number">04</span><span class="step-title">{t.guiding}</span><span class="step-status" data-step-status>{workflowText.optional}</span></summary>
      <div class="step-content"><label class="analyser-check"><input name="guiding" type="checkbox" /> {t.guidingToggle}</label><div class="guiding-setup" data-guiding hidden>
        <fieldset><legend>{guideText.scope}</legend><div class="analyser-fields guide-tube-grid">
          <label>{t.aperture}<span><input name="guideAperture" type="number" min="1" step="any" value="30" inputmode="decimal" /> mm</span></label>
          <label>{tubeText.input}<select name="guideFocalMode"><option value="mm">{t.focal} (mm)</option><option value="ratio">f/…</option></select></label>
          <label data-guide-focal-mm>{t.focal}<span><input name="guideFocal" type="number" min="1" step="any" value="120" inputmode="decimal" /> mm</span></label>
          <label data-guide-focal-ratio>{tubeText.ratio}<span>f/ <input name="guideNativeRatio" type="number" min="0.1" step="0.1" value="4" inputmode="decimal" /></span></label>
          <p class="tube-result tube-result--field" data-guide-tube-result><span>{guideText.scopeResult}</span><strong>120 mm · f/4</strong></p>
        </div></fieldset>
        <fieldset><legend>{guideText.camera}</legend><label class="analyser-select"><span>{guideText.cameraChoice}</span><select name="guideCameraProfile"><option value="manual">{t.manual}</option>{guideCameraProfiles.map((p) => <option value={p.id}>{p.name}</option>)}</select></label><div class="analyser-fields analyser-fields--three"><label>{t.guidePixel}<span><input name="guidePixel" type="number" min="0.1" step="any" value="3.75" inputmode="decimal" /> µm</span></label><label>{t.width}<span><input name="guideWidth" type="number" min="1" step="1" value="1280" inputmode="numeric" /> px</span></label><label>{t.height}<span><input name="guideHeight" type="number" min="1" step="1" value="960" inputmode="numeric" /> px</span></label></div><p class="preset-source" data-guide-camera-source hidden></p></fieldset>
      </div></div>
    </details>
  </form>
  <section class="analyser-results" aria-labelledby="analyser-results-title">
    <header><p>{t.results}</p><h2 id="analyser-results-title" data-result-title>{t.components}</h2></header>
    <p data-incomplete hidden>{t.incomplete}</p>
    <div class="analyser-metrics" data-metrics><article><span>{tubeText.effectiveFocal}</span><strong data-result="effectiveFocal">—</strong></article><article><span>{t.effectiveRatio}</span><strong data-result="ratio">—</strong></article><article><span>{t.imageScale}</span><strong data-result="scale">—</strong></article><article><span>{t.field}</span><strong data-result="field">—</strong></article><article><span>{t.diffraction}</span><strong data-result="dawes">—</strong></article></div>
    <section class="fov-comparison" data-fov hidden>
      <div class="fov-comparison__header"><div><h3>{fovText.title}</h3><p>{fovText.intro}</p></div><div class="fov-controls"><label>{fovText.choose}<select data-fov-select>{fovReferences.map((reference) => <option value={reference.id}>{fovText[reference.id]}</option>)}</select></label><label>{fovText.view}<select data-fov-style><option value="outline">{fovText.outline}</option><option value="image">{fovText.image}</option></select></label><button type="button" data-fov-rotate>{fovText.rotate}</button></div></div>
      <div class="fov-stage"><svg viewBox="0 0 600 320" role="img" aria-labelledby="fov-svg-title"><title id="fov-svg-title">{fovText.title}</title><defs><clipPath id={`fov-clip-${lang}`}><rect data-fov-clip /></clipPath><clipPath id={`fov-object-clip-${lang}`}><ellipse data-fov-object-clip /></clipPath><radialGradient id={`fov-object-gradient-${lang}`}><stop offset="0" stop-color="#fff4bd" stop-opacity=".95"/><stop offset=".45" stop-color="#e4c66a" stop-opacity=".55"/><stop offset="1" stop-color="#7ca0d8" stop-opacity=".08"/></radialGradient></defs><rect class="fov-frame" data-fov-frame/><g clip-path={`url(#fov-clip-${lang})`}><ellipse class="fov-object" data-fov-object fill={`url(#fov-object-gradient-${lang})`}/><image class="fov-gallery-image" data-fov-image preserveAspectRatio="xMidYMid slice" clip-path={`url(#fov-object-clip-${lang})`}/><ellipse class="fov-object-ring" data-fov-ring/></g><line class="fov-cross" data-fov-cross-x/><line class="fov-cross" data-fov-cross-y/></svg></div>
      <div class="fov-caption"><strong data-fov-verdict></strong><span data-fov-field></span><span data-fov-size></span></div>
    </section>
    <div class="analyser-reading"><h3>{t.sampling}</h3><p data-result="sampling"></p><p data-result="sky" hidden></p><p data-result="guiding" hidden></p></div><p class="analyser-disclaimer">{t.disclaimer}</p><div class="analyser-actions"><button type="button" data-copy>{t.copy}</button><button type="button" data-pdf>{t.pdf}</button></div><small class="analyser-print-help">{t.printHelp}</small>
  </section>
</section>
</Layout>
<script define:vars={{ cameraProfiles, fovReferences, guideCameraProfiles, smartProfiles, t, tubeText, guideText, workflowText, fovText }}>
const root=document.querySelector('[data-analyser]'),form=root.querySelector('form'),q=(name)=>form.elements.namedItem(name),blocks=[...root.querySelectorAll('[data-components]')],smartBlock=root.querySelector('[data-smart]');let mode='components',summary='',currentFov={width:0,height:0},fovRotated=false;const num=(name)=>Number.parseFloat(q(name).value),fmt=(v,d=2)=>new Intl.NumberFormat(root.dataset.lang,{maximumFractionDigits:d}).format(v),sourceText=(p)=>`${t.source}: ${p.name} · ${t.verified} ${p.checked}`;
function update(){let aperture,focal,pixel,width,height,title,source;if(mode==='smart'){const p=smartProfiles.find(x=>x.id===q('smartProfile').value);({aperture,focal,pixel,width,height}=p);title=p.name;source=p}else{aperture=num('aperture');focal=num('focal')*num('factor');pixel=num('pixel');width=num('width');height=num('height')}root.querySelector('[data-result-title]').textContent=mode==='smart'?title:t.components;const valid=[aperture,focal,pixel,width,height].every(v=>Number.isFinite(v)&&v>0),fovPanel=root.querySelector('[data-fov]');root.querySelector('[data-incomplete]').hidden=valid;root.querySelector('[data-metrics]').hidden=!valid;fovPanel.hidden=!valid;root.querySelector('[data-copy]').disabled=!valid;root.querySelector('[data-pdf]').disabled=!valid;if(!valid)return;const ratio=focal/aperture,scale=206.265*pixel/focal,sensorW=pixel*width/1000,sensorH=pixel*height/1000,fovW=2*Math.atan(sensorW/(2*focal))*180/Math.PI,fovH=2*Math.atan(sensorH/(2*focal))*180/Math.PI,dawes=116/aperture;currentFov={width:fovW,height:fovH};renderFov();root.querySelector('[data-result="ratio"]').textContent=`f/${fmt(ratio)}`;root.querySelector('[data-result="scale"]').textContent=`${fmt(scale)} ″/px`;root.querySelector('[data-result="field"]').textContent=`${fmt(fovW)}° × ${fmt(fovH)}°`;root.querySelector('[data-result="dawes"]').textContent=`${fmt(dawes)} ″`;const exact=num('seeing'),seeing=Number.isFinite(exact)?exact:num('seeingCategory'),sampling=Number.isFinite(seeing)?(seeing/scale<1.5?t.under:seeing/scale<=3.5?t.balanced:t.over):t.noSeeing;root.querySelector('[data-result="sampling"]').textContent=sampling;const sqm=num('sqm'),sky=root.querySelector('[data-result="sky"]');sky.hidden=!Number.isFinite(sqm);if(Number.isFinite(sqm))sky.textContent=`${t.sky}: ${sqm>=21.5?t.sqmDark:sqm>=20.5?t.sqmRural:sqm>=19?t.sqmSuburban:t.sqmBright}`;const guide=root.querySelector('[data-result="guiding"]'),guideScale=206.265*num('guidePixel')/num('guideFocal'),showGuide=mode==='components'&&q('guiding').checked&&Number.isFinite(guideScale);guide.hidden=!showGuide;if(showGuide)guide.textContent=`${t.guideScale}: ${fmt(guideScale)} ″/px · ${t.guideRatio}: ${fmt(guideScale/scale,1)}×`;summary=`${t.title}\n${mode==='smart'?title:t.components}\n${t.aperture}: ${fmt(aperture)} mm · ${t.focal}: ${fmt(focal)} mm\n${t.effectiveRatio}: f/${fmt(ratio)}\n${t.imageScale}: ${fmt(scale)} ″/px\n${t.field}: ${fmt(fovW)}° × ${fmt(fovH)}°\n${t.diffraction}: ${fmt(dawes)} ″\n${t.sampling}: ${sampling}${Number.isFinite(sqm)?`\n${sky.textContent}`:''}${showGuide?`\n${guide.textContent}`:''}\n${t.disclaimer}${source?`\n${sourceText(source)}: ${source.source}`:''}`;if(source)root.querySelector('[data-smart-source]').innerHTML=`<a href="${source.source}" target="_blank" rel="noreferrer">${sourceText(source)}</a>`}
function angularSize(value){if(value<.03)return`${fmt(value*3600,0)}″`;if(value<1)return`${fmt(value*60,0)}′`;return`${fmt(value)}°`}
