async function analyserFovPage(){const{canvas,context}=reportCanvas();reportHeader(context,2);let y=230;context.fillStyle='#111827';context.font='700 38px Arial';context.fillText(fovText.title,80,y);y+=52;const fovLines=selectedFovResultLines();context.fillStyle='#475467';context.font='21px Arial';for(const line of fovLines.slice(2))y=wrapReportText(context,line,80,y,1080,31)+5;const source=root.querySelector('.fov-stage svg'),clone=source.cloneNode(true),style=document.createElementNS('http://www.w3.org/2000/svg','style');style.textContent='.fov-frame{fill:#080b12;stroke:#e4c66a;stroke-width:2}.fov-object{fill:#e4c66a}.fov-object-ring{fill:rgba(228,198,106,.18);stroke:#e4c66a;stroke-width:2}.fov-cross{stroke:#e4c66a;stroke-width:1}.fov-gallery-image{opacity:.95}';clone.prepend(style);clone.setAttribute('xmlns','http://www.w3.org/2000/svg');const galleryImage=clone.querySelector('[data-fov-image]');if(galleryImage?.getAttribute('href'))galleryImage.setAttribute('href',new URL(galleryImage.getAttribute('href'),location.href).href);const svgUrl=URL.createObjectURL(new Blob([new XMLSerializer().serializeToString(clone)],{type:'image/svg+xml'}));try{const image=new Image();await new Promise((resolve,reject)=>{image.onload=resolve;image.onerror=()=>reject(new Error('FOV export failed'));image.src=svgUrl});context.fillStyle='#080b12';context.fillRect(80,570,1080,576);context.drawImage(image,80,570,1080,576)}finally{URL.revokeObjectURL(svgUrl)}context.fillStyle='#13786f';context.font='700 21px Arial';context.fillText(interpretationText.title.toLocaleUpperCase(),80,1215);context.fillStyle='#344054';context.font='19px Arial';let textY=1260;for(const reading of [...root.querySelectorAll('.analyser-reading p:not([hidden])')].map(item=>item.textContent).filter(Boolean))textY=wrapReportText(context,reading,80,textY,1080,28)+8;context.fillStyle='#667085';context.font='16px Arial';wrapReportText(context,t.disclaimer,80,1680,1080,23);return canvas}
function canvasJpeg(canvas){return new Promise((resolve,reject)=>canvas.toBlob(async blob=>blob?resolve(new Uint8Array(await blob.arrayBuffer())):reject(new Error('PDF image failed')),'image/jpeg',.92))}
function pdfFromJpegs(images){const encoder=new TextEncoder(),objects=new Map(),asBytes=value=>encoder.encode(value),join=parts=>{const size=parts.reduce((sum,part)=>sum+part.length,0),result=new Uint8Array(size);let offset=0;for(const part of parts){result.set(part,offset);offset+=part.length}return result};objects.set(1,asBytes('<< /Type /Catalog /Pages 2 0 R >>'));objects.set(2,asBytes(`<< /Type /Pages /Count ${images.length} /Kids [${images.map((_,index)=>`${3+index*3} 0 R`).join(' ')}] >>`));images.forEach((image,index)=>{const page=3+index*3,content=page+1,picture=page+2;objects.set(page,asBytes(`<< /Type /Page /Parent 2 0 R /MediaBox [0 0 595 842] /Resources << /XObject << /Im0 ${picture} 0 R >> >> /Contents ${content} 0 R >>`));const drawing=asBytes('q\n595 0 0 842 0 0 cm\n/Im0 Do\nQ');objects.set(content,join([asBytes(`<< /Length ${drawing.length} >>\nstream\n`),drawing,asBytes('\nendstream')]));objects.set(picture,join([asBytes(`<< /Type /XObject /Subtype /Image /Width ${image.width} /Height ${image.height} /ColorSpace /DeviceRGB /BitsPerComponent 8 /Filter /DCTDecode /Length ${image.bytes.length} >>\nstream\n`),image.bytes,asBytes('\nendstream')]))});const chunks=[new Uint8Array([37,80,68,70,45,49,46,52,10,37,226,227,207,211,10])],offsets=[0];let position=chunks[0].length;for(let number=1;number<=objects.size;number+=1){offsets[number]=position;const chunk=join([asBytes(`${number} 0 obj\n`),objects.get(number),asBytes('\nendobj\n')]);chunks.push(chunk);position+=chunk.length}const xref=position,entries=['0000000000 65535 f ',...offsets.slice(1).map(offset=>`${String(offset).padStart(10,'0')} 00000 n `)];chunks.push(asBytes(`xref\n0 ${objects.size+1}\n${entries.join('\n')}\ntrailer\n<< /Size ${objects.size+1} /Root 1 0 R >>\nstartxref\n${xref}\n%%EOF`));return new Blob(chunks,{type:'application/pdf'})}
const oldDownloadButton=root.querySelector('[data-download]'),downloadButton=oldDownloadButton.cloneNode(true);oldDownloadButton.replaceWith(downloadButton);downloadButton.setAttribute('aria-live','polite');downloadButton.addEventListener('click',async()=>{const old=downloadButton.textContent;downloadButton.disabled=true;try{const pages=[analyserSummaryPage(),await analyserFovPage()],images=await Promise.all(pages.map(async page=>({bytes:await canvasJpeg(page),width:page.width,height:page.height}))),blob=pdfFromJpegs(images),url=URL.createObjectURL(blob),link=document.createElement('a');link.href=url;link.download='informe-analizador-equipo.pdf';link.click();downloadButton.textContent=transferText.downloaded;downloadButton.classList.add('is-confirmed');setTimeout(()=>{URL.revokeObjectURL(url);downloadButton.textContent=old;downloadButton.classList.remove('is-confirmed')},3500)}catch(error){console.error(error)}finally{downloadButton.disabled=false}});
</script>
