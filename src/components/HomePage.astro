---
import Layout from '../layouts/Layout.astro';
import SiteMapIcon from './SiteMapIcon.astro';
import type { Lang } from '../i18n';
import { articlesHref, copy, equipmentHref, galleryHref, languageLinks, myNightHref, sessionPreparationHref, siteMapHref, withBase } from '../i18n';
import { optimizedVariant } from '../lib/optimized-images';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const base = import.meta.env.BASE_URL;
const t = copy[lang];
const homeUrl = new URL(lang === 'ca' ? base : `${base}${lang}/`, Astro.site).href;
const authorName = 'Juan José Romero';
const [introBeforeAuthor, introAfterAuthor = ''] = t.homeIntro.split(authorName);
const coverRotationDays = 1;
const coverRotationAnchor = Date.UTC(2026, 7, 21);
const coverPreviewEnabled = import.meta.env.DEV;
const homeNavigationTitles = {
	ca: { firstVisit: 'Primera visita', directAccess: 'Accessos directes' },
	es: { firstVisit: 'Primera visita', directAccess: 'Accesos directos' },
	en: { firstVisit: 'First visit', directAccess: 'Quick access' },
}[lang];
const advancedLevel = {
	ca: 'Avançat',
	es: 'Avanzado',
	en: 'Advanced',
}[lang];
// Cada portada ofrece copias de 1280, 1920 y 2560 px; el original (4K) solo se usa en pantallas mayores.
const cover = (file: string) => ({
	1280: optimizedVariant(`portadas/${file}`, 1280, base),
	1920: optimizedVariant(`portadas/${file}`, 1920, base),
	2560: optimizedVariant(`portadas/${file}`, 2560, base),
	original: withBase(`imagenes/portadas/${file}`, base),
});
const rotatingCovers = [
	{ src: cover('portada-rotativa-01.webp'), shadeLeft: .45, shadeRight: .08 }, // azul/rojo
	{ src: cover('portada-rotativa-07.webp'), shadeLeft: .55, shadeRight: .17 }, // NGC 2237 verde
	{ src: cover('portada-rotativa-05.webp'), shadeLeft: .53, shadeRight: .15 }, // rojo
	{ src: cover('portada-rotativa-11.webp'), shadeLeft: .48, shadeRight: .11 }, // neutro/oscuro
	{ src: cover('portada-rotativa-06.webp'), shadeLeft: .50, shadeRight: .13 }, // dorado/azul
	{ src: cover('portada-rotativa-08.webp'), shadeLeft: .48, shadeRight: .11 }, // NGC 2237 rojo
	{ src: cover('portada-rotativa-03.webp'), shadeLeft: .55, shadeRight: .17 }, // verde
	{ src: cover('portada-rotativa-02.webp'), shadeLeft: .45, shadeRight: .08 }, // rojo oscuro
	{ src: cover('portada-rotativa-12.webp'), shadeLeft: .55, shadeRight: .16 }, // magenta/azul
	{ src: cover('portada-rotativa-09.webp'), shadeLeft: .47, shadeRight: .10 }, // NGC 2237 azul/dorado
	{ src: cover('portada-rotativa-10.webp'), shadeLeft: .49, shadeRight: .11 }, // rojo
	{ src: cover('portada-rotativa-04.webp'), shadeLeft: .45, shadeRight: .08 }, // azul/rojo
];
const structuredData = {
	'@context': 'https://schema.org',
	'@type': 'WebSite',
	name: 'El meu Cel Profund',
	url: homeUrl,
	description: t.homeSeoDescription,
	inLanguage: lang,
	author: {
		'@type': 'Person',
		name: 'Juan José Romero',
	},
};
---

<Layout title={t.homeSeoTitle} description={t.homeSeoDescription} image={withBase('imagenes/optimizadas/og/portada-1200x630.jpg', base)} structuredData={structuredData} hero lang={lang} languageLinks={languageLinks.home(base)}>
	<script is:inline define:vars={{ rotatingCovers, coverRotationDays, coverRotationAnchor, coverPreviewEnabled }}>
		const requestedCover = coverPreviewEnabled ? Number(new URLSearchParams(window.location.search).get('cover')) : 0;
		const madridDateParts = (date) => Object.fromEntries(
			new Intl.DateTimeFormat('en-CA', {
				timeZone: 'Europe/Madrid',
				year: 'numeric',
				month: '2-digit',
				day: '2-digit',
			}).formatToParts(date).filter(({ type }) => type !== 'literal').map(({ type, value }) => [type, Number(value)]),
		);
		const dayNumber = (date) => {
			const { year, month, day } = madridDateParts(date);
			return Math.floor(Date.UTC(year, month - 1, day) / 86400000);
		};
		const anchorDay = Math.floor(coverRotationAnchor / 86400000);
		let appliedDay;
		const applyRotatingCover = () => {
			const currentDay = dayNumber(new Date());
			if (currentDay === appliedDay) return;
			appliedDay = currentDay;
			const elapsedDays = currentDay - anchorDay;
			const cycleIndex = ((Math.floor(elapsedDays / coverRotationDays) % rotatingCovers.length) + rotatingCovers.length) % rotatingCovers.length;
			const selectedIndex = Number.isInteger(requestedCover) && requestedCover >= 1 && requestedCover <= rotatingCovers.length ? requestedCover - 1 : cycleIndex;
			const selectedCover = rotatingCovers[selectedIndex];
			const pixelRatio = window.devicePixelRatio || 1;
			const neededWidth = Math.max(window.innerWidth * pixelRatio, window.innerHeight * 16 / 9 * Math.min(pixelRatio, 1.5));
			const coverSrc = neededWidth <= 1400 ? selectedCover.src[1280] : neededWidth <= 2100 ? selectedCover.src[1920] : neededWidth <= 2900 ? selectedCover.src[2560] : selectedCover.src.original;
			document.documentElement.style.setProperty('--rotating-hero-image', `url("${coverSrc}")`);
			document.documentElement.style.setProperty('--rotating-hero-shade-left', String(selectedCover.shadeLeft));
			document.documentElement.style.setProperty('--rotating-hero-shade-right', String(selectedCover.shadeRight));
		};
		applyRotatingCover();
		window.addEventListener('pageshow', applyRotatingCover);
		document.addEventListener('visibilitychange', () => {
			if (!document.hidden) applyRotatingCover();
		});
		window.setInterval(applyRotatingCover, 60000);
	</script>
	<section class="welcome-hero" style={`--hero-image: var(--rotating-hero-image, url('${withBase('imagenes/portada.webp', base)}')); --hero-shade-left: var(--rotating-hero-shade-left, .45); --hero-shade-right: var(--rotating-hero-shade-right, .08)`} aria-labelledby="welcome-title">
		<div class="welcome-hero__content">
			<div class="welcome-hero__message">
				<h1 id="welcome-title">El meu Cel Profund</h1>
				<p class="welcome-hero__description">{introBeforeAuthor}<span class="welcome-hero__author">{authorName}</span>{introAfterAuthor}</p>
			</div>
		</div>
		<div class="welcome-hero__navigation">
			<section class="welcome-hero__entry-group" aria-labelledby="home-first-visit-title">
				<h2 id="home-first-visit-title">{homeNavigationTitles.firstVisit}</h2>
				<div class="welcome-hero__entry-content welcome-hero__entry-content--first">
					<a class="welcome-hero__map" href={siteMapHref(lang, base)}><SiteMapIcon name="sitemap" />{t.siteMap}</a>
				</div>
			</section>
			<section class="welcome-hero__entry-group" aria-labelledby="home-direct-access-title">
				<h2 id="home-direct-access-title">{homeNavigationTitles.directAccess}</h2>
				<div class="welcome-hero__actions">
					<a class="welcome-hero__cta welcome-hero__cta--secondary welcome-hero__cta--result" href={equipmentHref(lang, base)}><SiteMapIcon name="equipment" size="sm" />{t.myEquipment}</a>
					<a class="welcome-hero__cta welcome-hero__cta--secondary welcome-hero__cta--articles" href={articlesHref(lang, base)}><SiteMapIcon name="articles" size="sm" />{t.articles}</a>
					<a class="welcome-hero__cta welcome-hero__cta--secondary welcome-hero__cta--review context-tooltip context-tooltip--home" href={sessionPreparationHref(lang, base)} aria-describedby="home-session-tip"><SiteMapIcon name="route" size="sm" />{t.homeSessionPreparation}<span class="context-tooltip__bubble" id="home-session-tip" role="tooltip">{t.homeSessionPreparationTooltip}</span></a>
					<a class="welcome-hero__cta welcome-hero__cta--secondary welcome-hero__cta--my-night" href={myNightHref(lang, base)}><SiteMapIcon name="night" size="sm" /><span>{t.myNight}</span><small>{advancedLevel}</small></a>
					<a class="welcome-hero__cta welcome-hero__cta--primary welcome-hero__cta--gallery" href={galleryHref(lang, base)}><SiteMapIcon name="gallery" size="sm" />{t.explore}<span aria-hidden="true">→</span></a>
				</div>
			</section>
		</div>
	</section>
</Layout>
