---
import type { Lang } from '../i18n';
import { languageLinks, visibilityHref } from '../i18n';
import Layout from '../layouts/Layout.astro';

interface Props { lang: Extract<Lang, 'ca' | 'es' | 'en'>; }
const { lang } = Astro.props;
const base = import.meta.env.BASE_URL;
const content = {
  ca: {
    title: 'Guia de Visibilitat',
    intro: 'Aquesta eina ajuda a escollir objectes de cel profund segons la setmana, la durada de la visibilitat i la presència de la Lluna. Els càlculs estan referits al centre de Catalunya: 41° N, 1,5° E.',
    index: 'En aquesta guia',
    back: 'Tornar a Visibilitat',
    summaryTitle: 'Resum ràpid',
    summary: 'Escull el llindar d’altura i les hores mínimes, compara els objectes resultants i revisa la Lluna durant la nit seleccionada abans de decidir.',
    sections: [
      { id: 'comencar', title: 'Com començar', steps: ['Selecciona la setmana i l’any.', 'Si cal, desplaça el període uns dies per adaptar-lo a una sortida o un pont.', 'Tria una constel·lació o mantén «Totes».', 'Escull el llindar d’altura i quantes hores mínimes ha de romandre l’objecte per sobre seu.', 'Tria «Galeria» o «Pendents» i consulta els resultats «Amb fotos» o en format «Llista».', 'Prem «Veure gràfica» per obrir directament la nit seleccionada, o «Planificar» per analitzar l’objecte des de la ubicació que triïs.'] },
      { id: 'planificacio', title: 'De Visibilitat a Planificació', paragraphs: ['Visibilitat és la vista de descoberta: compara molts objectes per a una setmana des de la ubicació de referència del centre de Catalunya i mostra les hores en hora local.', 'Quan ja hagis escollit un objecte, «Planificar» obre l’anàlisi tècnica amb l’objecte, la setmana i l’any ja seleccionats. Allí pots canviar la ubicació i comparar les set nits amb dades en UTC.'] },
      { id: 'hores', title: 'Hora local i UTC', paragraphs: ['Les fitxes, la millor hora i la gràfica nocturna mostren l’hora local de Catalunya, tal com indica la capçalera. Això inclou automàticament l’horari d’estiu quan correspon.', 'La gràfica anual és l’excepció: representa l’altura de l’objecte a les 00:00 UTC i ho indica explícitament.'] },
      { id: 'setmana-any', title: 'Setmana, any i desplaçament', paragraphs: ['La selecció utilitza setmanes ISO, de dilluns a diumenge. El número de setmana i les dates del període es mostren separadament.', 'Amb «Desplaçament de dies» pots moure el període complet fins a tres dies abans o després sense canviar de setmana. Això permet estudiar, per exemple, de dissabte a divendres. En canviar de setmana o d’any, el desplaçament torna a zero.', 'L’any és especialment important per calcular la posició i la fase de la Lluna.'] },
      { id: 'llindar', title: 'Llindar d’altura i hores mínimes', paragraphs: ['«Llindar d’altura» permet filtrar a 30°, 35°, 40°, 45°, 50°, 55° o 60°. «Hores mínimes sobre el llindar» conserva només els objectes que compleixen tots dos criteris durant el període seleccionat.'], bullets: ['2 hores: selecció àmplia.', '3–4 hores: selecció equilibrada.', '5–6 hores: selecció més exigent.'], note: 'Aquest llindar variable només modifica la selecció d’objectes de Visibilitat. La referència general de les altres gràfiques de la web continua sent 30°.' },
      { id: 'vistes-informes', title: 'Vistes i informe', paragraphs: ['«Amb fotos» mostra les targetes visuals i «Llista» ofereix les mateixes dades en files més compactes. «Galeria» reuneix els objectes ja fotografiats i «Pendents», els que encara són a la llista de treball.', '«Copia els resultats» envia al porta-retalls una relació sense fotografies. «Descarrega el PDF» genera el mateix conjunt com a informe, incloent el període, els filtres aplicats i les dades útils de cada objecte. Un tic confirma que l’ordre s’ha executat.'] },
      { id: 'nit-astronomica', title: 'Nit astronòmica', paragraphs: ['Es considera nit astronòmica el període durant el qual el Sol està per sota de −18°. És l’interval més fosc de la nit i, generalment, el més adequat per fotografiar objectes febles de cel profund.', 'La durada canvia al llarg de l’any: les nits astronòmiques són més llargues a l’hivern i més curtes a l’estiu.'] },
      { id: 'grafica-anual', title: 'Gràfica anual', paragraphs: ['La gràfica anual representa l’altura aproximada de l’objecte a les 00:00 UTC durant les setmanes de l’any.'], bullets: ['La millor època de l’any.', 'Les setmanes en què l’objecte assoleix més altura.', 'Quan es troba per sobre o per sota de 30°.', 'L’evolució general de la seva visibilitat.'], note: 'El marcador vertical assenyala la setmana i l’any seleccionats.' },
      { id: 'grafica-nit', title: 'Gràfica d’una nit', paragraphs: ['«Veure gràfica» obre directament la pestanya «Nit seleccionada». Els botons «Anual» i «Nit seleccionada» continuen disponibles per canviar de vista, i els botons de dilluns a diumenge permeten estudiar qualsevol nit del període.'], bullets: ['L’altura de l’objecte i de la Lluna.', 'L’horitzó a 0°.', 'Una línia blava discontínua amb el llindar escollit.', 'La referència general de 30°, si el llindar escollit és diferent.', 'L’inici i el final de la foscor astronòmica.', 'L’hora de màxima altura de l’objecte.'], note: 'Si esculls 30°, les dues referències coincideixen i la gràfica mostra una sola línia.' },
      { id: 'lluna', title: 'L’objecte, la Lluna i el llindar', paragraphs: ['La corba verda representa l’altura de l’objecte, la corba vermellosa discontínua representa la Lluna i la línia blava de punts identifica el llindar seleccionat.', 'Si la corba lunar està per sota de 0°, la Lluna es troba sota l’horitzó. Si és alta durant bona part de la nit, pot reduir el contrast del cel, especialment quan la fase és avançada.'], curves: { object: 'Objecte', moon: 'Lluna', horizon: 'Horitzó', threshold: 'Llindar seleccionat' } },
      { id: 'fase-lunar', title: 'Fase lunar', paragraphs: ['La fase i l’altura lunar s’han d’interpretar conjuntament: una Lluna brillant sota l’horitzó no afecta l’observació, mentre que una Lluna alta sí que pot fer-ho.'], bullets: ['Lluna nova.', 'Creixent fina.', 'Quart creixent.', 'Gibosa creixent.', 'Lluna plena.', 'Gibosa minvant.', 'Quart minvant.', 'Minvant fina.'] },
      { id: 'navegacio-contextual', title: 'Retorn a l’objecte seleccionat', paragraphs: ['Quan obres una fotografia des de Visibilitat, la fitxa conserva la setmana, l’any, la constel·lació, el llindar i el tipus de vista. En tornar, la pàgina recupera aquella selecció i situa al centre l’objecte que estaves consultant.', 'El mateix passa si des de la fitxa obres «Veure la visibilitat completa»: en tancar la gràfica amb la ×, tocant fora o amb Esc, tornes a la targeta o fila de l’objecte, ressaltada durant uns segons.'] },
      { id: 'limits', title: 'Què no té en compte', paragraphs: ['L’eina és una ajuda per planificar, però no substitueix la comprovació de les condicions reals.'], bullets: ['La meteorologia.', 'Núvols o humitat.', 'Relleu i obstacles de l’horitzó.', 'Contaminació lumínica local.', 'Transparència o turbulència atmosfèrica.'] },
    ],
  },
  es: {
    title: 'Guía de Visibilidad',
    intro: 'Esta herramienta ayuda a elegir objetos de cielo profundo según la semana, la duración de su visibilidad y la presencia de la Luna. Los cálculos están referidos al centro de Cataluña: 41° N, 1,5° E.',
    index: 'En esta guía',
    back: 'Volver a Visibilidad',
    summaryTitle: 'Resumen rápido',
    summary: 'Elige el umbral de altura y las horas mínimas, compara los objetos resultantes y revisa la Luna durante la noche seleccionada antes de decidir.',
    sections: [
      { id: 'empezar', title: 'Cómo empezar', steps: ['Selecciona la semana y el año.', 'Si lo necesitas, desplaza el periodo unos días para adaptarlo a una salida o un puente.', 'Elige una constelación o mantén «Todas».', 'Selecciona el umbral de altura y cuántas horas mínimas debe permanecer el objeto por encima de él.', 'Elige «Galería» o «Pendientes» y consulta los resultados «Con fotos» o en formato «Lista».', 'Pulsa «Ver gráfica» para abrir directamente la noche seleccionada, o «Planificar» para analizar el objeto desde la ubicación que elijas.'] },
      { id: 'planificacion', title: 'De Visibilidad a Planificación', paragraphs: ['Visibilidad es la vista de descubrimiento: compara muchos objetos para una semana desde la ubicación de referencia del centro de Cataluña y muestra las horas en hora local.', 'Cuando ya hayas elegido un objeto, «Planificar» abre el análisis técnico con el objeto, la semana y el año ya seleccionados. Allí puedes cambiar la ubicación y comparar las siete noches con datos en UTC.'] },
      { id: 'horas', title: 'Hora local y UTC', paragraphs: ['Las fichas, la mejor hora y la gráfica nocturna muestran la hora local de Cataluña, tal como indica la cabecera. Esto incluye automáticamente el horario de verano cuando corresponde.', 'La gráfica anual es la excepción: representa la altura del objeto a las 00:00 UTC y lo indica explícitamente.'] },
      { id: 'semana-ano', title: 'Semana, año y desplazamiento', paragraphs: ['La selección utiliza semanas ISO, de lunes a domingo. El número de semana y las fechas del periodo se muestran por separado.', 'Con «Desplazamiento de días» puedes mover el periodo completo hasta tres días antes o después sin cambiar de semana. Esto permite estudiar, por ejemplo, de sábado a viernes. Al cambiar de semana o de año, el desplazamiento vuelve a cero.', 'El año es especialmente importante para calcular la posición y la fase de la Luna.'] },
      { id: 'umbral', title: 'Umbral de altura y horas mínimas', paragraphs: ['«Umbral de altura» permite filtrar a 30°, 35°, 40°, 45°, 50°, 55° o 60°. «Horas mínimas sobre el umbral» conserva únicamente los objetos que cumplen ambos criterios durante el periodo seleccionado.'], bullets: ['2 horas: selección amplia.', '3–4 horas: selección equilibrada.', '5–6 horas: selección más exigente.'], note: 'Este umbral variable solo modifica la selección de objetos de Visibilidad. La referencia general de las demás gráficas de la web continúa siendo 30°.' },
      { id: 'vistas-informes', title: 'Vistas e informe', paragraphs: ['«Con fotos» muestra las tarjetas visuales y «Lista» ofrece los mismos datos en filas más compactas. «Galería» reúne los objetos ya fotografiados y «Pendientes», los que todavía están en la lista de trabajo.', '«Copiar resultados» envía al portapapeles una relación sin fotografías. «Descargar PDF» genera el mismo conjunto como informe, incluyendo el periodo, los filtros aplicados y los datos útiles de cada objeto. Un tic confirma que la orden se ha ejecutado.'] },
      { id: 'noche-astronomica', title: 'Noche astronómica', paragraphs: ['Se considera noche astronómica el periodo durante el cual el Sol está por debajo de −18°. Es el intervalo más oscuro de la noche y, generalmente, el más adecuado para fotografiar objetos débiles de cielo profundo.', 'La duración cambia a lo largo del año: las noches astronómicas son más largas en invierno y más cortas en verano.'] },
      { id: 'grafica-anual', title: 'Gráfica anual', paragraphs: ['La gráfica anual representa la altura aproximada del objeto a las 00:00 UTC durante las semanas del año.'], bullets: ['La mejor época del año.', 'Las semanas en que el objeto alcanza mayor altura.', 'Cuándo se encuentra por encima o por debajo de 30°.', 'La evolución general de su visibilidad.'], note: 'El marcador vertical señala la semana y el año seleccionados.' },
      { id: 'grafica-noche', title: 'Gráfica de una noche', paragraphs: ['«Ver gráfica» abre directamente la pestaña «Noche seleccionada». Los botones «Anual» y «Noche seleccionada» continúan disponibles para cambiar de vista, y los botones de lunes a domingo permiten estudiar cualquier noche del periodo.'], bullets: ['La altura del objeto y de la Luna.', 'El horizonte a 0°.', 'Una línea azul discontinua con el umbral elegido.', 'La referencia general de 30°, si el umbral elegido es diferente.', 'El inicio y el final de la oscuridad astronómica.', 'La hora de máxima altura del objeto.'], note: 'Si eliges 30°, ambas referencias coinciden y la gráfica muestra una sola línea.' },
      { id: 'luna', title: 'El objeto, la Luna y el umbral', paragraphs: ['La curva verde representa la altura del objeto, la curva rojiza discontinua representa la Luna y la línea azul de puntos identifica el umbral seleccionado.', 'Si la curva lunar está por debajo de 0°, la Luna se encuentra bajo el horizonte. Si está alta durante buena parte de la noche, puede reducir el contraste del cielo, especialmente cuando su fase es avanzada.'], curves: { object: 'Objeto', moon: 'Luna', horizon: 'Horizonte', threshold: 'Umbral seleccionado' } },
      { id: 'fase-lunar', title: 'Fase lunar', paragraphs: ['La fase y la altura lunar deben interpretarse conjuntamente: una Luna brillante bajo el horizonte no afecta a la observación, mientras que una Luna alta sí puede hacerlo.'], bullets: ['Luna nueva.', 'Creciente fina.', 'Cuarto creciente.', 'Gibosa creciente.', 'Luna llena.', 'Gibosa menguante.', 'Cuarto menguante.', 'Menguante fina.'] },
      { id: 'navegacion-contextual', title: 'Regreso al objeto seleccionado', paragraphs: ['Cuando abres una fotografía desde Visibilidad, la ficha conserva la semana, el año, la constelación, el umbral y el tipo de vista. Al volver, la página recupera esa selección y sitúa en el centro el objeto que estabas consultando.', 'Lo mismo sucede si desde la ficha abres «Ver la visibilidad completa»: al cerrar la gráfica con la ×, tocando fuera o con Esc, regresas a la tarjeta o fila del objeto, resaltada durante unos segundos.'] },
      { id: 'limites', title: 'Qué no tiene en cuenta', paragraphs: ['La herramienta es una ayuda para planificar, pero no sustituye la comprobación de las condiciones reales.'], bullets: ['La meteorología.', 'Nubes o humedad.', 'Relieve y obstáculos del horizonte.', 'Contaminación luminosa local.', 'Transparencia o turbulencia atmosférica.'] },
    ],
  },
  en: {
    title: 'Visibility Guide',
    intro: 'This tool helps you choose deep-sky objects according to the week, how long they remain visible and the presence of the Moon. Calculations use central Catalonia as the reference location: 41° N, 1.5° E.',
    index: 'In this guide',
    back: 'Back to Visibility',
    summaryTitle: 'Quick summary',
    summary: 'Choose an altitude threshold and a minimum duration, compare the resulting objects and check the Moon during the selected night before making your decision.',
    sections: [
      { id: 'getting-started', title: 'Getting started', steps: ['Select the week and year.', 'If needed, shift the period by a few days to match an observing trip or a long weekend.', 'Choose a constellation or keep “All”.', 'Select the altitude threshold and the minimum time the object must remain above it.', 'Choose “Gallery” or “Pending”, and view the results as “With photos” or as a “List”.', 'Select “View chart” to open the selected night directly, or “Plan” to analyse the object from a location of your choice.'] },
      { id: 'planning', title: 'From Visibility to Planning', paragraphs: ['Visibility is the discovery view: it compares many objects for a given week from the reference location in central Catalonia and displays times in local time.', 'Once you have chosen an object, “Plan” opens the technical analysis with the object, week and year already selected. There you can change the location and compare all seven nights using UTC data.'] },
      { id: 'time', title: 'Local time and UTC', paragraphs: ['The cards, best time and night chart use local time in Catalonia, as stated in the header. Daylight saving time is applied automatically when appropriate.', 'The annual chart is the exception: it shows the object’s altitude at 00:00 UTC and labels this explicitly.'] },
      { id: 'week-year', title: 'Week, year and day offset', paragraphs: ['The selector uses ISO weeks, from Monday to Sunday. The week number and the dates in the period are shown separately.', '“Day offset” moves the entire period up to three days earlier or later without changing the selected week. This makes it possible, for example, to study Saturday through Friday. The offset returns to zero when the week or year changes.', 'The year is particularly important when calculating the Moon’s position and phase.'] },
      { id: 'threshold', title: 'Altitude threshold and minimum duration', paragraphs: ['“Altitude threshold” lets you filter at 30°, 35°, 40°, 45°, 50°, 55° or 60°. “Minimum hours above threshold” keeps only objects that satisfy both criteria during the selected period.'], bullets: ['2 hours: broad selection.', '3–4 hours: balanced selection.', '5–6 hours: more demanding selection.'], note: 'This adjustable threshold only changes the object selection in Visibility. The general reference used by other charts on the website remains 30°.' },
      { id: 'views-reports', title: 'Views and report', paragraphs: ['“With photos” displays visual cards, while “List” presents the same information in more compact rows. “Gallery” contains objects that have already been photographed, while “Pending” contains those still on the target list.', '“Copy results” sends a text-only list to the clipboard. “Download PDF” creates a report with the same results, including the period, active filters and useful data for each object. A tick confirms that the action has completed.'] },
      { id: 'astronomical-night', title: 'Astronomical night', paragraphs: ['Astronomical night is the period when the Sun is below −18°. It is the darkest part of the night and is generally the most suitable time for photographing faint deep-sky objects.', 'Its duration changes throughout the year: astronomical nights are longer in winter and shorter in summer.'] },
      { id: 'annual-chart', title: 'Annual chart', paragraphs: ['The annual chart shows the object’s approximate altitude at 00:00 UTC over the weeks of the year.'], bullets: ['The best time of year.', 'The weeks when the object reaches its greatest altitude.', 'When it is above or below 30°.', 'The overall evolution of its visibility.'], note: 'The vertical marker identifies the selected week and year.' },
      { id: 'night-chart', title: 'Chart for one night', paragraphs: ['“View chart” opens the “Selected night” tab directly. The “Annual” and “Selected night” buttons remain available for switching views, and the Monday-to-Sunday buttons let you study any night in the period.'], bullets: ['The altitude of the object and the Moon.', 'The horizon at 0°.', 'A blue dotted line marking the selected threshold.', 'The general 30° reference when the selected threshold is different.', 'The beginning and end of astronomical darkness.', 'The time when the object reaches its maximum altitude.'], note: 'If you select 30°, both references coincide and the chart displays a single line.' },
      { id: 'moon-threshold', title: 'The object, Moon and threshold', paragraphs: ['The green curve represents the object’s altitude, the reddish dashed curve represents the Moon, and the blue dotted line identifies the selected threshold.', 'When the lunar curve is below 0°, the Moon is below the horizon. If it remains high for much of the night, it can reduce sky contrast, especially when its phase is advanced.'], curves: { object: 'Object', moon: 'Moon', horizon: 'Horizon', threshold: 'Selected threshold' } },
      { id: 'moon-phase', title: 'Moon phase', paragraphs: ['Moon phase and altitude should be considered together: a bright Moon below the horizon does not affect observing, whereas a high Moon can.'], bullets: ['New Moon.', 'Waxing crescent.', 'First quarter.', 'Waxing gibbous.', 'Full Moon.', 'Waning gibbous.', 'Last quarter.', 'Waning crescent.'] },
      { id: 'contextual-navigation', title: 'Returning to the selected object', paragraphs: ['When you open a photograph from Visibility, the object page preserves the week, year, constellation, threshold and view type. When you return, the page restores that selection and centres the object you were viewing.', 'The same applies when you open “View full visibility” from an object page: closing the chart with ×, by clicking outside it or by pressing Esc returns you to the object’s card or row, which is briefly highlighted.'] },
      { id: 'limitations', title: 'What it does not account for', paragraphs: ['The tool helps with planning, but it does not replace checking actual observing conditions.'], bullets: ['Weather.', 'Cloud or humidity.', 'Terrain and horizon obstructions.', 'Local light pollution.', 'Atmospheric transparency or turbulence.'] },
    ],
  },
} as const;
const t = content[lang];
---

<Layout title={t.title} description={t.intro} lang={lang} languageLinks={languageLinks.visibilityGuide(base)} focused>
  <article class="visibility-guide">
    <a class="visibility-guide__back" href={visibilityHref(lang, base)}>← {t.back}</a>
    <header class="visibility-guide__hero">
      <div class="visibility-guide__book" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M3.5 5.5c3.2-.8 5.9-.3 8.5 1.6v12c-2.6-1.9-5.3-2.4-8.5-1.6zM20.5 5.5c-3.2-.8-5.9-.3-8.5 1.6v12c2.6-1.9 5.3-2.4 8.5-1.6z" /></svg></div>
      <h1>{t.title}</h1>
    </header>
    <p class="visibility-guide__intro">{t.intro}</p>

    <nav class="visibility-guide__index" aria-label={t.index}>
      <strong>{t.index}</strong>
      <ol>{t.sections.map((section, index) => <li><a href={`#${section.id}`}><span>{String(index + 1).padStart(2, '0')}</span>{section.title}</a></li>)}</ol>
    </nav>

    <div class="visibility-guide__sections">
      {t.sections.map((section, index) => <section id={section.id}>
        <div class="visibility-guide__number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</div>
        <div class="visibility-guide__copy">
          <h2>{section.title}</h2>
          {'paragraphs' in section && section.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}
          {'steps' in section && section.steps && <ol class="visibility-guide__steps">{section.steps.map((step) => <li>{step}</li>)}</ol>}
          {'bullets' in section && section.bullets && <ul>{section.bullets.map((bullet) => <li>{bullet}</li>)}</ul>}
          {'curves' in section && section.curves && <div class="visibility-guide__curves" aria-label={section.title}>
            <span><i class="curve curve--object"></i>{section.curves.object}</span>
            <span><i class="curve curve--moon"></i>{section.curves.moon}</span>
            <span><i class="curve curve--horizon"></i>{section.curves.horizon}</span>
            <span><i class="curve curve--threshold"></i>{section.curves.threshold}</span>
          </div>}
          {'note' in section && section.note && <aside>{section.note}</aside>}
        </div>
      </section>)}
    </div>

    <section class="visibility-guide__summary" aria-labelledby="visibility-summary">
      <p>{t.summaryTitle}</p>
      <h2 id="visibility-summary">{t.summary}</h2>
    </section>
    <a class="visibility-guide__return" href={visibilityHref(lang, base)}>← {t.back}</a>
  </article>
</Layout>

<style>
  .visibility-guide { --visibility-link: #438ea0; --visibility-link-soft: #74b2c0; max-width: 58rem; margin: 0 auto; padding: .5rem 0 3rem; }
  .visibility-guide__back { display: inline-block; margin-bottom: 1.1rem; color: var(--visibility-link-soft); font-size: .78rem; text-decoration: none; }
  .visibility-guide__back:hover { color: #99d2dd; }
  .visibility-guide__hero { display: flex; align-items: center; gap: 1rem; padding-bottom: 1.1rem; border-bottom: 1px solid var(--color-border); }
  .visibility-guide__hero h1 { margin: 0; font-size: clamp(1.45rem, 3vw, 2.2rem); letter-spacing: -.035em; line-height: 1.05; }
  .visibility-guide__book { display: grid; flex: 0 0 auto; width: 2.8rem; height: 2.8rem; place-items: center; border: 1px solid rgba(67, 142, 160, .66); border-radius: .65rem; background: rgba(67, 142, 160, .12); color: var(--visibility-link-soft); }
  .visibility-guide__book svg { width: 1.6rem; height: 1.6rem; fill: none; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.45; }
  .visibility-guide__intro { max-width: 48rem; margin: 1.25rem 0; color: var(--color-text); font-size: clamp(1rem, 2vw, 1.14rem); line-height: 1.7; }
  .visibility-guide__index { margin: 1.5rem 0 2.4rem; padding: 1rem; border: 1px solid var(--color-border); border-radius: .8rem; background: var(--color-surface); }
  .visibility-guide__index > strong { display: block; margin-bottom: .65rem; color: var(--color-muted); font-size: .72rem; letter-spacing: .06em; text-transform: uppercase; }
  .visibility-guide__index ol { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .3rem .8rem; margin: 0; padding: 0; list-style: none; }
  .visibility-guide__index a { display: flex; align-items: baseline; gap: .5rem; padding: .35rem .4rem; border-radius: .35rem; color: var(--color-text); font-size: .85rem; text-decoration: none; }
  .visibility-guide__index a:hover { background: rgba(67, 142, 160, .13); }
  .visibility-guide__index a span { color: var(--visibility-link-soft); font: .68rem var(--font-mono); }
  .visibility-guide__sections { display: grid; gap: 1rem; }
  .visibility-guide__sections > section { display: grid; grid-template-columns: 2.8rem minmax(0, 1fr); scroll-margin-top: 1rem; overflow: hidden; border: 1px solid var(--color-border); border-radius: .8rem; background: var(--color-surface); }
