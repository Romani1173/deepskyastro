---
import type { Lang } from '../i18n';

interface Props {
  lang: Lang;
  tool: 'visibility' | 'planning' | 'analyser' | 'my-night';
}

const { lang, tool } = Astro.props;
const copy = {
  ca: {
    question: 'T’ha estat útil aquesta eina?', yes: 'Sí, m’ha estat útil', no: 'No, cal millorar-la',
    reason: 'Què hauries de millorar?', confusing: 'El resultat no és clar',
    missing: 'Trobo a faltar una funció', broken: 'No ha funcionat com esperava',
    other: 'Un altre motiu', comment: 'Vols concretar-ho? (opcional)',
    send: 'Envia la valoració', thanks: 'Gràcies per ajudar-me a millorar aquesta eina.',
    change: 'Canvia la resposta', preview: 'Resum privat de la prova',
    note: 'Prototip local: només es desa una resposta per eina en aquest navegador. No s’envia res a Internet.',
    positive: 'positives', negative: 'negatives', empty: 'Sense resposta',
    tools: { visibility: 'Visibilitat', planning: 'Planificació', analyser: 'Analitzador', 'my-night': 'La meva nit' },
  },
  es: {
    question: '¿Te ha resultado útil esta herramienta?', yes: 'Sí, me ha resultado útil', no: 'No, podría mejorar',
    reason: '¿Qué debería mejorar?', confusing: 'El resultado no está claro',
    missing: 'Echo en falta una función', broken: 'No funcionó como esperaba',
    other: 'Otro motivo', comment: '¿Quieres concretarlo? (opcional)',
    send: 'Enviar valoración', thanks: 'Gracias por ayudarme a mejorar esta herramienta.',
    change: 'Cambiar respuesta', preview: 'Resumen privado de la prueba',
    note: 'Prototipo local: solo se guarda una respuesta por herramienta en este navegador. No se envía nada a Internet.',
    positive: 'positivos', negative: 'negativos', empty: 'Sin respuesta',
    tools: { visibility: 'Visibilidad', planning: 'Planificación', analyser: 'Analizador', 'my-night': 'Mi noche' },
  },
  en: {
    question: 'Was this tool useful to you?', yes: 'Yes, it was useful', no: 'No, it could be improved',
    reason: 'What should be improved?', confusing: 'The result is unclear',
    missing: 'A feature is missing', broken: 'It did not work as expected',
    other: 'Another reason', comment: 'Would you like to explain? (optional)',
    send: 'Send feedback', thanks: 'Thank you for helping me improve this tool.',
    change: 'Change response', preview: 'Private test summary',
    note: 'Local prototype: one response per tool is stored in this browser only. Nothing is sent online.',
    positive: 'positive', negative: 'negative', empty: 'No response',
    tools: { visibility: 'Visibility', planning: 'Planning', analyser: 'Equipment analyser', 'my-night': 'My night' },
  },
}[lang];
---

<section class="tool-feedback-demo" id={`feedback-${tool}`} data-tool-feedback={tool} data-lang={lang} aria-label={copy.question}>
  <p class="tool-feedback-demo__question">{copy.question}</p>
  <div class="tool-feedback-demo__choices" data-feedback-choices>
    <button type="button" data-feedback-vote="up" aria-label={copy.yes}><span aria-hidden="true">👍</span> {copy.yes}</button>
    <button type="button" data-feedback-vote="down" aria-label={copy.no}><span aria-hidden="true">👎</span> {copy.no}</button>
  </div>
  <form class="tool-feedback-demo__reason" data-feedback-form hidden>
    <fieldset>
      <legend>{copy.reason}</legend>
      <label><input type="radio" name="reason" value="confusing" required />{copy.confusing}</label>
      <label><input type="radio" name="reason" value="missing" />{copy.missing}</label>
      <label><input type="radio" name="reason" value="broken" />{copy.broken}</label>
      <label><input type="radio" name="reason" value="other" />{copy.other}</label>
    </fieldset>
    <label class="tool-feedback-demo__comment">{copy.comment}<textarea name="comment" rows="2" maxlength="500"></textarea></label>
    <button type="submit">{copy.send}</button>
  </form>
  <p class="tool-feedback-demo__thanks" data-feedback-thanks hidden>{copy.thanks} <button type="button" data-feedback-change>{copy.change}</button></p>
  <details class="tool-feedback-demo__preview">
    <summary>{copy.preview}</summary>
    <p>{copy.note}</p>
    <ul data-feedback-summary></ul>
  </details>
</section>

<script>
  type Vote = { vote: 'up' | 'down'; reason?: string; comment?: string };
  type Tool = 'visibility' | 'planning' | 'analyser' | 'my-night';
  const key = 'deepskyastro-feedback-demo-v1';
  const labels = {
    ca: { tools: { visibility: 'Visibilitat', planning: 'Planificació', analyser: 'Analitzador', 'my-night': 'La meva nit' }, empty: 'Sense resposta', reasons: { confusing: 'El resultat no és clar', missing: 'Trobo a faltar una funció', broken: 'No ha funcionat com esperava', other: 'Un altre motiu' } },
    es: { tools: { visibility: 'Visibilidad', planning: 'Planificación', analyser: 'Analizador', 'my-night': 'Mi noche' }, empty: 'Sin respuesta', reasons: { confusing: 'El resultado no está claro', missing: 'Echo en falta una función', broken: 'No funcionó como esperaba', other: 'Otro motivo' } },
    en: { tools: { visibility: 'Visibility', planning: 'Planning', analyser: 'Equipment analyser', 'my-night': 'My night' }, empty: 'No response', reasons: { confusing: 'The result is unclear', missing: 'A feature is missing', broken: 'It did not work as expected', other: 'Another reason' } },
  } as const;
  const tools: Tool[] = ['visibility', 'planning', 'analyser', 'my-night'];
  const read = (): Partial<Record<Tool, Vote>> => {
    try {
      const value = JSON.parse(localStorage.getItem(key) ?? '{}');
      return value && typeof value === 'object' && !Array.isArray(value) ? value : {};
    } catch { return {}; }
  };
  const save = (votes: Partial<Record<Tool, Vote>>) => {
    try { localStorage.setItem(key, JSON.stringify(votes)); } catch { /* The demo remains usable without storage. */ }
  };
  document.querySelectorAll<HTMLElement>('[data-tool-feedback]').forEach((root) => {
    const tool = root.dataset.toolFeedback as Tool;
    const lang = root.dataset.lang as keyof typeof labels;
    const choices = root.querySelector<HTMLElement>('[data-feedback-choices]')!;
    const form = root.querySelector<HTMLFormElement>('[data-feedback-form]')!;
    const thanks = root.querySelector<HTMLElement>('[data-feedback-thanks]')!;
    const list = root.querySelector<HTMLElement>('[data-feedback-summary]')!;
    const render = () => {
      const votes = read();
      choices.hidden = Boolean(votes[tool]);
      form.hidden = true;
      thanks.hidden = !votes[tool];
      list.replaceChildren(...tools.map((id) => {
        const item = document.createElement('li');
        const vote = votes[id];
        const reason = vote?.reason && vote.reason in labels[lang].reasons
          ? labels[lang].reasons[vote.reason as keyof typeof labels[typeof lang]['reasons']]
          : '';
        item.textContent = `${labels[lang].tools[id]}: ${vote ? (vote.vote === 'up' ? '👍 1 · 👎 0' : '👍 0 · 👎 1') : labels[lang].empty}${reason ? ` · ${reason}` : ''}${vote?.comment ? ` · “${vote.comment}”` : ''}`;
        return item;
      }));
    };
    root.querySelectorAll<HTMLButtonElement>('[data-feedback-vote]').forEach((button) => button.addEventListener('click', () => {
      if (button.dataset.feedbackVote === 'up') {
        save({ ...read(), [tool]: { vote: 'up' } });
        render();
      } else {
        choices.hidden = true;
        form.hidden = false;
        form.querySelector<HTMLInputElement>('input[name="reason"]')?.focus();
      }
    }));
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const values = new FormData(form);
      const reason = String(values.get('reason') ?? '');
      if (!reason) return;
      save({ ...read(), [tool]: { vote: 'down', reason, comment: String(values.get('comment') ?? '').trim() } });
      render();
    });
    root.querySelector<HTMLButtonElement>('[data-feedback-change]')!.addEventListener('click', () => {
      const votes = read();
      delete votes[tool];
      save(votes);
      form.reset();
      render();
    });
    window.addEventListener('storage', render);
    render();
  });
</script>

<style>
  .tool-feedback-demo{margin:1.5rem 0;padding:1.15rem 1.35rem;border:1px solid rgba(113,188,214,.42);border-radius:.8rem;background:linear-gradient(135deg,rgba(25,47,63,.75),rgba(15,23,38,.9));color:#e7f3f6}
  .tool-feedback-demo__question{margin:0 0 .85rem;font-size:1rem;font-weight:700}
  .tool-feedback-demo__choices{display:flex;flex-wrap:wrap;gap:.65rem}
  .tool-feedback-demo__choices button,.tool-feedback-demo__reason>button{padding:.55rem .8rem;border:1px solid #75c8e4;border-radius:.48rem;background:#102b3a;color:#e8f7fc;font:inherit;font-size:.82rem;font-weight:700;cursor:pointer}
  .tool-feedback-demo__choices button:hover,.tool-feedback-demo__reason>button:hover{background:#21475a}
  .tool-feedback-demo__choices button:focus-visible,.tool-feedback-demo__reason button:focus-visible,.tool-feedback-demo__thanks button:focus-visible{outline:2px solid #fff;outline-offset:3px}
  .tool-feedback-demo__reason{display:grid;gap:.75rem}
  .tool-feedback-demo__reason fieldset{display:grid;gap:.5rem;margin:0;padding:0;border:0}
  .tool-feedback-demo__reason legend{margin-bottom:.4rem;font-size:.82rem;font-weight:700}
  .tool-feedback-demo__reason label{display:flex;align-items:center;gap:.55rem;font-size:.82rem}
  .tool-feedback-demo__reason input{accent-color:#5bc6ef}
  .tool-feedback-demo__comment{display:grid!important;align-items:stretch!important;gap:.35rem!important}
  .tool-feedback-demo__comment textarea{width:100%;max-width:36rem;padding:.55rem;border:1px solid #6b94a3;border-radius:.4rem;background:#0a1624;color:#fff;font:inherit;resize:vertical}
  .tool-feedback-demo__reason>button{justify-self:start}
  .tool-feedback-demo__thanks{margin:0;font-size:.85rem}
  .tool-feedback-demo__thanks button{margin-left:.45rem;padding:0;border:0;background:transparent;color:#75d5f5;font:inherit;text-decoration:underline;cursor:pointer}
  .tool-feedback-demo__preview{margin-top:1rem;padding-top:.65rem;border-top:1px solid rgba(135,174,188,.25);font-size:.72rem;color:#b3cbd3}
  .tool-feedback-demo__preview summary{cursor:pointer}
  .tool-feedback-demo__preview p{margin:.6rem 0}
  .tool-feedback-demo__preview ul{margin:.4rem 0 0;padding-left:1.2rem}
  .tool-feedback-demo [hidden]{display:none!important}
  @media(max-width:520px){.tool-feedback-demo{padding:1rem}.tool-feedback-demo__choices{display:grid}.tool-feedback-demo__choices button{text-align:left}}
</style>
