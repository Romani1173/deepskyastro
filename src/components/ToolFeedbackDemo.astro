---
import type { Lang } from '../i18n';

interface Props {
  lang: Lang;
  tool: 'visibility' | 'planning' | 'analyser' | 'my-night';
  allowNegativeBack?: boolean;
}

const { lang, tool, allowNegativeBack = false } = Astro.props;
const feedbackApiUrl = import.meta.env.PUBLIC_FEEDBACK_API_URL ?? 'https://deepskyastro-feedback.jjromero1173.workers.dev';
const copy = {
  ca: {
    question: 'T’ha estat útil aquesta eina?', yes: 'Sí, m’ha estat útil', no: 'No, cal millorar-la',
    reason: 'Què hauries de millorar?', confusing: 'El resultat no és clar',
    missing: 'Trobo a faltar una funció', broken: 'No ha funcionat com esperava',
    other: 'Un altre motiu', comment: 'Vols concretar-ho? (opcional)',
    send: 'Envia la valoració', back: 'Torna sense valorar', thanks: 'Gràcies per ajudar-me a millorar aquesta eina.',
    change: 'Canvia la resposta', sending: 'Enviant…', error: 'No s’ha pogut enviar. Torna-ho a provar.',
  },
  es: {
    question: '¿Te ha resultado útil esta herramienta?', yes: 'Sí, me ha resultado útil', no: 'No, podría mejorar',
    reason: '¿Qué debería mejorar?', confusing: 'El resultado no está claro',
    missing: 'Echo en falta una función', broken: 'No funcionó como esperaba',
    other: 'Otro motivo', comment: '¿Quieres concretarlo? (opcional)',
    send: 'Enviar valoración', back: 'Volver sin valorar', thanks: 'Gracias por ayudarme a mejorar esta herramienta.',
    change: 'Cambiar respuesta', sending: 'Enviando…', error: 'No se ha podido enviar. Inténtalo de nuevo.',
  },
  en: {
    question: 'Was this tool useful to you?', yes: 'Yes, it was useful', no: 'No, it could be improved',
    reason: 'What should be improved?', confusing: 'The result is unclear',
    missing: 'A feature is missing', broken: 'It did not work as expected',
    other: 'Another reason', comment: 'Would you like to explain? (optional)',
    send: 'Send feedback', back: 'Go back without rating', thanks: 'Thank you for helping me improve this tool.',
    change: 'Change response', sending: 'Sending…', error: 'Your feedback could not be sent. Please try again.',
  },
}[lang];
---

<section class="tool-feedback-demo" id={`feedback-${tool}`} data-tool-feedback={tool} data-lang={lang} data-feedback-api={feedbackApiUrl} data-sending={copy.sending} data-error={copy.error} aria-label={copy.question}>
  <p class="tool-feedback-demo__question">{copy.question}</p>
  <div class="tool-feedback-demo__choices" data-feedback-choices>
    <button type="button" data-feedback-vote="up" aria-label={copy.yes}><span aria-hidden="true">👍</span> {copy.yes}</button>
    <button type="button" data-feedback-vote="down" aria-label={copy.no}><span aria-hidden="true">👎</span> {copy.no}</button>
  </div>
  <form class="tool-feedback-demo__reason" data-feedback-form hidden>
    <fieldset>
      <legend>{copy.reason}</legend>
      <label><input type="radio" name="reason" value="confusing" required />{copy.confusing}</label>
      <label><input type="radio" name="reason" value="missing" />{copy.missing}</label>
      <label><input type="radio" name="reason" value="broken" />{copy.broken}</label>
      <label><input type="radio" name="reason" value="other" />{copy.other}</label>
    </fieldset>
    <label class="tool-feedback-demo__comment">{copy.comment}<textarea name="comment" rows="2" maxlength="500"></textarea></label>
    <div class="tool-feedback-demo__form-actions">
      <button type="submit">{copy.send}</button>
      {allowNegativeBack && <button type="button" class="tool-feedback-demo__back" data-feedback-back>{copy.back}</button>}
    </div>
  </form>
  <p class="tool-feedback-demo__thanks" data-feedback-thanks hidden>{copy.thanks} <button type="button" data-feedback-change>{copy.change}</button></p>
  <p class="tool-feedback-demo__status" data-feedback-status role="status" hidden></p>
</section>

<script>
  type Vote = { vote: 'up' | 'down'; reason?: string; comment?: string; createdAt?: string };
  type Tool = 'visibility' | 'planning' | 'analyser' | 'my-night';
  const key = 'deepskyastro-feedback-v1';
  const visitorKey = 'deepskyastro-feedback-visitor-v1';
  const read = (): Partial<Record<Tool, Vote>> => {
    try {
      const value = JSON.parse(localStorage.getItem(key) ?? '{}');
      return value && typeof value === 'object' && !Array.isArray(value) ? value : {};
    } catch { return {}; }
  };
  const save = (votes: Partial<Record<Tool, Vote>>) => {
    try { localStorage.setItem(key, JSON.stringify(votes)); } catch { /* The form remains usable without storage. */ }
  };
  const visitorId = () => {
    try {
      const stored = localStorage.getItem(visitorKey);
      if (stored) return stored;
      const created = crypto.randomUUID().replaceAll('-', '');
      localStorage.setItem(visitorKey, created);
      return created;
    } catch {
      return crypto.randomUUID().replaceAll('-', '');
    }
  };
  document.querySelectorAll<HTMLElement>('[data-tool-feedback]').forEach((root) => {
    const tool = root.dataset.toolFeedback as Tool;
    const lang = root.dataset.lang ?? 'es';
    const apiUrl = root.dataset.feedbackApi ?? '';
    const choices = root.querySelector<HTMLElement>('[data-feedback-choices]')!;
    const form = root.querySelector<HTMLFormElement>('[data-feedback-form]')!;
    const thanks = root.querySelector<HTMLElement>('[data-feedback-thanks]')!;
    const status = root.querySelector<HTMLElement>('[data-feedback-status]')!;
    const controls = [...root.querySelectorAll<HTMLButtonElement>('button')];
    const setBusy = (busy: boolean) => controls.forEach((control) => { control.disabled = busy; });
    const showStatus = (message = '', error = false) => {
      status.textContent = message;
      status.hidden = !message;
      status.classList.toggle('is-error', error);
    };
    const request = async (method: 'POST' | 'DELETE', vote?: Vote) => {
      const response = await fetch(`${apiUrl}/v1/feedback`, {
        method,
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({
          visitorId: visitorId(), tool, language: lang, pagePath: location.pathname,
          website: '', ...(vote ?? {}),
        }),
      });
      if (!response.ok) throw new Error(`feedback_${response.status}`);
    };
    const render = () => {
      const votes = read();
      choices.hidden = Boolean(votes[tool]);
      form.hidden = true;
      thanks.hidden = !votes[tool];
    };
    root.querySelectorAll<HTMLButtonElement>('[data-feedback-vote]').forEach((button) => button.addEventListener('click', async () => {
      if (button.dataset.feedbackVote === 'up') {
        const vote: Vote = { vote: 'up', createdAt: new Date().toISOString() };
        setBusy(true);
        showStatus(root.dataset.sending);
        try {
          await request('POST', vote);
          save({ ...read(), [tool]: vote });
          showStatus();
          render();
        } catch {
          showStatus(root.dataset.error, true);
        } finally {
          setBusy(false);
        }
      } else {
        showStatus();
        choices.hidden = true;
        form.hidden = false;
        form.querySelector<HTMLInputElement>('input[name="reason"]')?.focus();
      }
    }));
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const values = new FormData(form);
      const reason = String(values.get('reason') ?? '');
      if (!reason) return;
      const vote: Vote = { vote: 'down', reason, comment: String(values.get('comment') ?? '').trim(), createdAt: new Date().toISOString() };
      setBusy(true);
      showStatus(root.dataset.sending);
      try {
        await request('POST', vote);
        save({ ...read(), [tool]: vote });
        showStatus();
        render();
      } catch {
        showStatus(root.dataset.error, true);
      } finally {
        setBusy(false);
      }
    });
    root.querySelector<HTMLButtonElement>('[data-feedback-back]')?.addEventListener('click', () => {
      form.reset();
      form.hidden = true;
      choices.hidden = false;
      showStatus();
      choices.querySelector<HTMLButtonElement>('[data-feedback-vote="down"]')?.focus();
    });
    root.querySelector<HTMLButtonElement>('[data-feedback-change]')!.addEventListener('click', async () => {
      setBusy(true);
      showStatus(root.dataset.sending);
      try {
        await request('DELETE');
        const votes = read();
        delete votes[tool];
        save(votes);
        form.reset();
        showStatus();
        render();
        choices.querySelector<HTMLButtonElement>('[data-feedback-vote="up"]')?.focus();
      } catch {
        showStatus(root.dataset.error, true);
      } finally {
        setBusy(false);
      }
    });
    window.addEventListener('storage', render);
    render();
  });
</script>

<style>
  .tool-feedback-demo{margin:1.5rem 0;padding:1.15rem 1.35rem;border:1px solid rgba(113,188,214,.42);border-radius:.8rem;background:linear-gradient(135deg,rgba(25,47,63,.75),rgba(15,23,38,.9));color:#e7f3f6}
  .tool-feedback-demo__question{margin:0 0 .85rem;font-size:1rem;font-weight:700}
  .tool-feedback-demo__choices{display:flex;flex-wrap:wrap;gap:.65rem}
  .tool-feedback-demo__choices button,.tool-feedback-demo__form-actions button{padding:.55rem .8rem;border:1px solid #75c8e4;border-radius:.48rem;background:#102b3a;color:#e8f7fc;font:inherit;font-size:.82rem;font-weight:700;cursor:pointer}
  .tool-feedback-demo__choices button:hover,.tool-feedback-demo__form-actions button:hover{background:#21475a}
  .tool-feedback-demo__choices button:focus-visible,.tool-feedback-demo__form-actions button:focus-visible,.tool-feedback-demo__thanks button:focus-visible{outline:2px solid #fff;outline-offset:3px}
  .tool-feedback-demo__reason{display:grid;gap:.75rem}
  .tool-feedback-demo__reason fieldset{display:grid;gap:.5rem;margin:0;padding:0;border:0}
  .tool-feedback-demo__reason legend{margin-bottom:.4rem;font-size:.82rem;font-weight:700}
  .tool-feedback-demo__reason label{display:flex;align-items:center;gap:.55rem;font-size:.82rem}
  .tool-feedback-demo__reason input{accent-color:#5bc6ef}
  .tool-feedback-demo__comment{display:grid!important;align-items:stretch!important;gap:.35rem!important}
  .tool-feedback-demo__comment textarea{width:100%;max-width:36rem;padding:.55rem;border:1px solid #6b94a3;border-radius:.4rem;background:#0a1624;color:#fff;font:inherit;resize:vertical}
  .tool-feedback-demo__form-actions{display:flex;flex-wrap:wrap;gap:.55rem}
  .tool-feedback-demo__form-actions .tool-feedback-demo__back{border-color:#617786;background:transparent;color:#b8cad2}
  .tool-feedback-demo__thanks{margin:0;font-size:.85rem}
  .tool-feedback-demo__thanks button{margin-left:.45rem;padding:0;border:0;background:transparent;color:#75d5f5;font:inherit;text-decoration:underline;cursor:pointer}
  .tool-feedback-demo:is([data-tool-feedback="visibility"],[data-tool-feedback="planning"],[data-tool-feedback="analyser"],[data-tool-feedback="my-night"]) .tool-feedback-demo__thanks button{display:inline-flex;align-items:center;justify-content:center;padding:.48rem .68rem;border:1px solid rgba(224,239,88,.78);border-radius:.52rem;background:rgba(224,239,88,.1);color:#eef879;font-size:.78rem;font-weight:700;line-height:1;text-decoration:none;transition:border-color .16s ease,background .16s ease,color .16s ease,transform .16s ease}
  .tool-feedback-demo:is([data-tool-feedback="visibility"],[data-tool-feedback="planning"],[data-tool-feedback="analyser"],[data-tool-feedback="my-night"]) .tool-feedback-demo__thanks button:hover,.tool-feedback-demo:is([data-tool-feedback="visibility"],[data-tool-feedback="planning"],[data-tool-feedback="analyser"],[data-tool-feedback="my-night"]) .tool-feedback-demo__thanks button:focus-visible{border-color:#eef879;background:rgba(224,239,88,.2);color:#f7ffad;text-decoration:none;transform:translateY(-1px)}
  .tool-feedback-demo__status{margin:.75rem 0 0;color:#b3cbd3;font-size:.75rem}.tool-feedback-demo__status.is-error{color:#ffaaaa}
  .tool-feedback-demo button:disabled{cursor:wait;opacity:.6}
  .tool-feedback-demo [hidden]{display:none!important}
  @media(max-width:520px){.tool-feedback-demo{padding:1rem}.tool-feedback-demo__choices{display:grid}.tool-feedback-demo__choices button{text-align:left}}
</style>
