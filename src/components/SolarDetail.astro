---
import type { CollectionEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import type { Lang } from '../i18n';
import { categoryHref, copy, homeHref, imageUseHref, localeFor, withBase } from '../i18n';
import { imageSizes, optimizedImage } from '../lib/optimized-images';
import { IMAGE_LICENSE, author, breadcrumbList, publicUrl, sunVariant } from '../lib/seo';

interface Props { foto: CollectionEntry<'sol'>; lang: Lang; }
const { foto, lang } = Astro.props;
const base = import.meta.env.BASE_URL;
const labels = {
	ca: { title: 'Fotografia del Sol', back: 'Tornar a Sol', enlarge: 'Ampliar', close: 'Tancar la imatge ampliada' },
	es: { title: 'Fotografía del Sol', back: 'Volver a Sol', enlarge: 'Ampliar', close: 'Cerrar la imagen ampliada' },
	en: { title: 'Photograph of the Sun', back: 'Back to Sun', enlarge: 'Enlarge', close: 'Close enlarged image' },
}[lang];
const date = new Intl.DateTimeFormat(localeFor(lang), { dateStyle: 'long', timeZone: 'UTC' }).format(foto.data.fecha);
const imageUrl = withBase(`imagenes/sol/${foto.data.imagen}`, base);
const comment = lang === 'ca'
	? foto.data.comentario
	: foto.data.traducciones?.[lang] ?? foto.data.comentario;
const variant = sunVariant(foto.id, lang);
const seoTitle = `${lang === 'en' ? 'Sun' : 'Sol'} · ${date}${variant ? ` (${variant})` : ''}`;
const seoDescription = (() => {
	const full = `${labels.title}, ${date}${variant ? ` (${variant})` : ''}. ${comment}`.replace(/\s+/g, ' ');
	return full.length <= 160 ? full : `${full.slice(0, 159).replace(/\s+\S*$/, '')}…`;
})();
const pageHref = lang === 'ca' ? withBase(`sol/${foto.id}/`, base) : withBase(`${lang}/${lang === 'en' ? 'sun' : 'sol'}/${foto.id}/`, base);
const structuredData = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'ImageObject', name: seoTitle, description: seoDescription, caption: comment, contentUrl: publicUrl(imageUrl, base), url: publicUrl(pageHref, base),
			inLanguage: lang, representativeOfPage: true, creator: author, creditText: author.name, copyrightHolder: author, copyrightNotice: `© ${author.name}`,
			license: IMAGE_LICENSE.url, acquireLicensePage: publicUrl(imageUseHref(lang, base), base),
			dateCreated: foto.data.fecha.toISOString().slice(0, 10),
		},
		breadcrumbList([[copy[lang].home, homeHref(lang, base)], [lang === 'en' ? 'Sun' : 'Sol', categoryHref(lang, 'sun', base)], [seoTitle, pageHref]], base),
	],
};
const languageLinks = {
	ca: withBase(`sol/${foto.id}/`, base),
	es: withBase(`es/sol/${foto.id}/`, base),
	en: withBase(`en/sun/${foto.id}/`, base),
};
---

<Layout title={seoTitle} description={seoDescription} image={imageUrl} structuredData={structuredData} ogType="article" minimal lang={lang} languageLinks={languageLinks}>
	<article class="photo-detail">
		<a class="back-link" href={categoryHref(lang, 'sun', base)}>← {labels.back}</a>
		<header class="page-heading"><h1>{labels.title}</h1><p>{date}</p></header>
		<div class="photo-detail__image">
			<button class="image-zoom-trigger" type="button" data-solar-enlarge aria-label={labels.enlarge}>
				<img {...optimizedImage(`sol/${foto.data.imagen}`, base)} sizes={imageSizes.detail} alt={`${labels.title}, ${date}`} fetchpriority="high" />
				<span aria-hidden="true">{labels.enlarge} ↗</span>
			</button>
		</div>
		<p class="photo-detail__summary">{comment}</p>
	</article>
	<dialog class="image-lightbox solar-detail-lightbox">
		<button class="image-lightbox__close" type="button" aria-label={labels.close}>×</button>
		<img src={imageUrl} alt={`${labels.title}, ${date}`} loading="lazy" />
	</dialog>
</Layout>

<script>
	const trigger = document.querySelector<HTMLButtonElement>('[data-solar-enlarge]');
	const lightbox = document.querySelector<HTMLDialogElement>('.solar-detail-lightbox');
	trigger?.addEventListener('click', () => lightbox?.showModal());
	lightbox?.querySelector<HTMLButtonElement>('.image-lightbox__close')?.addEventListener('click', () => lightbox.close());
	lightbox?.addEventListener('click', (event) => {
		if (event.target === lightbox) lightbox.close();
	});
</script>
