---
import Layout from '../layouts/Layout.astro';
import SessionToolLink from './SessionToolLink.astro';
import ToolFeedbackDemo from './ToolFeedbackDemo.astro';
import type { Lang } from '../i18n';
import { captureSequencerGuideHref, captureSequencerHref, languageLinks, sessionPreparationHref } from '../i18n';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const base = import.meta.env.BASE_URL;
const all = {
  ca: { title:'Seqüenciador de captura', eyebrow:'Preparació de la sessió', intro:'Calcula una seqüència de lights completa a partir del temps real disponible, incloent autofocus, dithering i canvis de filtre.', session:'Durada i exposició', hours:'Hores', minutes:'Minuts', exposure:'Exposició de cada light', iterations:'Iteracions iguals', filters:'Filtres i proporció', available:'Filtres disponibles', selected:'Distribució dels filtres seleccionats', filter:'Filtre', percentage:'Proporció', operations:'Operacions automàtiques', ditherEvery:'Dither cada', lights:'lights', ditherTime:'Temps addicional de dither', lightTime:'Lectura i preparació entre lights', afEvery:'Autofocus cada', afTime:'Durada de l’autofocus', filterTime:'Canvi de filtre i reenfocament', seconds:'s', result:'Seqüència resultant', integration:'Integració efectiva', duration:'Durada estimada', remaining:'Marge disponible', totalLights:'Lights totals', breakdown:'Desglossament de captures', perIteration:'Per iteració', totalIterations:'Total de {count} iteracions', overhead:'Temps auxiliar', autofocus:'Autofocus', dithers:'Dithers', readout:'Lectura i preparació', changes:'Canvis de filtre i reenfocament', initial:'Inclou l’autofocus inicial abans de fotografiar. El recompte de dither és global i continua en canviar de filtre.', incomplete:'Completa la durada, l’exposició i almenys un filtre.', short:'El temps disponible no permet completar una iteració amb tots els filtres.', approx:'Els percentatges són aproximats per conservar iteracions completes i iguals.', nina:'Estructura compatible amb blocs Smart Exposure de NINA i recompte global de dither.', summary:'Resum per configurar la seqüència' },
  es: { title:'Secuenciador de captura', eyebrow:'Preparación de la sesión', intro:'Calcula una secuencia de lights completa a partir del tiempo real disponible, incluyendo autofocus, dithering y cambios de filtro.', session:'Duración y exposición', hours:'Horas', minutes:'Minutos', exposure:'Exposición de cada light', iterations:'Iteraciones iguales', filters:'Filtros y proporción', available:'Filtros disponibles', selected:'Distribución de los filtros seleccionados', filter:'Filtro', percentage:'Proporción', operations:'Operaciones automáticas', ditherEvery:'Dither cada', lights:'lights', ditherTime:'Tiempo adicional de dither', lightTime:'Lectura y preparación entre lights', afEvery:'Autofocus cada', afTime:'Duración del autofocus', filterTime:'Cambio de filtro y reenfoque', seconds:'s', result:'Secuencia resultante', integration:'Integración efectiva', duration:'Duración estimada', remaining:'Margen disponible', totalLights:'Lights totales', breakdown:'Desglose de capturas', perIteration:'Por iteración', totalIterations:'Total de {count} iteraciones', overhead:'Tiempo auxiliar', autofocus:'Autofocus', dithers:'Dithers', readout:'Lectura y preparación', changes:'Cambios de filtro y reenfoque', initial:'Incluye el autofocus inicial antes de empezar a fotografiar. El contador de dither es global y continúa al cambiar de filtro.', incomplete:'Completa la duración, la exposición y al menos un filtro.', short:'El tiempo disponible no permite completar una iteración con todos los filtros.', approx:'Los porcentajes son aproximados para conservar iteraciones completas e iguales.', nina:'Estructura compatible con bloques Smart Exposure de NINA y contador global de dither.', summary:'Resumen para configurar la secuencia' },
  en: { title:'Capture sequencer', eyebrow:'Session preparation', intro:'Calculate a complete light-frame sequence from the actual time available, including autofocus, dithering and filter changes.', session:'Duration and exposure', hours:'Hours', minutes:'Minutes', exposure:'Exposure for each light', iterations:'Equal iterations', filters:'Filters and proportions', available:'Available filters', selected:'Selected filter distribution', filter:'Filter', percentage:'Proportion', operations:'Automatic operations', ditherEvery:'Dither every', lights:'lights', ditherTime:'Additional dither time', lightTime:'Readout and preparation between lights', afEvery:'Autofocus every', afTime:'Autofocus duration', filterTime:'Filter change and refocus', seconds:'s', result:'Resulting sequence', integration:'Effective integration', duration:'Estimated duration', remaining:'Time remaining', totalLights:'Total lights', breakdown:'Capture breakdown', perIteration:'Per iteration', totalIterations:'Total for {count} iterations', overhead:'Overhead', autofocus:'Autofocus', dithers:'Dithers', readout:'Readout and preparation', changes:'Filter changes and refocus', initial:'Includes the initial autofocus before imaging starts. The dither count is global and continues across filter changes.', incomplete:'Complete the duration, exposure and at least one filter.', short:'The available time cannot fit one iteration with every filter.', approx:'Percentages are approximate so every iteration remains complete and identical.', nina:'Compatible with NINA Smart Exposure blocks and a global dither count.', summary:'Sequence setup summary' },
} as const;
const t = all[lang];
const filters = [{id:'CLS',label:'CLS',tone:'cls'},{id:'R',label:'R',tone:'r'},{id:'G',label:'G',tone:'g'},{id:'B',label:'B',tone:'b'},{id:'Ha',label:'Hα',tone:'ha'},{id:'OIII',label:'OIII',tone:'oiii'},{id:'SII',label:'SII',tone:'sii'}];
const selected = new Map([['Ha',50],['OIII',30],['SII',20]]);
const modeText = {
  ca:{available:'Parteixo del temps disponible',nina:'Parteixo d’una seqüència NINA',ninaIntro:'Calcula la durada i l’hora final d’una seqüència NINA ja programada, incloent autofocus, dithering, canvis de filtre i el canvi de meridià opcional.',start:'Hora d’inici',meridian:'Incloure canvi de meridià',meridianHelp:'Bloc fix de 6 min, autofocus posterior inclòs',lightsPerIteration:'Lights per iteració',end:'Hora final',nextDay:'dia següent',exact:'Seqüència programada'},
  es:{available:'Parto del tiempo disponible',nina:'Parto de una secuencia NINA',ninaIntro:'Calcula la duración y la hora final de una secuencia NINA ya programada, incluyendo autofocus, dithering, cambios de filtro y el cambio de meridiano opcional.',start:'Hora de inicio',meridian:'Incluir cambio de meridiano',meridianHelp:'Bloque fijo de 6 min, autofocus posterior incluido',lightsPerIteration:'Lights por iteración',end:'Hora final',nextDay:'día siguiente',exact:'Secuencia programada'},
  en:{available:'Start from available time',nina:'Start from a NINA sequence',ninaIntro:'Calculate the duration and end time of an existing NINA sequence, including autofocus, dithering, filter changes and an optional meridian flip.',start:'Start time',meridian:'Include meridian flip',meridianHelp:'Fixed 6 min block including the subsequent autofocus',lightsPerIteration:'Lights per iteration',end:'End time',nextDay:'next day',exact:'Programmed sequence'},
}[lang];
const guideText = {
  ca:{label:'Guia del Seqüenciador de captura',tooltip:'Manual complet dels dos modes de càlcul'},
  es:{label:'Guía del Secuenciador de captura',tooltip:'Manual completo de los dos modos de cálculo'},
  en:{label:'Capture Sequencer guide',tooltip:'Complete guide to both calculation modes'},
}[lang];
---
<Layout title={t.title} description={t.intro} lang={lang} languageLinks={languageLinks.captureSequencer(base)} focused>
  <article class="capture-tool" data-capture-tool data-lang={lang} data-copy={JSON.stringify(t)} data-mode-copy={JSON.stringify(modeText)}>
    <SessionToolLink lang={lang} href={sessionPreparationHref(lang, base)} />
    <header class="capture-tool__header"><h1>{t.title}</h1><p data-mode-intro>{t.intro}</p><a class="capture-guide-link" href={captureSequencerGuideHref(lang, base)} title={guideText.tooltip}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3.5 5.5c3.2-.8 5.9-.3 8.5 1.6v12c-2.6-1.9-5.3-2.4-8.5-1.6zM20.5 5.5c-3.2-.8-5.9-.3-8.5 1.6v12c2.6-1.9 5.3-2.4 8.5-1.6z" /></svg><span>{guideText.label}</span></a></header>
    <nav class="capture-mode" aria-label={t.title}><button type="button" data-mode="available" aria-pressed="true">{modeText.available}</button><button type="button" data-mode="nina" aria-pressed="false">{modeText.nina}</button></nav>
    <a class="capture-feedback-shortcut" href="#feedback-capture-sequencer">{lang === 'ca' ? 'Valora aquesta eina ↓' : lang === 'es' ? 'Valorar esta herramienta ↓' : 'Rate this tool ↓'}</a>
    <div class="capture-tool__layout">
      <form class="capture-form" data-form>
        <fieldset><legend>01 · {t.operations}</legend><div class="field-grid field-grid--three">
          <label>{t.ditherEvery}<span><input name="ditherEvery" type="number" min="0" step="1" value="4" /><b>{t.lights}</b></span></label>
          <label>{t.ditherTime}<span><input name="ditherTime" type="number" min="0" step="1" value="22" /><b>{t.seconds}</b></span></label>
          <label>{t.lightTime}<span><input name="lightTime" type="number" min="0" step="1" value="6" /><b>{t.seconds}</b></span></label>
          <label>{t.afEvery}<span><input name="afEvery" type="number" min="1" step="1" value="60" /><b>min</b></span></label>
          <label>{t.afTime}<span><input name="afTime" type="number" min="0" step="1" value="235" /><b>{t.seconds}</b></span></label>
          <label>{t.filterTime}<span><input name="filterTime" type="number" min="0" step="1" value="5" /><b>{t.seconds}</b></span></label>
        </div><p class="form-note">{t.initial}</p></fieldset>
        <fieldset><legend>02 · {t.session}</legend><div class="field-grid field-grid--four">
          <label data-available-only>{t.hours}<span><input name="hours" type="number" min="0" max="24" step="1" value="6" /></span></label>
          <label data-available-only>{t.minutes}<span><input name="minutes" type="number" min="0" max="59" step="1" value="0" /></span></label>
          <label data-nina-only hidden>{modeText.start}<span><input name="startTime" type="time" value="21:00" /></span></label>
          <label>{t.exposure}<span><input name="exposure" type="number" min="10" step="10" value="300" /><b>{t.seconds}</b></span></label>
          <label>{t.iterations}<span><input name="iterations" type="number" min="1" max="50" step="1" value="3" /></span></label>
          <label class="meridian-option" data-nina-only hidden><span><input name="meridian" type="checkbox" />{modeText.meridian}</span><small>{modeText.meridianHelp}</small></label>
        </div></fieldset>
        <fieldset><legend>03 · {t.filters}</legend><h3 class="filter-heading">{t.available}</h3><div class="filter-choices" data-filter-choices>{filters.map((filter)=><label class="filter-choice" data-tone={filter.tone}><input type="checkbox" value={filter.id} data-filter-toggle checked={selected.has(filter.id)} /><span aria-hidden="true">✓</span><strong>{filter.label}</strong></label>)}</div><h3 class="filter-heading filter-heading--selected">{t.selected}</h3><div class="filter-list" data-filters>{filters.map((filter)=><div class="filter-row" data-filter-row data-filter-id={filter.id} data-tone={filter.tone} hidden={!selected.has(filter.id)}><strong>{filter.label}</strong><label data-percentage-control><span>{t.percentage}</span><span><input type="number" min="1" max="100" step="1" value={selected.get(filter.id) ?? 1} /><b>%</b></span></label><label data-lights-control hidden><span>{modeText.lightsPerIteration}</span><span><input type="number" min="1" step="1" value="5" /><b>{t.lights}</b></span></label></div>)}</div><p class="percentage-total" data-percentage-total-box><span>Total</span><strong data-percentage-total>100 %</strong></p></fieldset>
      </form>
      <aside class="capture-result" aria-live="polite"><header><span>04</span><h2>{t.result}</h2></header><p data-status></p><div data-result hidden>
        <div class="result-metrics"><section><span>{t.totalLights}</span><strong data-total-lights></strong></section><section><span>{t.integration}</span><strong data-integration></strong></section><section><span>{t.duration}</span><strong data-duration></strong></section><section><span data-final-label>{t.remaining}</span><strong data-remaining></strong></section></div>
        <section class="sequence-card"><h3>{t.breakdown}</h3><h4>{t.perIteration}</h4><div data-allocation></div><h4 data-total-iterations></h4><div data-allocation-total></div><p data-sequence-note>{t.approx}</p></section>
        <section class="overhead-card"><h3>{t.overhead}</h3><dl><div><dt>{t.autofocus}</dt><dd data-autofocus></dd></div><div><dt>{t.dithers}</dt><dd data-dithers></dd></div><div><dt>{t.readout}</dt><dd data-readout></dd></div><div><dt>{t.changes}</dt><dd data-changes></dd></div><div data-meridian-result hidden><dt>{modeText.meridian}</dt><dd>1× → 6 min 0 s</dd></div></dl></section>
      </div></aside>
    </div>
    <ToolFeedbackDemo lang={lang} tool="capture-sequencer" allowNegativeBack />
  </article>
</Layout>
<script>
  import { calculateCaptureSequence, simulateCapture } from '../lib/capture-sequencer.mjs';
  document.querySelectorAll<HTMLElement>('[data-capture-tool]').forEach((root) => {
    const form=root.querySelector<HTMLFormElement>('[data-form]')!, list=root.querySelector<HTMLElement>('[data-filters]')!, t=JSON.parse(root.dataset.copy||'{}'),modeCopy=JSON.parse(root.dataset.modeCopy||'{}');
    let mode='available';
    const operationNames=['ditherEvery','ditherTime','lightTime','afEvery','afTime','filterTime'];
    const operationStorageKey='deepskyastro:capture-sequencer:operations:v2';
    const sequenceStorageKey='deepskyastro:capture-sequencer:sequence:v1';
    try{const saved=JSON.parse(localStorage.getItem(operationStorageKey)||'{}');for(const name of operationNames){const field=form.elements.namedItem(name) as HTMLInputElement|null,value=Number(saved[name]);if(field&&Number.isFinite(value)&&value>=0)field.value=String(value)}}catch{}
    const saveOperations=()=>{const values=Object.fromEntries(operationNames.map((name)=>[name,Number((form.elements.namedItem(name) as HTMLInputElement).value)]));try{localStorage.setItem(operationStorageKey,JSON.stringify(values))}catch{}};
    let savedSequence:any=null;
    try{savedSequence=JSON.parse(localStorage.getItem(sequenceStorageKey)||'null')}catch{}
    const saveSequence=()=>{const fields=Object.fromEntries([...form.querySelectorAll<HTMLInputElement>('input[name]')].map((input)=>[input.name,input.type==='checkbox'?input.checked:input.value]));const filterState=Object.fromEntries([...list.querySelectorAll<HTMLElement>('[data-filter-row]')].map((row)=>{const id=row.dataset.filterId||'',toggle=root.querySelector<HTMLInputElement>(`[data-filter-toggle][value="${id}"]`),percentage=row.querySelector<HTMLInputElement>('[data-percentage-control] input'),lights=row.querySelector<HTMLInputElement>('[data-lights-control] input');return [id,{selected:Boolean(toggle?.checked),percentage:percentage?.value,lights:lights?.value}]}));try{localStorage.setItem(sequenceStorageKey,JSON.stringify({mode,fields,filters:filterState}))}catch{}};
    const num=(name:string)=>Number(new FormData(form).get(name));
    const duration=(seconds:number)=>{const s=Math.max(0,Math.round(seconds)),h=Math.floor(s/3600),m=Math.floor(s%3600/60),r=s%60;return [h&&`${h} h`,(m||h)&&`${m} min`,`${r} s`].filter(Boolean).join(' ')};
    const compactDuration=(seconds:number)=>{const s=Math.max(0,Math.round(seconds)),h=Math.floor(s/3600),m=Math.floor(s%3600/60),r=s%60;return [h&&`${h} h`,m&&`${m} min`,r&&`${r} s`].filter(Boolean).join(' ')||'0 s'};
    const operationDuration=(seconds:number)=>{const s=Math.max(0,Math.round(seconds)),h=Math.floor(s/3600),m=Math.floor(s%3600/60),r=s%60;return [h&&`${h} h`,(m||h)&&`${m} min`,`${r} s`].filter(Boolean).join(' ')};
    const filterLabel=(id:string)=>root.querySelector<HTMLInputElement>(`[data-filter-toggle][value="${id}"]`)?.closest('label')?.querySelector('strong')?.textContent||id;
    const visibleFilterRows=()=>[...list.querySelectorAll<HTMLElement>('[data-filter-row]:not([hidden])')];
    const percentageInput=(row:HTMLElement)=>row.querySelector<HTMLInputElement>('input[type=number]')!;
    let percentageLimitTimer=0;
    const showPercentageLimit=()=>{const box=root.querySelector<HTMLElement>('[data-percentage-total-box]');if(!box)return;box.classList.add('is-limit');window.clearTimeout(percentageLimitTimer);percentageLimitTimer=window.setTimeout(()=>box.classList.remove('is-limit'),2200)};
    const refreshPercentageTotal=()=>{const total=visibleFilterRows().reduce((sum,row)=>sum+(Number(percentageInput(row).value)||0),0);const totalNode=root.querySelector<HTMLElement>('[data-percentage-total]');if(totalNode)totalNode.textContent=`${total} %`};
    const constrainPercentage=(input:HTMLInputElement)=>{const row=input.closest<HTMLElement>('[data-filter-row]');if(!row||row.hidden)return;const others=visibleFilterRows().filter(item=>item!==row).reduce((sum,item)=>sum+(Number(percentageInput(item).value)||0),0);const maximum=Math.max(1,100-others),requested=Math.round(Number(input.value)||1);if(requested>maximum)showPercentageLimit();input.value=String(Math.min(maximum,Math.max(1,requested)));refreshPercentageTotal()};
    const render=()=>{
      const rows=visibleFilterRows();
      const filters=rows.map((row)=>({id:row.dataset.filterId||'',name:filterLabel(row.dataset.filterId||''),weight:Number(row.querySelector<HTMLInputElement>('[data-percentage-control] input')?.value)})).filter(x=>x.name&&x.weight>0);
      const common={exposureSeconds:num('exposure'),iterations:num('iterations'),ditherEvery:num('ditherEvery'),ditherDurationSeconds:num('ditherTime'),lightOverheadSeconds:num('lightTime'),autofocusIntervalSeconds:num('afEvery')*60,autofocusDurationSeconds:num('afTime'),filterChangeSeconds:num('filterTime')};
      let result:any;
      if(mode==='available') result=calculateCaptureSequence({...common,totalSeconds:num('hours')*3600+num('minutes')*60,filters});
      else{
        const allocation=rows.map((row)=>({id:row.dataset.filterId||'',name:filterLabel(row.dataset.filterId||''),count:Number(row.querySelector<HTMLInputElement>('[data-lights-control] input')?.value)||0})).filter(item=>item.count>0);
        const simulation=allocation.length?simulateCapture(common,allocation):null;
        const meridian=(form.elements.namedItem('meridian') as HTMLInputElement).checked?360:0;
        result=simulation?{valid:true,iterations:num('iterations'),allocation,...simulation,elapsedSeconds:simulation.elapsedSeconds+meridian,remainingSeconds:0,meridianSeconds:meridian}:{valid:false,reason:'incomplete'};
      }
      const panel=root.querySelector<HTMLElement>('[data-result]')!,status=root.querySelector<HTMLElement>('[data-status]')!;
      panel.hidden=!result.valid;status.hidden=Boolean(result.valid);
      if(!result.valid){status.textContent=result.reason==='too-short'?t.short:t.incomplete;return}
      const set=(sel:string,value:string)=>{root.querySelector<HTMLElement>(sel)!.textContent=value};
      set('[data-total-lights]',String(result.lights));set('[data-integration]',duration(result.integrationSeconds));set('[data-duration]',duration(result.elapsedSeconds));
      const finalLabel=root.querySelector<HTMLElement>('[data-final-label]')!;
      if(mode==='available'){finalLabel.textContent=t.remaining;set('[data-remaining]',duration(result.remainingSeconds))}else{const start=(form.elements.namedItem('startTime') as HTMLInputElement).value||'00:00',[h,m]=start.split(':').map(Number),total=h*3600+m*60+Math.round(result.elapsedSeconds),day=Math.floor(total/86400),withinDay=total%86400,clock=`${String(Math.floor(withinDay/3600)).padStart(2,'0')}:${String(Math.floor(withinDay%3600/60)).padStart(2,'0')}:${String(withinDay%60).padStart(2,'0')}`;finalLabel.textContent=modeCopy.end;set('[data-remaining]',`${clock}${day?` · ${modeCopy.nextDay}`:''}`)}
      set('[data-autofocus]',`${result.autofocusCount}× → ${operationDuration(result.autofocusSeconds)}`);
      set('[data-dithers]',`${result.ditherCount}× → ${operationDuration(result.ditherSeconds)}`);
      set('[data-readout]',`${result.lightOverheadCount}× → ${operationDuration(result.lightOverheadSeconds)}`);
      set('[data-changes]',`${result.filterChangeCount}× → ${operationDuration(result.filterChangeSeconds)}`);
      root.querySelector<HTMLElement>('[data-allocation]')!.innerHTML=result.allocation.map((filter:any)=>`<div><strong>${filter.name}:&nbsp;&nbsp;</strong><span>${filter.count}×${num('exposure')} s</span><i>→</i><b>${filter.count} lights</b><i>→</i><em>${compactDuration(filter.count*num('exposure'))}</em></div>`).join('');
      root.querySelector<HTMLElement>('[data-total-iterations]')!.textContent=t.totalIterations.replace('{count}',String(result.iterations));
      root.querySelector<HTMLElement>('[data-allocation-total]')!.innerHTML=result.allocation.map((filter:any)=>{const total=filter.count*result.iterations;return `<div><strong>${filter.name}:&nbsp;&nbsp;</strong><span>${total}×${num('exposure')} s</span><i>→</i><b>${total} lights</b><i>→</i><em>${compactDuration(total*num('exposure'))}</em></div>`}).join('');
      root.querySelector<HTMLElement>('[data-meridian-result]')!.hidden=!(mode==='nina'&&result.meridianSeconds);
    };
    const setMode=(next:string)=>{mode=next;root.querySelectorAll<HTMLButtonElement>('[data-mode]').forEach(button=>button.setAttribute('aria-pressed',String(button.dataset.mode===mode)));root.querySelectorAll<HTMLElement>('[data-available-only]').forEach(item=>item.hidden=mode!=='available');root.querySelectorAll<HTMLElement>('[data-nina-only]').forEach(item=>item.hidden=mode!=='nina');root.querySelectorAll<HTMLElement>('[data-percentage-control]').forEach(item=>item.hidden=mode!=='available');root.querySelectorAll<HTMLElement>('[data-lights-control]').forEach(item=>item.hidden=mode!=='nina');root.querySelector<HTMLElement>('[data-percentage-total-box]')!.hidden=mode!=='available';root.querySelector<HTMLElement>('[data-sequence-note]')!.textContent=mode==='nina'?modeCopy.exact:t.approx;root.querySelector<HTMLElement>('[data-mode-intro]')!.textContent=mode==='nina'?modeCopy.ninaIntro:t.intro;render();saveSequence()};
    if(savedSequence?.fields)for(const [name,value] of Object.entries(savedSequence.fields)){if(operationNames.includes(name))continue;const input=form.elements.namedItem(name) as HTMLInputElement|null;if(input){if(input.type==='checkbox')input.checked=Boolean(value);else input.value=String(value)}}
    if(savedSequence?.filters)for(const [id,state] of Object.entries<any>(savedSequence.filters)){const row=list.querySelector<HTMLElement>(`[data-filter-row][data-filter-id="${id}"]`),toggle=root.querySelector<HTMLInputElement>(`[data-filter-toggle][value="${id}"]`);if(!row||!toggle)continue;toggle.checked=Boolean(state.selected);row.hidden=!toggle.checked;const percentage=row.querySelector<HTMLInputElement>('[data-percentage-control] input'),lights=row.querySelector<HTMLInputElement>('[data-lights-control] input');if(percentage&&state.percentage)percentage.value=state.percentage;if(lights&&state.lights)lights.value=state.lights}
    root.querySelectorAll<HTMLButtonElement>('[data-mode]').forEach(button=>button.addEventListener('click',()=>setMode(button.dataset.mode||'available')));
    root.querySelectorAll<HTMLInputElement>('[data-filter-toggle]').forEach((toggle)=>toggle.addEventListener('change',()=>{const row=list.querySelector<HTMLElement>(`[data-filter-row][data-filter-id="${toggle.value}"]`);if(!row)return;if(toggle.checked){percentageInput(row).value='5';const currentTotal=visibleFilterRows().reduce((sum,item)=>sum+(Number(percentageInput(item).value)||0),0);if(currentTotal+5>100){const donor=visibleFilterRows().filter(item=>item!==row&&Number(percentageInput(item).value)>5).sort((a,b)=>Number(percentageInput(b).value)-Number(percentageInput(a).value))[0];if(donor)percentageInput(donor).value=String(Number(percentageInput(donor).value)-5)}row.hidden=false}else row.hidden=true;refreshPercentageTotal();render();saveSequence()}));list.querySelectorAll<HTMLInputElement>('[data-percentage-control] input').forEach((input)=>input.addEventListener('input',()=>constrainPercentage(input)));for(const name of operationNames){const field=form.elements.namedItem(name) as HTMLInputElement|null;field?.addEventListener('input',saveOperations);field?.addEventListener('change',saveOperations)}form.addEventListener('input',()=>{render();saveSequence()});form.addEventListener('change',()=>{render();saveSequence()});refreshPercentageTotal();setMode(savedSequence?.mode==='nina'?'nina':'available');
  });
</script>
<style>
.capture-feedback-shortcut{display:inline-flex;align-items:center;justify-content:center;margin:0 0 1rem;padding:.52rem .72rem;border:1px solid rgba(224,239,88,.78);border-radius:.6rem;background:rgba(224,239,88,.1);color:#eef879;font-size:.78rem;font-weight:700;line-height:1;text-decoration:none;transition:border-color .16s ease,background .16s ease,color .16s ease,transform .16s ease}
