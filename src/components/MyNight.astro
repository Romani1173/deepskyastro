---
import Layout from '../layouts/Layout.astro';
import type { Lang } from '../i18n';
import { languageLinks, myNightGuideHref, myNightHref, sessionPreparationHref } from '../i18n';
import objectsData from '../data/astronomical-objects.json';
import { PUBLIC_PENDING_OBJECTS } from '../config/features';
import { formatCatalogDesignations } from '../lib/catalog-formatting.mjs';
import { getCollection } from 'astro:content';
import { photoText } from '../photoTranslations';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const base = import.meta.env.BASE_URL;
const texts = {
  ca: { title: 'La meva nit', intro: 'Reuneix els objectius de la sessió i decideix quins filtres vols dedicar a cadascun. L’ordre astronòmic segons visibilitat i Lluna s’afegirà en el pas següent.', back: 'Torna a Prepara la teva sessió', session: '1 · La sessió', date: 'Nit que planifiques', ready: 'A punt per fotografiar', readyHelp: 'Equip en estació, fitxers de correcció preparats i càmeres refredades.', finish: 'Finalitza les captures', finishHelp: 'Moment d’apagar les càmeres. Reserva després el temps necessari per tancar i guardar l’equip.', equipment: '2 · Equip', smart: 'Telescopi intel·ligent', osc: 'Càmera OSC', mono: 'Càmera monocroma', filters: 'Filtres disponibles aquesta nit', targets: '3 · Cistella d’objectius', search: 'Cerca un objecte', placeholder: 'M 31, NGC 7000, nebulosa…', add: 'Afegeix a La meva nit', empty: 'La cistella encara és buida.', selectAll: 'Tots', clearAll: 'Cap', remove: 'Elimina', summary: 'Resum provisional', duration: 'Temps disponible', combinations: 'Combinacions objecte + filtre', next: 'Ordena la cistella per altura i incidència de la Lluna.', createPlan: 'Crea el pla de la meva nit', plan: '4 · Ordre de la nit', reference: 'Càlcul provisional per al centre de Catalunya.', altitude: 'altura', moonDistance: 'Lluna', recalculate: 'Recalcula el pla', hours: 'h', noFilter: 'Captura en color' },
  es: { title: 'Mi noche', intro: 'Reúne los objetivos de la sesión y decide qué filtros quieres dedicar a cada uno. El orden astronómico según visibilidad y Luna se añadirá en el siguiente paso.', back: 'Volver a Prepara tu sesión', session: '1 · La sesión', date: 'Noche que planificas', ready: 'Listo para fotografiar', readyHelp: 'Equipo puesto en estación, ficheros de corrección preparados y cámaras enfriadas.', finish: 'Finalizar las capturas', finishHelp: 'Momento de apagar las cámaras. Reserva después el tiempo necesario para cerrar y guardar el equipo.', equipment: '2 · Equipo', smart: 'Telescopio inteligente', osc: 'Cámara OSC', mono: 'Cámara monocroma', filters: 'Filtros disponibles esta noche', targets: '3 · Cesta de objetivos', search: 'Buscar un objeto', placeholder: 'M 31, NGC 7000, nebulosa…', add: 'Añadir a Mi noche', empty: 'La cesta todavía está vacía.', selectAll: 'Todos', clearAll: 'Ninguno', remove: 'Eliminar', summary: 'Resumen provisional', duration: 'Tiempo disponible', combinations: 'Combinaciones objeto + filtro', next: 'Ordena la cesta por altura e incidencia de la Luna.', createPlan: 'Crear el plan de mi noche', plan: '4 · Orden de la noche', reference: 'Cálculo provisional para el centro de Cataluña.', altitude: 'altura', moonDistance: 'Luna', recalculate: 'Recalcular el plan', hours: 'h', noFilter: 'Captura en color' },
  en: { title: 'My night', intro: 'Collect the session targets and choose which filters to use for each one. Astronomical ordering by visibility and Moon will be added in the next step.', back: 'Back to Prepare your session', session: '1 · The session', date: 'Night being planned', ready: 'Ready to photograph', readyHelp: 'Equipment polar aligned, correction files prepared and cameras cooled.', finish: 'Finish captures', finishHelp: 'Time to switch off the cameras. Allow extra time afterwards to close and pack the equipment.', equipment: '2 · Equipment', smart: 'Smart telescope', osc: 'OSC camera', mono: 'Monochrome camera', filters: 'Filters available tonight', targets: '3 · Target basket', search: 'Find a target', placeholder: 'M 31, NGC 7000, nebula…', add: 'Add to My night', empty: 'The basket is still empty.', selectAll: 'All', clearAll: 'None', remove: 'Remove', summary: 'Preliminary summary', duration: 'Available time', combinations: 'Target + filter combinations', next: 'Order the basket by altitude and Moon impact.', createPlan: 'Create my night plan', plan: '4 · Night order', reference: 'Provisional calculation for central Catalonia.', altitude: 'altitude', moonDistance: 'Moon', recalculate: 'Recalculate plan', hours: 'h', noFilter: 'Colour capture' },
} as const;
const sourceTexts = {
  ca: { equipmentHelp: 'Tria un únic tipus de càmera per a tota la sessió.', local: 'Llista local', simbad: 'SIMBAD', simbadSearch: 'Nom o catàleg', resolve: 'Resol', resolving: 'Resolent…', resolved: 'Objecte resolt', simbadHelp: 'SIMBAD aporta el nom i les coordenades per planificar aquesta nit.', simbadError: 'SIMBAD no ha pogut resoldre aquest objecte.', targetCount: 'objectius', targetLimit: 'Has arribat al màxim de 4 objectius per nit.', previousWeek: 'Setmana anterior', nextWeek: 'Setmana següent', weekIso: 'Setmana ISO', month: 'Mes', selectedDay: 'Dia seleccionat', threshold: 'Llindar d\'altura', previousDay: 'Dia anterior', nextDay: 'Dia següent', scoringTitle: 'Puntuació dels objectius', scoringOrder: 'El pla divideix la sessió en trams iguals i, al centre de cada tram, ordena els objectius pendents per altura i incidència de la Lluna.', scoringThreshold: 'Un objecte situat per sota del llindar seleccionat rep una penalització forta. Llindar actual:', scoringMoon: 'La penalització lunar combina proximitat, fracció il·luminada i sensibilitat del filtre. Si la Lluna és sota l\'horitzó, la penalització és zero.', scoringWeights: 'Pes lunar: B 34 · L/color 30 · G 24 · R 15 · OIII 7 · Hα 4 · SII 4.', comparison: 'Comparació de visibilitat', objectCurve: 'Objecte', moonCurve: 'Lluna', selectedSlot: 'Tram seleccionat', invalidSlot: 'Tram no vàlid', whyHere: 'Per què aquí?', chosenReason: 'Al centre del tram ({time}) era l’objectiu pendent amb millor puntuació: altura {altitude}° davant del llindar de {threshold}° i incidència lunar {moon}.', invalidReason: 'És la millor opció pendent a les {time}, però no és vàlida: altura {altitude}° davant del llindar de {threshold}°. Incidència lunar {moon}.', moonLow: 'baixa', moonMedium: 'mitjana', moonHigh: 'alta' },
  es: { equipmentHelp: 'Selecciona un único tipo de cámara para toda la sesión.', local: 'Lista local', simbad: 'SIMBAD', simbadSearch: 'Nombre o catálogo', resolve: 'Resolver', resolving: 'Resolviendo…', resolved: 'Objeto resuelto', simbadHelp: 'SIMBAD aporta el nombre y las coordenadas para planificar esta noche.', simbadError: 'SIMBAD no ha podido resolver este objeto.', targetCount: 'objetivos', targetLimit: 'Has alcanzado el máximo de 4 objetivos por noche.', previousWeek: 'Semana anterior', nextWeek: 'Semana siguiente', weekIso: 'Semana ISO', month: 'Mes', selectedDay: 'Día seleccionado', threshold: 'Umbral de altura', previousDay: 'Día anterior', nextDay: 'Día siguiente', scoringTitle: 'Puntuación de objetivos', scoringOrder: 'El plan divide la sesión en tramos iguales y, en el centro de cada tramo, ordena los objetivos pendientes por altura e incidencia de la Luna.', scoringThreshold: 'Un objeto situado por debajo del umbral seleccionado recibe una penalización fuerte. Umbral actual:', scoringMoon: 'La penalización lunar combina proximidad, fracción iluminada y sensibilidad del filtro. Si la Luna está bajo el horizonte, la penalización es cero.', scoringWeights: 'Peso lunar: B 34 · L/color 30 · G 24 · R 15 · OIII 7 · Hα 4 · SII 4.', comparison: 'Comparación de visibilidad', objectCurve: 'Objeto', moonCurve: 'Luna', selectedSlot: 'Tramo seleccionado', invalidSlot: 'Tramo no válido', whyHere: '¿Por qué aquí?', chosenReason: 'En el centro del tramo ({time}) era el objetivo pendiente con mejor puntuación: altura {altitude}° frente al umbral de {threshold}° e incidencia lunar {moon}.', invalidReason: 'Es la mejor opción pendiente a las {time}, pero no es válida: altura {altitude}° frente al umbral de {threshold}°. Incidencia lunar {moon}.', moonLow: 'baja', moonMedium: 'media', moonHigh: 'alta' },
  en: { equipmentHelp: 'Choose one camera type for the whole session.', local: 'Local list', simbad: 'SIMBAD', simbadSearch: 'Name or catalogue', resolve: 'Resolve', resolving: 'Resolving…', resolved: 'Resolved target', simbadHelp: 'SIMBAD provides the name and coordinates needed to plan this night.', simbadError: 'SIMBAD could not resolve this target.', targetCount: 'targets', targetLimit: 'You have reached the maximum of 4 targets per night.', previousWeek: 'Previous week', nextWeek: 'Next week', weekIso: 'ISO week', month: 'Month', selectedDay: 'Selected day', threshold: 'Altitude threshold', previousDay: 'Previous day', nextDay: 'Next day', scoringTitle: 'Target scoring', scoringOrder: 'The plan divides the session into equal slots and, at each slot midpoint, ranks the remaining targets by altitude and Moon impact.', scoringThreshold: 'A target below the selected altitude threshold receives a strong penalty. Current threshold:', scoringMoon: 'The lunar penalty combines proximity, illuminated fraction and filter sensitivity. It is zero while the Moon is below the horizon.', scoringWeights: 'Lunar weight: B 34 · L/colour 30 · G 24 · R 15 · OIII 7 · Hα 4 · SII 4.', comparison: 'Visibility comparison', objectCurve: 'Target', moonCurve: 'Moon', selectedSlot: 'Selected slot', invalidSlot: 'Invalid slot', whyHere: 'Why here?', chosenReason: 'At the slot midpoint ({time}) it was the highest-scoring pending target: altitude {altitude}° versus a {threshold}° threshold, with {moon} Moon impact.', invalidReason: 'It is the best pending option at {time}, but it is not valid: altitude {altitude}° versus a {threshold}° threshold. Moon impact is {moon}.', moonLow: 'low', moonMedium: 'medium', moonHigh: 'high' },
} as const;
const t = { ...texts[lang], ...sourceTexts[lang] };
const guideLinkText = {
  ca: { label: 'Guia de La meva nit', tooltip: 'Obre la guia completa de La meva nit' },
  es: { label: 'Guía de Mi noche', tooltip: 'Abre la guía completa de Mi noche' },
  en: { label: 'My Night guide', tooltip: 'Open the complete My Night guide' },
}[lang];
const explanationText = {
  ca: { comparison: 'La següent alternativa era {target}, a {altitude}°.', only: 'No quedaven altres objectius pendents.', noneValid: 'Cap dels objectius pendents arribava al llindar.' },
  es: { comparison: 'La siguiente alternativa era {target}, a {altitude}°.', only: 'No quedaban otros objetivos pendientes.', noneValid: 'Ninguno de los objetivos pendientes alcanzaba el umbral.' },
  en: { comparison: 'The next alternative was {target}, at {altitude}°.', only: 'No other targets remained.', noneValid: 'None of the pending targets reached the threshold.' },
}[lang];
const lunarWeightHelp = {
  ca: {
    values: 'Penalització lunar màxima que es pot restar segons el filtre: B −34 punts · L/color −30 · G −24 · R −15 · OIII −7 · Hα −4 · SII −4.',
    meaning: 'Com més alt és el valor, més sensible és el filtre a la Lluna. Només s’aplica tota la penalització amb la Lluna visible, molt il·luminada i molt a prop de l’objecte; disminueix quan la separació augmenta o la fase és menor, i és zero quan la Lluna és sota l’horitzó.',
  },
  es: {
    values: 'Penalización lunar máxima que puede restarse según el filtro: B −34 puntos · L/color −30 · G −24 · R −15 · OIII −7 · Hα −4 · SII −4.',
    meaning: 'Cuanto mayor es el valor, más sensible es el filtro a la Luna. La penalización completa solo se aplica con la Luna visible, muy iluminada y muy próxima al objeto; disminuye al aumentar la separación o reducirse la fase, y es cero cuando la Luna está bajo el horizonte.',
  },
  en: {
    values: 'Maximum lunar penalty that may be subtracted by filter: B −34 points · L/colour −30 · G −24 · R −15 · OIII −7 · Hα −4 · SII −4.',
    meaning: 'The larger the value, the more Moon-sensitive the filter is. The full penalty applies only when the Moon is visible, strongly illuminated and very close to the target; it decreases with greater separation or a smaller phase, and is zero while the Moon is below the horizon.',
  },
}[lang];
const photos = await getCollection('fotos');
const latestPhotoByObject = new Map<string, (typeof photos)[number]>();
for (const photo of [...photos].sort((a, b) => b.data.entorn.data.valueOf() - a.data.entorn.data.valueOf())) {
  if (photo.data.objecte_astronomic && !latestPhotoByObject.has(photo.data.objecte_astronomic)) latestPhotoByObject.set(photo.data.objecte_astronomic, photo);
}
const photoAlias = (id: string, catalogName: string) => {
  const photo = latestPhotoByObject.get(id);
  if (!photo) return undefined;
  const localizedName = photoText(photo, lang).objecte;
  const escapedCatalog = [...catalogName.replace(/\s+/g, '')].map((character) => character.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')).join('\\s*');
  const alias = localizedName.replace(new RegExp(`^\\s*${escapedCatalog}(?:\\s*\\((?:HOO|SHO|Hα|NN)\\))?\\s*(?:[–—,:-]\\s*)?`, 'i'), '').trim();
  return alias || undefined;
};
const objects = objectsData
  .filter((object) => import.meta.env.DEV || PUBLIC_PENDING_OBJECTS || object.status === 'photographed')
  .map((object) => {
    const commonName = formatCatalogDesignations(object.commonNames?.[lang] ?? photoAlias(object.id, object.catalogName));
    return { id: object.id, catalogName: object.catalogName, commonName, label: `${formatCatalogDesignations(object.catalogName)}${commonName ? ` · ${commonName}` : ''}`, raDeg: object.raDeg, decDeg: object.decDeg, source: object.status === 'pending' ? 'pending' : 'gallery' };
  })
  .sort((a, b) => a.label.localeCompare(b.label, lang, { numeric: true }));
const clientData = JSON.stringify({ lang, texts: { ...t, explanation: explanationText }, objects }).replace(/</g, '\\u003c');
---

<Layout title={t.title} description={t.intro} lang={lang} languageLinks={languageLinks.myNight(base)} focused>
  <main class="my-night" data-my-night>
    <a class="my-night__back" href={sessionPreparationHref(lang, base)}>← {t.back}</a>
    <header class="my-night__header"><h1>{t.title}</h1><span>{t.intro}</span></header>
    <div class="my-night__help-row">
      <details class="my-night__scoring my-night__scoring--guide">
        <summary>
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 10.5v6M12 7.5h.01" /></svg>
          <span>{t.scoringTitle}</span>
        </summary>
        <div>
          <p>{t.scoringOrder}</p>
          <p>{t.scoringThreshold} <strong><output data-scoring-threshold>30</output>°</strong></p>
          <p>{t.scoringMoon}</p>
          <p class="my-night__scoring-weights"><strong>{lunarWeightHelp.values}</strong><span>{lunarWeightHelp.meaning}</span></p>
        </div>
      </details>
      <a class="my-night__guide-link" href={myNightGuideHref(lang, base)} title={guideLinkText.tooltip}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3.5 5.5c3.2-.8 5.9-.3 8.5 1.6v12c-2.6-1.9-5.3-2.4-8.5-1.6zM20.5 5.5c-3.2-.8-5.9-.3-8.5 1.6v12c2.6-1.9 5.3-2.4 8.5-1.6z" /></svg><span>{guideLinkText.label}</span></a>
    </div>
    <div class="my-night__grid">
      <section class="my-night__panel my-night__panel--session">
        <h2>{t.session}</h2>
        <div class="my-night__fields">
          <div class="my-night__date-field" aria-label={t.date}>
            <input class="my-night__date-input" type="date" data-night-date tabindex="-1" aria-hidden="true" />
            <div class="my-night__period-head">
              <label><span>{t.weekIso}</span><span class="my-night__stepper"><button type="button" data-week-step="-1" aria-label={t.previousWeek}>‹</button><output data-week-number></output><button type="button" data-week-step="1" aria-label={t.nextWeek}>›</button></span></label>
              <label><span>{t.month}</span><output class="my-night__period-value" data-month></output></label>
              <label><span>{t.threshold}</span><span class="my-night__threshold"><input type="number" min="0" max="90" step="5" value="30" data-altitude-threshold /><b>°</b></span></label>
            </div>
            <label class="my-night__selected-day"><span>{t.selectedDay}</span><span class="my-night__stepper my-night__stepper--day"><button type="button" data-day-step="-1" aria-label={t.previousDay}>‹</button><output data-selected-day></output><button type="button" data-day-step="1" aria-label={t.nextDay}>›</button></span></label>
            <div class="my-night__week-strip">
              <div data-night-days></div>
            </div>
          </div>
          <label><span class="my-night__field-title">{t.ready}<button class="my-night__info" type="button" aria-label={t.readyHelp} data-tooltip={t.readyHelp}><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 10.5v6M12 7.5h.01" /></svg></button></span><input type="time" value="21:30" data-ready /></label>
          <label><span class="my-night__field-title">{t.finish}<button class="my-night__info" type="button" aria-label={t.finishHelp} data-tooltip={t.finishHelp}><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 10.5v6M12 7.5h.01" /></svg></button></span><input type="time" value="03:00" data-finish /></label>
        </div>
      </section>

      <section class="my-night__panel my-night__panel--equipment">
        <h2>{t.equipment}</h2>
        <div class="my-night__equipment" data-equipment>
          <label><input type="radio" name="equipment" value="smart" checked /><span>{t.smart}</span></label>
          <label><input type="radio" name="equipment" value="osc" /><span>{t.osc}</span></label>
          <label><input type="radio" name="equipment" value="mono" /><span>{t.mono}</span></label>
        </div>
        <small class="my-night__equipment-help">{t.equipmentHelp}</small>
        <div class="my-night__global-filters" data-global-filters hidden>
          <strong>{t.filters}</strong>
          <div>{['L','R','G','B','Hα','OIII','SII'].map((filter) => <label><input type="checkbox" value={filter} checked /><span>{filter}</span></label>)}</div>
        </div>
      </section>

      <section class="my-night__panel my-night__panel--basket">
        <div class="my-night__basket-heading"><h2>{t.targets}</h2><span data-target-count>0/4 {t.targetCount}</span></div>
        <nav class="my-night__sources" aria-label={t.targets}>
          <button type="button" data-object-mode="local" aria-pressed="true">{t.local}</button>
          <button type="button" data-object-mode="simbad" aria-pressed="false">{t.simbad}</button>
        </nav>
        <div data-object-panel="local">
          <form class="my-night__picker" data-picker autocomplete="off">
            <div class="my-night__object-picker">
              <label><span>{t.search}</span><input name="localAstronomicalObject" type="search" placeholder={t.placeholder} data-object-search autocomplete="off" autocapitalize="off" spellcheck="false" aria-autocomplete="list" aria-controls="my-night-object-results" aria-expanded="false" /></label>
              <div class="my-night__object-results" id="my-night-object-results" data-object-results role="listbox" hidden></div>
            </div>
            <button type="submit" data-add-local>+ {t.add}</button>
          </form>
        </div>
        <div class="my-night__simbad" data-object-panel="simbad" hidden>
          <form class="my-night__picker" data-simbad-form autocomplete="off">
            <label><span>{t.simbadSearch}</span><input name="simbadAstronomicalObject" type="search" placeholder="NGC 7000, LDN 1235…" data-simbad-query autocomplete="off" autocapitalize="off" spellcheck="false" /></label>
            <button type="submit" data-resolve-simbad>{t.resolve}</button>
          </form>
          <small>{t.simbadHelp}</small>
          <div class="my-night__simbad-result" data-simbad-result hidden><strong data-simbad-name></strong><span data-simbad-coordinates></span><button type="button" data-add-simbad>+ {t.add}</button></div>
          <p class="my-night__simbad-error" data-simbad-error hidden>{t.simbadError}</p>
        </div>
        <p class="my-night__limit" data-target-limit hidden>{t.targetLimit}</p>
        <p class="my-night__empty" data-empty>{t.empty}</p>
        <div class="my-night__basket" data-basket></div>
      </section>

      <aside class="my-night__summary">
        <h2>{t.summary}</h2>
        <dl><div><dt>{t.duration}</dt><dd data-duration>—</dd></div><div><dt>{t.combinations}</dt><dd data-combinations>0</dd></div></dl>
        <p>{t.next}</p>
        <button type="button" data-create-plan disabled>{t.createPlan}</button>
      </aside>

      <section class="my-night__panel my-night__plan" data-plan hidden>
        <header><div><h2>{t.plan}</h2><p>{t.reference}</p></div></header>
        <div class="my-night__plan-settings">
          <label><span>{t.selectedDay}</span><input type="date" data-plan-date /></label>
          <label><span>{t.threshold}</span><span class="my-night__plan-threshold"><input type="number" min="0" max="90" step="5" data-plan-threshold /><b>°</b></span></label>
          <button type="button" data-recalculate>{t.recalculate}</button>
        </div>
        <div class="my-night__timeline" data-timeline></div>
        <div class="my-night__plan-charts" data-plan-charts></div>
        <ol class="my-night__schedule" data-schedule></ol>
      </section>
    </div>
  </main>
</Layout>

<script type="application/json" id="my-night-data" set:html={clientData}></script>
<script>
  import { findLocalObject, resolveSimbad } from '../lib/planning/simbad.mjs';
  import { sampleInstant } from '../lib/planning/engine.mjs';
  const config = JSON.parse(document.querySelector('#my-night-data')?.textContent ?? '{}');
  const root = document.querySelector<HTMLElement>('[data-my-night]');
  if (!root) throw new Error('My night interface not found');
  const date = root.querySelector<HTMLInputElement>('[data-night-date]')!;
  const nightDays = root.querySelector<HTMLElement>('[data-night-days]')!;
  const weekNumber = root.querySelector<HTMLOutputElement>('[data-week-number]')!;
  const month = root.querySelector<HTMLOutputElement>('[data-month]')!;
  const selectedDay = root.querySelector<HTMLOutputElement>('[data-selected-day]')!;
  const altitudeThreshold = root.querySelector<HTMLInputElement>('[data-altitude-threshold]')!;
  const scoringThreshold = root.querySelector<HTMLOutputElement>('[data-scoring-threshold]')!;
  const ready = root.querySelector<HTMLInputElement>('[data-ready]')!;
  const finish = root.querySelector<HTMLInputElement>('[data-finish]')!;
  const globalFilters = root.querySelector<HTMLElement>('[data-global-filters]')!;
  const picker = root.querySelector<HTMLFormElement>('[data-picker]')!;
  const addLocal = root.querySelector<HTMLButtonElement>('[data-add-local]')!;
  const search = root.querySelector<HTMLInputElement>('[data-object-search]')!;
  const objectResults = root.querySelector<HTMLElement>('[data-object-results]')!;
  const simbadForm = root.querySelector<HTMLFormElement>('[data-simbad-form]')!;
  const simbadQuery = root.querySelector<HTMLInputElement>('[data-simbad-query]')!;
  const simbadButton = root.querySelector<HTMLButtonElement>('[data-resolve-simbad]')!;
  const simbadResult = root.querySelector<HTMLElement>('[data-simbad-result]')!;
  const simbadName = root.querySelector<HTMLElement>('[data-simbad-name]')!;
  const simbadCoordinates = root.querySelector<HTMLElement>('[data-simbad-coordinates]')!;
  const simbadError = root.querySelector<HTMLElement>('[data-simbad-error]')!;
  const addSimbad = root.querySelector<HTMLButtonElement>('[data-add-simbad]')!;
  const basket = root.querySelector<HTMLElement>('[data-basket]')!;
  const targetCount = root.querySelector<HTMLElement>('[data-target-count]')!;
  const targetLimit = root.querySelector<HTMLElement>('[data-target-limit]')!;
  const empty = root.querySelector<HTMLElement>('[data-empty]')!;
  const duration = root.querySelector<HTMLElement>('[data-duration]')!;
  const combinations = root.querySelector<HTMLElement>('[data-combinations]')!;
  const createPlan = root.querySelector<HTMLButtonElement>('[data-create-plan]')!;
  const plan = root.querySelector<HTMLElement>('[data-plan]')!;
  const timeline = root.querySelector<HTMLElement>('[data-timeline]')!;
  const planCharts = root.querySelector<HTMLElement>('[data-plan-charts]')!;
  const schedule = root.querySelector<HTMLOListElement>('[data-schedule]')!;
  const planDate = root.querySelector<HTMLInputElement>('[data-plan-date]')!;
  const planThreshold = root.querySelector<HTMLInputElement>('[data-plan-threshold]')!;
  const recalculate = root.querySelector<HTMLButtonElement>('[data-recalculate]')!;
  type NightTarget = { id:string; label:string; filters:string[]; raDeg?:number; decDeg?:number; source?:string };
  const MAX_TARGETS = 4;
  let items: NightTarget[] = [];
  let selectedLocal: any = null;
  let resolvedSimbad: { displayName:string; canonicalName?:string; raDeg:number; decDeg:number; source:string; localObjectId?:string } | null = null;
  const isoDate = (value:Date) => `${value.getFullYear()}-${String(value.getMonth() + 1).padStart(2, '0')}-${String(value.getDate()).padStart(2, '0')}`;
  const parseDate = (value:string) => { const [year, month, day] = value.split('-').map(Number); return new Date(year, month - 1, day, 12); };
  const today = new Date();
  date.value = isoDate(today);
  let visibleWeek = parseDate(date.value);
  const isoWeek = (value:Date) => {
    const day = new Date(Date.UTC(value.getFullYear(), value.getMonth(), value.getDate()));
    day.setUTCDate(day.getUTCDate() + 4 - (day.getUTCDay() || 7));
    const yearStart = new Date(Date.UTC(day.getUTCFullYear(), 0, 1));
    return Math.ceil((((day.getTime() - yearStart.getTime()) / 86400000) + 1) / 7);
  };
  const selectNight = (day:Date) => {
    date.value = isoDate(day);
    visibleWeek = new Date(day);
    renderNightDays();
    invalidatePlan();
    render();
  };
  const renderNightDays = () => {
    const monday = new Date(visibleWeek);
    monday.setDate(monday.getDate() - ((monday.getDay() + 6) % 7));
    const weekday = new Intl.DateTimeFormat(config.lang, { weekday: 'short' });
    const selected = parseDate(date.value);
    weekNumber.textContent = String(isoWeek(monday));
    month.textContent = new Intl.DateTimeFormat(config.lang, { month: 'short' }).format(selected).replace('.', '');
    const selectedLabel = new Intl.DateTimeFormat(config.lang, { weekday: 'long', day: 'numeric', month: 'long' }).format(selected);
    selectedDay.textContent = `${selectedLabel.charAt(0).toLocaleUpperCase(config.lang)}${selectedLabel.slice(1)}`;
    nightDays.replaceChildren();
    for (let offset = 0; offset < 7; offset += 1) {
      const day = new Date(monday); day.setDate(monday.getDate() + offset);
      const value = isoDate(day);
      const button = document.createElement('button');
      button.type = 'button'; button.dataset.nightValue = value;
      button.setAttribute('aria-pressed', String(value === date.value));
      button.innerHTML = `<span>${weekday.format(day).replace('.', '')}</span><strong>${day.getDate()}</strong>`;
      button.addEventListener('click', () => selectNight(day));
      nightDays.append(button);
    }
  };
  root.querySelectorAll<HTMLButtonElement>('[data-week-step]').forEach((button) => button.addEventListener('click', () => { const day = parseDate(date.value); day.setDate(day.getDate() + Number(button.dataset.weekStep) * 7); selectNight(day); }));
  root.querySelectorAll<HTMLButtonElement>('[data-day-step]').forEach((button) => button.addEventListener('click', () => { const day = parseDate(date.value); day.setDate(day.getDate() + Number(button.dataset.dayStep)); selectNight(day); }));
  const equipment = () => root.querySelector<HTMLInputElement>('input[name="equipment"]:checked')?.value ?? 'smart';
  const availableFilters = () => equipment() === 'mono' ? [...globalFilters.querySelectorAll<HTMLInputElement>('input:checked')].map((input) => input.value) : [config.texts.noFilter];
  const updateSummary = () => {
    const [rh, rm] = ready.value.split(':').map(Number), [fh, fm] = finish.value.split(':').map(Number);
    let minutes = fh * 60 + fm - (rh * 60 + rm); if (minutes <= 0) minutes += 1440;
    duration.textContent = `${Math.floor(minutes / 60)} ${config.texts.hours} ${String(minutes % 60).padStart(2, '0')} min`;
    combinations.textContent = String(equipment() === 'mono' ? items.reduce((total, item) => total + item.filters.length, 0) : items.length);
    createPlan.disabled = items.length === 0 || (equipment() === 'mono' && items.every((item) => item.filters.length === 0));
  };
  const invalidatePlan = () => { plan.hidden = true; timeline.replaceChildren(); planCharts.replaceChildren(); schedule.replaceChildren(); };
  const updateScoringThreshold = () => { scoringThreshold.value = altitudeThreshold.value; };
  altitudeThreshold.addEventListener('input', () => { updateScoringThreshold(); invalidatePlan(); render(); });
  const STORAGE_KEY = 'deepskyastro:my-night:v1';
  const persistState = () => {
    try {
      sessionStorage.setItem(STORAGE_KEY, JSON.stringify({
        date: date.value,
        ready: ready.value,
        finish: finish.value,
        altitudeThreshold: altitudeThreshold.value,
        equipment: equipment(),
        globalFilters: [...globalFilters.querySelectorAll<HTMLInputElement>('input:checked')].map((input) => input.value),
        items,
      }));
    } catch (error) { console.warn('Could not preserve My night state', error); }
  };
  const restoreState = () => {
    try {
      const saved = JSON.parse(sessionStorage.getItem(STORAGE_KEY) ?? 'null');
      if (!saved || typeof saved !== 'object') return;
      if (typeof saved.date === 'string' && /^\d{4}-\d{2}-\d{2}$/.test(saved.date)) date.value = saved.date;
      if (typeof saved.ready === 'string' && /^\d{2}:\d{2}$/.test(saved.ready)) ready.value = saved.ready;
      if (typeof saved.finish === 'string' && /^\d{2}:\d{2}$/.test(saved.finish)) finish.value = saved.finish;
      const savedThreshold = Number(saved.altitudeThreshold);
      if (Number.isFinite(savedThreshold) && savedThreshold >= 0 && savedThreshold <= 90) altitudeThreshold.value = String(savedThreshold);
      if (['smart', 'osc', 'mono'].includes(saved.equipment)) {
        const equipmentInput = root.querySelector<HTMLInputElement>(`input[name="equipment"][value="${saved.equipment}"]`);
        if (equipmentInput) equipmentInput.checked = true;
      }
      if (Array.isArray(saved.globalFilters)) globalFilters.querySelectorAll<HTMLInputElement>('input').forEach((input) => { input.checked = saved.globalFilters.includes(input.value); });
      if (Array.isArray(saved.items)) items = saved.items.slice(0, MAX_TARGETS).flatMap((savedItem:any) => {
        if (!savedItem || typeof savedItem.id !== 'string' || typeof savedItem.label !== 'string') return [];
        const local = config.objects.find((object:any) => object.id === savedItem.id);
        return [{
          id: savedItem.id,
          label: local?.label ?? savedItem.label,
          filters: Array.isArray(savedItem.filters) ? savedItem.filters.filter((filter:any) => typeof filter === 'string') : [],
          raDeg: typeof local?.raDeg === 'number' ? local.raDeg : savedItem.raDeg,
          decDeg: typeof local?.decDeg === 'number' ? local.decDeg : savedItem.decDeg,
          source: local?.source ?? savedItem.source,
        }];
      });
      globalFilters.hidden = equipment() !== 'mono';
    } catch (error) { console.warn('Could not restore My night state', error); }
  };
  const render = () => {
    empty.hidden = items.length > 0;
    targetCount.textContent = `${items.length}/${MAX_TARGETS} ${config.texts.targetCount}`;
    const full = items.length >= MAX_TARGETS;
    addLocal.disabled = full;
    addSimbad.disabled = full;
    if (!full) targetLimit.hidden = true;
    basket.innerHTML = '';
    items.forEach((item) => {
      const article = document.createElement('article'); article.className = 'my-night-item';
      const header = document.createElement('header'); const title = document.createElement('strong'); title.textContent = item.label;
      const remove = document.createElement('button'); remove.type = 'button'; remove.textContent = config.texts.remove; remove.addEventListener('click', () => { items = items.filter((entry) => entry.id !== item.id); invalidatePlan(); render(); });
      header.append(title, remove); article.append(header);
      if (equipment() === 'mono') {
        const actions = document.createElement('div'); actions.className = 'my-night-item__actions';
        const all = document.createElement('button'); all.type = 'button'; all.textContent = config.texts.selectAll; all.addEventListener('click', () => { item.filters = availableFilters(); invalidatePlan(); render(); });
        const none = document.createElement('button'); none.type = 'button'; none.textContent = config.texts.clearAll; none.addEventListener('click', () => { item.filters = []; invalidatePlan(); render(); }); actions.append(all, none); article.append(actions);
        const filterBox = document.createElement('div'); filterBox.className = 'my-night-item__filters'; availableFilters().forEach((filter:string) => { const label = document.createElement('label'), input = document.createElement('input'), span = document.createElement('span'); input.type = 'checkbox'; input.checked = item.filters.includes(filter); span.textContent = filter; input.addEventListener('change', () => { item.filters = input.checked ? [...new Set([...item.filters, filter])] : item.filters.filter((value) => value !== filter); invalidatePlan(); updateSummary(); persistState(); }); label.append(input, span); filterBox.append(label); }); article.append(filterBox);
      }
      basket.append(article);
    });
    updateSummary();
    persistState();
  };
  root.querySelectorAll<HTMLInputElement>('input[name="equipment"]').forEach((input) => input.addEventListener('change', () => { globalFilters.hidden = equipment() !== 'mono'; const filters = availableFilters(); items.forEach((item) => item.filters = [...filters]); invalidatePlan(); render(); }));
  globalFilters.querySelectorAll<HTMLInputElement>('input').forEach((input) => input.addEventListener('change', () => { const filters = availableFilters(); items.forEach((item) => item.filters = item.filters.filter((filter) => filters.includes(filter))); invalidatePlan(); render(); }));
  const addTarget = (target: NightTarget) => {
    if (items.some((item) => item.id === target.id)) return false;
    if (items.length >= MAX_TARGETS) { targetLimit.hidden = false; return false; }
    items.push(target); invalidatePlan(); render();
    targetLimit.hidden = items.length < MAX_TARGETS;
    return true;
  };
  const normalizeSearch = (value:string) => value.normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-zA-Z0-9]+/g, '').toLocaleLowerCase();
  const matchingLocalObjects = (showAll = false) => { const query = normalizeSearch(search.value); return showAll || !query ? config.objects : config.objects.filter((object:any) => normalizeSearch(`${object.label} ${object.catalogName} ${object.id}`).includes(query)); };
  const closeObjectResults = () => { objectResults.hidden = true; search.setAttribute('aria-expanded', 'false'); };
  const chooseLocalObject = (object:any) => { selectedLocal = object; search.value = object.label; closeObjectResults(); };
  const renderObjectResults = (showAll = false) => {
    objectResults.replaceChildren();
    matchingLocalObjects(showAll).forEach((object:any) => { const button = document.createElement('button'); button.type = 'button'; button.role = 'option'; button.textContent = object.label; button.addEventListener('pointerdown', (event) => event.preventDefault()); button.addEventListener('click', () => chooseLocalObject(object)); objectResults.append(button); });
    objectResults.hidden = false; search.setAttribute('aria-expanded', 'true');
  };
  search.addEventListener('focus', () => renderObjectResults(true));
  search.addEventListener('pointerdown', () => renderObjectResults(true));
  search.addEventListener('input', () => { selectedLocal = null; renderObjectResults(); });
  search.addEventListener('keydown', (event) => { if (event.key === 'Escape') closeObjectResults(); if (event.key === 'ArrowDown') { event.preventDefault(); objectResults.querySelector<HTMLButtonElement>('button')?.focus(); } if (event.key === 'Enter') { const first = matchingLocalObjects()[0]; if (first) { event.preventDefault(); chooseLocalObject(first); } } });
  search.addEventListener('blur', () => window.setTimeout(closeObjectResults, 120));
  picker.addEventListener('submit', (event) => { event.preventDefault(); const object = selectedLocal ?? matchingLocalObjects()[0]; if (!object) return; if (addTarget({ id: object.id, label: object.label, filters: availableFilters(), raDeg: object.raDeg, decDeg: object.decDeg, source: object.source })) { selectedLocal = null; search.value = ''; closeObjectResults(); } });
  root.querySelectorAll<HTMLButtonElement>('[data-object-mode]').forEach((button) => button.addEventListener('click', () => { const mode = button.dataset.objectMode; root.querySelectorAll<HTMLButtonElement>('[data-object-mode]').forEach((entry) => entry.setAttribute('aria-pressed', String(entry === button))); root.querySelectorAll<HTMLElement>('[data-object-panel]').forEach((panel) => panel.hidden = panel.dataset.objectPanel !== mode); }));
  simbadQuery.addEventListener('input', () => { resolvedSimbad = null; simbadResult.hidden = true; simbadError.hidden = true; });
  simbadForm.addEventListener('submit', async (event) => {
    event.preventDefault(); const query = simbadQuery.value.trim(); if (!query) return;
    simbadButton.disabled = true; simbadButton.textContent = config.texts.resolving; simbadResult.hidden = true; simbadError.hidden = true;
    try {
      const local = findLocalObject(config.objects, query);
      resolvedSimbad = local ? { displayName: local.label, canonicalName: local.catalogName, raDeg: local.raDeg, decDeg: local.decDeg, source: local.source, localObjectId: local.id } : await resolveSimbad(query);
      simbadName.textContent = `${config.texts.resolved}: ${resolvedSimbad.displayName}`;
      simbadCoordinates.textContent = `AR ${resolvedSimbad.raDeg.toFixed(6)}° · Dec ${resolvedSimbad.decDeg.toFixed(6)}°`;
      simbadResult.hidden = false;
    } catch (error) { console.error(error); simbadError.hidden = false; }
    finally { simbadButton.disabled = false; simbadButton.textContent = config.texts.resolve; }
  });
  const clearSimbad = () => {
    resolvedSimbad = null;
    simbadQuery.value = '';
    simbadName.textContent = '';
    simbadCoordinates.textContent = '';
    simbadResult.hidden = true;
    simbadError.hidden = true;
  };
  addSimbad.addEventListener('click', () => {
    if (!resolvedSimbad) return;
    if (addTarget({ id: resolvedSimbad.localObjectId ?? `simbad:${resolvedSimbad.canonicalName ?? resolvedSimbad.displayName}`, label: resolvedSimbad.displayName, filters: availableFilters(), raDeg: resolvedSimbad.raDeg, decDeg: resolvedSimbad.decDeg, source: resolvedSimbad.source })) {
      clearSimbad();
      simbadQuery.focus();
    }
  });
  const centralCatalonia = { name: 'Catalunya central', latitudeDeg: 41.7, longitudeDeg: 1.5, elevationM: 0 };
  const sessionBounds = () => {
    const start = new Date(`${date.value}T${ready.value}:00`);
    const end = new Date(`${date.value}T${finish.value}:00`);
    if (end <= start) end.setDate(end.getDate() + 1);
    return { start, end };
  };
  function makeComparisonChart(item:NightTarget, selectedSlots:{ start:Date; end:Date; valid:boolean }[] = []) {
    const figure = document.createElement('figure');
    figure.className = 'my-night-chart';
    figure.setAttribute('aria-label', `${config.texts.comparison}: ${item.label}`);
    if (typeof item.raDeg !== 'number' || typeof item.decDeg !== 'number') return figure;
    const { start, end } = sessionBounds();
    const sampleCount = 25;
    const readings = Array.from({ length: sampleCount }, (_, index) => {
      const instant = new Date(start.getTime() + ((end.getTime() - start.getTime()) * index) / (sampleCount - 1));
      return { instant, ...sampleInstant({ date: instant, location: centralCatalonia, object: item }) };
    });
    const width = 320, height = 160, left = 28, right = 10, top = 16, bottom = 28;
    const plotWidth = width - left - right, plotHeight = height - top - bottom;
    const x = (index:number) => left + (index / (sampleCount - 1)) * plotWidth;
    const y = (altitude:number) => top + ((90 - Math.max(-10, Math.min(90, altitude))) / 100) * plotHeight;
    const path = (key:'objectAltitudeDeg'|'moonAltitudeDeg') => readings.map((reading:any, index) => `${index ? 'L' : 'M'}${x(index).toFixed(1)},${y(reading[key]).toFixed(1)}`).join(' ');
    const timeX = (instant:Date) => left + ((instant.getTime() - start.getTime()) / (end.getTime() - start.getTime())) * plotWidth;
    const slotBands = selectedSlots.map((slot) => {
      const bandStart = Math.max(left, timeX(slot.start));
      const bandEnd = Math.min(width - right, timeX(slot.end));
      return `<rect class="my-night-chart__selected-slot${slot.valid ? '' : ' is-invalid'}" x="${bandStart.toFixed(1)}" y="${top}" width="${Math.max(0, bandEnd - bandStart).toFixed(1)}" height="${plotHeight}"/>`;
    }).join('');
    const thresholdY = y(Number(altitudeThreshold.value));
    const grid = [0,30,60,90].map((value) => `<line x1="${left}" y1="${y(value)}" x2="${width-right}" y2="${y(value)}"/><text x="${left-5}" y="${y(value)+3}" text-anchor="end">${value}°</text>`).join('');
    figure.innerHTML = `<figcaption><strong data-chart-title></strong><small>${config.texts.comparison}</small><span><i class="my-night-chart__object"></i>${config.texts.objectCurve}<i class="my-night-chart__moon"></i>${config.texts.moonCurve}<i class="my-night-chart__threshold"></i>${config.texts.threshold}<i class="my-night-chart__slot"></i>${config.texts.selectedSlot}<i class="my-night-chart__slot my-night-chart__slot--invalid"></i>${config.texts.invalidSlot}</span></figcaption><svg viewBox="0 0 ${width} ${height}" role="img" aria-hidden="true"><g class="my-night-chart__grid">${grid}</g>${slotBands}<line class="my-night-chart__threshold-line" x1="${left}" y1="${thresholdY}" x2="${width-right}" y2="${thresholdY}"/><path class="my-night-chart__moon-line" d="${path('moonAltitudeDeg')}"/><path class="my-night-chart__object-line" d="${path('objectAltitudeDeg')}"/><text class="my-night-chart__time" x="${left}" y="${height-7}">${clock(start)}</text><text class="my-night-chart__time" x="${width-right}" y="${height-7}" text-anchor="end">${clock(end)}</text></svg>`;
    figure.querySelector<HTMLElement>('[data-chart-title]')!.textContent = item.label;
    return figure;
  }
  const filterMoonWeight = (filter:string) => ({ B: 34, L: 30, G: 24, R: 15, Hα: 4, OIII: 7, SII: 4 }[filter] ?? 30);
  const scoreAt = (task:any, instant:Date) => {
    const reading = sampleInstant({ date: instant, location: centralCatalonia, object: task });
    const moonProximity = reading.isMoonUp ? Math.max(0, (100 - reading.moonSeparationDeg) / 100) : 0;
    const moonPenalty = moonProximity * reading.moonIlluminationFraction * filterMoonWeight(task.filter);
    return { reading, moonPenalty, score: reading.objectAltitudeDeg - moonPenalty - (reading.objectAltitudeDeg < Number(altitudeThreshold.value) ? 120 : 0) };
  };
  const clock = (instant:Date) => instant.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
  const explainSlot = (slot:any, valid:boolean) => {
    const moonImpact = slot.moonPenalty < 5 ? config.texts.moonLow : slot.moonPenalty < 15 ? config.texts.moonMedium : config.texts.moonHigh;
    const template = valid ? config.texts.chosenReason : config.texts.invalidReason;
    const mainReason = template
      .replace('{time}', clock(slot.midpoint))
      .replace('{altitude}', slot.reading.objectAltitudeDeg.toFixed(0))
      .replace('{threshold}', altitudeThreshold.value)
      .replace('{moon}', moonImpact);
    if (!valid && slot.validCandidateCount === 0) return `${mainReason} ${config.texts.explanation.noneValid}`;
    if (!slot.runnerUp) return `${mainReason} ${config.texts.explanation.only}`;
    const comparison = config.texts.explanation.comparison
      .replace('{target}', slot.runnerUp.task.label)
      .replace('{altitude}', slot.runnerUp.reading.objectAltitudeDeg.toFixed(0));
    return `${mainReason} ${comparison}`;
  };
  const makePlan = () => {
    const tasks = items.flatMap((item) => (equipment() === 'mono' ? item.filters : [config.texts.noFilter]).map((filter) => ({ ...item, filter })));
    if (!tasks.length) return;
    const { start, end } = sessionBounds();
    const slotMs = (end.getTime() - start.getTime()) / tasks.length;
    const remaining = [...tasks];
    const ordered = Array.from({ length: tasks.length }, (_, index) => {
      const slotStart = new Date(start.getTime() + index * slotMs);
      const slotEnd = new Date(start.getTime() + (index + 1) * slotMs);
      const midpoint = new Date((slotStart.getTime() + slotEnd.getTime()) / 2);
      const candidates = remaining.map((task) => ({ task, ...scoreAt(task, midpoint) })).sort((a, b) => b.score - a.score);
      const selected = candidates[0];
      remaining.splice(remaining.indexOf(selected.task), 1);
      return { ...selected, start: slotStart, end: slotEnd, midpoint, runnerUp: candidates[1] ?? null, validCandidateCount: candidates.filter((candidate) => candidate.reading.objectAltitudeDeg >= Number(altitudeThreshold.value)).length };
    });
    planDate.value = date.value;
    planThreshold.value = altitudeThreshold.value;
    timeline.replaceChildren(); planCharts.replaceChildren(); schedule.replaceChildren();
    ordered.forEach((slot, index) => {
      const valid = slot.reading.objectAltitudeDeg >= Number(altitudeThreshold.value);
      const segment = document.createElement('div');
      segment.classList.toggle('is-invalid', !valid);
      segment.style.setProperty('--night-colour', `hsl(${270 + (index * 31) % 65} 48% ${42 + (index % 2) * 8}%)`);
      segment.innerHTML = `<strong>${slot.task.label}</strong><span>${equipment() === 'mono' ? slot.task.filter : ''}</span><small>${clock(slot.start)}–${clock(slot.end)}${valid ? '' : ` · ${config.texts.invalidSlot}`}</small>`;
      timeline.append(segment);
      const row = document.createElement('li');
      row.classList.toggle('is-invalid', !valid);
      const filter = equipment() === 'mono' ? ` · ${slot.task.filter}` : '';
      row.innerHTML = `<time>${clock(slot.start)}–${clock(slot.end)}</time><strong>${slot.task.label}${filter}</strong><span>${config.texts.altitude} ${slot.reading.objectAltitudeDeg.toFixed(0)}° · ${config.texts.moonDistance} ${slot.reading.moonSeparationDeg.toFixed(0)}°${valid ? '' : ` · ${config.texts.invalidSlot}`}</span>`;
      const explanation = document.createElement('details');
      explanation.className = 'my-night__slot-explanation';
      const explanationSummary = document.createElement('summary');
      explanationSummary.textContent = config.texts.whyHere;
      const explanationText = document.createElement('p');
      explanationText.textContent = explainSlot(slot, valid);
      explanation.append(explanationSummary, explanationText);
      row.append(explanation);
      schedule.append(row);
    });
    const chartTargets = ordered.reduce<NightTarget[]>((targets, slot) => targets.some((target) => target.id === slot.task.id) ? targets : [...targets, slot.task], []);
    chartTargets.slice(0, MAX_TARGETS).forEach((target) => {
      const targetSlots = ordered.filter((slot) => slot.task.id === target.id).map((slot) => ({ start: slot.start, end: slot.end, valid: slot.reading.objectAltitudeDeg >= Number(altitudeThreshold.value) }));
      planCharts.append(makeComparisonChart(target, targetSlots));
    });
    plan.hidden = false;
    recalculate.classList.remove('is-dirty');
    persistState();
    plan.scrollIntoView({ behavior: 'smooth', block: 'start' });
  };
  createPlan.addEventListener('click', makePlan);
  recalculate.addEventListener('click', makePlan);
  planDate.addEventListener('change', () => {
    if (!/^\d{4}-\d{2}-\d{2}$/.test(planDate.value)) return;
    date.value = planDate.value;
    visibleWeek = parseDate(date.value);
    renderNightDays();
    recalculate.classList.add('is-dirty');
    render();
  });
  planThreshold.addEventListener('input', () => {
    altitudeThreshold.value = planThreshold.value;
    updateScoringThreshold();
    recalculate.classList.add('is-dirty');
    render();
  });
  [date, ready, finish].forEach((input) => input.addEventListener('change', () => { invalidatePlan(); render(); }));
  restoreState();
  visibleWeek = parseDate(date.value);
  renderNightDays();
  updateScoringThreshold();
  render();
