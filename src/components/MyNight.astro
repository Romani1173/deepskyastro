  const wrapCanvasText = (context:CanvasRenderingContext2D, value:string, x:number, y:number, maxWidth:number, lineHeight:number, maxLines = 99) => { const words = value.split(/\s+/); let line = '', lines = 0; for (const word of words) { const candidate = line ? `${line} ${word}` : word; if (context.measureText(candidate).width > maxWidth && line) { context.fillText(line, x, y); y += lineHeight; lines += 1; line = word; if (lines >= maxLines) return y; } else line = candidate; } if (line && lines < maxLines) { context.fillText(line, x, y); y += lineHeight; } return y; };
  const reportCanvas = () => { const canvas = document.createElement('canvas'); canvas.width = 1240; canvas.height = 1754; const context = canvas.getContext('2d')!; context.fillStyle = '#f7f4ed'; context.fillRect(0, 0, canvas.width, canvas.height); context.fillStyle = '#21172f'; context.fillRect(0, 0, canvas.width, 155); context.fillStyle = '#f1e8fb'; context.font = '700 42px Arial'; context.fillText(config.texts.export.title, 70, 82); context.fillStyle = '#c7b7da'; context.font = '20px Arial'; context.fillText(`${dateLabel()} · ${ready.value}–${finish.value}`, 70, 122); return { canvas, context }; };
  const summaryPdfPage = () => { const { canvas, context } = reportCanvas(); let y = 215; context.fillStyle = '#6e5295'; context.font = '700 21px Arial'; context.fillText(config.texts.export.summary, 70, y); y += 48; context.fillStyle = '#172033'; context.font = '22px Arial'; [`${config.texts.export.equipment}: ${equipmentLabel()}`, `${config.texts.export.threshold}: ${altitudeThreshold.value}°`, `${config.texts.export.targets}: ${items.length}`].forEach((line) => { context.fillText(line, 70, y); y += 38; }); y += 22; context.fillStyle = '#6e5295'; context.font = '700 21px Arial'; context.fillText(config.texts.export.schedule, 70, y); y += 42; currentPlan.forEach((slot, index) => { const valid = slot.reading.objectAltitudeDeg >= Number(altitudeThreshold.value); context.fillStyle = valid ? '#e9e4db' : '#f4d8d8'; context.fillRect(60, y - 25, 1120, 150); context.fillStyle = valid ? '#172033' : '#8b2834'; context.font = '700 24px Arial'; context.fillText(`${index + 1}. ${clock(slot.start)}–${clock(slot.end)} · ${slot.task.label}${equipment() === 'mono' ? ` · ${slot.task.filter}` : ''}`, 78, y + 8); context.font = '19px Arial'; context.fillText(`${config.texts.altitude}: ${slot.reading.objectAltitudeDeg.toFixed(0)}° · ${config.texts.moonDistance}: ${slot.reading.moonSeparationDeg.toFixed(0)}° · ${valid ? config.texts.export.valid : config.texts.export.invalid}`, 78, y + 43); context.fillStyle = '#475467'; context.font = '17px Arial'; wrapCanvasText(context, explainSlot(slot, valid), 78, y + 76, 1060, 23, 2); y += 166; }); context.fillStyle = '#667085'; context.font = '17px Arial'; wrapCanvasText(context, config.texts.export.note, 70, 1670, 1100, 25, 2); return canvas; };
  const chartsPdfPage = async () => { const { canvas, context } = reportCanvas(); context.fillStyle = '#6e5295'; context.font = '700 21px Arial'; context.fillText(config.texts.comparison.toLocaleUpperCase(config.lang), 70, 215); const charts = [...planCharts.querySelectorAll<SVGSVGElement>('svg')], figures = [...planCharts.querySelectorAll<HTMLElement>('figure')]; for (let index = 0; index < charts.length; index += 1) { const column = index % 2, row = Math.floor(index / 2), x = 70 + column * 565, y = 265 + row * 610; const targetId = figures[index]?.dataset.targetId, title = currentPlan.find((entry) => entry.task.id === targetId)?.task.label ?? ''; context.fillStyle = '#172033'; context.font = '700 21px Arial'; context.fillText(title, x, y); context.fillStyle = '#090e18'; context.fillRect(x, y + 25, 530, 290); const clone = charts[index].cloneNode(true) as SVGSVGElement; const style = document.createElementNS('http://www.w3.org/2000/svg', 'style'); style.textContent = `.my-night-chart__grid line{stroke:#43506a}.my-night-chart__grid text,.my-night-chart__time{fill:#aab4c5;font:8px monospace}.my-night-chart__object-line{fill:none;stroke:#55d9b3;stroke-width:2.2}.my-night-chart__moon-line{fill:none;stroke:#e78983;stroke-width:1.6;stroke-dasharray:4 3}.my-night-chart__threshold-line{stroke:#75a8d7;stroke-dasharray:3 3}.my-night-chart__selected-slot{fill:color-mix(in srgb,var(--filter-colour) 22%,transparent);stroke:color-mix(in srgb,var(--filter-colour) 78%,white)}.my-night-chart__selected-slot.is-invalid{fill:rgba(229,91,91,.3);stroke:#ef7878}`; clone.prepend(style); clone.setAttribute('xmlns', 'http://www.w3.org/2000/svg'); const url = URL.createObjectURL(new Blob([new XMLSerializer().serializeToString(clone)], { type: 'image/svg+xml' })); try { const image = new Image(); await new Promise<void>((resolve, reject) => { image.onload = () => resolve(); image.onerror = () => reject(new Error('Chart export failed')); image.src = url; }); context.drawImage(image, x + 10, y + 35, 510, 255); } finally { URL.revokeObjectURL(url); } const slots = currentPlan.filter((slot) => slot.task.id === targetId); context.fillStyle = '#475467'; context.font = '17px Arial'; let detailY = y + 350; slots.forEach((slot) => { const valid = slot.reading.objectAltitudeDeg >= Number(altitudeThreshold.value); detailY = wrapCanvasText(context, `${clock(slot.start)}–${clock(slot.end)} · ${valid ? config.texts.export.valid : config.texts.export.invalid} · ${explainSlot(slot, valid)}`, x, detailY, 530, 23, 4) + 8; }); } return canvas; };
  const canvasJpeg = (canvas:HTMLCanvasElement) => new Promise<Uint8Array>((resolve, reject) => canvas.toBlob(async (blob) => blob ? resolve(new Uint8Array(await blob.arrayBuffer())) : reject(new Error('PDF image failed')), 'image/jpeg', .92));
  const pdfFromJpegs = (images:{ bytes:Uint8Array; width:number; height:number }[]) => { const encoder = new TextEncoder(), objects = new Map<number,Uint8Array>(); const bytes = (value:string) => encoder.encode(value); const join = (parts:Uint8Array[]) => { const result = new Uint8Array(parts.reduce((sum, part) => sum + part.length, 0)); let offset = 0; parts.forEach((part) => { result.set(part, offset); offset += part.length; }); return result; }; objects.set(1, bytes('<< /Type /Catalog /Pages 2 0 R >>')); objects.set(2, bytes(`<< /Type /Pages /Count ${images.length} /Kids [${images.map((_, index) => `${3 + index * 3} 0 R`).join(' ')}] >>`)); images.forEach((image, index) => { const page = 3 + index * 3, content = page + 1, picture = page + 2; objects.set(page, bytes(`<< /Type /Page /Parent 2 0 R /MediaBox [0 0 595 842] /Resources << /XObject << /Im0 ${picture} 0 R >> >> /Contents ${content} 0 R >>`)); const drawing = bytes('q\n595 0 0 842 0 0 cm\n/Im0 Do\nQ'); objects.set(content, join([bytes(`<< /Length ${drawing.length} >>\nstream\n`), drawing, bytes('\nendstream')])); objects.set(picture, join([bytes(`<< /Type /XObject /Subtype /Image /Width ${image.width} /Height ${image.height} /ColorSpace /DeviceRGB /BitsPerComponent 8 /Filter /DCTDecode /Length ${image.bytes.length} >>\nstream\n`), image.bytes, bytes('\nendstream')])); }); const chunks:Uint8Array[] = [new Uint8Array([37,80,68,70,45,49,46,52,10,37,226,227,207,211,10])], offsets = [0]; let position = chunks[0].length; for (let number = 1; number <= objects.size; number += 1) { offsets[number] = position; const chunk = join([bytes(`${number} 0 obj\n`), objects.get(number)!, bytes('\nendobj\n')]); chunks.push(chunk); position += chunk.length; } const xref = position, entries = ['0000000000 65535 f ', ...offsets.slice(1).map((offset) => `${String(offset).padStart(10, '0')} 00000 n `)]; chunks.push(bytes(`xref\n0 ${objects.size + 1}\n${entries.join('\n')}\ntrailer\n<< /Size ${objects.size + 1} /Root 1 0 R >>\nstartxref\n${xref}\n%%EOF`)); return new Blob(chunks as BlobPart[], { type: 'application/pdf' }); };
  downloadPdf.addEventListener('click', async () => { if (!currentPlan.length) return; downloadPdf.disabled = true; try { const pages = [summaryPdfPage(), await chartsPdfPage()]; const images = await Promise.all(pages.map(async (page) => ({ bytes: await canvasJpeg(page), width: page.width, height: page.height }))); saveBlob(pdfFromJpegs(images), `${config.texts.export.file}-${date.value}.pdf`); confirmExport(downloadPdf, config.texts.export.pdfDone); } catch (error) { console.error(error); } finally { downloadPdf.disabled = false; } });
  planDate.addEventListener('change', () => {
    if (!/^\d{4}-\d{2}-\d{2}$/.test(planDate.value)) return;
    date.value = planDate.value;
    visibleWeek = parseDate(date.value);
    renderNightDays();
    recalculate.classList.add('is-dirty');
    markPlanParametersPending();
    render();
  });
  planThreshold.addEventListener('input', () => {
    altitudeThreshold.value = planThreshold.value;
    updateScoringThreshold();
    recalculate.classList.add('is-dirty');
    markPlanParametersPending();
    render();
  });
  [date, ready, finish].forEach((input) => input.addEventListener('change', () => { invalidatePlan(); render(); }));
  restoreState();
  visibleWeek = parseDate(date.value);
  renderNightDays();
  updateScoringThreshold();
  render();
</script>

