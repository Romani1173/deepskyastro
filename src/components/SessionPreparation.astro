---
import Layout from '../layouts/Layout.astro';
import type { Lang } from '../i18n';
import { equipmentAnalyzerHref, languageLinks, planningHref, sessionPreparationCopy, visibilityHref } from '../i18n';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const base = import.meta.env.BASE_URL;
const text = sessionPreparationCopy[lang];
const origin = '?from=prepara-sesion';
const steps = [
	{ number: '01', title: text.visibility, description: text.visibilityHelp, action: text.openVisibility, href: `${visibilityHref(lang, base)}${origin}`, symbol: '⌖' },
	{ number: '02', title: text.analyser, description: text.analyserHelp, action: text.openAnalyser, href: `${equipmentAnalyzerHref(lang, base)}${origin}`, symbol: '▣' },
	{ number: '03', title: text.planning, description: text.planningHelp, action: text.openPlanning, href: `${planningHref(lang, base)}${origin}`, symbol: '◎' },
];
---

<Layout title={text.title} description={text.intro} lang={lang} languageLinks={languageLinks.sessionPreparation(base)}>
	<section class="session-path" aria-labelledby="session-path-title">
		<header class="session-path__header">
			<h1 id="session-path-title">{text.title}</h1>
			<span>{text.intro}</span>
		</header>
		<p class="session-path__freedom">{text.start}</p>
		<div class="session-path__steps">
			{steps.map((step, index) => (
				<>
					<a class="session-path__card" href={step.href}>
						<span class="session-path__number">{step.number}</span>
						<span class="session-path__symbol" aria-hidden="true">{step.symbol}</span>
						<strong>{step.title}</strong>
						<small>{step.description}</small>
						<b>{step.action} →</b>
					</a>
					{index < steps.length - 1 && <span class="session-path__connector" aria-hidden="true">→</span>}
				</>
			))}
		</div>
	</section>
</Layout>

<style>
	.session-path{width:min(100%,1040px);margin:1rem auto 0;padding:1.4rem;border:1px solid var(--color-border);border-radius:.9rem;background:rgba(17,24,39,.82);box-shadow:0 18px 42px rgba(0,0,0,.2)}
	.session-path__header{max-width:760px}.session-path__header h1{margin:0;font-size:clamp(1.8rem,4vw,2.8rem);letter-spacing:-.045em}.session-path__header span{display:block;margin-top:.55rem;color:var(--color-muted);font-size:.92rem;line-height:1.6}
	.session-path__freedom{margin:1.4rem 0 .75rem;color:var(--color-accent-soft);font-size:.8rem;font-weight:700}
	.session-path__steps{display:grid;grid-template-columns:1fr auto 1fr auto 1fr;gap:.7rem;align-items:stretch}.session-path__card{display:grid;grid-template-columns:auto 1fr;gap:.35rem .7rem;min-width:0;padding:1.15rem;border:1px solid #3b4a63;border-radius:.7rem;background:#090e18;color:var(--color-text);text-decoration:none;transition:border-color .2s ease,transform .2s ease,background .2s ease}.session-path__card:hover{border-color:var(--color-accent);background:rgba(228,198,106,.06);opacity:1;transform:translateY(-2px)}.session-path__number{color:var(--color-accent);font-family:var(--font-technical);font-size:.75rem}.session-path__symbol{justify-self:end;color:var(--color-accent);font-size:1.45rem;font-weight:700;line-height:1}.session-path__card strong,.session-path__card small,.session-path__card b{grid-column:1/-1}.session-path__card strong{margin-top:.45rem;color:var(--color-accent-soft);font-size:1.05rem}.session-path__card small{min-height:5.2em;color:#aeb8c9;font-size:.78rem;font-weight:400;line-height:1.55}.session-path__card b{align-self:end;margin-top:.65rem;color:var(--color-accent);font-size:.73rem}.session-path__connector{align-self:center;color:var(--color-accent);font-family:var(--font-technical);font-size:1.25rem;font-weight:700;-webkit-text-stroke:.3px currentColor}
	@media(max-width:760px){.session-path{padding:1rem}.session-path__steps{grid-template-columns:1fr}.session-path__connector{justify-self:center;transform:rotate(90deg)}.session-path__card small{min-height:0}}
</style>
