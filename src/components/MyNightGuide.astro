---
import type { Lang } from '../i18n';
import { languageLinks, myNightHref } from '../i18n';
import Layout from '../layouts/Layout.astro';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const base = import.meta.env.BASE_URL;
const content = {
  ca: {
    title: 'Guia de La meva nit', back: 'Tornar a La meva nit', index: 'En aquesta guia',
    intro: 'La meva nit converteix fins a quatre objectius en un pla de captura ordenat i ajustable, tenint en compte l’altura, el temps útil i l’efecte de la Lluna.',
    sections: [
      ['acces', '1 · Com arribar-hi', ['La meva nit és accessible des de la navegació superior i des de la portada. També és la destinació porpra de «Prepara la teva sessió», dins de la branca activa «Descobreix la web».', 'El distintiu «Nivell avançat» indica que és una eina completa, pensada per a qui ja coneix conceptes com l’altura, els filtres, el llindar i l’efecte de la Lluna.']],
      ['sessio', '2 · Nit i horari', ['Escull la nit amb la setmana ISO i la franja gràfica de set dies. Després indica el dia seleccionat, l’hora d’inici, l’hora final i el llindar mínim d’altura; si l’hora final és anterior a la inicial, la sessió acaba l’endemà.', 'El llindar també es pot modificar al pas 4. Els dos controls estan sincronitzats i representen sempre el mateix valor.']],
      ['equip', '3 · Equip, filtres i Lluna', ['Tria un únic tipus de càmera. Amb telescopi intel·ligent o càmera OSC, cada objectiu genera una captura en color; amb càmera monocroma, inicialment no hi ha cap filtre seleccionat i cada combinació objecte–filtre que triïs es converteix en una tasca.', 'La sensibilitat lunar depèn del filtre: B 34, L/color 30, G 24, R 15, OIII 7, Hα 4 i SII 4. Un valor més alt fa que la proximitat i la il·luminació de la Lluna penalitzin més la puntuació.']],
      ['objectius', '4 · Selecció d’objectius', ['Pots afegir un màxim de quatre objectius de la llista local o cercar-ne un mitjançant SIMBAD. La selecció i la configuració es conserven durant la sessió del navegador encara que visitis una altra pàgina i tornis a La meva nit.', 'La llista local ofereix els objectius preparats per la web; SIMBAD permet resoldre altres denominacions astronòmiques.']],
      ['calcul', '5 · Càlcul i ordre inicial', ['El primer càlcul distribueix el temps disponible i ordena les tasques segons l’altura, el temps útil sobre el llindar i l’efecte de la Lluna, inclosa la seva separació angular i la sensibilitat del filtre.', 'A cada tram compara les tasques encara disponibles. Estar sota el llindar rep una penalització forta: l’objecte es continua mostrant per facilitar la comparació, però el tram queda marcat en vermell translúcid com a no recomanat.']],
      ['ajustos', '6 · Ajust manual dels trams', ['Els controls − i + canvien cada període en passos de cinc minuts. Quan ajustes un tram, queda fixat i el temps restant es redistribueix entre els trams lliures posteriors, sense alterar els anteriors.', 'L’últim tram pot quedar bloquejat si ja no existeix marge posterior per compensar el canvi. «Iguala els períodes» elimina els ajustos manuals i torna a repartir l’horari en parts iguals.']],
      ['recalcul', '7 · Canvis pendents i recàlcul', ['Canviar el dia, el llindar o la durada no recalcula automàticament el pla: el botó porpra «Recalcula el pla» parpelleja per indicar que hi ha canvis pendents. En prémer-lo, totes les modificacions s’apliquen conjuntament sense canviar els objectius seleccionats.', 'Les durades modificades es destaquen en groc. Mentre el pla estigui pendent de recàlcul, les descàrregues queden desactivades perquè no exportis una versió anterior.']],
      ['grafiques', '8 · Gràfiques i «Per què aquí?»', ['L’eix vertical va de −30° a 90°. La corba verda mostra l’altura de l’objecte, la vermella l’altura de la Lluna, la línia discontínua el llindar i la franja vertical el període assignat; és porpra si és vàlid i vermella translúcida si no arriba al llindar.', 'La capçalera conserva l’horari del tram. El desplegable «Per què en aquesta posició?» resumeix per què l’objectiu ha estat escollit en aquell moment i quina era l’alternativa següent.']],
      ['calculs', '9 · Càlculs i puntuació', ['El requadre «5 · Càlculs» inclou el desplegable «Puntuació dels objectius». L’explicació separa les dades d’entrada, les variables calculades i la fórmula final; també aclareix que la il·luminació lunar es mostra com a percentatge i es converteix a una fracció entre 0 i 1 per al càlcul.', 'A sota, les fitxes s’agrupen en una columna per objecte i, amb càmera monocroma, els seus filtres s’apilen dins de la mateixa columna. Cada fitxa mostra els valors numèrics substituïts i les dades es regeneren quan recalcules el pla.']],
      ['descarregues', '10 · Descàrregues', ['«Descarrega TXT» crea una versió textual del pla actual; «Descarrega PDF» genera un informe visual preparat per consultar o imprimir. Cap de les dues opcions modifica l’ordre.', 'Després de cada descàrrega apareix temporalment una marca de verificació. Els botons només estan disponibles quan el pla mostrat està actualitzat.']],
      ['limits', '11 · Model i límits', ['El càlcul és provisional i utilitza una ubicació de referència al centre de Catalunya. Considera geometria celeste, altura, temps útil, separació angular de la Lluna, fracció il·luminada i sensibilitat del filtre.', 'No substitueix la previsió meteorològica ni modela núvols, transparència, seeing, vent, horitzó local, relleu, obstacles, contaminació lumínica o el rendiment real de l’equip. Utilitza’l com a ajuda i comprova sempre les condicions reals.']],
    ],
  },
  es: {
    title: 'Guía de Mi noche', back: 'Volver a Mi noche', index: 'En esta guía',
    intro: 'Mi noche convierte hasta cuatro objetivos en un plan de captura ordenado y ajustable, teniendo en cuenta la altura, el tiempo útil y el efecto de la Luna.',
    sections: [
      ['acceso', '1 · Cómo llegar', ['Mi noche está disponible desde la navegación superior y desde la portada. También es el destino morado de «Prepara tu sesión», dentro de la rama activa «Descubre la web».', 'El distintivo «Nivel avanzado» indica que es una herramienta completa, pensada para quien ya conoce conceptos como la altura, los filtros, el umbral y el efecto de la Luna.']],
      ['sesion', '2 · Noche y horario', ['Elige la noche mediante la semana ISO y la franja gráfica de siete días. Después indica el día seleccionado, la hora de inicio, la hora final y el umbral mínimo de altura; si la hora final es anterior a la inicial, la sesión termina al día siguiente.', 'El umbral también puede modificarse en el paso 4. Ambos controles están sincronizados y representan siempre el mismo valor.']],
      ['equipo', '3 · Equipo, filtros y Luna', ['Selecciona un único tipo de cámara. Con telescopio inteligente o cámara OSC, cada objeto genera una captura en color; con cámara monocroma, inicialmente no hay ningún filtro seleccionado y cada combinación objeto–filtro que elijas se convierte en una tarea.', 'La sensibilidad lunar depende del filtro: B 34, L/color 30, G 24, R 15, OIII 7, Hα 4 y SII 4. Un valor más alto hace que la proximidad y la iluminación de la Luna penalicen más la puntuación.']],
      ['objetivos', '4 · Selección de objetivos', ['Puedes añadir un máximo de cuatro objetos de la lista local o buscar uno mediante SIMBAD. La selección y la configuración se conservan durante la sesión del navegador aunque visites otra página y regreses a Mi noche.', 'La lista local ofrece los objetos preparados para la web; SIMBAD permite resolver otras denominaciones astronómicas.']],
      ['calculo', '5 · Cálculo y orden inicial', ['El primer cálculo distribuye el tiempo disponible y ordena las tareas según la altura, el tiempo útil sobre el umbral y el efecto de la Luna, incluida su separación angular y la sensibilidad del filtro.', 'En cada tramo compara las tareas todavía disponibles. Estar bajo el umbral recibe una penalización fuerte: el objeto se sigue mostrando para facilitar la comparación, pero el tramo queda marcado en rojo translúcido como no recomendado.']],
      ['ajustes', '6 · Ajuste manual de los tramos', ['Los controles − y + cambian cada periodo en pasos de cinco minutos. Cuando ajustas un tramo, queda fijo y el tiempo restante se redistribuye entre los tramos libres posteriores, sin alterar los anteriores.', 'El último tramo puede quedar bloqueado si ya no existe margen posterior para compensar el cambio. «Igualar periodos» elimina los ajustes manuales y vuelve a repartir el horario en partes iguales.']],
      ['recalculo', '7 · Cambios pendientes y recálculo', ['Cambiar el día, el umbral o la duración no recalcula automáticamente el plan: el botón morado «Recalcular el plan» parpadea para indicar que hay cambios pendientes. Al pulsarlo, todas las modificaciones se aplican conjuntamente sin cambiar los objetos seleccionados.', 'Las duraciones modificadas se destacan en amarillo. Mientras el plan esté pendiente de recálculo, las descargas permanecen desactivadas para evitar exportar una versión anterior.']],
      ['graficas', '8 · Gráficas y «¿Por qué aquí?»', ['El eje vertical va de −30° a 90°. La curva verde muestra la altura del objeto, la roja la altura de la Luna, la línea discontinua el umbral y la franja vertical el periodo asignado; es morada si es válido y roja translúcida si no alcanza el umbral.', 'La cabecera conserva el horario del tramo. El desplegable «¿Por qué en esta posición?» resume por qué se eligió el objetivo en ese momento y cuál era la siguiente alternativa.']],
      ['calculos', '9 · Cálculos y puntuación', ['El recuadro «5 · Cálculos» contiene el desplegable «Puntuación de objetivos». La explicación separa los datos de entrada, las variables calculadas y la fórmula final; también aclara que la iluminación lunar se expresa como porcentaje y se convierte a una fracción entre 0 y 1 para el cálculo.', 'Debajo, las fichas se agrupan en una columna por objeto y, con cámara monocroma, sus filtros se apilan dentro de esa misma columna. Cada ficha muestra los valores numéricos sustituidos y los datos se regeneran al recalcular el plan.']],
      ['descargas', '10 · Descargas', ['«Descargar TXT» crea una versión textual del plan actual; «Descargar PDF» genera un informe visual preparado para consultar o imprimir. Ninguna de las dos opciones modifica el orden.', 'Después de cada descarga aparece temporalmente una marca de verificación. Los botones solo están disponibles cuando el plan mostrado está actualizado.']],
      ['limites', '11 · Modelo y límites', ['El cálculo es provisional y utiliza una ubicación de referencia en el centro de Cataluña. Considera geometría celeste, altura, tiempo útil, separación angular de la Luna, fracción iluminada y sensibilidad del filtro.', 'No sustituye la previsión meteorológica ni modela nubes, transparencia, seeing, viento, horizonte local, relieve, obstáculos, contaminación lumínica o el rendimiento real del equipo. Utilízalo como ayuda y comprueba siempre las condiciones reales.']],
    ],
  },
  en: {
    title: 'My Night guide', back: 'Back to My Night', index: 'In this guide',
    intro: 'My Night turns up to four targets into an ordered, adjustable capture plan based on altitude, useful time and Moon impact.',
    sections: [
      ['access', '1 · How to get there', ['My Night is available from the top navigation and the home page. It is also the purple destination in “Prepare your session”, within the active “Discover the website” branch.', 'The “Advanced level” badge indicates that this is a complete tool intended for users already familiar with altitude, filters, thresholds and the Moon’s effect.']],
      ['session', '2 · Night and times', ['Choose the night using the ISO week and the graphical seven-day strip. Then set the selected day, start time, finish time and minimum altitude threshold; if the finish time is earlier, the session ends on the following day.', 'The threshold can also be changed in step 4. Both controls stay synchronised and always represent the same value.']],
      ['equipment', '3 · Equipment, filters and Moon', ['Choose one camera type. With a smart telescope or OSC camera, each target creates a colour capture; with a monochrome camera, no filters are selected initially and every target–filter combination you choose becomes a task.', 'Lunar sensitivity depends on the filter: B 34, L/colour 30, G 24, R 15, OIII 7, Hα 4 and SII 4. A higher value makes Moon proximity and illumination penalise the score more strongly.']],
      ['targets', '4 · Choosing targets', ['Add up to four targets from the local list or search for one through SIMBAD. The selection and settings are retained for the browser session even if you visit another page and return to My Night.', 'The local list contains targets prepared for the website; SIMBAD can resolve other astronomical designations.']],
      ['calculation', '5 · Initial calculation and order', ['The first calculation distributes the available time and orders tasks according to altitude, useful time above the threshold and Moon impact, including its angular separation and filter sensitivity.', 'At each slot it compares the tasks still available. Being below the threshold receives a strong penalty: the target remains visible for comparison, but the slot is shown in translucent red as not recommended.']],
      ['adjustments', '6 · Adjusting slots manually', ['The − and + controls change each period in five-minute steps. Once adjusted, that slot stays fixed and the remaining time is redistributed among later free slots without changing earlier ones.', 'The final slot may be locked when there is no later margin left to compensate for a change. “Equalise periods” removes manual adjustments and divides the schedule equally again.']],
      ['recalculation', '7 · Pending changes and recalculation', ['Changing the day, threshold or duration does not recalculate the plan automatically: the purple “Recalculate plan” button blinks to show that changes are pending. Pressing it applies all changes together without changing the selected targets.', 'Changed durations are highlighted in yellow. While recalculation is pending, downloads remain disabled to prevent exporting an earlier version.']],
      ['charts', '8 · Charts and “Why here?”', ['The vertical axis runs from −30° to 90°. The green curve shows target altitude, the red curve Moon altitude, the dashed line the threshold, and the vertical band the assigned period; it is purple when valid and translucent red when below the threshold.', 'The header retains the slot time range. The expandable “Why in this position?” explains why the target was selected at that time and identifies the next alternative.']],
      ['calculations', '9 · Calculations and scoring', ['The “5 · Calculations” panel contains the “Target scoring” disclosure. Its explanation separates input data, calculated variables and the final formula; it also clarifies that lunar illumination is expressed as a percentage and converted to a fraction between 0 and 1 for the calculation.', 'Below it, cards are grouped into one column per target and, with a monochrome camera, its filters are stacked within that column. Each card shows the substituted numerical values, which are regenerated whenever the plan is recalculated.']],
      ['downloads', '10 · Downloads', ['“Download TXT” creates a text version of the current plan; “Download PDF” produces a visual report for reference or printing. Neither option changes the order.', 'A check mark appears temporarily after each download. The buttons are available only when the displayed plan is up to date.']],
      ['limits', '11 · Model and limits', ['The calculation is provisional and uses a reference location in central Catalonia. It considers sky geometry, altitude, useful time, Moon angular separation, illuminated fraction and filter sensitivity.', 'It does not replace a weather forecast or model cloud, transparency, seeing, wind, the local horizon, terrain, obstructions, light pollution or actual equipment performance. Use it as a decision aid and always check real conditions.']],
    ],
  },
} as const;
const t = content[lang];
---

<Layout title={t.title} description={t.intro} lang={lang} languageLinks={languageLinks.myNightGuide(base)} focused>
  <article class="my-night-guide">
    <a class="my-night-guide__back" href={myNightHref(lang, base)}>← {t.back}</a>
    <header><div aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M3.5 5.5c3.2-.8 5.9-.3 8.5 1.6v12c-2.6-1.9-5.3-2.4-8.5-1.6zM20.5 5.5c-3.2-.8-5.9-.3-8.5 1.6v12c2.6-1.9 5.3-2.4 8.5-1.6z" /></svg></div><h1>{t.title}</h1></header>
    <p class="my-night-guide__intro">{t.intro}</p>
    <nav aria-label={t.index}><strong>{t.index}</strong><ol>{t.sections.map((section, index) => <li><a href={`#${section[0]}`}><span>{String(index + 1).padStart(2, '0')}</span>{section[1]}</a></li>)}</ol></nav>
    <div class="my-night-guide__sections">{t.sections.map((section, index) => <section id={section[0]}><i>{String(index + 1).padStart(2, '0')}</i><div><h2>{section[1]}</h2>{section[2].map((paragraph) => <p>{paragraph}</p>)}</div></section>)}</div>
    <a class="my-night-guide__return" href={myNightHref(lang, base)}>← {t.back}</a>
  </article>
</Layout>

<style>
  .my-night-guide{max-width:58rem;margin:0 auto;padding:.5rem 0 3rem}.my-night-guide__back{display:inline-block;margin-bottom:1.1rem;color:#cba9f4;font-size:.78rem;text-decoration:none}.my-night-guide>header{display:flex;align-items:center;gap:1rem;padding-bottom:1.1rem;border-bottom:1px solid var(--color-border)}.my-night-guide>header>div{display:grid;flex:0 0 auto;width:2.8rem;height:2.8rem;place-items:center;border:1px solid #765ca1;border-radius:.65rem;background:rgba(155,114,209,.12);color:#d9c5f5}.my-night-guide svg{width:1.6rem;height:1.6rem;fill:none;stroke:currentColor;stroke-linecap:round;stroke-linejoin:round;stroke-width:1.45}.my-night-guide h1{margin:0;font-size:clamp(1.45rem,3vw,2.2rem);letter-spacing:-.035em;line-height:1.05}.my-night-guide__intro{max-width:50rem;margin:1.25rem 0;color:var(--color-text);font-size:clamp(1rem,2vw,1.14rem);line-height:1.7}.my-night-guide nav{margin:1.5rem 0 2.4rem;padding:1rem;border:1px solid var(--color-border);border-radius:.8rem;background:var(--color-surface)}.my-night-guide nav>strong{display:block;margin-bottom:.65rem;color:var(--color-muted);font-size:.72rem;text-transform:uppercase}.my-night-guide nav ol{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.3rem .8rem;margin:0;padding:0;list-style:none}.my-night-guide nav a{display:flex;gap:.5rem;padding:.35rem .4rem;color:var(--color-text);font-size:.85rem;text-decoration:none}.my-night-guide nav span,.my-night-guide section>i{color:#cba9f4;font:.68rem var(--font-mono)}.my-night-guide__sections{display:grid;gap:1rem}.my-night-guide section{display:grid;grid-template-columns:2.8rem 1fr;scroll-margin-top:1rem;overflow:hidden;border:1px solid var(--color-border);border-radius:.8rem;background:var(--color-surface)}.my-night-guide section>i{padding:1.2rem .55rem;border-right:1px solid var(--color-border);font-weight:700;text-align:center;font-style:normal}.my-night-guide section>div{padding:1.1rem 1.2rem 1.2rem}.my-night-guide h2{margin:0 0 .65rem;font-size:1.25rem}.my-night-guide section p{margin:.55rem 0;color:var(--color-muted);line-height:1.65}.my-night-guide__return{display:inline-flex;margin-top:1rem;padding:.65rem .8rem;border:1px solid #765ca1;border-radius:.55rem;color:#d9c5f5;font-size:.82rem;font-weight:700;text-decoration:none}@media(max-width:600px){.my-night-guide nav ol{grid-template-columns:1fr}.my-night-guide section{grid-template-columns:2.35rem 1fr}}
</style>
