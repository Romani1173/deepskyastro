---
import type { Lang } from '../../i18n';
import { languageLinks, planningGuideHref, sessionPreparationHref, visibilityHref } from '../../i18n';
import Layout from '../../layouts/Layout.astro';
import SessionToolLink from '../SessionToolLink.astro';
import objectsData from '../../data/astronomical-objects.json';
import { PUBLIC_PENDING_OBJECTS } from '../../config/features';
import { getCollection } from 'astro:content';
import { photoText } from '../../photoTranslations';
import { formatCatalogDesignations } from '../../lib/catalog-formatting.mjs';
import '../../styles/planning.css';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const base = import.meta.env.BASE_URL;
const texts = {
  ca: {
    title: 'Planificació', intro: 'Analitza un únic objecte durant set nits des de la ubicació que triïs. Utilitza aquesta eina quan ja sàpigues què vols fotografiar; tots els càlculs, dates i hores s’expressen en UTC.', guide: 'Guia de Planificació', guideTooltip: 'Manual complet de l’eina avançada de Planificació',
    location: '1 · Ubicació', locationName: 'Nom opcional', savedLocations: 'Cercar ubicació', latitude: 'Latitud', longitude: 'Longitud', session: 'La ubicació es conserva només durant aquesta sessió.',
    object: '2 · Objecte', localObject: 'Objecte local', searchObject: 'Cercar un objecte', searchObjectPlaceholder: 'M 31, NGC 7000, nebulosa…', noObjectMatches: 'No hi ha coincidències', gallery: 'Galeria', pending: 'Pendents', simbad: 'SIMBAD', simbadQuery: 'Consulta SIMBAD', simbadPlaceholder: 'Nom o catàleg', resolve: 'Resoldre', resolving: 'Resolent…', simbadNote: 'Primer es comproven els objectes locals. SIMBAD només resol nom i coordenades durant aquesta sessió.', simbadError: 'SIMBAD no ha pogut resoldre aquest objecte.', localResolved: 'Coincidència local', manual: 'AR/Dec manuals', manualCoordinates: 'Coordenades manuals', ra: 'AR J2000 (graus)', dec: 'Dec J2000 (graus)',
    period: '3 · Setmana i any', week: 'Setmana ISO', year: 'Any', calculate: 'Calcular nits', calculating: 'Calculant…',
    conclusionTitle: 'Lectura de la setmana', bestNight: 'Millor nit', usefulWindow: 'Finestra útil', moonlessTime: 'Temps sense Lluna', culmination: 'Culminació', excellent: 'Excel·lent', favourable: 'Favorable', limited: 'Limitada', notRecommended: 'No recomanable', geometryNotice: 'Valoració geomètrica: no inclou núvols, transparència, seeing, vent ni obstacles de l’horitzó local.', copyResults: 'Copia els resultats', copiedResults: '✓ Resultats copiats', downloadPdf: 'Descarrega el PDF', downloadedPdf: '✓ PDF descarregat', exportHelp: 'Copia el resum en text o descarrega un informe PDF de dues pàgines.',
    comparison: '4 · Comparació de les set nits', night: 'Nit UTC', darkness: 'Nit astronòmica', maxAltitude: 'Alt. màx. nocturna', effective: 'Finestra >30°', moonDown: 'Sense Lluna', bestMoonDown: 'Millor hora sense Lluna', bestMoonUp: 'Millor hora amb Lluna', moon: 'Lluna', separation: 'Separació', unavailable: 'No supera 30° durant la nit astronòmica', none: '—', select: 'Seleccionar nit',
    detail: '5 · Detall nocturn', objectCurve: 'Objecte', moonCurve: 'Lluna', threshold: 'Límit 30°', astronomyNight: 'Nit astronòmica', chartHelp: 'Mou el cursor; en pantalles tàctils, toca per consultar i arrossega per desplaçar-te per la gràfica. Els trams fora de la nit astronòmica es mostren atenuats.', altitude: 'Altura', azimuth: 'Azimut', illumination: 'Il·luminació', sun: 'Sol', engine: 'Coordenades topocèntriques geomètriques, sense refracció atmosfèrica.', error: 'Revisa la ubicació, l’objecte i el període.',
  },
  es: {
    title: 'Planificación', intro: 'Analiza un único objeto durante siete noches desde la ubicación que elijas. Utiliza esta herramienta cuando ya sepas qué quieres fotografiar; todos los datos se muestran en UTC.', guide: 'Guía de Planificación', guideTooltip: 'Manual completo de la herramienta avanzada de Planificación',
    location: '1 · Ubicación', locationName: 'Nombre opcional', savedLocations: 'Buscar ubicación', latitude: 'Latitud', longitude: 'Longitud', session: 'La ubicación se conserva únicamente durante esta sesión.',
    object: '2 · Objeto', localObject: 'Objeto local', searchObject: 'Buscar un objeto', searchObjectPlaceholder: 'M 31, NGC 7000, nebulosa…', noObjectMatches: 'No hay coincidencias', gallery: 'Galería', pending: 'Pendientes', simbad: 'SIMBAD', simbadQuery: 'Consulta en SIMBAD', simbadPlaceholder: 'Nombre o catálogo', resolve: 'Resolver', resolving: 'Resolviendo…', simbadNote: 'Se buscan primero los objetos locales. SIMBAD solo devuelve el nombre y las coordenadas; no añade el objeto a la galería.', simbadError: 'SIMBAD no ha podido resolver este objeto.', localResolved: 'Objeto local', manual: 'AR/Dec manuales', manualCoordinates: 'Nombre opcional', ra: 'AR J2000 (grados)', dec: 'Dec J2000 (grados)',
    period: '3 · Semana y año', week: 'Semana ISO', year: 'Año', calculate: 'Calcular noches', calculating: 'Calculando…',
    conclusionTitle: 'Lectura de la semana', bestNight: 'Mejor noche', usefulWindow: 'Ventana útil', moonlessTime: 'Tiempo sin Luna', culmination: 'Culminación', excellent: 'Excelente', favourable: 'Favorable', limited: 'Limitada', notRecommended: 'No recomendable', geometryNotice: 'Valoración geométrica: no incluye nubes, transparencia, seeing, viento ni obstáculos del horizonte local.', copyResults: 'Copiar resultados', copiedResults: '✓ Resultados copiados', downloadPdf: 'Descargar PDF', downloadedPdf: '✓ PDF descargado', exportHelp: 'Copia el resumen en texto o descarga un informe PDF de dos páginas.',
    comparison: '4 · Comparación de las siete noches', night: 'Noche UTC', darkness: 'Noche astronómica', maxAltitude: 'Altura máxima', effective: 'Ventana >30°', moonDown: 'Tiempo sin Luna', bestMoonDown: 'Mejor hora sin Luna', bestMoonUp: 'Mejor hora con Luna', moon: 'Luna', separation: 'Separación', unavailable: 'No supera 30° durante la noche astronómica', none: '—', select: 'Ver esta noche',
    detail: '5 · Detalle de la noche', objectCurve: 'Objeto', moonCurve: 'Luna', threshold: 'Límite 30°', astronomyNight: 'Noche astronómica', chartHelp: 'Mueve el cursor; en pantallas táctiles, toca para consultar y arrastra para desplazarte por la gráfica. Los tramos fuera de la noche astronómica aparecen atenuados.', altitude: 'Altura', azimuth: 'Azimut', illumination: 'Iluminación', sun: 'Sol', engine: 'Posiciones topocéntricas geométricas, sin refracción atmosférica.', error: 'Revisa la ubicación, el objeto y la semana.',
  },
  en: {
    title: 'Planning', intro: 'Analyse one object over seven nights from the location you choose. Use this tool once you know what you want to photograph; all calculations, dates, and times are expressed in UTC.', guide: 'Planning guide', guideTooltip: 'Complete guide to the advanced Planning tool',
    location: '1 · Location', locationName: 'Optional name', savedLocations: 'Find location', latitude: 'Latitude', longitude: 'Longitude', session: 'The location is retained only for this browser session.',
    object: '2 · Object', localObject: 'Local object', searchObject: 'Find an object', searchObjectPlaceholder: 'M 31, NGC 7000, nebula…', noObjectMatches: 'No matches found', gallery: 'Gallery', pending: 'Pending', simbad: 'SIMBAD', simbadQuery: 'SIMBAD lookup', simbadPlaceholder: 'Name or catalogue', resolve: 'Resolve', resolving: 'Resolving…', simbadNote: 'Local objects are checked first. SIMBAD resolves only a name and coordinates for this session.', simbadError: 'SIMBAD could not resolve this object.', localResolved: 'Local match', manual: 'Manual RA/Dec', manualCoordinates: 'Manual coordinates', ra: 'RA J2000 (degrees)', dec: 'Dec J2000 (degrees)',
    period: '3 · Week and year', week: 'ISO week', year: 'Year', calculate: 'Calculate nights', calculating: 'Calculating…',
    conclusionTitle: 'Reading of the week', bestNight: 'Best night', usefulWindow: 'Useful window', moonlessTime: 'Moonless time', culmination: 'Culmination', excellent: 'Excellent', favourable: 'Favourable', limited: 'Limited', notRecommended: 'Not recommended', geometryNotice: 'Geometric assessment: it does not include cloud, transparency, seeing, wind or local-horizon obstructions.', copyResults: 'Copy results', copiedResults: '✓ Results copied', downloadPdf: 'Download PDF', downloadedPdf: '✓ PDF downloaded', exportHelp: 'Copy the text summary or download a two-page PDF report.',
    comparison: '4 · Seven-night comparison', night: 'UTC night', darkness: 'Astronomical night', maxAltitude: 'Night max. alt.', effective: '>30° window', moonDown: 'Moon down', bestMoonDown: 'Best Moon-down time', bestMoonUp: 'Best Moon-up time', moon: 'Moon', separation: 'Separation', unavailable: 'Never above 30° during astronomical night', none: '—', select: 'Select night',
    detail: '5 · Night detail', objectCurve: 'Object', moonCurve: 'Moon', threshold: '30° limit', astronomyNight: 'Astronomical night', chartHelp: 'Move the pointer; on touchscreens, tap to inspect and drag to scroll across the chart. Segments outside astronomical night are dimmed.', altitude: 'Altitude', azimuth: 'Azimuth', illumination: 'Illumination', sun: 'Sun', engine: 'Geometric topocentric coordinates without atmospheric refraction.', error: 'Check the location, object, and period.',
  },
} as const;
const t = texts[lang];
const moonGuide = {
  ca: {
    title: 'Com interpretar la Lluna', separation: 'Separació', effect: 'Efecte probable',
    rows: [['Menys de 20°', 'Molt desfavorable, especialment amb Lluna brillant'], ['20–40°', 'Interferència important'], ['40–60°', 'Pot ser acceptable amb Lluna moderada o filtres estrets'], ['60–90°', 'Generalment manejable'], ['Més de 90°', 'Situació favorable, tot i que una Lluna plena i alta encara il·lumina el cel']],
    illumination: 'La il·luminació lunar canvia molt la interpretació:', bullets: ['0–20 %: la separació sol tenir poca importància.', '20–60 %: convé buscar una separació superior a 50–60°.', 'Més de 60 %: fins i tot amb més de 90° pot elevar apreciablement el fons del cel.'],
  },
  es: {
    title: 'Cómo interpretar la Luna', separation: 'Separación', effect: 'Efecto probable',
    rows: [['Menos de 20°', 'Muy desfavorable, especialmente con Luna brillante'], ['20–40°', 'Interferencia importante'], ['40–60°', 'Puede ser aceptable con Luna moderada o filtros estrechos'], ['60–90°', 'Generalmente manejable'], ['Más de 90°', 'Situación favorable, aunque una Luna llena y alta todavía ilumina el cielo']],
    illumination: 'La iluminación lunar cambia mucho la interpretación:', bullets: ['0–20 %: la separación suele tener poca importancia.', '20–60 %: conviene buscar una separación superior a 50–60°.', 'Más de 60 %: incluso con más de 90° puede elevar apreciablemente el fondo del cielo.'],
  },
  en: {
    title: 'How to interpret the Moon', separation: 'Separation', effect: 'Likely effect',
    rows: [['Under 20°', 'Very unfavourable, especially with a bright Moon'], ['20–40°', 'Significant interference'], ['40–60°', 'May be acceptable with a moderate Moon or narrowband filters'], ['60–90°', 'Generally manageable'], ['Over 90°', 'Favourable, although a high full Moon still brightens the sky']],
    illumination: 'Lunar illumination changes the interpretation considerably:', bullets: ['0–20%: separation usually matters little.', '20–60%: aim for a separation greater than 50–60°.', 'Over 60%: even beyond 90° it can noticeably brighten the sky background.'],
  },
}[lang];
const photos = await getCollection('fotos');
const latestPhotoByObject = new Map<string, (typeof photos)[number]>();
for (const photo of [...photos].sort((a, b) => b.data.entorn.data.valueOf() - a.data.entorn.data.valueOf())) {
  if (photo.data.objecte_astronomic && !latestPhotoByObject.has(photo.data.objecte_astronomic)) latestPhotoByObject.set(photo.data.objecte_astronomic, photo);
}
const photoAlias = (id: string, catalogName: string) => {
  const photo = latestPhotoByObject.get(id);
  if (!photo) return undefined;
  const localizedName = photoText(photo, lang).objecte;
  const escapedCatalog = [...catalogName.replace(/\s+/g, '')].map((character) => character.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')).join('\\s*');
  const alias = localizedName.replace(new RegExp(`^\\s*${escapedCatalog}(?:\\s*\\((?:HOO|SHO|Hα|NN)\\))?\\s*(?:[–—,:-]\\s*)?`, 'i'), '').trim();
  return alias || undefined;
};
const objects = objectsData
  .filter((object) => import.meta.env.DEV || PUBLIC_PENDING_OBJECTS || object.status === 'photographed')
  .map((object) => ({ id: object.id, catalogName: object.catalogName, displayCatalogName: formatCatalogDesignations(object.catalogName), commonName: formatCatalogDesignations(object.commonNames?.[lang] ?? photoAlias(object.id, object.catalogName)), raDeg: object.raDeg, decDeg: object.decDeg, source: object.status === 'pending' ? 'pending' : 'gallery' }));
const photographed = objects.filter((object) => object.source === 'gallery');
const pending = objects.filter((object) => object.source === 'pending');
const clientData = JSON.stringify({ lang, texts: t, objects }).replace(/</g, '\\u003c');
---

<Layout title={t.title} description={t.intro} lang={lang} languageLinks={languageLinks.planning(base)} focused>
  <main class="planning" data-planning-root>
    <SessionToolLink lang={lang} href={sessionPreparationHref(lang, base)} visibilityHref={visibilityHref(lang, base)} />
    <header class="planning__header">
      <h1>{t.title}</h1>
      <p>{t.intro}</p>
      <a class="planning-guide-link" href={planningGuideHref(lang, base)} title={t.guideTooltip}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3.5 5.5c3.2-.8 5.9-.3 8.5 1.6v12c-2.6-1.9-5.3-2.4-8.5-1.6zM20.5 5.5c-3.2-.8-5.9-.3-8.5 1.6v12c2.6-1.9 5.3-2.4 8.5-1.6z" /></svg>
        <span>{t.guide}</span>
      </a>
    </header>

    <form class="planning-controls" data-planning-form>
      <fieldset class="planning-panel">
        <legend>{t.location}</legend>
        <div class="planning-fields planning-fields--location">
          <label><span>{t.locationName}</span><span class="planning-stepper"><button type="button" data-step-field="locationName" data-step-direction="-1" aria-label={`◀ ${t.locationName}`}>‹</button><select name="locationName" title={t.savedLocations}><option value="">—</option><option value="L’Ampolla" selected>L’Ampolla</option><option value="Barcelona">Barcelona</option><option value="Pujalt">Pujalt</option><option value="Huesca">Huesca</option><option value="Lleida">Lleida</option><option value="Tarragona">Tarragona</option><option value="Girona">Girona</option><option value="Vilanova i la Geltrú">Vilanova i la Geltrú</option></select><button type="button" data-step-field="locationName" data-step-direction="1" aria-label={`${t.locationName} ▶`}>›</button></span></label>
          <label><span>{t.latitude}</span><input name="latitude" type="text" inputmode="decimal" pattern="-?[0-9]+(?:[.,][0-9]+)?" value="40.80194" required /></label>
          <label><span>{t.longitude}</span><input name="longitude" type="text" inputmode="decimal" pattern="-?[0-9]+(?:[.,][0-9]+)?" value="0.69361" required /></label>
        </div>
        <div class="planning-panel__footer"><small>{t.session}</small></div>
      </fieldset>

      <fieldset class="planning-panel planning-panel--object">
        <legend>{t.object}</legend>
        <nav class="planning-object-modes" aria-label={t.object}>
          <button type="button" data-object-mode="local" aria-pressed="true">{t.localObject}</button>
          <button type="button" data-object-mode="simbad" aria-pressed="false">{t.simbad}</button>
          <button type="button" data-object-mode="manual" aria-pressed="false">{t.manual}</button>
        </nav>
        <div data-object-panel="local">
          <div class="planning-object-picker" data-object-picker>
            <label><span>{t.searchObject}</span><input name="localObjectSearch" type="search" placeholder={t.searchObjectPlaceholder} autocomplete="off" aria-autocomplete="list" aria-controls="planning-object-results" aria-expanded="false" /></label>
            <div class="planning-object-results" id="planning-object-results" data-object-results role="listbox" hidden></div>
          </div>
          <select name="localObject" hidden aria-hidden="true" tabindex="-1">
            <optgroup label={t.gallery}>{photographed.map((object) => <option value={object.id}>{object.displayCatalogName}{object.commonName ? ` · ${object.commonName}` : ''}</option>)}</optgroup>
            {pending.length > 0 && <optgroup label={t.pending}>{pending.map((object) => <option value={object.id}>{object.displayCatalogName}{object.commonName ? ` · ${object.commonName}` : ''}</option>)}</optgroup>}
          </select>
        </div>
        <div class="planning-simbad" data-object-panel="simbad" hidden>
          <p data-simbad-result aria-live="polite"></p>
          <label><span>{t.simbadQuery}</span><span class="planning-simbad__row"><input name="simbadQuery" type="search" placeholder={t.simbadPlaceholder} autocomplete="off" /><button type="button" class="planning-button planning-button--quiet" data-resolve-simbad>{t.resolve}</button></span></label>
          <small>{t.simbadNote}</small>
        </div>
        <div class="planning-fields" data-object-panel="manual" hidden>
          <label><span>{t.manualCoordinates}</span><input name="manualName" type="text" placeholder="J2000" /></label>
          <label><span>{t.ra}</span><input name="manualRa" type="number" min="0" max="359.999999" step="0.000001" /></label>
          <label><span>{t.dec}</span><input name="manualDec" type="number" min="-90" max="90" step="0.000001" /></label>
        </div>
      </fieldset>

      <fieldset class="planning-panel planning-panel--period">
        <legend>{t.period}</legend>
        <div class="planning-fields">
          <label><span>{t.year}</span><span class="planning-stepper"><button type="button" data-step-field="year" data-step-direction="-1" aria-label={`◀ ${t.year}`}>‹</button><input name="year" type="number" min="1900" max="2200" required /><button type="button" data-step-field="year" data-step-direction="1" aria-label={`${t.year} ▶`}>›</button></span></label>
          <label><span>{t.week}</span><span class="planning-stepper"><button type="button" data-step-field="week" data-step-direction="-1" aria-label={`◀ ${t.week}`}>‹</button><input name="week" type="number" min="1" max="53" required /><button type="button" data-step-field="week" data-step-direction="1" aria-label={`${t.week} ▶`}>›</button></span></label>
          <output class="planning-week-range" data-week-range aria-live="polite"></output>
          <button class="planning-button" type="submit" data-calculate>{t.calculate}</button>
        </div>
        <p class="planning-error" data-planning-error hidden>{t.error}</p>
      </fieldset>
    </form>

    <section class="planning-results" data-results hidden>
      <section class="planning-conclusion" data-planning-conclusion hidden aria-live="polite">
        <header class="planning-conclusion__header">
          <h2>{t.conclusionTitle}</h2>
          <div class="planning-conclusion__tools">
            <strong data-conclusion-rating></strong>
            <button type="button" data-copy-planning title={t.exportHelp}>{t.copyResults}</button>
            <button type="button" data-download-planning title={t.exportHelp}>{t.downloadPdf}</button>
          </div>
        </header>
        <div class="planning-conclusion__metrics">
          <article><span>{t.bestNight}</span><strong data-conclusion-night>—</strong></article>
          <article><span>{t.usefulWindow}</span><strong data-conclusion-window>—</strong></article>
          <article><span>{t.moonlessTime}</span><strong data-conclusion-moonless>—</strong></article>
          <article><span>{t.culmination}</span><strong data-conclusion-culmination>—</strong></article>
        </div>
        <p class="planning-conclusion__comment" data-conclusion-comment></p>
        <small>{t.geometryNotice}</small>
      </section>
      <div class="planning-section-heading"><h2>{t.comparison}</h2><strong class="planning-selected-object" data-selected-object></strong><span class="planning-week-context" data-week-label></span></div>
      <div class="planning-table-wrap">
        <table class="planning-table">
          <thead><tr><th>{t.night}</th><th>{t.darkness}</th><th>{t.maxAltitude}</th><th>{t.effective}</th><th>{t.moonDown}</th><th>{t.bestMoonDown}</th><th>{t.bestMoonUp}</th><th>{t.moon}</th><th>{t.separation}</th></tr></thead>
          <tbody data-night-rows></tbody>
        </table>
      </div>

      <section class="planning-night" data-night-detail>
        <div class="planning-section-heading planning-section-heading--night">
          <p data-night-date>UTC</p><h2>{t.detail}</h2>
          <details class="planning-moon-guide">
            <summary><span aria-hidden="true">☾</span>{moonGuide.title}</summary>
            <div class="planning-moon-guide__content">
              <table><thead><tr><th>{moonGuide.separation}</th><th>{moonGuide.effect}</th></tr></thead><tbody>{moonGuide.rows.map((row) => <tr><th>{row[0]}</th><td>{row[1]}</td></tr>)}</tbody></table>
              <p>{moonGuide.illumination}</p>
              <ul>{moonGuide.bullets.map((bullet) => <li>{bullet}</li>)}</ul>
            </div>
          </details>
        </div>
        <div class="planning-legend"><span class="planning-legend__object">— {t.objectCurve}</span><span class="planning-legend__moon">— {t.moonCurve}</span><span class="planning-legend__threshold">┄ {t.threshold}</span><span class="planning-legend__darkness">■ {t.astronomyNight}</span></div>
        <div class="planning-chart" data-chart-wrap>
          <svg viewBox="0 0 1000 430" role="img" aria-label={t.detail} data-night-chart></svg>
          <div class="planning-tooltip" data-chart-tooltip hidden></div>
        </div>
        <p class="planning-chart-help">{t.chartHelp}</p>
      </section>
    </section>
  </main>
</Layout>

<script type="application/json" id="planning-data" set:html={clientData}></script>
<script>
  import { analyzeWeek, isoWeekStart, isoWeeksInYear } from '../../lib/planning/engine.mjs';
  import { loadPlanningSession, savePlanningSession } from '../../lib/planning/session.mjs';
  import { findLocalObject, resolveSimbad } from '../../lib/planning/simbad.mjs';
  import { formatCatalogDesignations } from '../../lib/catalog-formatting.mjs';

  const config = JSON.parse(document.querySelector('#planning-data')?.textContent ?? '{}');
  const root = document.querySelector<HTMLElement>('[data-planning-root]');
  const form = document.querySelector<HTMLFormElement>('[data-planning-form]');
  if (!root || !form) throw new Error('Planning interface not found');
  const field = (name: string) => form.elements.namedItem(name) as HTMLInputElement | HTMLSelectElement;
  const results = root.querySelector<HTMLElement>('[data-results]');
  const error = root.querySelector<HTMLElement>('[data-planning-error]');
  const calculateButton = root.querySelector<HTMLButtonElement>('[data-calculate]');
  const rows = root.querySelector<HTMLTableSectionElement>('[data-night-rows]');
  const chart = root.querySelector<SVGSVGElement>('[data-night-chart]');
  const tooltip = root.querySelector<HTMLElement>('[data-chart-tooltip]');
  const nightDetail = root.querySelector<HTMLElement>('[data-night-detail]');
  const simbadButton = root.querySelector<HTMLButtonElement>('[data-resolve-simbad]');
  const simbadResult = root.querySelector<HTMLElement>('[data-simbad-result]');
  const weekRange = root.querySelector<HTMLOutputElement>('[data-week-range]');
  const conclusion = root.querySelector<HTMLElement>('[data-planning-conclusion]');
  const copyPlanningButton = root.querySelector<HTMLButtonElement>('[data-copy-planning]');
  const downloadPlanningButton = root.querySelector<HTMLButtonElement>('[data-download-planning]');
  let analysis: any = null;
  let selectedNight: any = null;
  let resolvedSimbad: any = null;
  let objectMode = sessionStorage.getItem('deepskyastro:planning-object-mode') ?? 'local';

  const now = new Date();
  const iso = (() => {
    const day = new Date(Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), now.getUTCDate()));
    day.setUTCDate(day.getUTCDate() + 4 - (day.getUTCDay() || 7));
    const start = new Date(Date.UTC(day.getUTCFullYear(), 0, 1));
    return { year: day.getUTCFullYear(), week: Math.ceil((((day.getTime() - start.getTime()) / 86400000) + 1) / 7) };
  })();

  const session = loadPlanningSession(sessionStorage);
  const requestUrl = new URL(window.location.href);
  const requestedYear = Number(requestUrl.searchParams.get('year'));
  const requestedWeek = Number(requestUrl.searchParams.get('week'));
  field('locationName').value = session.location.name ?? '';
  field('latitude').value = String(session.location.latitudeDeg);
  field('longitude').value = String(session.location.longitudeDeg);
  field('year').value = String(Number.isInteger(requestedYear) && requestedYear >= 1900 && requestedYear <= 2200 ? requestedYear : session.isoYear ?? iso.year);
  field('week').value = String(Number.isInteger(requestedWeek) && requestedWeek >= 1 && requestedWeek <= 53 ? requestedWeek : session.isoWeek ?? iso.week);
  const locationPresets: Record<string, { name: string; latitudeDeg: number; longitudeDeg: number }> = {
    lampolla: { name: 'L’Ampolla', latitudeDeg: 40.80194, longitudeDeg: 0.69361 },
    barcelona: { name: 'Barcelona', latitudeDeg: 41.3926, longitudeDeg: 2.1865 },
    pujalt: { name: 'Pujalt', latitudeDeg: 41.717479, longitudeDeg: 1.424563 },
    huesca: { name: 'Huesca', latitudeDeg: 42.139166, longitudeDeg: -0.407826 },
    lleida: { name: 'Lleida', latitudeDeg: 41.617207, longitudeDeg: 0.625766 },
    tarragona: { name: 'Tarragona', latitudeDeg: 41.119005, longitudeDeg: 1.245268 },
    girona: { name: 'Girona', latitudeDeg: 41.9738, longitudeDeg: 2.817016 },
    vilanova: { name: 'Vilanova i la Geltrú', latitudeDeg: 41.222704, longitudeDeg: 1.72398 },
  };
  const updateWeekRange = () => {
    if (!weekRange) return;
    const year = Number(field('year').value);
    const week = Number(field('week').value);
    if (!Number.isInteger(year) || !Number.isInteger(week) || week < 1 || week > isoWeeksInYear(year)) { weekRange.textContent = ''; return; }
    const start = isoWeekStart(year, week);
    const end = new Date(start.getTime() + 6 * 86400000);
    const formatter = new Intl.DateTimeFormat({ ca: 'ca-ES', es: 'es-ES', en: 'en-GB' }[config.lang] ?? 'es-ES', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
    weekRange.textContent = `${typeof formatter.formatRange === 'function' ? formatter.formatRange(start, end) : `${formatter.format(start)} — ${formatter.format(end)}`} · UTC`;
  };
  updateWeekRange();
  const requestedObject = requestUrl.searchParams.get('object');
  const hasRequestedObject = requestedObject && config.objects.some((object: any) => object.id === requestedObject);
  if (hasRequestedObject) {
    objectMode = 'local';
    field('localObject').value = requestedObject!;
  } else {
    if (session.objectInputMode) objectMode = session.objectInputMode;
    if (session.object?.localObjectId && config.objects.some((object: any) => object.id === session.object.localObjectId)) field('localObject').value = session.object.localObjectId;
    else if (session.object?.source === 'simbad' && Number.isFinite(session.object.raDeg) && Number.isFinite(session.object.decDeg)) {
      resolvedSimbad = { ...session.object, displayName: formatCatalogDesignations(session.object.displayName) };
      field('simbadQuery').value = session.object.canonicalName ?? session.object.displayName;
      if (simbadResult) simbadResult.textContent = `${resolvedSimbad.displayName} · AR ${session.object.raDeg.toFixed(6)}° · Dec ${session.object.decDeg.toFixed(6)}°`;
    }
  }

  const localObjectSearch = field('localObjectSearch') as HTMLInputElement;
  const localObjectResults = root.querySelector<HTMLElement>('[data-object-results]');
  const objectLabel = (object: any) => object.commonName ? `${object.displayCatalogName} · ${object.commonName}` : object.displayCatalogName;
  const normalizeSearch = (value: string) => value.normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-zA-Z0-9]+/g, '').toLocaleLowerCase();
  const syncLocalObjectSearch = () => {
    const selected = config.objects.find((object: any) => object.id === field('localObject').value);
    localObjectSearch.value = selected ? objectLabel(selected) : '';
  };
  syncLocalObjectSearch();
  const closeLocalObjectResults = () => {
    if (localObjectResults) localObjectResults.hidden = true;
    localObjectSearch.setAttribute('aria-expanded', 'false');
  };
  const positionMobileObjectResults = () => {
    if (!localObjectResults || !window.matchMedia('(max-width: 520px)').matches || localObjectResults.hidden) return;
    const viewport = window.visualViewport;
    const viewportTop = viewport?.offsetTop ?? 0;
    const viewportHeight = viewport?.height ?? window.innerHeight;
    const viewportBottom = viewportTop + viewportHeight;
    const inputBottom = localObjectSearch.getBoundingClientRect().bottom;
    const spaceBelowInput = viewportBottom - inputBottom - 8;
    const panelHeight = Math.min(viewportHeight * .42, 288, Math.max(spaceBelowInput, 144));
    const preferredTop = inputBottom + 6;
    const top = preferredTop + panelHeight <= viewportBottom - 8 ? preferredTop : viewportBottom - panelHeight - 8;
    localObjectResults.style.top = `${Math.max(viewportTop + 8, top)}px`;
    localObjectResults.style.bottom = 'auto';
    localObjectResults.style.maxHeight = `${panelHeight}px`;
  };
  const chooseLocalObject = (selected: any) => {
    if (!selected) return;
    field('localObject').value = selected.id;
    localObjectSearch.value = objectLabel(selected);
    field('localObject').dispatchEvent(new Event('change', { bubbles: true }));
    closeLocalObjectResults();
  };
  const matchingLocalObjects = (showAll = false) => {
    const query = normalizeSearch(localObjectSearch.value);
    if (showAll || !query) return config.objects;
    return config.objects
      .filter((object: any) => normalizeSearch(`${objectLabel(object)} ${object.catalogName} ${object.id}`).includes(query));
  };
  const renderLocalObjectResults = (showAll = false) => {
    if (!localObjectResults) return;
    if (window.matchMedia('(max-width: 520px)').matches && localObjectResults.parentElement !== document.body) document.body.append(localObjectResults);
    const matches = matchingLocalObjects(showAll);
    localObjectResults.replaceChildren();
    if (!matches.length) {
      const empty = document.createElement('p');
      empty.className = 'planning-object-results__empty';
      empty.textContent = config.texts.noObjectMatches;
      localObjectResults.append(empty);
    } else {
      matches.forEach((object: any) => {
        const button = document.createElement('button');
        button.type = 'button';
        button.role = 'option';
        button.dataset.objectId = object.id;
        button.textContent = objectLabel(object);
        button.addEventListener('pointerdown', (event) => event.preventDefault());
        button.addEventListener('click', () => chooseLocalObject(object));
        localObjectResults.append(button);
      });
    }
    localObjectResults.hidden = false;
    localObjectSearch.setAttribute('aria-expanded', 'true');
    window.requestAnimationFrame(positionMobileObjectResults);
  };
  window.visualViewport?.addEventListener('resize', positionMobileObjectResults);
  window.visualViewport?.addEventListener('scroll', positionMobileObjectResults);
  localObjectSearch.addEventListener('pointerdown', () => renderLocalObjectResults(true));
  localObjectSearch.addEventListener('touchstart', () => renderLocalObjectResults(true), { passive: true });
  localObjectSearch.addEventListener('focus', () => renderLocalObjectResults(true));
  localObjectSearch.addEventListener('click', () => renderLocalObjectResults(true));
  localObjectSearch.addEventListener('input', renderLocalObjectResults);
  localObjectSearch.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') { closeLocalObjectResults(); return; }
    if (event.key === 'Enter') {
      const firstMatch = matchingLocalObjects()[0];
      if (firstMatch) { event.preventDefault(); chooseLocalObject(firstMatch); }
    }
    if (event.key === 'ArrowDown') {
      event.preventDefault();
      if (localObjectResults?.hidden) renderLocalObjectResults();
      localObjectResults?.querySelector<HTMLButtonElement>('button')?.focus();
    }
  });
  localObjectSearch.addEventListener('change', () => {
    const query = normalizeSearch(localObjectSearch.value);
    const exact = config.objects.find((object: any) => normalizeSearch(objectLabel(object)) === query);
    if (exact) chooseLocalObject(exact);
  });
  localObjectSearch.addEventListener('blur', () => window.setTimeout(closeLocalObjectResults, 120));

  const modeButtons = [...root.querySelectorAll<HTMLButtonElement>('[data-object-mode]')];
  const modePanels = [...root.querySelectorAll<HTMLElement>('[data-object-panel]')];
  const setObjectMode = (mode: string, changed = false) => {
    objectMode = ['local', 'simbad', 'manual'].includes(mode) ? mode : 'local';
    modeButtons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.objectMode === objectMode)));
    modePanels.forEach((panel) => { panel.hidden = panel.dataset.objectPanel !== objectMode; });
    sessionStorage.setItem('deepskyastro:planning-object-mode', objectMode);
    if (changed) { invalidateObjectResults(); markDirty(); persist(); }
  };
  modeButtons.forEach((button) => button.addEventListener('click', () => setObjectMode(button.dataset.objectMode ?? 'local', true)));
  setObjectMode(objectMode);

  field('locationName').addEventListener('change', () => {
    const preset = Object.values(locationPresets).find((location) => location.name.toLocaleLowerCase() === field('locationName').value.trim().toLocaleLowerCase());
    if (!preset) return;
    field('locationName').value = preset.name;
    field('latitude').value = String(preset.latitudeDeg);
    field('longitude').value = String(preset.longitudeDeg);
    persist(); markDirty();
  });
  ['latitude', 'longitude'].forEach((name) => field(name).addEventListener('input', () => {
    field('locationName').value = '';
  }));
  ['latitude', 'longitude'].forEach((name) => field(name).addEventListener('change', () => {
    const value = decimalValue(field(name).value);
    if (Number.isFinite(value)) field(name).value = String(value);
  }));

  const decimalValue = (value: string) => Number(value.trim().replace(',', '.'));
  const locationValue = () => ({
    name: field('locationName').value.trim() || `${decimalValue(field('latitude').value).toFixed(5)}, ${decimalValue(field('longitude').value).toFixed(5)}`,
    latitudeDeg: decimalValue(field('latitude').value), longitudeDeg: decimalValue(field('longitude').value), elevationM: 0,
  });
  const objectValue = () => {
    if (objectMode === 'manual') return {
      displayName: field('manualName').value.trim() || 'J2000', raDeg: Number(field('manualRa').value), decDeg: Number(field('manualDec').value), epoch: 'J2000', frame: 'ICRS', source: 'manual',
    };
    if (objectMode === 'simbad') return resolvedSimbad ?? { displayName: '—', raDeg: Number.NaN, decDeg: Number.NaN, epoch: 'J2000', frame: 'ICRS', source: 'simbad' };
    const selected = config.objects.find((object: any) => object.id === field('localObject').value);
    return { displayName: selected.commonName ? `${selected.displayCatalogName} · ${selected.commonName}` : selected.displayCatalogName, canonicalName: selected.catalogName, raDeg: selected.raDeg, decDeg: selected.decDeg, epoch: 'J2000', frame: 'ICRS', source: selected.source, localObjectId: selected.id };
  };
  const persist = () => {
    const location = locationValue();
    if (!Number.isFinite(location.latitudeDeg) || !Number.isFinite(location.longitudeDeg)) return;
    savePlanningSession(sessionStorage, { version: 1, location, object: objectValue(), objectInputMode: objectMode, isoYear: Number(field('year').value), isoWeek: Number(field('week').value), selectedNightDateUtc: selectedNight?.nightDateUtc });
  };
  ['locationName', 'latitude', 'longitude', 'localObject', 'year', 'week'].forEach((name) => field(name).addEventListener('change', persist));
  ['year', 'week'].forEach((name) => field(name).addEventListener('input', updateWeekRange));
  root.querySelectorAll<HTMLButtonElement>('[data-step-field]').forEach((button) => button.addEventListener('click', () => {
    const name = button.dataset.stepField ?? '';
    const direction = Number(button.dataset.stepDirection) < 0 ? -1 : 1;
    const control = field(name);
    if (control instanceof HTMLSelectElement) {
      const selectable = [...control.options].filter((option) => option.value);
      const current = selectable.findIndex((option) => option.value === control.value);
      const next = current < 0
        ? (direction > 0 ? 0 : selectable.length - 1)
        : (current + direction + selectable.length) % selectable.length;
      control.value = selectable[next]?.value ?? '';
    } else if (name === 'week') {
      let year = Number(field('year').value);
      let week = Number(control.value) + direction;
      if (week < 1) { year -= 1; week = isoWeeksInYear(year); }
      else if (week > isoWeeksInYear(year)) { year += 1; week = 1; }
      field('year').value = String(year);
      control.value = String(week);
    } else if (control instanceof HTMLInputElement) {
      direction > 0 ? control.stepUp() : control.stepDown();
    }
    control.dispatchEvent(new Event('input', { bubbles: true }));
    control.dispatchEvent(new Event('change', { bubbles: true }));
  }));
  field('localObject').addEventListener('change', () => { resolvedSimbad = null; if (simbadResult) simbadResult.textContent = ''; invalidateObjectResults(); });
  field('simbadQuery').addEventListener('input', () => { resolvedSimbad = null; if (simbadResult) simbadResult.textContent = ''; invalidateObjectResults(); });
  field('simbadQuery').addEventListener('input', () => simbadButton?.classList.add('is-dirty'));

  simbadButton?.addEventListener('click', async () => {
    const query = field('simbadQuery').value.trim();
    if (!query) return;
    simbadButton.disabled = true; simbadButton.classList.remove('is-dirty'); simbadButton.textContent = config.texts.resolving;
    if (simbadResult) simbadResult.textContent = '';
    try {
      const local = findLocalObject(config.objects, query);
      if (local) {
        field('localObject').value = local.id;
        syncLocalObjectSearch();
        resolvedSimbad = { displayName: local.commonName ? `${local.displayCatalogName} · ${local.commonName}` : local.displayCatalogName, canonicalName: local.catalogName, raDeg: local.raDeg, decDeg: local.decDeg, epoch: 'J2000', frame: 'ICRS', source: local.source, localObjectId: local.id };
        if (simbadResult) simbadResult.textContent = `${config.texts.localResolved}: ${local.displayCatalogName}${local.commonName ? ` · ${local.commonName}` : ''}`;
      } else {
        resolvedSimbad = await resolveSimbad(query);
        if (simbadResult) simbadResult.textContent = `${resolvedSimbad.displayName} · AR ${resolvedSimbad.raDeg.toFixed(6)}° · Dec ${resolvedSimbad.decDeg.toFixed(6)}°`;
      }
      markDirty(); persist();
    } catch (caught) { console.error(caught); if (simbadResult) simbadResult.textContent = config.texts.simbadError; }
    finally { simbadButton.disabled = false; simbadButton.textContent = config.texts.resolve; }
  });

  const minutes = (value: number) => {
    const rounded = Math.round(value);
    return `${Math.floor(rounded / 60)} h ${(rounded % 60).toString().padStart(2, '0')} min`;
  };
  const time = (value?: string) => value ? `${value.slice(11, 16)} UTC` : config.texts.none;
  const timeSpan = (item?: { startUtc: string; endUtc: string }) => item
    ? `${time(item.startUtc)}–${time(item.endUtc)}`.replace(/ UTC–/, '–')
    : config.texts.none;
  const interval = (items: any[]) => items.length ? items.map((item) => `${time(item.startUtc)}–${time(item.endUtc)}`).join(', ') : config.texts.none;
  const degrees = (value?: number | null) => Number.isFinite(value) ? `${Number(value).toFixed(1)}°` : config.texts.none;
  const percent = (value?: number | null) => Number.isFinite(value) ? `${(Number(value) * 100).toFixed(0)} %` : config.texts.none;

  const setConclusionValue = (selector: string, value: string) => {
    const element = root.querySelector<HTMLElement>(selector);
    if (element) element.textContent = value;
  };
  const dateLabel = (timestamp: string) => new Intl.DateTimeFormat(
    { ca: 'ca-ES', es: 'es-ES', en: 'en-GB' }[config.lang] ?? 'es-ES',
    { day: 'numeric', month: 'short', timeZone: 'UTC' },
  ).format(new Date(timestamp)).replace('.', '');
  const nightLabel = (night: any) => {
    const start = `${night.nightDateUtc}T12:00:00.000Z`;
    const end = new Date(Date.parse(start) + 86400000).toISOString();
    return `${dateLabel(start)} → ${dateLabel(end)}`;
  };
  const nightPhrase = (night: any) => {
    const start = new Date(`${night.nightDateUtc}T12:00:00.000Z`);
    const end = new Date(start.getTime() + 86400000);
    const month = new Intl.DateTimeFormat(
      { ca: 'ca-ES', es: 'es-ES', en: 'en-GB' }[config.lang] ?? 'es-ES',
      { month: 'long', timeZone: 'UTC' },
    ).format(end);
    if (start.getUTCMonth() === end.getUTCMonth()) {
      if (config.lang === 'en') return `${start.getUTCDate()}–${end.getUTCDate()} ${month}`;
      return `${start.getUTCDate()} al ${end.getUTCDate()} de ${month}`;
    }
    return nightLabel(night);
  };
  const bestWeekNight = () => analysis?.nights
    .filter((night: any) => night.status === 'available')
    .sort((left: any, right: any) => {
      const quality = (night: any) => night.effectiveMoonDownMinutes + night.effectiveMinutes * .35 + Math.max(0, night.maxObjectAltitudeDeg);
      return quality(right) - quality(left);
    })[0] ?? null;
  const conclusionRating = (night: any) => {
    const favourableMoon = night.effectiveMoonDownMinutes >= 180
      || ((night.bestMoonUp?.moonIlluminationFraction ?? 1) <= .25 && (night.bestMoonUp?.moonSeparationDeg ?? 0) >= 60);
    if (night.effectiveMinutes >= 300 && night.maxObjectAltitudeDeg >= 50 && favourableMoon) return config.texts.excellent;
    if (night.effectiveMinutes >= 120 && night.maxObjectAltitudeDeg >= 35) return config.texts.favourable;
    if (night.effectiveMinutes > 0) return config.texts.limited;
    return config.texts.notRecommended;
  };
  const weeklyComment = (night: any, object: any, location: any) => {
    if (!night) {
      if (config.lang === 'ca') return `${object.displayName} no supera els 30° durant la nit astronòmica d’aquesta setmana des de ${location.name}. Convé triar una altra setmana o un altre objecte.`;
      if (config.lang === 'en') return `${object.displayName} does not rise above 30° during astronomical night this week from ${location.name}. Choose another week or another target.`;
      return `${object.displayName} no supera los 30° durante la noche astronómica de esta semana desde ${location.name}. Conviene elegir otra semana u otro objeto.`;
    }
    const useful = night.intervals.effective[0];
    const culmination = night.usefulCulmination;
    const moonless = night.effectiveMoonDownMinutes;
    const moonUp = night.bestMoonUp;
    const moonFraction = night.effectiveMinutes > 0 ? moonless / night.effectiveMinutes : 0;
    const usefulTimes = timeSpan(useful);
    const moonlessInterval = night.intervals.effectiveMoonDown[0];
    const moonlessTimes = moonlessInterval ? timeSpan(moonlessInterval) : '';
    const moonEffect = !moonUp ? 'none' : moonUp.moonIlluminationFraction <= .25 && moonUp.moonSeparationDeg >= 60 ? 'low' : moonUp.moonIlluminationFraction <= .6 && moonUp.moonSeparationDeg >= 45 ? 'manageable' : 'relevant';
    const availableNights = analysis.nights.filter((item: any) => item.status === 'available');
    const moonlessTrend = availableNights.length > 1
      ? availableNights.at(-1).effectiveMoonDownMinutes - availableNights[0].effectiveMoonDownMinutes
      : 0;
    if (config.lang === 'ca') {
      const trend = moonlessTrend >= 90 ? `Les condicions lunars milloren clarament a mesura que avança la setmana.` : moonlessTrend <= -90 ? `Les condicions lunars empitjoren a mesura que avança la setmana; convé aprofitar-ne l’inici.` : '';
      const lunar = moonFraction >= .75
        ? `La Lluna queda sota l’horitzó durant gairebé tota la finestra.`
        : moonless > 0
          ? `Prioritza el tram sense Lluna de ${moonlessTimes}; després, la seva influència és ${moonEffect === 'low' ? 'baixa' : moonEffect === 'manageable' ? 'moderada' : 'important'}.`
          : `La Lluna és present tota la finestra i la seva influència és ${moonEffect === 'low' ? 'baixa' : moonEffect === 'manageable' ? 'moderada' : 'important'}.`;
      return `${conclusionRating(night)} per a ${object.displayName} des de ${location.name}. ${trend} La millor oportunitat és la nit del ${nightPhrase(night)}, amb ${minutes(night.effectiveMinutes)} útils (${usefulTimes}) i una culminació de ${degrees(culmination?.objectAltitudeDeg)} a les ${time(culmination?.timestampUtc)}. ${lunar}`.replace(/\.  /g, '. ');
    }
    if (config.lang === 'en') {
      const trend = moonlessTrend >= 90 ? `Lunar conditions improve markedly as the week progresses.` : moonlessTrend <= -90 ? `Lunar conditions deteriorate as the week progresses, so favour the beginning of the week.` : '';
      const lunar = moonFraction >= .75
        ? `The Moon remains below the horizon for almost the entire window.`
        : moonless > 0
          ? `Prioritise the Moonless interval from ${moonlessTimes}; afterwards, its effect is ${moonEffect === 'low' ? 'low' : moonEffect === 'manageable' ? 'moderate' : 'significant'}.`
          : `The Moon is present throughout the window and its effect is ${moonEffect === 'low' ? 'low' : moonEffect === 'manageable' ? 'moderate' : 'significant'}.`;
      return `${conclusionRating(night)} for ${object.displayName} from ${location.name}. ${trend} The best opportunity is the night of ${nightPhrase(night)}, with ${minutes(night.effectiveMinutes)} of useful time (${usefulTimes}) and culmination at ${degrees(culmination?.objectAltitudeDeg)} at ${time(culmination?.timestampUtc)}. ${lunar}`.replace(/\.  /g, '. ');
    }
    const trend = moonlessTrend >= 90 ? `Las condiciones lunares mejoran claramente a medida que avanza la semana.` : moonlessTrend <= -90 ? `Las condiciones lunares empeoran a medida que avanza la semana; conviene aprovechar su inicio.` : '';
    const lunar = moonFraction >= .75
      ? `La Luna permanece bajo el horizonte durante casi toda la ventana.`
      : moonless > 0
        ? `Prioriza el tramo sin Luna de ${moonlessTimes}; después, su influencia es ${moonEffect === 'low' ? 'baja' : moonEffect === 'manageable' ? 'moderada' : 'importante'}.`
        : `La Luna está presente durante toda la ventana y su influencia es ${moonEffect === 'low' ? 'baja' : moonEffect === 'manageable' ? 'moderada' : 'importante'}.`;
    return `${conclusionRating(night)} para ${object.displayName} desde ${location.name}. ${trend} La mejor oportunidad es la noche del ${nightPhrase(night)}, con ${minutes(night.effectiveMinutes)} útiles (${usefulTimes}) y una culminación de ${degrees(culmination?.objectAltitudeDeg)} a las ${time(culmination?.timestampUtc)}. ${lunar}`.replace(/\.  /g, '. ');
  };
  const renderConclusion = (object: any, location: any) => {
    if (!conclusion) return;
    const best = bestWeekNight();
    conclusion.hidden = false;
    conclusion.dataset.rating = best ? conclusionRating(best).toLocaleLowerCase() : 'unavailable';
    setConclusionValue('[data-conclusion-rating]', best ? conclusionRating(best) : config.texts.notRecommended);
    setConclusionValue('[data-conclusion-night]', best ? nightLabel(best) : config.texts.none);
    setConclusionValue('[data-conclusion-window]', best ? best.intervals.effective.map(timeSpan).join(', ') : config.texts.none);
    setConclusionValue('[data-conclusion-moonless]', best ? minutes(best.effectiveMoonDownMinutes) : config.texts.none);
    setConclusionValue('[data-conclusion-culmination]', best ? `${degrees(best.usefulCulmination?.objectAltitudeDeg)} · ${time(best.usefulCulmination?.timestampUtc)}` : config.texts.none);
    setConclusionValue('[data-conclusion-comment]', weeklyComment(best, object, location));
  };

  const planningText = () => {
    if (!analysis) return '';
    const best = bestWeekNight();
    const lines = [
      `${config.texts.title.toLocaleUpperCase()} — ${analysis.object.displayName}`,
      `${config.texts.location}: ${analysis.location.name} (${analysis.location.latitudeDeg.toFixed(5)}, ${analysis.location.longitudeDeg.toFixed(5)})`,
      `${config.texts.week}: ${analysis.isoWeek} · ${config.texts.year}: ${analysis.isoYear}`,
      '',
      `${config.texts.conclusionTitle.toLocaleUpperCase()}`,
      best ? `${conclusionRating(best)} · ${config.texts.bestNight}: ${nightLabel(best)}` : config.texts.notRecommended,
      best ? `${config.texts.usefulWindow}: ${timeSpan(best.intervals.effective[0])} (${minutes(best.effectiveMinutes)})` : '',
      best ? `${config.texts.moonlessTime}: ${minutes(best.effectiveMoonDownMinutes)}` : '',
      best ? `${config.texts.culmination}: ${degrees(best.usefulCulmination?.objectAltitudeDeg)} · ${time(best.usefulCulmination?.timestampUtc)}` : '',
      '',
      weeklyComment(best, analysis.object, analysis.location),
      '',
      config.texts.comparison.toLocaleUpperCase(),
      ...analysis.nights.map((night: any) => `${night.nightDateUtc} · ${config.texts.effective}: ${minutes(night.effectiveMinutes)} · ${config.texts.moonDown}: ${minutes(night.effectiveMoonDownMinutes)} · ${config.texts.maxAltitude}: ${degrees(night.maxObjectAltitudeDeg)}`),
      '',
      `${config.texts.detail}: ${selectedNight?.nightDateUtc ?? config.texts.none}`,
      config.texts.geometryNotice,
    ];
    return lines.filter((line, index) => line || lines[index - 1]).join('\n');
  };

  const wrapCanvasText = (context: CanvasRenderingContext2D, textValue: string, x: number, y: number, maxWidth: number, lineHeight: number) => {
    const paragraphs = textValue.split('\n');
    let cursorY = y;
    paragraphs.forEach((paragraph) => {
      if (!paragraph) { cursorY += lineHeight * .65; return; }
      const words = paragraph.split(/\s+/);
      let line = '';
      words.forEach((word) => {
        const candidate = line ? `${line} ${word}` : word;
        if (context.measureText(candidate).width > maxWidth && line) { context.fillText(line, x, cursorY); cursorY += lineHeight; line = word; }
        else line = candidate;
      });
      if (line) { context.fillText(line, x, cursorY); cursorY += lineHeight; }
    });
    return cursorY;
  };
  const reportCanvas = () => {
    const canvas = document.createElement('canvas');
    canvas.width = 1240; canvas.height = 1754;
    const context = canvas.getContext('2d')!;
    context.fillStyle = '#f7f5ef'; context.fillRect(0, 0, canvas.width, canvas.height);
    context.fillStyle = '#c68418'; context.fillRect(0, 0, 24, canvas.height);
    return { canvas, context };
  };
  const reportHeader = (context: CanvasRenderingContext2D, page: number) => {
    context.fillStyle = '#111827'; context.font = '700 42px Arial'; context.fillText('DeepSkyAstro', 78, 92);
    context.fillStyle = '#9a6718'; context.font = '700 18px Arial'; context.fillText(config.texts.title.toLocaleUpperCase(), 80, 132);
    context.textAlign = 'right'; context.fillStyle = '#667085'; context.font = '18px Arial'; context.fillText(`${page} / 2`, 1160, 92); context.textAlign = 'left';
    context.strokeStyle = '#d6c7ad'; context.lineWidth = 2; context.beginPath(); context.moveTo(80, 158); context.lineTo(1160, 158); context.stroke();
  };
  const summaryReportPage = () => {
    const { canvas, context } = reportCanvas(); reportHeader(context, 1);
    const best = bestWeekNight(); let y = 224;
    context.fillStyle = '#111827'; context.font = '700 40px Arial'; y = wrapCanvasText(context, analysis.object.displayName, 80, y, 1080, 48) + 12;
    context.fillStyle = '#475467'; context.font = '22px Arial';
    y = wrapCanvasText(context, `${analysis.location.name} · ${analysis.location.latitudeDeg.toFixed(5)}, ${analysis.location.longitudeDeg.toFixed(5)} · ${config.texts.week} ${analysis.isoWeek}, ${analysis.isoYear}`, 80, y, 1080, 32) + 34;
    context.fillStyle = '#9a6718'; context.font = '700 22px Arial'; context.fillText(config.texts.conclusionTitle.toLocaleUpperCase(), 80, y); y += 48;
    context.fillStyle = '#111827'; context.font = '700 30px Arial'; context.fillText(best ? conclusionRating(best) : config.texts.notRecommended, 80, y); y += 52;
    context.font = '700 22px Arial';
    const metrics = best ? [
      [config.texts.bestNight, nightLabel(best)],
      [config.texts.usefulWindow, `${timeSpan(best.intervals.effective[0])} · ${minutes(best.effectiveMinutes)}`],
      [config.texts.moonlessTime, minutes(best.effectiveMoonDownMinutes)],
      [config.texts.culmination, `${degrees(best.usefulCulmination?.objectAltitudeDeg)} · ${time(best.usefulCulmination?.timestampUtc)}`],
    ] : [];
    metrics.forEach(([label, value], index) => {
      const x = 80 + (index % 2) * 540; if (index === 2) y += 98;
      context.fillStyle = '#667085'; context.font = '18px Arial'; context.fillText(label, x, y);
      context.fillStyle = '#111827'; context.font = '700 23px Arial'; context.fillText(value, x, y + 34);
    });
    y += 112; context.fillStyle = '#344054'; context.font = '22px Arial'; y = wrapCanvasText(context, weeklyComment(best, analysis.object, analysis.location), 80, y, 1080, 32) + 34;
    context.fillStyle = '#9a6718'; context.font = '700 21px Arial'; context.fillText(config.texts.comparison.toLocaleUpperCase(), 80, y); y += 42;
    context.fillStyle = '#667085'; context.font = '700 16px Arial'; context.fillText(config.texts.night, 80, y); context.fillText(config.texts.effective, 350, y); context.fillText(config.texts.moonDown, 650, y); context.fillText(config.texts.maxAltitude, 925, y); y += 24;
    analysis.nights.forEach((night: any, index: number) => {
      if (index % 2 === 0) { context.fillStyle = '#eee9df'; context.fillRect(70, y - 22, 1100, 56); }
      context.fillStyle = '#1d2939'; context.font = '19px Arial'; context.fillText(night.nightDateUtc, 80, y + 12); context.fillText(minutes(night.effectiveMinutes), 350, y + 12); context.fillText(minutes(night.effectiveMoonDownMinutes), 650, y + 12); context.fillText(degrees(night.maxObjectAltitudeDeg), 925, y + 12); y += 58;
    });
    context.fillStyle = '#667085'; context.font = '17px Arial'; wrapCanvasText(context, config.texts.geometryNotice, 80, 1662, 1080, 25);
    return canvas;
  };
  const detailReportPage = async () => {
    const { canvas, context } = reportCanvas(); reportHeader(context, 2);
    context.fillStyle = '#111827'; context.font = '700 36px Arial'; context.fillText(`${config.texts.detail} · ${selectedNight.nightDateUtc}`, 80, 230);
    context.fillStyle = '#475467'; context.font = '22px Arial';
    context.fillText(`${config.texts.effective}: ${minutes(selectedNight.effectiveMinutes)} · ${config.texts.moonDown}: ${minutes(selectedNight.effectiveMoonDownMinutes)} · ${config.texts.maxAltitude}: ${degrees(selectedNight.maxObjectAltitudeDeg)}`, 80, 280);
    context.fillStyle = '#080b12'; context.fillRect(80, 340, 1080, 520);
    const clonedChart = chart!.cloneNode(true) as SVGSVGElement;
    const style = document.createElementNS('http://www.w3.org/2000/svg', 'style');
    style.textContent = `.planning-chart__darkness{fill:rgba(72,91,132,.25)}.planning-chart__grid{stroke:rgba(124,143,172,.28);stroke-width:1}.planning-chart__threshold{stroke:#c68418;stroke-width:1.4;stroke-dasharray:7 6}.planning-chart__object,.planning-chart__moon,.planning-chart__object-context,.planning-chart__moon-context{fill:none}.planning-chart__object-context,.planning-chart__moon-context{stroke-width:1.5;opacity:.24}.planning-chart__object-context,.planning-chart__object{stroke:#e5a93f}.planning-chart__moon-context,.planning-chart__moon{stroke:#55d9b3;stroke-dasharray:7 5}.planning-chart__object,.planning-chart__moon{stroke-width:2.8}.planning-chart__label,.planning-chart__utc{fill:#aeb9ca;font:12px monospace}.planning-chart__cursor{stroke:#fff}`;
    clonedChart.prepend(style); clonedChart.setAttribute('xmlns', 'http://www.w3.org/2000/svg');
    const svgUrl = URL.createObjectURL(new Blob([new XMLSerializer().serializeToString(clonedChart)], { type: 'image/svg+xml' }));
    try {
      const image = new Image(); await new Promise<void>((resolve, reject) => { image.onload = () => resolve(); image.onerror = () => reject(new Error('Chart export failed')); image.src = svgUrl; });
      context.drawImage(image, 95, 365, 1050, 452);
    } finally { URL.revokeObjectURL(svgUrl); }
    let y = 930; context.fillStyle = '#9a6718'; context.font = '700 21px Arial'; context.fillText(config.texts.detail.toLocaleUpperCase(), 80, y); y += 48;
    context.fillStyle = '#344054'; context.font = '22px Arial';
    const details = [
      `${config.texts.astronomyNight}: ${timeSpan(selectedNight.intervals.astronomicalNight[0])}`,
      `${config.texts.usefulWindow}: ${timeSpan(selectedNight.intervals.effective[0])} · ${minutes(selectedNight.effectiveMinutes)}`,
      `${config.texts.moonlessTime}: ${selectedNight.intervals.effectiveMoonDown.length ? selectedNight.intervals.effectiveMoonDown.map(timeSpan).join(', ') : config.texts.none} · ${minutes(selectedNight.effectiveMoonDownMinutes)}`,
      `${config.texts.culmination}: ${degrees(selectedNight.usefulCulmination?.objectAltitudeDeg)} · ${time(selectedNight.usefulCulmination?.timestampUtc)} · ${config.texts.azimuth}: ${degrees(selectedNight.usefulCulmination?.objectAzimuthDeg)}`,
      `${config.texts.moon}: ${percent(selectedNight.bestMoonUp?.moonIlluminationFraction)} · ${config.texts.separation}: ${degrees(selectedNight.bestMoonUp?.moonSeparationDeg)}`,
    ];
    details.forEach((value) => { y = wrapCanvasText(context, value, 80, y, 1080, 34) + 16; });
    context.fillStyle = '#667085'; context.font = '17px Arial'; wrapCanvasText(context, `${config.texts.engine} ${config.texts.geometryNotice}`, 80, 1640, 1080, 25);
    return canvas;
  };
  const canvasJpeg = (canvas: HTMLCanvasElement) => new Promise<Uint8Array>((resolve, reject) => canvas.toBlob(async (blob) => blob ? resolve(new Uint8Array(await blob.arrayBuffer())) : reject(new Error('PDF image failed')), 'image/jpeg', .92));
  const pdfFromJpegs = (images: { bytes: Uint8Array; width: number; height: number }[]) => {
    const encoder = new TextEncoder(); const objects = new Map<number, Uint8Array>();
    const asBytes = (value: string) => encoder.encode(value);
    const join = (parts: Uint8Array[]) => { const size = parts.reduce((sum, part) => sum + part.length, 0); const result = new Uint8Array(size); let offset = 0; parts.forEach((part) => { result.set(part, offset); offset += part.length; }); return result; };
    objects.set(1, asBytes('<< /Type /Catalog /Pages 2 0 R >>'));
    objects.set(2, asBytes(`<< /Type /Pages /Count ${images.length} /Kids [${images.map((_, index) => `${3 + index * 3} 0 R`).join(' ')}] >>`));
    images.forEach((image, index) => {
      const page = 3 + index * 3, content = page + 1, picture = page + 2;
      objects.set(page, asBytes(`<< /Type /Page /Parent 2 0 R /MediaBox [0 0 595 842] /Resources << /XObject << /Im0 ${picture} 0 R >> >> /Contents ${content} 0 R >>`));
      const drawing = asBytes('q\n595 0 0 842 0 0 cm\n/Im0 Do\nQ');
      objects.set(content, join([asBytes(`<< /Length ${drawing.length} >>\nstream\n`), drawing, asBytes('\nendstream')]));
      objects.set(picture, join([asBytes(`<< /Type /XObject /Subtype /Image /Width ${image.width} /Height ${image.height} /ColorSpace /DeviceRGB /BitsPerComponent 8 /Filter /DCTDecode /Length ${image.bytes.length} >>\nstream\n`), image.bytes, asBytes('\nendstream')]));
    });
    const chunks: Uint8Array[] = [new Uint8Array([37, 80, 68, 70, 45, 49, 46, 52, 10, 37, 226, 227, 207, 211, 10])]; const offsets = [0]; let position = chunks[0].length;
    for (let number = 1; number <= objects.size; number += 1) { offsets[number] = position; const chunk = join([asBytes(`${number} 0 obj\n`), objects.get(number)!, asBytes('\nendobj\n')]); chunks.push(chunk); position += chunk.length; }
    const xref = position; const entries = ['0000000000 65535 f ', ...offsets.slice(1).map((offset) => `${String(offset).padStart(10, '0')} 00000 n `)];
    chunks.push(asBytes(`xref\n0 ${objects.size + 1}\n${entries.join('\n')}\ntrailer\n<< /Size ${objects.size + 1} /Root 1 0 R >>\nstartxref\n${xref}\n%%EOF`));
    return new Blob(chunks as BlobPart[], { type: 'application/pdf' });
  };
  const confirmButton = (button: HTMLButtonElement, textValue: string) => {
    const original = button.textContent; button.textContent = textValue; button.classList.add('is-confirmed');
    window.setTimeout(() => { button.textContent = original; button.classList.remove('is-confirmed'); }, 2800);
  };
  copyPlanningButton?.addEventListener('click', async () => {
    const value = planningText();
    try { await navigator.clipboard.writeText(value); }
    catch { const area = document.createElement('textarea'); area.value = value; document.body.append(area); area.select(); document.execCommand('copy'); area.remove(); }
    confirmButton(copyPlanningButton, config.texts.copiedResults);
  });
  downloadPlanningButton?.addEventListener('click', async () => {
    if (!analysis || !selectedNight || !chart) return;
    downloadPlanningButton.disabled = true;
    try {
      const pages = [summaryReportPage(), await detailReportPage()];
      const images = await Promise.all(pages.map(async (page) => ({ bytes: await canvasJpeg(page), width: page.width, height: page.height })));
      const url = URL.createObjectURL(pdfFromJpegs(images)); const link = document.createElement('a');
      link.href = url; link.download = `planificacion-${analysis.object.canonicalName ?? analysis.object.displayName}-${analysis.isoYear}-S${String(analysis.isoWeek).padStart(2, '0')}.pdf`.replace(/[^a-zA-Z0-9._-]+/g, '-'); link.click();
      window.setTimeout(() => URL.revokeObjectURL(url), 4000); confirmButton(downloadPlanningButton, config.texts.downloadedPdf);
    } catch (caught) { console.error(caught); }
    finally { downloadPlanningButton.disabled = false; }
  });

  const renderRows = () => {
    if (!rows || !analysis) return;
    rows.innerHTML = analysis.nights.map((night: any) => {
      const moonMoment = night.bestMoonUp;
      const selected = night.nightDateUtc === selectedNight?.nightDateUtc;
      return `<tr class="${selected ? 'is-selected' : ''}" data-night="${night.nightDateUtc}">
        <th><button type="button" data-select-night="${night.nightDateUtc}" aria-pressed="${selected}">${night.nightDateUtc}<span>${config.texts.select}</span></button></th>
        <td>${interval(night.intervals.astronomicalNight)}</td><td>${degrees(night.maxObjectAltitudeDeg)}</td>
        <td>${night.status === 'available' ? `${minutes(night.effectiveMinutes)}<small>${interval(night.intervals.effective)}</small>` : config.texts.unavailable}</td>
        <td>${minutes(night.effectiveMoonDownMinutes)}</td><td>${time(night.bestMoonDown?.timestampUtc)}</td><td>${time(moonMoment?.timestampUtc)}</td>
        <td>${percent(moonMoment?.moonIlluminationFraction)}</td><td>${degrees(moonMoment?.moonSeparationDeg)}</td></tr>`;
    }).join('');
    rows.querySelectorAll<HTMLButtonElement>('[data-select-night]').forEach((button) => button.addEventListener('click', () => selectNight(button.dataset.selectNight)));
  };

  const svgNode = (name: string, attributes: Record<string, string>) => {
    const node = document.createElementNS('http://www.w3.org/2000/svg', name);
    Object.entries(attributes).forEach(([key, value]) => node.setAttribute(key, value));
    return node;
  };
  const renderChart = () => {
    if (!chart || !selectedNight) return;
    chart.replaceChildren();
    const samples = selectedNight.samples;
    const left = 58, right = 980, top = 18, bottom = 375;
    const x = (index: number) => left + index / (samples.length - 1) * (right - left);
    const y = (altitude: number) => bottom - (Math.max(-90, Math.min(90, altitude)) + 90) / 180 * (bottom - top);
    selectedNight.intervals.astronomicalNight.forEach((period: any) => {
      const startIndex = (Date.parse(period.startUtc) - Date.parse(samples[0].timestampUtc)) / 300000;
      const endIndex = (Date.parse(period.endUtc) - Date.parse(samples[0].timestampUtc)) / 300000;
      chart.append(svgNode('rect', { x: String(x(startIndex)), y: String(top), width: String(x(endIndex) - x(startIndex)), height: String(bottom - top), class: 'planning-chart__darkness' }));
    });
    [-90, -60, -30, 0, 30, 60, 90].forEach((tick) => {
      chart.append(svgNode('line', { x1: String(left), x2: String(right), y1: String(y(tick)), y2: String(y(tick)), class: tick === 30 ? 'planning-chart__threshold' : 'planning-chart__grid' }));
      const label = svgNode('text', { x: '48', y: String(y(tick) + 4), 'text-anchor': 'end', class: 'planning-chart__label' }); label.textContent = `${tick}°`; chart.append(label);
    });
    const path = (key: string, className: string, selectedSamples = samples) => chart.append(svgNode('polyline', { points: selectedSamples.map((sample: any) => `${x(samples.indexOf(sample))},${y(sample[key])}`).join(' '), class: className }));
    const nightSegments = (key: string, className: string) => {
      let segment: any[] = [];
      samples.forEach((sample: any, index: number) => {
        if (sample.isAstronomicalNight) segment.push(sample);
        if ((!sample.isAstronomicalNight || index === samples.length - 1) && segment.length) { if (segment.length > 1) path(key, className, segment); segment = []; }
      });
    };
    path('objectAltitudeDeg', 'planning-chart__object-context'); path('moonAltitudeDeg', 'planning-chart__moon-context');
    nightSegments('objectAltitudeDeg', 'planning-chart__object'); nightSegments('moonAltitudeDeg', 'planning-chart__moon');
    for (let hour = 0; hour <= 24; hour += 2) {
      const index = hour * 12;
      const label = svgNode('text', { x: String(x(index)), y: '403', 'text-anchor': 'middle', class: 'planning-chart__label' });
      label.textContent = `${samples[index].timestampUtc.slice(11, 16)}`; chart.append(label);
    }
    const utc = svgNode('text', { x: String(right), y: '422', 'text-anchor': 'end', class: 'planning-chart__utc' }); utc.textContent = 'UTC'; chart.append(utc);
    const cursor = svgNode('line', { x1: String(left), x2: String(left), y1: String(top), y2: String(bottom), class: 'planning-chart__cursor' }); chart.append(cursor);
    const showSample = (index: number, tooltipLeft: number) => {
      const sample = samples[index]; const cursorX = x(index); cursor.removeAttribute('hidden'); cursor.setAttribute('x1', String(cursorX)); cursor.setAttribute('x2', String(cursorX));
      if (tooltip && chart) {
        tooltip.hidden = false;
        tooltip.innerHTML = `<strong>${time(sample.timestampUtc)}</strong><span>${config.texts.objectCurve}: ${degrees(sample.objectAltitudeDeg)} · ${config.texts.azimuth}: ${degrees(sample.objectAzimuthDeg)}</span><span>${config.texts.moonCurve}: ${degrees(sample.moonAltitudeDeg)} · ${config.texts.illumination}: ${percent(sample.moonIlluminationFraction)}</span><span>${config.texts.separation}: ${degrees(sample.moonSeparationDeg)} · ${config.texts.sun}: ${degrees(sample.sunAltitudeDeg)}</span>`;
        const edgePadding = 12;
        const desiredLeft = tooltipLeft / 100 * chart.clientWidth;
        const halfTooltipWidth = tooltip.offsetWidth / 2;
        const ordinateAxisWidth = chart.clientWidth * (left / 1000);
        const minimumLeft = ordinateAxisWidth + halfTooltipWidth + edgePadding;
        const maximumLeft = chart.clientWidth - halfTooltipWidth - edgePadding;
        tooltip.style.left = `${Math.max(minimumLeft, Math.min(maximumLeft, desiredLeft))}px`;
      }
    };
    const inspect = (event: PointerEvent) => {
      const rect = chart.getBoundingClientRect();
      const viewX = (event.clientX - rect.left) / rect.width * 1000;
      const index = Math.max(0, Math.min(samples.length - 1, Math.round((viewX - left) / (right - left) * (samples.length - 1))));
      showSample(index, (event.clientX - rect.left) / rect.width * 100);
    };
    chart.onpointermove = inspect; chart.onpointerdown = (event) => { chart.setPointerCapture(event.pointerId); inspect(event); };
    const initialIndex = samples.reduce((best: number, sample: any, index: number) => sample.isAstronomicalNight && sample.objectAltitudeDeg > samples[best].objectAltitudeDeg ? index : best, samples.findIndex((sample: any) => sample.isAstronomicalNight));
    const safeInitialIndex = initialIndex >= 0 ? initialIndex : Math.floor(samples.length / 2);
    showSample(safeInitialIndex, x(safeInitialIndex) / 10);
  };
  const selectNight = (date?: string) => {
    selectedNight = analysis?.nights.find((night: any) => night.nightDateUtc === date) ?? analysis?.nights[0];
    root.querySelector<HTMLElement>('[data-night-date]')!.textContent = `${selectedNight.nightDateUtc} · UTC`;
    renderRows(); renderChart(); persist();
  };

  const calculate = async () => {
    if (error) error.hidden = true;
    const location = locationValue(); const object = objectValue(); const isoYear = Number(field('year').value); const isoWeek = Number(field('week').value);
    const valid = form.reportValidity() && Number.isFinite(location.latitudeDeg) && location.latitudeDeg >= -90 && location.latitudeDeg <= 90 && Number.isFinite(location.longitudeDeg) && location.longitudeDeg >= -180 && location.longitudeDeg <= 180 && Number.isFinite(object.raDeg) && object.raDeg >= 0 && object.raDeg < 360 && Number.isFinite(object.decDeg) && object.decDeg >= -90 && object.decDeg <= 90 && isoWeek <= isoWeeksInYear(isoYear);
    if (!valid) { if (error) error.hidden = false; invalidateObjectResults(); return; }
    if (calculateButton) { calculateButton.disabled = true; calculateButton.classList.remove('is-dirty'); calculateButton.textContent = config.texts.calculating; }
    await new Promise((resolve) => requestAnimationFrame(() => resolve(undefined)));
    try {
      analysis = analyzeWeek({ isoYear, isoWeek, location, object });
      selectedNight = bestWeekNight() ?? analysis.nights[0];
      root.querySelector<HTMLElement>('[data-selected-object]')!.textContent = object.displayName;
      root.querySelector<HTMLElement>('[data-week-label]')!.textContent = `${location.name} · ${analysis.weekStartUtc.slice(0, 10)} — ${new Date(Date.parse(analysis.weekEndUtc) - 86400000).toISOString().slice(0, 10)} UTC`;
      renderConclusion(object, location);
      if (results) results.hidden = false; if (nightDetail) nightDetail.hidden = false; selectNight(selectedNight.nightDateUtc);
    } catch (caught) { console.error(caught); if (error) error.hidden = false; }
    finally { if (calculateButton) { calculateButton.disabled = false; calculateButton.textContent = config.texts.calculate; } }
  };
  const markDirty = () => calculateButton?.classList.add('is-dirty');
  function invalidateObjectResults() {
    analysis = null; selectedNight = null;
    if (results) results.hidden = false;
    const selectedObject = root.querySelector<HTMLElement>('[data-selected-object]');
    const weekLabel = root.querySelector<HTMLElement>('[data-week-label]');
    if (selectedObject) selectedObject.textContent = '—';
    if (weekLabel) weekLabel.textContent = '';
    if (conclusion) conclusion.hidden = true;
    if (rows) rows.replaceChildren();
    if (nightDetail) nightDetail.hidden = true;
  }
  ['locationName', 'latitude', 'longitude', 'localObject', 'year', 'week', 'manualName', 'manualRa', 'manualDec'].forEach((name) => field(name).addEventListener('input', markDirty));
  ['manualName', 'manualRa', 'manualDec'].forEach((name) => field(name).addEventListener('input', invalidateObjectResults));
  form.addEventListener('submit', (event) => { event.preventDefault(); calculate(); });
  calculate();
</script>
