---
import type { Lang } from '../../i18n';
import { languageLinks, planningGuideHref, sessionPreparationHref, visibilityHref, withBase } from '../../i18n';
import Layout from '../../layouts/Layout.astro';
import SessionToolLink from '../SessionToolLink.astro';
import SiteMapIcon from '../SiteMapIcon.astro';
import objectsData from '../../data/astronomical-objects.json';
import { PUBLIC_PENDING_OBJECTS } from '../../config/features';
import { getCollection } from 'astro:content';
import { photoText } from '../../photoTranslations';
import { formatCatalogDesignations } from '../../lib/catalog-formatting.mjs';
import '../../styles/planning.css';
import '../../styles/period-calendar.css';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const base = import.meta.env.BASE_URL;
const texts = {
  ca: {
    title: 'Planificació', intro: 'Analitza un únic objecte durant set nits des de la ubicació que triïs. Utilitza aquesta eina quan ja sàpigues què vols fotografiar; tots els càlculs, dates i hores s’expressen en UTC.', guide: 'Guia de Planificació', guideTooltip: 'Manual complet de l’eina avançada de Planificació',
    location: '1 · Ubicació', locationName: 'Nom opcional', savedLocations: 'Cercar ubicació', latitude: 'Latitud', longitude: 'Longitud', session: 'La ubicació es conserva només durant aquesta sessió.',
    object: '2 · Objecte', localObject: 'Llista local', searchObject: 'Cercar un objecte', searchObjectPlaceholder: 'M 31, NGC 7000, nebulosa…', noObjectMatches: 'No hi ha coincidències', gallery: 'Galeria', pending: 'Pendents', simbad: 'SIMBAD', simbadQuery: 'Consulta SIMBAD', simbadPlaceholder: 'Nom o catàleg', resolve: 'Resoldre', resolving: 'Resolent…', simbadNote: 'Primer es comproven els objectes locals. SIMBAD només resol nom i coordenades durant aquesta sessió.', simbadError: 'SIMBAD no ha pogut resoldre aquest objecte.', localResolved: 'Coincidència local', manual: 'AR/Dec manuals', manualCoordinates: 'Coordenades manuals', ra: 'AR J2000 (graus)', dec: 'Dec J2000 (graus)',
    period: '3 · Període temporal i llindar', week: 'Setmana ISO', year: 'Any', month: 'Mes', days: 'Dies', selectedWeeklyPeriod: 'Període setmanal seleccionat', altitudeThreshold: 'Llindar d’altura', calculate: 'Calcular nits', calculating: 'Calculant…',
    conclusionTitle: 'Lectura de la setmana', bestNight: 'Millor nit', usefulWindow: 'Finestra útil', moonlessTime: 'Temps sense Lluna', culmination: 'Culminació', excellent: 'Excel·lent', favourable: 'Favorable', limited: 'Limitada', notRecommended: 'No recomanable', geometryNotice: 'Valoració geomètrica: no inclou núvols, transparència, seeing, vent ni obstacles de l’horitzó local.', downloadTxt: 'Descarrega el TXT', downloadedTxt: '✓ TXT descarregat', downloadPdf: 'Descarrega el PDF', downloadedPdf: '✓ PDF descarregat', exportHelp: 'Descarrega el resum en TXT o un informe PDF de dues pàgines.',
    comparison: '4 · Comparació de les set nits', night: 'Nit UTC', darkness: 'Nit astronòmica', maxAltitude: 'Alt. màx. nocturna', effective: 'Finestra >30°', moonDown: 'Sense Lluna', bestMoonDown: 'Millor hora sense Lluna', bestMoonUp: 'Millor hora amb Lluna', moon: 'Lluna', separation: 'Separació', unavailable: 'No supera 30° durant la nit astronòmica', none: '—', select: 'Seleccionar nit',
    detail: '5 · Detall nocturn', objectCurve: 'Objecte', moonCurve: 'Lluna', threshold: 'Límit 30°', astronomyNight: 'Nit astronòmica', chartHelp: 'Mou el cursor; en pantalles tàctils, toca per consultar i arrossega per desplaçar-te per la gràfica. Els trams fora de la nit astronòmica es mostren atenuats.', altitude: 'Altura', azimuth: 'Azimut', illumination: 'Il·luminació', sun: 'Sol', engine: 'Coordenades topocèntriques geomètriques, sense refracció atmosfèrica.', error: 'Revisa la ubicació, l’objecte i el període.',
  },
  es: {
    title: 'Planificación', intro: 'Analiza un único objeto durante siete noches desde la ubicación que elijas. Utiliza esta herramienta cuando ya sepas qué quieres fotografiar; todos los datos se muestran en UTC.', guide: 'Guía de Planificación', guideTooltip: 'Manual completo de la herramienta avanzada de Planificación',
    location: '1 · Ubicación', locationName: 'Nombre opcional', savedLocations: 'Buscar ubicación', latitude: 'Latitud', longitude: 'Longitud', session: 'La ubicación se conserva únicamente durante esta sesión.',
    object: '2 · Objeto', localObject: 'Lista local', searchObject: 'Buscar un objeto', searchObjectPlaceholder: 'M 31, NGC 7000, nebulosa…', noObjectMatches: 'No hay coincidencias', gallery: 'Galería', pending: 'Pendientes', simbad: 'SIMBAD', simbadQuery: 'Consulta en SIMBAD', simbadPlaceholder: 'Nombre o catálogo', resolve: 'Resolver', resolving: 'Resolviendo…', simbadNote: 'Se buscan primero los objetos locales. SIMBAD solo devuelve el nombre y las coordenadas; no añade el objeto a la galería.', simbadError: 'SIMBAD no ha podido resolver este objeto.', localResolved: 'Coincidencia local', manual: 'AR/Dec manuales', manualCoordinates: 'Nombre opcional', ra: 'AR J2000 (grados)', dec: 'Dec J2000 (grados)',
    period: '3 · Periodo temporal y umbral', week: 'Semana ISO', year: 'Año', month: 'Mes', days: 'Días', selectedWeeklyPeriod: 'Periodo semanal seleccionado', altitudeThreshold: 'Umbral de altura', calculate: 'Calcular noches', calculating: 'Calculando…',
    conclusionTitle: 'Lectura de la semana', bestNight: 'Mejor noche', usefulWindow: 'Ventana útil', moonlessTime: 'Tiempo sin Luna', culmination: 'Culminación', excellent: 'Excelente', favourable: 'Favorable', limited: 'Limitada', notRecommended: 'No recomendable', geometryNotice: 'Valoración geométrica: no incluye nubes, transparencia, seeing, viento ni obstáculos del horizonte local.', downloadTxt: 'Descargar TXT', downloadedTxt: '✓ TXT descargado', downloadPdf: 'Descargar PDF', downloadedPdf: '✓ PDF descargado', exportHelp: 'Descarga el resumen en TXT o un informe PDF de dos páginas.',
    comparison: '4 · Comparación de las siete noches', night: 'Noche UTC', darkness: 'Noche astronómica', maxAltitude: 'Altura máxima', effective: 'Ventana >30°', moonDown: 'Tiempo sin Luna', bestMoonDown: 'Mejor hora sin Luna', bestMoonUp: 'Mejor hora con Luna', moon: 'Luna', separation: 'Separación', unavailable: 'No supera 30° durante la noche astronómica', none: '—', select: 'Ver esta noche',
    detail: '5 · Detalle de la noche', objectCurve: 'Objeto', moonCurve: 'Luna', threshold: 'Límite 30°', astronomyNight: 'Noche astronómica', chartHelp: 'Mueve el cursor; en pantallas táctiles, toca para consultar y arrastra para desplazarte por la gráfica. Los tramos fuera de la noche astronómica aparecen atenuados.', altitude: 'Altura', azimuth: 'Azimut', illumination: 'Iluminación', sun: 'Sol', engine: 'Posiciones topocéntricas geométricas, sin refracción atmosférica.', error: 'Revisa la ubicación, el objeto y la semana.',
  },
  en: {
    title: 'Planning', intro: 'Analyse one object over seven nights from the location you choose. Use this tool once you know what you want to photograph; all calculations, dates, and times are expressed in UTC.', guide: 'Planning guide', guideTooltip: 'Complete guide to the advanced Planning tool',
    location: '1 · Location', locationName: 'Optional name', savedLocations: 'Find location', latitude: 'Latitude', longitude: 'Longitude', session: 'The location is retained only for this browser session.',
    object: '2 · Object', localObject: 'Local list', searchObject: 'Find an object', searchObjectPlaceholder: 'M 31, NGC 7000, nebula…', noObjectMatches: 'No matches found', gallery: 'Gallery', pending: 'Pending', simbad: 'SIMBAD', simbadQuery: 'SIMBAD lookup', simbadPlaceholder: 'Name or catalogue', resolve: 'Resolve', resolving: 'Resolving…', simbadNote: 'Local objects are checked first. SIMBAD resolves only a name and coordinates for this session.', simbadError: 'SIMBAD could not resolve this object.', localResolved: 'Local match', manual: 'Manual RA/Dec', manualCoordinates: 'Manual coordinates', ra: 'RA J2000 (degrees)', dec: 'Dec J2000 (degrees)',
    period: '3 · Time period and threshold', week: 'ISO week', year: 'Year', month: 'Month', days: 'Days', selectedWeeklyPeriod: 'Selected weekly period', altitudeThreshold: 'Altitude threshold', calculate: 'Calculate nights', calculating: 'Calculating…',
    conclusionTitle: 'Reading of the week', bestNight: 'Best night', usefulWindow: 'Useful window', moonlessTime: 'Moonless time', culmination: 'Culmination', excellent: 'Excellent', favourable: 'Favourable', limited: 'Limited', notRecommended: 'Not recommended', geometryNotice: 'Geometric assessment: it does not include cloud, transparency, seeing, wind or local-horizon obstructions.', downloadTxt: 'Download TXT', downloadedTxt: '✓ TXT downloaded', downloadPdf: 'Download PDF', downloadedPdf: '✓ PDF downloaded', exportHelp: 'Download the summary as TXT or a two-page PDF report.',
    comparison: '4 · Seven-night comparison', night: 'UTC night', darkness: 'Astronomical night', maxAltitude: 'Night max. alt.', effective: '>30° window', moonDown: 'Moon down', bestMoonDown: 'Best Moon-down time', bestMoonUp: 'Best Moon-up time', moon: 'Moon', separation: 'Separation', unavailable: 'Never above 30° during astronomical night', none: '—', select: 'Select night',
    detail: '5 · Night detail', objectCurve: 'Object', moonCurve: 'Moon', threshold: '30° limit', astronomyNight: 'Astronomical night', chartHelp: 'Move the pointer; on touchscreens, tap to inspect and drag to scroll across the chart. Segments outside astronomical night are dimmed.', altitude: 'Altitude', azimuth: 'Azimuth', illumination: 'Illumination', sun: 'Sun', engine: 'Geometric topocentric coordinates without atmospheric refraction.', error: 'Check the location, object, and period.',
  },
} as const;
const rawTexts = texts[lang];
const numberedHeading = (value: string) => value.replace(' · ', '. ');
const t = { ...rawTexts, location: numberedHeading(rawTexts.location), object: numberedHeading(rawTexts.object), period: numberedHeading(rawTexts.period), comparison: numberedHeading(rawTexts.comparison), detail: numberedHeading(rawTexts.detail) };
const framingText = {
  ca: { title: '6. Comprova l’enquadrament', question: 'Quin és el teu FOV de referència?', width: 'Amplada', height: 'Alçada', unit: 'Unitat', degrees: 'Graus', arcminutes: 'Minuts d’arc', rotate: 'Girar sensor', field: 'FOV', object: 'Mida aparent de l’objecte', roomy: 'Hi cap amb marge', tight: 'Enquadrament ajustat', outside: 'No hi cap complet', unavailable: 'Aquest objecte no té una mida aparent disponible; no es pot generar l’enquadrament.' },
  es: { title: '6. Comprueba el encuadre', question: '¿Cuál es tu FOV de referencia?', width: 'Anchura', height: 'Altura', unit: 'Unidad', degrees: 'Grados', arcminutes: 'Minutos de arco', rotate: 'Girar sensor', field: 'FOV', object: 'Tamaño aparente del objeto', roomy: 'Cabe con margen', tight: 'Encuadre ajustado', outside: 'No cabe completo', unavailable: 'Este objeto no tiene un tamaño aparente disponible; no puede generarse el encuadre.' },
  en: { title: '6. Check the framing', question: 'What is your reference FOV?', width: 'Width', height: 'Height', unit: 'Unit', degrees: 'Degrees', arcminutes: 'Arcminutes', rotate: 'Rotate sensor', field: 'FOV', object: 'Object apparent size', roomy: 'Fits with room', tight: 'Tight framing', outside: 'Does not fit completely', unavailable: 'This object has no apparent size available, so its framing cannot be generated.' },
}[lang];
const analyserFovReuseText = {
  ca: { use: 'Utilitza l’últim FOV calculat a l’Analitzador', missing: 'Encara no hi ha cap FOV calculat en aquest navegador.' },
  es: { use: 'Usar el último FOV calculado en el Analizador', missing: 'Todavía no hay ningún FOV calculado en este navegador.' },
  en: { use: 'Use the latest FOV calculated in the Analyser', missing: 'No FOV has been calculated in this browser yet.' },
}[lang];
const manualFovText = {
  ca: { toggle: 'Forçar una mida de FOV', help: 'Activa les mateixes caselles d’amplada i alçada per introduir un FOV conegut.', missing: 'Selecciona el FOV de l’Analitzador o força una mida de FOV per generar l’enquadrament.' },
  es: { toggle: 'Forzar una medida de FOV', help: 'Activa las mismas casillas de anchura y altura para introducir un FOV conocido.', missing: 'Selecciona el FOV del Analizador o fuerza una medida de FOV para generar el encuadre.' },
  en: { toggle: 'Override the FOV size', help: 'Enables the same width and height fields so you can enter a known FOV.', missing: 'Select the Analyser FOV or override the FOV size to generate the framing.' },
}[lang];
const manualApparentSizeText = {
  ca: { toggle: 'Indicar la mida aparent de l’objecte', help: 'Només si el catàleg o SIMBAD no proporcionen la mida de l’objecte, o si la vols corregir.', width: 'Amplada aparent', height: 'Alçada aparent', unit: 'Unitat de mida aparent', degrees: 'Graus', arcminutes: 'Minuts d’arc' },
  es: { toggle: 'Indicar el tamaño aparente del objeto', help: 'Solo si el catálogo o SIMBAD no proporcionan el tamaño del objeto, o si quieres corregirlo.', width: 'Anchura aparente', height: 'Altura aparente', unit: 'Unidad del tamaño aparente', degrees: 'Grados', arcminutes: 'Minutos de arco' },
  en: { toggle: 'Enter the object’s apparent size', help: 'Only if the catalogue or SIMBAD does not provide the object size, or if you want to correct it.', width: 'Apparent width', height: 'Apparent height', unit: 'Apparent-size unit', degrees: 'Degrees', arcminutes: 'Arcminutes' },
}[lang];
const apparentSizeText = {
  ca: { label: 'Mida aparent', unavailable: 'No disponible' },
  es: { label: 'Tamaño aparente', unavailable: 'No disponible' },
  en: { label: 'Apparent size', unavailable: 'Not available' },
}[lang];
const periodShiftText = {
  ca: { label: 'Desplaçament de dies', previous: 'Un dia abans', next: 'Un dia després' },
  es: { label: 'Desplazamiento de días', previous: 'Un día antes', next: 'Un día después' },
  en: { label: 'Day shift', previous: 'One day earlier', next: 'One day later' },
}[lang];
const photoLinkText = { ca: 'Veure fotografia', es: 'Ver fotografía', en: 'View photograph' }[lang];
const moonGuide = {
  ca: {
    title: 'Com interpretar la Lluna', separation: 'Separació', effect: 'Efecte probable',
    rows: [['Menys de 20°', 'Molt desfavorable, especialment amb Lluna brillant'], ['20–40°', 'Interferència important'], ['40–60°', 'Pot ser acceptable amb Lluna moderada o filtres estrets'], ['60–90°', 'Generalment manejable'], ['Més de 90°', 'Situació favorable, tot i que una Lluna plena i alta encara il·lumina el cel']],
    illumination: 'La il·luminació lunar canvia molt la interpretació:', bullets: ['0–20 %: la separació sol tenir poca importància.', '20–60 %: convé buscar una separació superior a 50–60°.', 'Més de 60 %: fins i tot amb més de 90° pot elevar apreciablement el fons del cel.'],
  },
  es: {
    title: 'Cómo interpretar la Luna', separation: 'Separación', effect: 'Efecto probable',
    rows: [['Menos de 20°', 'Muy desfavorable, especialmente con Luna brillante'], ['20–40°', 'Interferencia importante'], ['40–60°', 'Puede ser aceptable con Luna moderada o filtros estrechos'], ['60–90°', 'Generalmente manejable'], ['Más de 90°', 'Situación favorable, aunque una Luna llena y alta todavía ilumina el cielo']],
    illumination: 'La iluminación lunar cambia mucho la interpretación:', bullets: ['0–20 %: la separación suele tener poca importancia.', '20–60 %: conviene buscar una separación superior a 50–60°.', 'Más de 60 %: incluso con más de 90° puede elevar apreciablemente el fondo del cielo.'],
  },
  en: {
    title: 'How to interpret the Moon', separation: 'Separation', effect: 'Likely effect',
    rows: [['Under 20°', 'Very unfavourable, especially with a bright Moon'], ['20–40°', 'Significant interference'], ['40–60°', 'May be acceptable with a moderate Moon or narrowband filters'], ['60–90°', 'Generally manageable'], ['Over 90°', 'Favourable, although a high full Moon still brightens the sky']],
    illumination: 'Lunar illumination changes the interpretation considerably:', bullets: ['0–20%: separation usually matters little.', '20–60%: aim for a separation greater than 50–60°.', 'Over 60%: even beyond 90° it can noticeably brighten the sky background.'],
  },
}[lang];
const moonPhaseText = {
  ca: ['Lluna nova', 'Creixent fina', 'Quart creixent', 'Gibosa creixent', 'Lluna plena', 'Gibosa minvant', 'Quart minvant', 'Minvant fina'],
  es: ['Luna nueva', 'Creciente fina', 'Cuarto creciente', 'Gibosa creciente', 'Luna llena', 'Gibosa menguante', 'Cuarto menguante', 'Menguante fina'],
  en: ['New moon', 'Waxing crescent', 'First quarter', 'Waxing gibbous', 'Full moon', 'Waning gibbous', 'Last quarter', 'Waning crescent'],
}[lang];
const photos = await getCollection('fotos');
const latestPhotoByObject = new Map<string, (typeof photos)[number]>();
for (const photo of [...photos].sort((a, b) => b.data.entorn.data.valueOf() - a.data.entorn.data.valueOf())) {
  if (photo.data.objecte_astronomic && !latestPhotoByObject.has(photo.data.objecte_astronomic)) latestPhotoByObject.set(photo.data.objecte_astronomic, photo);
}
const photoAlias = (id: string, catalogName: string) => {
  const photo = latestPhotoByObject.get(id);
  if (!photo) return undefined;
  const localizedName = photoText(photo, lang).objecte;
  const escapedCatalog = [...catalogName.replace(/\s+/g, '')].map((character) => character.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')).join('\\s*');
  const alias = localizedName.replace(new RegExp(`^\\s*${escapedCatalog}(?:\\s*\\((?:HOO|SHO|Hα|NN)\\))?\\s*(?:[–—,:-]\\s*)?`, 'i'), '').trim();
  return alias || undefined;
};
const objects = objectsData
  .filter((object) => import.meta.env.DEV || PUBLIC_PENDING_OBJECTS || object.status === 'photographed')
  .map((object) => {
    const photo = latestPhotoByObject.get(object.id);
    return { id: object.id, catalogName: object.catalogName, displayCatalogName: formatCatalogDesignations(object.catalogName), commonName: formatCatalogDesignations(object.commonNames?.[lang] ?? photoAlias(object.id, object.catalogName)), raDeg: object.raDeg, decDeg: object.decDeg, angularSizeArcmin: object.angularSizeArcmin, angularSizeSource: object.angularSizeSource, source: object.status === 'pending' ? 'pending' : 'gallery', photoSrc: photo ? withBase(`imagenes/cielo-profundo/${photo.data.imatge}`, base) : undefined };
  });
const photographed = objects.filter((object) => object.source === 'gallery');
const pending = objects.filter((object) => object.source === 'pending');
const clientData = JSON.stringify({ lang, texts: { ...t, ...apparentSizeText, framing: framingText }, moonPhases: moonPhaseText, objects }).replace(/</g, '\\u003c');
---

<Layout title={t.title} description={t.intro} lang={lang} languageLinks={languageLinks.planning(base)} focused>
  <main class="planning" data-planning-root>
    <SessionToolLink lang={lang} href={sessionPreparationHref(lang, base)} visibilityHref={visibilityHref(lang, base)} />
    <header class="planning__header">
      <h1>{t.title}</h1>
      <p>{t.intro}</p>
      <a class="planning-guide-link" href={planningGuideHref(lang, base)} title={t.guideTooltip}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3.5 5.5c3.2-.8 5.9-.3 8.5 1.6v12c-2.6-1.9-5.3-2.4-8.5-1.6zM20.5 5.5c-3.2-.8-5.9-.3-8.5 1.6v12c2.6-1.9 5.3-2.4 8.5-1.6z" /></svg>
        <span>{t.guide}</span>
      </a>
    </header>

    <form class="planning-controls" data-planning-form>
      <fieldset class="planning-panel">
        <legend>{t.location}</legend>
        <div class="planning-fields planning-fields--location">
          <label><span>{t.locationName}</span><span class="planning-stepper"><button type="button" data-step-field="locationName" data-step-direction="-1" aria-label={`◀ ${t.locationName}`}>‹</button><select name="locationName" title={t.savedLocations}><option value="">—</option><option value="L’Ampolla" selected>L’Ampolla</option><option value="Barcelona">Barcelona</option><option value="Pujalt">Pujalt</option><option value="Huesca">Huesca</option><option value="Lleida">Lleida</option><option value="Tarragona">Tarragona</option><option value="Girona">Girona</option><option value="Vilanova i la Geltrú">Vilanova i la Geltrú</option></select><button type="button" data-step-field="locationName" data-step-direction="1" aria-label={`${t.locationName} ▶`}>›</button></span></label>
          <label><span>{t.latitude}</span><input name="latitude" type="text" inputmode="decimal" pattern="-?[0-9]+(?:[.,][0-9]+)?" value="40.80194" required /></label>
          <label><span>{t.longitude}</span><input name="longitude" type="text" inputmode="decimal" pattern="-?[0-9]+(?:[.,][0-9]+)?" value="0.69361" required /></label>
        </div>
        <div class="planning-panel__footer"><small>{t.session}</small></div>
      </fieldset>

      <fieldset class="planning-panel planning-panel--object">
        <legend>{t.object}</legend>
        <nav class="planning-object-modes" aria-label={t.object}>
          <button type="button" data-object-mode="local" aria-pressed="true">{t.localObject}</button>
          <button type="button" data-object-mode="simbad" aria-pressed="false">{t.simbad}</button>
          <button type="button" data-object-mode="manual" aria-pressed="false">{t.manual}</button>
        </nav>
        <div data-object-panel="local">
          <div class="planning-object-picker" data-object-picker>
            <label><span>{t.searchObject}</span><input name="localObjectSearch" type="search" placeholder={t.searchObjectPlaceholder} autocomplete="off" aria-autocomplete="list" aria-controls="planning-object-results" aria-expanded="false" /></label>
            <div class="planning-object-results" id="planning-object-results" data-object-results role="listbox" hidden></div>
          </div>
          <select name="localObject" hidden aria-hidden="true" tabindex="-1">
            <optgroup label={t.gallery}>{photographed.map((object) => <option value={object.id}>{object.displayCatalogName}{object.commonName ? ` · ${object.commonName}` : ''}</option>)}</optgroup>
            {pending.length > 0 && <optgroup label={t.pending}>{pending.map((object) => <option value={object.id}>{object.displayCatalogName}{object.commonName ? ` · ${object.commonName}` : ''}</option>)}</optgroup>}
          </select>
          <button class="planning-photo-link" data-planning-photo type="button" hidden><SiteMapIcon name="photo" size="lg" /><span>{photoLinkText}</span></button>
        </div>
        <div class="planning-simbad" data-object-panel="simbad" hidden>
          <p data-simbad-result aria-live="polite"></p>
          <label><span>{t.simbadQuery}</span><span class="planning-simbad__row"><input name="simbadQuery" type="search" placeholder={t.simbadPlaceholder} autocomplete="off" /><button type="button" class="planning-button planning-button--quiet" data-resolve-simbad>{t.resolve}</button></span></label>
          <small>{t.simbadNote}</small>
        </div>
        <div class="planning-fields" data-object-panel="manual" hidden>
          <label><span>{t.manualCoordinates}</span><input name="manualName" type="text" placeholder="J2000" /></label>
          <label><span>{t.ra}</span><input name="manualRa" type="number" min="0" max="359.999999" step="0.000001" /></label>
          <label><span>{t.dec}</span><input name="manualDec" type="number" min="-90" max="90" step="0.000001" /></label>
        </div>
        <div class="planning-object-metadata">
          <p class="planning-object-size" data-object-angular-size hidden><strong>{apparentSizeText.label}</strong><span data-object-angular-size-value></span></p>
          <p class="planning-object-size planning-object-coordinates" data-object-coordinates hidden><strong>AR / Dec J2000</strong><span data-object-coordinates-value></span><small data-object-coordinates-sexagesimal></small></p>
        </div>
      </fieldset>

      <fieldset class="planning-panel planning-panel--period">
        <legend>{t.period}</legend>
        <div class="planning-period-grid">
          <label><span>{t.year}</span><span class="planning-stepper"><button type="button" data-step-field="year" data-step-direction="-1" aria-label={`◀ ${t.year}`}>‹</button><input name="year" type="number" min="1900" max="2200" required /><button type="button" data-step-field="year" data-step-direction="1" aria-label={`${t.year} ▶`}>›</button></span></label>
          <label><span>{t.week}</span><span class="planning-stepper"><button type="button" data-step-field="week" data-step-direction="-1" aria-label={`◀ ${t.week}`}>‹</button><input name="week" type="number" min="1" max="53" required /><button type="button" data-step-field="week" data-step-direction="1" aria-label={`${t.week} ▶`}>›</button></span></label>
          <div class="planning-period-field"><span>{t.month}</span><output data-week-month></output></div>
          <div class="planning-period-field"><span>{t.days}</span><output data-week-days></output></div>
        </div>
        <div class="planning-period-footer">
          <div class="planning-day-shift" aria-label={periodShiftText.label}>
            <span class="planning-day-shift__label">{t.selectedWeeklyPeriod}</span>
            <button type="button" data-planning-day-step="-1" aria-label={periodShiftText.previous}>‹</button>
            <button class="planning-day-shift__range" type="button" data-planning-calendar-toggle aria-expanded="false"><span data-shifted-range></span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.5 3.5v3M17.5 3.5v3M4 8.5h16M5.5 5h13A1.5 1.5 0 0 1 20 6.5v12a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 4 18.5v-12A1.5 1.5 0 0 1 5.5 5Z"/><path d="M8 12h3v3H8zM14 12h2M14 15h2"/></svg></button>
            <button type="button" data-planning-day-step="1" aria-label={periodShiftText.next}>›</button>
          </div>
          <label><span>{t.altitudeThreshold}</span><select name="threshold">{[30, 35, 40, 45, 50, 55, 60].map((threshold) => <option value={threshold}>{threshold}°</option>)}</select></label>
        </div>
        <div class="planning-period-calendar period-calendar-ui" data-planning-period-calendar hidden><p class="period-calendar-ui__caption" data-planning-calendar-caption></p><div class="planning-period-calendar__weekdays period-calendar-ui__weekdays" data-planning-calendar-weekdays></div><div class="planning-period-calendar__days period-calendar-ui__days" data-planning-calendar-days></div></div>
        <p class="planning-error" data-planning-error hidden>{t.error}</p>
      </fieldset>
      <div class="planning-period-actions">
        <button class="planning-button planning-button--calculate" type="submit" data-calculate>{t.calculate}</button>
        <div class="planning-period-actions__exports" data-planning-exports hidden>
          <button class="report-action report-action--planning" type="button" data-download-planning-txt title={t.exportHelp}><span class="report-action__icon report-action__icon--txt" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M9 5.5V4.8c0-.7.6-1.3 1.3-1.3h3.4c.7 0 1.3.6 1.3 1.3v.7M9 5.5h6M8 5.5H6.8c-.7 0-1.3.6-1.3 1.3v12.4c0 .7.6 1.3 1.3 1.3h10.4c.7 0 1.3-.6 1.3-1.3V6.8c0-.7-.6-1.3-1.3-1.3H16M8.5 10h7M8.5 13.5h7M8.5 17h4.5" /></svg></span><span>{t.downloadTxt}</span></button>
          <button class="report-action report-action--planning" type="button" data-download-planning title={t.exportHelp}><span class="report-action__icon report-action__icon--pdf" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M7 3.5h6.5L18 8v12.5H7zM13.5 3.5V8H18" /><text x="8.5" y="16.5">PDF</text></svg></span><span>{t.downloadPdf}</span></button>
        </div>
      </div>
    </form>

    <dialog class="planning-photo-dialog" data-planning-photo-dialog>
      <button class="planning-photo-dialog__close" type="button" data-close-planning-photo aria-label={lang === 'ca' ? 'Tancar la fotografia' : lang === 'es' ? 'Cerrar la fotografía' : 'Close photograph'}>×</button>
      <img data-planning-photo-image src="" alt="" />
      <p data-planning-photo-caption></p>
    </dialog>

    <section class="planning-results" data-results hidden>
      <section class="planning-conclusion" data-planning-conclusion hidden aria-live="polite">
        <header class="planning-conclusion__header">
          <h2>{t.conclusionTitle}</h2>
          <div class="planning-conclusion__tools">
            <strong data-conclusion-rating></strong>
          </div>
        </header>
        <div class="planning-conclusion__metrics">
          <article><span>{t.bestNight}</span><strong data-conclusion-night>—</strong></article>
          <article><span>{t.usefulWindow}</span><strong data-conclusion-window>—</strong></article>
          <article><span>{t.moonlessTime}</span><strong data-conclusion-moonless>—</strong></article>
          <article><span>{t.culmination}</span><strong data-conclusion-culmination>—</strong></article>
        </div>
        <p class="planning-conclusion__comment" data-conclusion-comment></p>
        <small>{t.geometryNotice}</small>
      </section>
      <div class="planning-section-heading"><h2>{t.comparison}</h2><strong class="planning-selected-object" data-selected-object></strong><span class="planning-week-context" data-week-label></span></div>
      <div class="planning-table-wrap">
        <table class="planning-table">
          <thead><tr><th>{t.night}</th><th>{t.darkness}</th><th>{t.maxAltitude}</th><th data-effective-heading>{t.effective}</th><th>{t.moonDown}</th><th>{t.bestMoonDown}</th><th>{t.bestMoonUp}</th><th>{t.moon}</th><th>{t.separation}</th></tr></thead>
          <tbody data-night-rows></tbody>
        </table>
      </div>

      <section class="planning-night" data-night-detail>
        <div class="planning-section-heading planning-section-heading--night">
          <p data-night-date>UTC</p><h2>{t.detail}</h2><div class="planning-night-lunar"><strong class="planning-night-phase" data-planning-moon-phase><span data-planning-moon-phase-icon aria-hidden="true"></span><span data-planning-moon-phase-label></span><small data-planning-moon-phase-percent></small></strong>
          <details class="planning-moon-guide">
            <summary><span aria-hidden="true">☾</span>{moonGuide.title}</summary>
            <div class="planning-moon-guide__content">
              <table><thead><tr><th>{moonGuide.separation}</th><th>{moonGuide.effect}</th></tr></thead><tbody>{moonGuide.rows.map((row) => <tr><th>{row[0]}</th><td>{row[1]}</td></tr>)}</tbody></table>
              <p>{moonGuide.illumination}</p>
              <ul>{moonGuide.bullets.map((bullet) => <li>{bullet}</li>)}</ul>
            </div>
          </details></div>
        </div>
        <div class="planning-legend"><span class="planning-legend__object">— {t.objectCurve}</span><span class="planning-legend__moon">— {t.moonCurve}</span><span class="planning-legend__threshold" data-threshold-legend>┄ {t.threshold}</span><span class="planning-legend__darkness">■ {t.astronomyNight}</span></div>
        <div class="planning-chart" data-chart-wrap>
          <svg viewBox="0 0 1000 430" role="img" aria-label={t.detail} data-night-chart></svg>
          <div class="planning-tooltip" data-chart-tooltip hidden></div>
        </div>
        <p class="planning-chart-help">{t.chartHelp}</p>
      </section>
      <section class="planning-framing" data-planning-framing>
        <div class="planning-section-heading"><h2>{framingText.title}</h2></div>
        <p class="planning-framing__question">{framingText.question}</p>
        <div class="planning-framing__fov-sources">
          <label class="planning-framing__reuse"><input type="checkbox" data-use-analyser-fov /><span>{analyserFovReuseText.use}</span><small data-analyser-fov-missing hidden>{analyserFovReuseText.missing}</small></label>
          <label class="planning-framing__reuse"><input type="checkbox" data-force-manual-fov /><span>{manualFovText.toggle}</span><small>{manualFovText.help}</small></label>
        </div>
        <div class="planning-framing__controls">
          <label><span>{framingText.width}</span><input type="number" min="0.01" step="0.01" value="0" data-framing-width disabled /></label>
          <label><span>{framingText.height}</span><input type="number" min="0.01" step="0.01" value="0" data-framing-height disabled /></label>
          <label><span>{framingText.unit}</span><select data-framing-unit disabled><option value="degrees">{framingText.degrees}</option><option value="arcminutes">{framingText.arcminutes}</option></select></label>
          <div class="planning-framing__rotation" aria-label={framingText.rotate}>
            <button type="button" data-framing-rotate="-45" aria-label={`${framingText.rotate} −45°`}>−45°</button>
            <output data-framing-angle>0°</output>
            <button type="button" data-framing-rotate="45" aria-label={`${framingText.rotate} +45°`}>+45°</button>
          </div>
        </div>
        <div class="planning-framing__manual-size">
          <label class="planning-framing__manual-toggle"><input type="checkbox" data-use-manual-size /><span>{manualApparentSizeText.toggle}</span></label>
          <small>{manualApparentSizeText.help}</small>
          <div class="planning-framing__manual-fields" data-manual-size-fields>
            <label><span>{manualApparentSizeText.width}</span><input type="number" min="0.01" step="0.01" data-manual-size-width disabled /></label>
            <label><span>{manualApparentSizeText.height}</span><input type="number" min="0.01" step="0.01" data-manual-size-height disabled /></label>
            <label><span>{manualApparentSizeText.unit}</span><select data-manual-size-unit disabled><option value="arcminutes">{manualApparentSizeText.arcminutes}</option><option value="degrees">{manualApparentSizeText.degrees}</option></select></label>
          </div>
        </div>
        <p class="planning-framing__unavailable" data-framing-fov-missing>{manualFovText.missing}</p>
        <p class="planning-framing__unavailable" data-framing-unavailable hidden>{framingText.unavailable}</p>
        <div class="planning-framing__visual" data-framing-visual>
          <svg viewBox="0 0 600 320" role="img" aria-label={framingText.title}>
            <rect class="planning-framing__sensor" data-framing-sensor rx="5" />
            <ellipse class="planning-framing__object" data-framing-object />
          </svg>
        </div>
        <div class="planning-framing__result" data-framing-result><strong data-framing-verdict></strong><span data-framing-field></span><span data-framing-size></span></div>
      </section>
    </section>
  </main>
</Layout>

<script type="application/json" id="planning-data" set:html={clientData}></script>
<script>
  import { analyzeWeek, isoWeekStart, isoWeeksInYear } from '../../lib/planning/engine.mjs';
  import { loadPlanningSession, savePlanningSession } from '../../lib/planning/session.mjs';
  import { findLocalObject, resolveSimbad } from '../../lib/planning/simbad.mjs';
  import { formatCatalogDesignations } from '../../lib/catalog-formatting.mjs';
  import { framingRatio, framingStatus } from '../../lib/framing.mjs';

  const config = JSON.parse(document.querySelector('#planning-data')?.textContent ?? '{}');
  const root = document.querySelector<HTMLElement>('[data-planning-root]');
  const form = document.querySelector<HTMLFormElement>('[data-planning-form]');
  if (!root || !form) throw new Error('Planning interface not found');
  document.addEventListener('pointerdown', (event) => {
    if (event.pointerType === 'mouse') return;
    const active = document.activeElement;
    const target = event.target;
    if (!(active instanceof HTMLElement) || !(target instanceof Element) || !root.contains(active)) return;
    if (!target.closest('button, input, select, textarea, a, [tabindex]')) active.blur();
  }, { passive: true });
  const field = (name: string) => form.elements.namedItem(name) as HTMLInputElement | HTMLSelectElement;
  const results = root.querySelector<HTMLElement>('[data-results]');
  const error = root.querySelector<HTMLElement>('[data-planning-error]');
  const calculateButton = root.querySelector<HTMLButtonElement>('[data-calculate]');
  const rows = root.querySelector<HTMLTableSectionElement>('[data-night-rows]');
  const chart = root.querySelector<SVGSVGElement>('[data-night-chart]');
  const tooltip = root.querySelector<HTMLElement>('[data-chart-tooltip]');
  const nightDetail = root.querySelector<HTMLElement>('[data-night-detail]');
  const simbadButton = root.querySelector<HTMLButtonElement>('[data-resolve-simbad]');
  const simbadResult = root.querySelector<HTMLElement>('[data-simbad-result]');
  const objectAngularSize = root.querySelector<HTMLElement>('[data-object-angular-size]');
  const objectAngularSizeValue = root.querySelector<HTMLElement>('[data-object-angular-size-value]');
  const objectCoordinates = root.querySelector<HTMLElement>('[data-object-coordinates]');
  const objectCoordinatesValue = root.querySelector<HTMLElement>('[data-object-coordinates-value]');
  const objectCoordinatesSexagesimal = root.querySelector<HTMLElement>('[data-object-coordinates-sexagesimal]');
  const weekMonth = root.querySelector<HTMLOutputElement>('[data-week-month]');
  const weekDays = root.querySelector<HTMLOutputElement>('[data-week-days]');
  const shiftedRange = root.querySelector<HTMLElement>('[data-shifted-range]');
  const calendarToggle = root.querySelector<HTMLButtonElement>('[data-planning-calendar-toggle]');
  const periodCalendar = root.querySelector<HTMLElement>('[data-planning-period-calendar]');
  const calendarCaption = root.querySelector<HTMLElement>('[data-planning-calendar-caption]');
  const calendarWeekdays = root.querySelector<HTMLElement>('[data-planning-calendar-weekdays]');
  const calendarDays = root.querySelector<HTMLElement>('[data-planning-calendar-days]');
  const planningPhotoButton = root.querySelector<HTMLButtonElement>('[data-planning-photo]');
  const planningPhotoDialog = root.querySelector<HTMLDialogElement>('[data-planning-photo-dialog]');
  const planningPhotoImage = root.querySelector<HTMLImageElement>('[data-planning-photo-image]');
  const planningPhotoCaption = root.querySelector<HTMLElement>('[data-planning-photo-caption]');
  const conclusion = root.querySelector<HTMLElement>('[data-planning-conclusion]');
  const downloadPlanningTxtButton = root.querySelector<HTMLButtonElement>('[data-download-planning-txt]');
  const downloadPlanningButton = root.querySelector<HTMLButtonElement>('[data-download-planning]');
  const planningExports = root.querySelector<HTMLElement>('[data-planning-exports]');
  const framingPanel = root.querySelector<HTMLElement>('[data-planning-framing]');
  const framingWidth = root.querySelector<HTMLInputElement>('[data-framing-width]');
  const framingHeight = root.querySelector<HTMLInputElement>('[data-framing-height]');
  const framingUnit = root.querySelector<HTMLSelectElement>('[data-framing-unit]');
  const useAnalyserFov = root.querySelector<HTMLInputElement>('[data-use-analyser-fov]');
  const forceManualFov = root.querySelector<HTMLInputElement>('[data-force-manual-fov]');
  const useManualSize = root.querySelector<HTMLInputElement>('[data-use-manual-size]');
  const manualSizeWidth = root.querySelector<HTMLInputElement>('[data-manual-size-width]');
  const manualSizeHeight = root.querySelector<HTMLInputElement>('[data-manual-size-height]');
  const manualSizeUnit = root.querySelector<HTMLSelectElement>('[data-manual-size-unit]');
  const framingSensor = root.querySelector<SVGRectElement>('[data-framing-sensor]');
  const framingObject = root.querySelector<SVGEllipseElement>('[data-framing-object]');
  let framingAngle = 0;
  let analysis: any = null;
  let selectedNight: any = null;
  let resolvedSimbad: any = null;
  let objectMode = sessionStorage.getItem('deepskyastro:planning-object-mode') ?? 'local';

  const framingData = () => {
    if (!useAnalyserFov?.checked && !forceManualFov?.checked) return null;
    const object = analysis?.object ?? objectValue();
    const manualMultiplier = manualSizeUnit?.value === 'degrees' ? 60 : 1;
    const manualSize = useManualSize?.checked ? { major: Number(manualSizeWidth?.value) * manualMultiplier, minor: Number(manualSizeHeight?.value) * manualMultiplier } : null;
    const size = manualSize ?? object?.angularSizeArcmin;
    const multiplier = framingUnit?.value === 'arcminutes' ? 1 / 60 : 1;
    const width = Number(framingWidth?.value) * multiplier, height = Number(framingHeight?.value) * multiplier;
    if (!size || !Number.isFinite(size.major) || !Number.isFinite(size.minor) || !Number.isFinite(width) || !Number.isFinite(height) || width <= 0 || height <= 0) return null;
    const objectWidth = size.major / 60, objectHeight = size.minor / 60;
    const radians = framingAngle * Math.PI / 180;
    const projectedWidth = Math.hypot(objectWidth * Math.cos(radians), objectHeight * Math.sin(radians));
    const projectedHeight = Math.hypot(objectWidth * Math.sin(radians), objectHeight * Math.cos(radians));
    const ratio = framingRatio(width, height, projectedWidth, projectedHeight);
    return { width, height, objectWidth, objectHeight, sizeArcmin: size, ratio, status: framingStatus(ratio), angle: framingAngle };
  };
  const renderFraming = () => {
    if (!framingPanel) return;
    const data = framingData();
    const unavailable = framingPanel.querySelector<HTMLElement>('[data-framing-unavailable]');
    const fovMissing = framingPanel.querySelector<HTMLElement>('[data-framing-fov-missing]');
    const visual = framingPanel.querySelector<HTMLElement>('[data-framing-visual]');
    const result = framingPanel.querySelector<HTMLElement>('[data-framing-result]');
    const hasFovSource = Boolean(useAnalyserFov?.checked || forceManualFov?.checked);
    if (fovMissing) fovMissing.hidden = hasFovSource;
    if (unavailable) unavailable.hidden = !hasFovSource || Boolean(data);
    if (visual) visual.hidden = !data;
    if (result) result.hidden = !data;
    if (!data || !framingSensor || !framingObject) return;
    const diagonal = Math.hypot(data.width, data.height);
    const scale = Math.min(540 / diagonal, 270 / diagonal);
    const sensorWidth = data.width * scale, sensorHeight = data.height * scale;
    framingSensor.setAttribute('x', String((600 - sensorWidth) / 2)); framingSensor.setAttribute('y', String((320 - sensorHeight) / 2));
    framingSensor.setAttribute('width', String(sensorWidth)); framingSensor.setAttribute('height', String(sensorHeight));
    framingSensor.setAttribute('transform', `rotate(${framingAngle} 300 160)`);
    framingObject.setAttribute('cx', '300'); framingObject.setAttribute('cy', '160');
    framingObject.setAttribute('rx', String(Math.max(data.objectWidth * scale / 2, 2))); framingObject.setAttribute('ry', String(Math.max(data.objectHeight * scale / 2, 2)));
    framingPanel.querySelector<HTMLElement>('[data-framing-verdict]')!.textContent = config.texts.framing[data.status];
    framingPanel.querySelector<HTMLElement>('[data-framing-field]')!.textContent = `${config.texts.framing.field}: ${data.width.toFixed(2)}° × ${data.height.toFixed(2)}° · ${data.angle}°`;
    framingPanel.querySelector<HTMLElement>('[data-framing-size]')!.textContent = `${config.texts.framing.object}: ${formatAngularSize(data.sizeArcmin)}`;
  };
  [framingWidth, framingHeight, framingUnit].forEach((control) => { control?.addEventListener('input', renderFraming); control?.addEventListener('change', renderFraming); });
  root.querySelectorAll<HTMLButtonElement>('[data-framing-rotate]').forEach((button) => button.addEventListener('click', () => {
    framingAngle = (framingAngle + Number(button.dataset.framingRotate) + 360) % 360;
    const angle = framingPanel?.querySelector<HTMLOutputElement>('[data-framing-angle]');
    if (angle) angle.value = `${framingAngle}°`;
    renderFraming();
  }));
  const readAnalyserFov = () => {
    try {
      const saved = JSON.parse(localStorage.getItem('deepskyastro:last-analyser-fov') ?? 'null');
      return saved && Number.isFinite(saved.widthDeg) && saved.widthDeg > 0 && Number.isFinite(saved.heightDeg) && saved.heightDeg > 0 ? saved : null;
    } catch { return null; }
  };
  const syncAnalyserFovOption = () => {
    const saved = readAnalyserFov();
    const missing = root.querySelector<HTMLElement>('[data-analyser-fov-missing]');
    if (useAnalyserFov) { useAnalyserFov.disabled = !saved; useAnalyserFov.checked = false; }
    if (missing) missing.hidden = Boolean(saved);
  };
  useAnalyserFov?.addEventListener('change', () => {
    const saved = readAnalyserFov();
    if (useAnalyserFov.checked && saved && framingWidth && framingHeight && framingUnit) {
      if (forceManualFov) forceManualFov.checked = false;
      framingUnit.value = 'degrees'; framingWidth.value = String(saved.widthDeg); framingHeight.value = String(saved.heightDeg);
    }
    [framingWidth, framingHeight, framingUnit].forEach((control) => { if (control) control.disabled = !forceManualFov?.checked; });
    renderFraming();
  });
  syncAnalyserFovOption();
  forceManualFov?.addEventListener('change', () => {
    if (forceManualFov.checked && useAnalyserFov) useAnalyserFov.checked = false;
    [framingWidth, framingHeight, framingUnit].forEach((control) => { if (control) control.disabled = !forceManualFov.checked; });
    renderFraming();
  });
  const syncManualSize = () => {
    const enabled = Boolean(useManualSize?.checked);
    [manualSizeWidth, manualSizeHeight, manualSizeUnit].forEach((control) => { if (control) control.disabled = !enabled; });
    renderFraming();
  };
  useManualSize?.addEventListener('change', syncManualSize);
  [manualSizeWidth, manualSizeHeight, manualSizeUnit].forEach((control) => { control?.addEventListener('input', renderFraming); control?.addEventListener('change', renderFraming); });

  const now = new Date();
  const iso = (() => {
    const day = new Date(Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), now.getUTCDate()));
    day.setUTCDate(day.getUTCDate() + 4 - (day.getUTCDay() || 7));
    const start = new Date(Date.UTC(day.getUTCFullYear(), 0, 1));
    return { year: day.getUTCFullYear(), week: Math.ceil((((day.getTime() - start.getTime()) / 86400000) + 1) / 7) };
  })();

  const session = loadPlanningSession(sessionStorage);
  const requestUrl = new URL(window.location.href);
  const requestedYear = Number(requestUrl.searchParams.get('year'));
  const requestedWeek = Number(requestUrl.searchParams.get('week'));
  const requestedOffset = Number(requestUrl.searchParams.get('offset'));
  const requestedThreshold = Number(requestUrl.searchParams.get('threshold'));
  const thresholdOptions = [30, 35, 40, 45, 50, 55, 60];
  let dayOffset = requestUrl.searchParams.has('offset') && Number.isInteger(requestedOffset) ? Math.max(-3, Math.min(3, requestedOffset)) : Math.max(-3, Math.min(3, Number(session.dayOffset) || 0));
  const renderPeriodCalendar = (year: number, week: number) => {
    if (!calendarDays || !calendarCaption || !calendarWeekdays) return;
    const locale = { ca: 'ca-ES', es: 'es-ES', en: 'en-GB' }[config.lang] ?? 'es-ES';
    const start = isoWeekStart(year, week);
    const first = new Date(start.getTime() - 3 * 86400000);
    const last = new Date(start.getTime() + 9 * 86400000);
    const monthLabel = new Intl.DateTimeFormat(locale, { month: 'long', year: 'numeric', timeZone: 'UTC' });
    calendarCaption.textContent = first.getUTCMonth() === last.getUTCMonth() ? monthLabel.format(first) : `${monthLabel.format(first)} — ${monthLabel.format(last)}`;
    calendarWeekdays.replaceChildren(...Array.from({ length: 13 }, (_, index) => {
      const date = new Date(first.getTime() + index * 86400000);
      const item = document.createElement('span');
      item.textContent = new Intl.DateTimeFormat(locale, { weekday: 'narrow', timeZone: 'UTC' }).format(date);
      item.classList.toggle('is-weekend', [0, 6].includes(date.getUTCDay()));
      return item;
    }));
    calendarDays.replaceChildren(...Array.from({ length: 13 }, (_, index) => {
      const date = new Date(first.getTime() + index * 86400000);
      const relativeDay = index - 3;
      const button = document.createElement('button');
      button.type = 'button';
      button.textContent = String(date.getUTCDate());
      button.title = new Intl.DateTimeFormat(locale, { weekday: 'long', day: 'numeric', month: 'long', timeZone: 'UTC' }).format(date);
      button.classList.toggle('is-weekend', [0, 6].includes(date.getUTCDay()));
      button.classList.toggle('is-selected', relativeDay >= dayOffset && relativeDay <= dayOffset + 6);
      button.classList.toggle('is-start', relativeDay === dayOffset);
      button.classList.toggle('is-end', relativeDay === dayOffset + 6);
      if (relativeDay >= -3 && relativeDay <= 3) button.addEventListener('click', () => { dayOffset = relativeDay; updateWeekRange(); syncPhotoLink(); markDirty(); invalidateObjectResults(); persist(); });
      else button.disabled = true;
      return button;
    }));
  };
  field('locationName').value = session.location.name ?? '';
  field('latitude').value = String(session.location.latitudeDeg);
  field('longitude').value = String(session.location.longitudeDeg);
  field('year').value = String(Number.isInteger(requestedYear) && requestedYear >= 1900 && requestedYear <= 2200 ? requestedYear : session.isoYear ?? iso.year);
  field('week').value = String(Number.isInteger(requestedWeek) && requestedWeek >= 1 && requestedWeek <= 53 ? requestedWeek : session.isoWeek ?? iso.week);
  field('threshold').value = String(thresholdOptions.includes(requestedThreshold) ? requestedThreshold : thresholdOptions.includes(Number(session.altitudeThreshold)) ? session.altitudeThreshold : 30);
  const locationPresets: Record<string, { name: string; latitudeDeg: number; longitudeDeg: number }> = {
    lampolla: { name: 'L’Ampolla', latitudeDeg: 40.80194, longitudeDeg: 0.69361 },
    barcelona: { name: 'Barcelona', latitudeDeg: 41.3926, longitudeDeg: 2.1865 },
