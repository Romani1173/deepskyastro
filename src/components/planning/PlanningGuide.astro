---
import type { Lang } from '../../i18n';
import { languageLinks, planningHref } from '../../i18n';
import Layout from '../../layouts/Layout.astro';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const base = import.meta.env.BASE_URL;
const content = {
  ca: {
    title: 'Guia de Planificació', back: 'Tornar a Planificació', index: 'En aquesta guia',
    intro: 'Planificació estudia amb detall un únic objecte durant set nits des d’una ubicació concreta. Complementa Visibilitat i tots els seus càlculs, dates, eixos i avisos s’expressen en UTC.',
    sections: [
      ['diferencia', 'Planificació i Visibilitat', ['Visibilitat serveix per descobrir ràpidament quins objectes es poden fotografiar durant una setmana des del centre de Catalunya. Planificació està pensada per a l’estudi tècnic d’un objecte concret, amb ubicació lliure, comparació nocturna i mostres cada cinc minuts.', 'Si arribes amb el botó «Planificar» de Visibilitat, l’objecte, la setmana i l’any es carreguen automàticament. Només cal confirmar o canviar la ubicació i revisar el càlcul detallat.']],
      ['ubicacio', '1 · Ubicació', ['L’Ampolla és la ubicació inicial. El selector també ofereix Barcelona, Pujalt, Huesca, Lleida, Tarragona, Girona i Vilanova i la Geltrú; pots introduir qualsevol altra latitud i longitud i un nom opcional.', 'La ubicació es conserva només mentre la sessió del navegador continua oberta. Qualsevol canvi deixa el càlcul pendent i obliga a recalcular les dades dependents de l’observador.']],
      ['objecte', '2 · Objecte', ['Només pot estar actiu un mode d’entrada: llista local, SIMBAD o coordenades AR/Dec manuals J2000. A «Llista local», escriu un nom, un catàleg o un àlies i selecciona una de les coincidències de la galeria o dels objectius pendents.', 'SIMBAD només retorna nom i coordenades durant la sessió; no incorpora res a la galeria. Si l’objecte ja existeix al catàleg local, no cal fer una consulta externa.']],
      ['setmana', '3 · Setmana i any', ['La setmana és ISO, de dilluns a diumenge. L’interval exacte de dates UTC es mostra immediatament sota els selectors, sense haver de calcular.', 'En modificar la ubicació, l’objecte, la setmana o l’any, «Calcular nits» parpelleja. El càlcul només s’executa quan el prems, de manera que pots explorar els selectors sense provocar càlculs continus.']],
      ['lectura', '4 · Lectura de la setmana', ['Després del càlcul, la lectura automàtica identifica la nit més favorable i en mostra la valoració, la finestra útil, el temps sense Lluna i el moment de culminació de l’objecte.', 'El comentari interpreta conjuntament la geometria de les set nits i explica per què destaca aquella oportunitat. És una orientació astronòmica: no inclou núvols, transparència, seeing, vent ni obstacles de l’horitzó local.']],
      ['comparacio', '5 · Comparació de les set nits', ['Cada fila resumeix la nit astronòmica, l’altura màxima nocturna, la finestra efectiva per sobre de 30°, el temps efectiu sense Lluna i les millors hores amb la Lluna sota o sobre l’horitzó.', 'La il·luminació i la separació corresponen a la millor hora amb Lluna. Un guió indica que aquella dada no és aplicable. La nit oberta a la gràfica queda marcada amb un contorn.']],
      ['lluna', 'Com interpretar la Lluna', ['«Sense Lluna» significa que la Lluna és sota l’horitzó dins de la finestra efectiva >30°. Quan és visible, valora conjuntament la il·luminació, l’altura lunar i la separació angular amb l’objecte.', 'Una separació gran sol ser més favorable, però el resultat real també depèn del filtre, la transparència i la brillantor superficial de l’objecte.']],
      ['detall', '6 · Detall nocturn', ['La gràfica cobreix 24 hores i mostra les corbes completes de l’objecte i la Lluna entre −90° i +90°. La zona sombrejada és la nit astronòmica; la línia discontínua marca 30° i els trams fora de la foscor apareixen atenuats.', 'En carregar-se, el cursor i el panell de dades assenyalen automàticament el moment de màxima altura de l’objecte durant la nit astronòmica. Mou el cursor per consultar qualsevol altra mostra; en pantalles tàctils, toca per consultar i arrossega per desplaçar-te per la gràfica. Es mostren l’hora UTC, l’altura i l’azimut de l’objecte, l’altura i la il·luminació lunar, la separació Lluna–objecte i l’altura del Sol en mostres cada cinc minuts.']],
      ['exportacio', '7 · Copiar o descarregar', ['«Copia els resultats» envia al porta-retalls un resum en text amb l’objecte, la ubicació, la setmana, la lectura automàtica i la comparació de les set nits.', '«Descarrega el PDF» crea un informe de dues pàgines: la primera resumeix la setmana i la segona recull la gràfica i les dades de la nit seleccionada. Tot es genera al navegador i no es desen dades personals.']],
      ['model', 'Model i límits', ['Les posicions són topocèntriques geomètriques i no incorporen refracció atmosfèrica. La separació Lluna–objecte també és topocèntrica.', 'L’eina no modela meteorologia, núvols, humitat, relleu, obstacles, contaminació lumínica local, transparència ni turbulència. Comprova sempre les condicions reals abans de la sessió.']],
    ],
  },
  es: {
    title: 'Guía de Planificación', back: 'Volver a Planificación', index: 'En esta guía',
    intro: 'Planificación estudia en detalle un único objeto durante siete noches desde una ubicación concreta. Complementa Visibilidad y todos sus cálculos, fechas, ejes y avisos se expresan en UTC.',
    sections: [
      ['diferencia', 'Planificación y Visibilidad', ['Visibilidad sirve para descubrir rápidamente qué objetos pueden fotografiarse durante una semana desde el centro de Cataluña. Planificación está pensada para el estudio técnico de un objeto concreto, con ubicación libre, comparación nocturna y muestras cada cinco minutos.', 'Si llegas mediante el botón «Planificar» de Visibilidad, el objeto, la semana y el año se cargan automáticamente. Solo necesitas confirmar o cambiar la ubicación y revisar el cálculo detallado.']],
      ['ubicacion', '1 · Ubicación', ['L’Ampolla es la ubicación inicial. El selector también ofrece Barcelona, Pujalt, Huesca, Lleida, Tarragona, Girona y Vilanova i la Geltrú; puedes introducir cualquier otra latitud y longitud, además de un nombre opcional.', 'La ubicación se conserva solo mientras la sesión del navegador permanece abierta. Cualquier cambio deja el cálculo pendiente y obliga a recalcular los datos dependientes del observador.']],
      ['objeto', '2 · Objeto', ['Solo puede estar activo un modo de entrada: lista local, SIMBAD o coordenadas AR/Dec manuales J2000. En «Lista local», escribe un nombre, un catálogo o un alias y selecciona una de las coincidencias de la galería o de los objetivos pendientes.', 'SIMBAD solo devuelve el nombre y las coordenadas durante la sesión; no incorpora nada a la galería. Si el objeto ya existe en el catálogo local, no es necesaria una consulta externa.']],
      ['semana', '3 · Semana y año', ['La semana es ISO, de lunes a domingo. El intervalo exacto de fechas UTC aparece inmediatamente bajo los selectores, sin necesidad de calcular.', 'Al modificar la ubicación, el objeto, la semana o el año, «Calcular noches» parpadea. El cálculo solo se ejecuta al pulsarlo, por lo que puedes explorar los selectores sin provocar cálculos continuos.']],
      ['lectura', '4 · Lectura de la semana', ['Después del cálculo, la lectura automática identifica la noche más favorable y muestra su valoración, la ventana útil, el tiempo sin Luna y el momento de culminación del objeto.', 'El comentario interpreta conjuntamente la geometría de las siete noches y explica por qué destaca esa oportunidad. Es una orientación astronómica: no incluye nubes, transparencia, seeing, viento ni obstáculos del horizonte local.']],
      ['comparacion', '5 · Comparación de las siete noches', ['Cada fila resume la noche astronómica, la altura máxima nocturna, la ventana efectiva por encima de 30°, el tiempo efectivo sin Luna y las mejores horas con la Luna bajo o sobre el horizonte.', 'La iluminación y la separación corresponden a la mejor hora con Luna. Un guion indica que ese dato no es aplicable. La noche abierta en la gráfica queda identificada mediante un contorno.']],
      ['luna', 'Cómo interpretar la Luna', ['«Tiempo sin Luna» significa que la Luna está bajo el horizonte dentro de la ventana efectiva >30°. Cuando es visible, valora conjuntamente su iluminación, su altura y la separación angular respecto al objeto.', 'Una separación grande suele ser más favorable, pero el resultado real también depende del filtro, la transparencia y el brillo superficial del objeto.']],
      ['detalle', '6 · Detalle de la noche', ['La gráfica cubre 24 horas y muestra las curvas completas del objeto y la Luna entre −90° y +90°. La zona sombreada es la noche astronómica; la línea discontinua marca 30° y los tramos fuera de la oscuridad aparecen atenuados.', 'Al cargarse, el cursor y el panel de datos señalan automáticamente el momento de máxima altura del objeto durante la noche astronómica. Mueve el cursor para consultar cualquier otra muestra; en pantallas táctiles, toca para consultar y arrastra para desplazarte por la gráfica. Se muestran la hora UTC, la altura y el azimut del objeto, la altura e iluminación lunar, la separación Luna–objeto y la altura del Sol en muestras cada cinco minutos.']],
      ['exportacion', '7 · Copiar o descargar', ['«Copiar resultados» envía al portapapeles un resumen en texto con el objeto, la ubicación, la semana, la lectura automática y la comparación de las siete noches.', '«Descargar PDF» crea un informe de dos páginas: la primera resume la semana y la segunda recoge la gráfica y los datos de la noche seleccionada. Todo se genera en el navegador y no se guardan datos personales.']],
      ['modelo', 'Modelo y límites', ['Las posiciones son topocéntricas geométricas y no incorporan refracción atmosférica. La separación Luna–objeto también es topocéntrica.', 'La herramienta no modela meteorología, nubes, humedad, relieve, obstáculos, contaminación lumínica local, transparencia ni turbulencia. Comprueba siempre las condiciones reales antes de la sesión.']],
    ],
  },
  en: {
    title: 'Planning guide', back: 'Back to Planning', index: 'In this guide',
    intro: 'Planning studies one object in detail over seven nights from a specific location. It complements Visibility, and all calculations, dates, axes and notices use UTC.',
    sections: [
      ['difference', 'Planning and Visibility', ['Visibility quickly discovers which objects can be photographed during a week from central Catalonia. Planning is for the technical study of one target, with a custom location, night-by-night comparison and five-minute samples.', 'When opened with the “Plan” button in Visibility, the object, week and year load automatically. You only need to confirm or change the location and review the detailed calculation.']],
      ['location', '1 · Location', ['L’Ampolla is the initial location. The selector also includes Barcelona, Pujalt, Huesca, Lleida, Tarragona, Girona and Vilanova i la Geltrú; you can enter any other latitude and longitude and an optional name.', 'The location lasts only for the current browser session. Any change marks the calculation as pending and requires observer-dependent data to be recalculated.']],
      ['object', '2 · Object', ['Only one input mode can be active: local list, SIMBAD, or manual J2000 RA/Dec. Under “Local list”, type a name, catalogue designation or alias and select a match from the gallery or pending targets.', 'SIMBAD returns only a name and coordinates for the session and adds nothing to the gallery. If the object is already in the local catalogue, no external lookup is required.']],
      ['week', '3 · Week and year', ['Weeks follow ISO Monday-to-Sunday rules. The exact UTC date range appears below the selectors before calculation.', 'After a change, “Calculate nights” pulses. Calculation runs only when pressed, so selectors can be explored without continuous computation.']],
      ['reading', '4 · Reading of the week', ['After calculation, the automatic reading identifies the most favourable night and shows its rating, useful window, Moonless time and the target’s culmination.', 'The comment interprets the geometry of all seven nights together and explains why that opportunity stands out. It is astronomical guidance: cloud, transparency, seeing, wind and local-horizon obstructions are not included.']],
      ['comparison', '5 · Seven-night comparison', ['Each row summarises astronomical night, maximum night altitude, the effective window above 30°, Moon-down effective time, and the best times with the Moon below or above the horizon.', 'Illumination and separation refer to the best Moon-up time. A dash means the value does not apply. An outline identifies the night shown in the chart.']],
      ['moon', 'Interpreting the Moon', ['“Moon down” means the Moon is below the horizon within the effective >30° window. When visible, consider illumination, lunar altitude and angular separation together.', 'Greater separation is usually favourable, but filters, transparency and the target’s surface brightness also matter.']],
      ['detail', '6 · Night detail', ['The 24-hour chart shows the complete object and Moon curves from −90° to +90°. Shading marks astronomical night, the dashed line marks 30°, and segments outside darkness are dimmed.', 'On load, the cursor and data panel automatically mark the object’s highest point during astronomical night. Move the pointer to inspect another sample; on touchscreens, tap to inspect and drag to scroll across the chart. UTC time, object altitude and azimuth, lunar altitude and illumination, Moon–object separation and Sun altitude are shown at five-minute intervals.']],
      ['export', '7 · Copy or download', ['“Copy results” sends a text summary to the clipboard with the target, location, week, automatic reading and seven-night comparison.', '“Download PDF” creates a two-page report: the first page summarises the week, while the second contains the chart and data for the selected night. Everything is generated in the browser and no personal data is stored.']],
      ['model', 'Model and limits', ['Positions are geometric and topocentric, without atmospheric refraction. Moon–object separation is topocentric as well.', 'Weather, clouds, humidity, terrain, obstructions, local light pollution, transparency and seeing are not modelled. Always check real conditions before a session.']],
    ],
  },
} as const;
const t = content[lang];
---

<Layout title={t.title} description={t.intro} lang={lang} languageLinks={languageLinks.planningGuide(base)} focused>
  <article class="planning-guide">
    <a class="planning-guide__back" href={planningHref(lang, base)}>← {t.back}</a>
    <header class="planning-guide__hero">
      <div class="planning-guide__book" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M3.5 5.5c3.2-.8 5.9-.3 8.5 1.6v12c-2.6-1.9-5.3-2.4-8.5-1.6zM20.5 5.5c-3.2-.8-5.9-.3-8.5 1.6v12c2.6-1.9 5.3-2.4 8.5-1.6z" /></svg></div>
      <h1>{t.title}</h1>
    </header>
    <p class="planning-guide__intro">{t.intro}</p>
    <nav aria-label={t.index}><strong>{t.index}</strong><ol>{t.sections.map((section, index) => <li><a href={`#${section[0]}`}><span>{String(index + 1).padStart(2, '0')}</span>{section[1]}</a></li>)}</ol></nav>
    <div class="planning-guide__sections">{t.sections.map((section, index) => <section id={section[0]}><i>{String(index + 1).padStart(2, '0')}</i><div><h2>{section[1]}</h2>{section[2].map((paragraph) => <p>{paragraph}</p>)}</div></section>)}</div>
    <a class="planning-guide__return" href={planningHref(lang, base)}>← {t.back}</a>
  </article>
</Layout>

<style>
  .planning-guide{max-width:58rem;margin:0 auto;padding:.5rem 0 3rem}.planning-guide__back{display:inline-block;margin-bottom:1.1rem;color:var(--color-muted);font-size:.78rem;text-decoration:none}.planning-guide__hero{display:flex;align-items:center;gap:1rem;padding-bottom:1.1rem;border-bottom:1px solid var(--color-border)}.planning-guide__book{display:grid;flex:0 0 auto;width:2.8rem;height:2.8rem;place-items:center;border:1px solid color-mix(in srgb,var(--color-accent) 58%,transparent);border-radius:.65rem;background:color-mix(in srgb,var(--color-accent) 10%,transparent);color:var(--color-text)}.planning-guide__book svg{width:1.6rem;height:1.6rem;fill:none;stroke:currentColor;stroke-linecap:round;stroke-linejoin:round;stroke-width:1.45}.planning-guide h1{margin:0;font-size:clamp(1.45rem,3vw,2.2rem);letter-spacing:-.035em;line-height:1.05}.planning-guide__intro{max-width:50rem;margin:1.25rem 0;color:var(--color-text);font-size:clamp(1rem,2vw,1.14rem);line-height:1.7}.planning-guide nav{margin:1.5rem 0 2.4rem;padding:1rem;border:1px solid var(--color-border);border-radius:.8rem;background:var(--color-surface)}.planning-guide nav>strong{display:block;margin-bottom:.65rem;color:var(--color-muted);font-size:.72rem;text-transform:uppercase}.planning-guide nav ol{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.3rem .8rem;margin:0;padding:0;list-style:none}.planning-guide nav a{display:flex;gap:.5rem;padding:.35rem .4rem;color:var(--color-text);font-size:.85rem;text-decoration:none}.planning-guide nav span,.planning-guide section>i{color:var(--color-accent);font:.68rem var(--font-mono)}.planning-guide__sections{display:grid;gap:1rem}.planning-guide section{display:grid;grid-template-columns:2.8rem 1fr;scroll-margin-top:1rem;overflow:hidden;border:1px solid var(--color-border);border-radius:.8rem;background:var(--color-surface)}.planning-guide section>i{padding:1.2rem .55rem;border-right:1px solid var(--color-border);font-weight:700;text-align:center;font-style:normal}.planning-guide section>div{padding:1.1rem 1.2rem 1.2rem}.planning-guide h2{margin:0 0 .65rem;font-size:1.25rem}.planning-guide section p{margin:.55rem 0;color:var(--color-muted);line-height:1.65}.planning-guide__return{display:inline-flex;margin-top:1rem;padding:.65rem .8rem;border:1px solid var(--color-border);border-radius:.55rem;color:var(--color-text);font-size:.82rem;font-weight:700;text-decoration:none}@media(max-width:600px){.planning-guide nav ol{grid-template-columns:1fr}.planning-guide section{grid-template-columns:2.35rem 1fr}}
</style>
