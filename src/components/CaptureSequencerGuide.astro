---
import type { Lang } from '../i18n';
import { captureSequencerHref, languageLinks } from '../i18n';
import Layout from '../layouts/Layout.astro';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const base = import.meta.env.BASE_URL;
const content = {
  ca: {
    title: 'Guia del Seqüenciador de captura', back: 'Tornar al Seqüenciador de captura', index: 'En aquesta guia',
    intro: 'El Seqüenciador de captura resol dos problemes complementaris: construir una seqüència a partir del temps disponible o calcular la durada i l’hora final d’una seqüència NINA ja definida.',
    sections: [
      ['modes', '1 · Dos modes de càlcul', ['«Parteixo del temps disponible» busca la quantitat màxima de lights que cap dins la durada indicada, mantenint iteracions completes i iguals i aproximant la proporció dels filtres.', '«Parteixo d’una seqüència NINA» no reparteix el temps: utilitza exactament les iteracions i els lights per filtre introduïts, i calcula la integració, la durada total i l’hora final. Canviar de mode no ha d’alterar les dades escrites.']],
      ['automatic', '2 · Operacions automàtiques', ['«Dither cada» indica el nombre total de lights entre dithers. El comptador és global: continua quan canvia el filtre i només es reinicia en començar una seqüència nova. No es fa dither després de l’últim light. La mesura real de referència és cada 4 lights i 22 s addicionals per moviment i recuperació del guiatge.', '«Lectura i preparació entre lights» representa l’interval entre el final d’una exposició i l’inici de la següent, sense atribuir-lo al desament del fitxer. La mesura de referència és 6 s i només s’aplica quan queda un altre light.', 'L’autofocus inicial es compta abans de la primera fotografia. Els següents es programen per temps i el comptador no es reinicia en canviar de filtre. La durada de referència és 235 s. «Canvi de filtre i reenfocament» conserva 5 s per al canvi i l’offset de focus.']],
      ['available', '3 · Partir del temps disponible', ['Indica la durada total de la sessió, l’exposició de cada light i el nombre d’iteracions iguals. La durada total inclou exposicions i operacions auxiliars.', 'Selecciona els filtres i assigna’n les proporcions. La suma no pot superar el 100 %. Els percentatges són una preferència: el resultat els aproxima amb nombres enters per conservar tots els filtres seleccionats i repetir exactament la mateixa distribució en cada iteració.']],
      ['nina', '4 · Partir d’una seqüència NINA', ['Indica l’hora d’inici, la durada de l’exposició, les iteracions i els lights per iteració de cada filtre. Aquest mode reprodueix la seqüència escrita sense redistribuir-ne les captures.', 'Si la sessió inclou canvi de meridià, activa la casella corresponent. S’hi afegeix un únic bloc fix de sis minuts que ja inclou l’autofocus posterior, per evitar comptar-lo dues vegades. L’hora final es mostra amb segons i indica quan cau l’endemà.']],
      ['filters', '5 · Filtres i iteracions', ['Pots activar CLS, R, G, B, Hα, OIII i SII. Només els filtres seleccionats apareixen a la distribució. En el mode de temps disponible s’hi mostra la proporció; en el mode NINA, els lights per iteració.', 'Una iteració és una volta completa pels blocs de filtre seleccionats. En acabar, la iteració següent repeteix els mateixos blocs i les mateixes quantitats.']],
      ['result', '6 · Interpretar el resultat', ['«Lights totals» i «Integració efectiva» compten només les exposicions. «Durada estimada» hi afegeix lectura i preparació, autofocus, dithers, canvis de filtre i reenfocament i, quan s’ha activat, el canvi de meridià.', '«Desglossament de captures» separa les xifres d’una sola iteració de les xifres acumulades de totes les iteracions. «Temps auxiliar» mostra quantes vegades s’executa cada operació i el temps total que consumeix.']],
      ['persistence', '7 · Conservació de les dades', ['El mode seleccionat, l’hora, l’exposició, les iteracions, els filtres, les proporcions, els lights i el canvi de meridià es conserven localment en aquest navegador. Les operacions automàtiques també mantenen els últims valors.', 'Les dades no s’envien a cap servidor. Només canvien quan edites els camps o la configuració del navegador elimina l’emmagatzematge local.']],
      ['limits', '8 · Model i límits', ['El càlcul pressuposa que les exposicions i les operacions indicades acaben correctament. No intenta predir autofocus fallits, reintents, pèrdues de guiatge, núvols, errors de maquinari ni intervencions manuals.', 'El desament del fitxer no afegeix temps propi al model. Els 6 s entre lights representen la cadència observada de lectura i preparació de la càmera i NINA. Per comparar una sessió real cal consultar els registres de NINA i mesurar-hi les incidències extraordinàries.']],
    ],
  },
  es: {
    title: 'Guía del Secuenciador de captura', back: 'Volver al Secuenciador de captura', index: 'En esta guía',
    intro: 'El Secuenciador de captura resuelve dos problemas complementarios: construir una secuencia a partir del tiempo disponible o calcular la duración y la hora final de una secuencia NINA ya definida.',
    sections: [
      ['modos', '1 · Dos modos de cálculo', ['«Parto del tiempo disponible» busca la cantidad máxima de lights que cabe en la duración indicada, manteniendo iteraciones completas e iguales y aproximando la proporción de los filtros.', '«Parto de una secuencia NINA» no reparte el tiempo: utiliza exactamente las iteraciones y los lights por filtro introducidos, y calcula la integración, la duración total y la hora final. Cambiar de modo no debe alterar los datos escritos.']],
      ['automaticas', '2 · Operaciones automáticas', ['«Dither cada» indica el número total de lights entre dithers. El contador es global: continúa cuando cambia el filtro y solo se reinicia al comenzar una secuencia nueva. No se hace dither después del último light. La medida real de referencia es cada 4 lights y 22 s adicionales para el movimiento y la recuperación del guiado.', '«Lectura y preparación entre lights» representa el intervalo entre el final de una exposición y el inicio de la siguiente, sin atribuirlo al guardado del fichero. La medida de referencia es 6 s y solo se aplica cuando queda otro light.', 'El autofocus inicial se cuenta antes de la primera fotografía. Los siguientes se programan por tiempo y el contador no se reinicia al cambiar de filtro. La duración de referencia es 235 s. «Cambio de filtro y reenfoque» mantiene 5 s para el cambio y el offset de foco.']],
      ['disponible', '3 · Partir del tiempo disponible', ['Indica la duración total de la sesión, la exposición de cada light y el número de iteraciones iguales. La duración total incluye exposiciones y operaciones auxiliares.', 'Selecciona los filtros y asigna sus proporciones. La suma no puede superar el 100 %. Los porcentajes son una preferencia: el resultado los aproxima con números enteros para conservar todos los filtros seleccionados y repetir exactamente la misma distribución en cada iteración.']],
      ['nina', '4 · Partir de una secuencia NINA', ['Indica la hora de inicio, la duración de la exposición, las iteraciones y los lights por iteración de cada filtro. Este modo reproduce la secuencia escrita sin redistribuir sus capturas.', 'Si la sesión incluye cambio de meridiano, activa la casilla correspondiente. Se añade un único bloque fijo de seis minutos que ya incluye el autofocus posterior, para evitar contarlo dos veces. La hora final se muestra con segundos e indica cuándo cae al día siguiente.']],
      ['filtros', '5 · Filtros e iteraciones', ['Puedes activar CLS, R, G, B, Hα, OIII y SII. Solo los filtros seleccionados aparecen en la distribución. En el modo de tiempo disponible se muestra la proporción; en el modo NINA, los lights por iteración.', 'Una iteración es una vuelta completa por los bloques de filtro seleccionados. Al terminar, la siguiente iteración repite los mismos bloques y las mismas cantidades.']],
      ['resultado', '6 · Interpretar el resultado', ['«Lights totales» e «Integración efectiva» cuentan únicamente las exposiciones. «Duración estimada» añade lectura y preparación, autofocus, dithers, cambios de filtro y reenfoque y, cuando se ha activado, el cambio de meridiano.', '«Desglose de capturas» separa las cifras de una sola iteración de las cifras acumuladas de todas las iteraciones. «Tiempo auxiliar» muestra cuántas veces se ejecuta cada operación y el tiempo total que consume.']],
      ['conservacion', '7 · Conservación de los datos', ['El modo seleccionado, la hora, la exposición, las iteraciones, los filtros, las proporciones, los lights y el cambio de meridiano se conservan localmente en este navegador. Las operaciones automáticas también mantienen los últimos valores.', 'Los datos no se envían a ningún servidor. Solo cambian cuando editas los campos o la configuración del navegador elimina el almacenamiento local.']],
      ['limites', '8 · Modelo y límites', ['El cálculo presupone que las exposiciones y las operaciones indicadas terminan correctamente. No intenta predecir autofocus fallidos, reintentos, pérdidas de guiado, nubes, errores de hardware ni intervenciones manuales.', 'El guardado del fichero no añade tiempo propio al modelo. Los 6 s entre lights representan la cadencia observada de lectura y preparación de la cámara y NINA. Para comparar una sesión real hay que consultar los registros de NINA y medir allí las incidencias extraordinarias.']],
    ],
  },
  en: {
    title: 'Capture Sequencer guide', back: 'Back to Capture Sequencer', index: 'In this guide',
    intro: 'Capture Sequencer solves two complementary problems: building a sequence from the available time, or calculating the duration and end time of an existing NINA sequence.',
    sections: [
      ['modes', '1 · Two calculation modes', ['“Start from available time” finds the greatest number of lights that fits within the stated duration while keeping complete, identical iterations and approximating the filter proportions.', '“Start from a NINA sequence” does not distribute time: it uses the exact iterations and lights per filter entered, then calculates integration, total duration and end time. Switching modes must not alter entered values.']],
      ['automatic', '2 · Automatic operations', ['“Dither every” sets the total number of lights between dithers. The counter is global: it continues across filter changes and resets only when a new sequence starts. No dither is added after the final light. The measured reference is every 4 lights with 22 additional seconds for movement and guide recovery.', '“Readout and preparation between lights” represents the interval from the end of one exposure to the start of the next without attributing it to file saving. The reference value is 6 seconds and applies only when another light remains.', 'The initial autofocus is counted before the first photograph. Later runs are time-based and the timer does not reset with a filter change. The reference duration is 235 seconds. “Filter change and refocus” retains 5 seconds for the change and focus offset.']],
      ['available', '3 · Starting from available time', ['Enter the complete session duration, exposure per light and number of identical iterations. Total duration includes exposures and auxiliary operations.', 'Select filters and assign their proportions. Their sum cannot exceed 100%. Percentages are a preference: integer counts approximate them so every selected filter is retained and precisely the same distribution is repeated in each iteration.']],
      ['nina', '4 · Starting from a NINA sequence', ['Enter the start time, exposure duration, iterations and lights per iteration for each filter. This mode reproduces the entered sequence without redistributing captures.', 'Enable the meridian-flip option when required. One fixed six-minute block is added and already includes the subsequent autofocus so it is not counted twice. End time includes seconds and indicates when it falls on the following day.']],
      ['filters', '5 · Filters and iterations', ['CLS, R, G, B, Hα, OIII and SII can be enabled. Only selected filters appear in the distribution. Available-time mode shows proportions; NINA mode shows lights per iteration.', 'An iteration is one complete pass through the selected filter blocks. The next iteration repeats the same blocks and quantities.']],
      ['result', '6 · Reading the result', ['“Total lights” and “Effective integration” count exposures only. “Estimated duration” adds readout and preparation, autofocus, dithers, filter changes and refocus, plus the meridian flip when enabled.', '“Capture breakdown” separates one-iteration figures from totals across every iteration. “Overhead” shows how often each operation runs and its combined duration.']],
      ['persistence', '7 · Retaining data', ['The selected mode, time, exposure, iterations, filters, proportions, lights and meridian-flip choice are stored locally in this browser. Automatic-operation values are retained as well.', 'No data is sent to a server. Values change only when you edit them or the browser clears local storage.']],
      ['limits', '8 · Model and limits', ['The calculation assumes that the stated exposures and operations complete successfully. Failed autofocus runs, retries, guiding losses, cloud, hardware errors and manual intervention cannot be predicted.', 'File saving adds no separate time. The 6 seconds between lights represent the observed camera and NINA readout/preparation cadence. Comparing an actual session requires the NINA logs so exceptional events can be measured.']],
    ],
  },
} as const;
const t = content[lang];
---

<Layout title={t.title} description={t.intro} lang={lang} languageLinks={languageLinks.captureSequencerGuide(base)} focused>
  <article class="capture-guide">
    <a class="capture-guide__back" href={captureSequencerHref(lang, base)}>← {t.back}</a>
    <header><div aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M3.5 5.5c3.2-.8 5.9-.3 8.5 1.6v12c-2.6-1.9-5.3-2.4-8.5-1.6zM20.5 5.5c-3.2-.8-5.9-.3-8.5 1.6v12c2.6-1.9 5.3-2.4 8.5-1.6z" /></svg></div><h1>{t.title}</h1></header>
    <p class="capture-guide__intro">{t.intro}</p>
    <nav aria-label={t.index}><strong>{t.index}</strong><ol>{t.sections.map((section, index) => <li><a href={`#${section[0]}`}><span>{String(index + 1).padStart(2, '0')}</span>{section[1]}</a></li>)}</ol></nav>
    <div class="capture-guide__sections">{t.sections.map((section, index) => <section id={section[0]}><i>{String(index + 1).padStart(2, '0')}</i><div><h2>{section[1]}</h2>{section[2].map((paragraph) => <p>{paragraph}</p>)}</div></section>)}</div>
    <a class="capture-guide__return" href={captureSequencerHref(lang, base)}>← {t.back}</a>
  </article>
</Layout>

<style>
.capture-guide{max-width:58rem;margin:0 auto;padding:.5rem 0 3rem}.capture-guide__back{display:inline-block;margin-bottom:1.1rem;color:#9fc1f5;font-size:.78rem;text-decoration:none}.capture-guide>header{display:flex;align-items:center;gap:1rem;padding-bottom:1.1rem;border-bottom:1px solid var(--color-border)}.capture-guide>header>div{display:grid;flex:0 0 auto;width:2.8rem;height:2.8rem;place-items:center;border:1px solid #5278b2;border-radius:.65rem;background:rgba(122,167,239,.12);color:#cfe0fa}.capture-guide svg{width:1.6rem;height:1.6rem;fill:none;stroke:currentColor;stroke-linecap:round;stroke-linejoin:round;stroke-width:1.45}.capture-guide h1{margin:0;font-size:clamp(1.45rem,3vw,2.2rem);letter-spacing:-.035em;line-height:1.05}.capture-guide__intro{max-width:50rem;margin:1.25rem 0;color:var(--color-text);font-size:clamp(1rem,2vw,1.14rem);line-height:1.7}.capture-guide nav{margin:1.5rem 0 2.4rem;padding:1rem;border:1px solid var(--color-border);border-radius:.8rem;background:var(--color-surface)}.capture-guide nav>strong{display:block;margin-bottom:.65rem;color:var(--color-muted);font-size:.72rem;text-transform:uppercase}.capture-guide nav ol{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.3rem .8rem;margin:0;padding:0;list-style:none}.capture-guide nav a{display:flex;gap:.5rem;padding:.35rem .4rem;color:var(--color-text);font-size:.85rem;text-decoration:none}.capture-guide nav span,.capture-guide section>i{color:#7aa7ef;font:.68rem var(--font-mono)}.capture-guide__sections{display:grid;gap:1rem}.capture-guide section{display:grid;grid-template-columns:2.8rem 1fr;scroll-margin-top:1rem;overflow:hidden;border:1px solid var(--color-border);border-radius:.8rem;background:var(--color-surface)}.capture-guide section>i{padding:1.2rem .55rem;border-right:1px solid var(--color-border);font-weight:700;text-align:center;font-style:normal}.capture-guide section>div{padding:1.1rem 1.2rem 1.2rem}.capture-guide h2{margin:0 0 .65rem;font-size:1.25rem}.capture-guide section p{margin:.55rem 0;color:var(--color-muted);line-height:1.65}.capture-guide__return{display:inline-flex;margin-top:1rem;padding:.65rem .8rem;border:1px solid var(--color-border);border-radius:.55rem;color:var(--color-text);font-size:.82rem;font-weight:700;text-decoration:none}@media(max-width:600px){.capture-guide nav ol{grid-template-columns:1fr}.capture-guide section{grid-template-columns:2.35rem 1fr}}
</style>
