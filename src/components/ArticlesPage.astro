---
import type { CollectionEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import type { Lang } from '../i18n';
import { articlesHref, copy, homeHref, languageLinks, withBase } from '../i18n';
import { author, breadcrumbList, publicUrl, shortenDescription } from '../lib/seo';
import { articleTexts, articleWebHref, localizedArticle, topicNames as allTopicNames } from '../lib/articles';
import ArticleCard from './ArticleCard.astro';

interface Props {
	lang: Lang;
	articles: CollectionEntry<'articulos'>[];
}

const { lang, articles } = Astro.props;
const base = import.meta.env.BASE_URL;
const labels = {
	ca: { title: 'Articles', description: "Experiències, tècniques i procediments d'astrofotografia.", index: 'Explora els articles', latest: 'Més recent', all: 'Tots', topics: 'Temes', available: 'PDF disponibles', open: 'Obrir PDF', read: 'Llegir l’article', readIn: 'Llegir', minutes: 'min de lectura', backHome: 'Tornar a la portada' },
	es: { title: 'Artículos', description: 'Experiencias, técnicas y procedimientos de astrofotografía.', index: 'Explora los artículos', latest: 'Más reciente', all: 'Todos', topics: 'Temas', available: 'PDF disponibles', open: 'Abrir PDF', read: 'Leer el artículo', readIn: 'Leer', minutes: 'min de lectura', backHome: 'Volver a la portada' },
	en: { title: 'Articles', description: 'Astrophotography experiences, techniques and procedures.', index: 'Explore the articles', latest: 'Latest', all: 'All', topics: 'Topics', available: 'Available PDFs', open: 'Open PDF', read: 'Read the article', readIn: 'Read', minutes: 'min read', backHome: 'Back to the home page' },
}[lang];
const localized = articles.sort((a, b) => b.data.fecha.getTime() - a.data.fecha.getTime());
const topicNames = allTopicNames[lang];
const localizedText = (article: CollectionEntry<'articulos'>) => localizedArticle(article, lang);
const texts = await articleTexts();
const webHref = (article: CollectionEntry<'articulos'>) => articleWebHref(texts, article, lang, base);
// Temas con artículos, en el orden del esquema, para el filtro de la lista.
const topicCounts = (Object.keys(topicNames) as Array<keyof typeof topicNames>).map((topic) => [topic, localized.filter((article) => article.data.tema === topic).length] as const).filter(([, count]) => count > 0);
// SEO: descripción con los temas reales y datos estructurados de cada artículo (con sus PDF).
const seoDescription = shortenDescription({
	ca: 'Articles de Juan José Romero sobre astrofotografia: apilat i processament amb PixInsight, màscares, fitxers de correcció, SNR, planificació i fotografia solar.',
	es: 'Artículos de Juan José Romero sobre astrofotografía: apilado y procesado con PixInsight, máscaras, archivos de calibración, SNR, planificación y fotografía solar.',
	en: 'Astrophotography articles by Juan José Romero (in Catalan and Spanish): stacking and processing in PixInsight, masks, calibration frames, SNR, planning and solar imaging.',
}[lang], 165);
const pageUrl = publicUrl(articlesHref(lang, base), base);
const structuredData = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'CollectionPage', name: labels.title, description: seoDescription, url: pageUrl, inLanguage: lang, author,
			hasPart: localized.map((article) => ({
				'@type': 'Article',
				headline: localizedText(article).titulo,
				abstract: localizedText(article).resumen,
				url: webHref(article) ? publicUrl(webHref(article)!, base) : `${pageUrl}#article-${article.data.slug}`,
				datePublished: article.data.fecha.toISOString().slice(0, 10),
				author,
				encoding: (['ca', 'es', 'en'] as const).filter((pdfLang) => article.data.pdfs[pdfLang]).map((pdfLang) => ({
					'@type': 'MediaObject', contentUrl: publicUrl(withBase(article.data.pdfs[pdfLang]!, base), base), encodingFormat: 'application/pdf', inLanguage: pdfLang,
				})),
			})),
		},
		breadcrumbList([[copy[lang].home, homeHref(lang, base)], [labels.title, articlesHref(lang, base)]], base),
	],
};
---

<Layout title={{ ca: 'Articles d’astrofotografia i PixInsight', es: 'Artículos de astrofotografía y PixInsight', en: 'Astrophotography and PixInsight articles' }[lang]} description={seoDescription} structuredData={structuredData} focused lang={lang} languageLinks={languageLinks.articles(base)}>
	<section class="articles-index">
		<header class="page-heading">
			<h1>{labels.title}</h1>
			<p>{labels.description}</p>
		</header>
		<div class="articles-topics" role="group" aria-label={labels.topics} data-topic-filter hidden>
			<span>{labels.topics}</span>
			<button type="button" aria-pressed="true" data-topic="">{labels.all}<small>{localized.length}</small></button>
			{topicCounts.map(([topic, count]) => <button type="button" aria-pressed="false" data-topic={topic}>{topicNames[topic]}<small>{count}</small></button>)}
		</div>
		<div class="articles-compact-list">
			{localized.map((article, index) => <ArticleCard lang={lang} article={article} texts={texts} latest={index === 0} />)}
		</div>
	</section>
</Layout>

<script>
	// Filtro por tema: sin JavaScript el grupo queda oculto y se ve la lista completa.
	const filter = document.querySelector<HTMLElement>('[data-topic-filter]');
	if (filter) {
		const buttons = [...filter.querySelectorAll<HTMLButtonElement>('button[data-topic]')];
		const cards = [...document.querySelectorAll<HTMLElement>('.articles-compact-list .article-card')];
		filter.hidden = false;
		filter.addEventListener('click', (event) => {
			const button = (event.target as Element).closest<HTMLButtonElement>('button[data-topic]');
			if (!button) return;
			const topic = button.dataset.topic;
			buttons.forEach((candidate) => candidate.setAttribute('aria-pressed', String(candidate === button)));
			cards.forEach((card) => { card.hidden = Boolean(topic) && card.dataset.topic !== topic; });
		});
	}
</script>
