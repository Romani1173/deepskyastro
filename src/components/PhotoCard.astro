---
import type { CollectionEntry } from 'astro:content';
import type { Lang } from '../i18n';
import { copy, localeFor, photoHref, withBase } from '../i18n';
import { photoText } from '../photoTranslations';
import { photoTechnicalText } from '../technicalTranslations';
import visibility from '../data/visibility.generated.json';

interface Props { foto: CollectionEntry<'fotos'>; lang?: Lang; }
const { foto, lang = 'ca' } = Astro.props;
const t = copy[lang];
const text = photoText(foto, lang);
const technical = photoTechnicalText(foto, lang);
const date = new Intl.DateTimeFormat(localeFor(lang), { dateStyle: 'long' }).format(foto.data.entorn.data);
const hasProcess = foto.data.imatges_addicionals.some((imatge) => imatge.tipus === 'process');
const hasVisibility = Boolean(foto.data.visibilitat);
const processImage = foto.data.imatges_addicionals.find((imatge) => imatge.tipus === 'process');
const base = import.meta.env.BASE_URL;
const visibilityObject = foto.data.objecte_astronomic ? visibility.objects[foto.data.objecte_astronomic as keyof typeof visibility.objects] : undefined;
const periodDate = new Intl.DateTimeFormat(localeFor(lang), { day: 'numeric', month: 'short', timeZone: 'UTC' });
const visibilityPeriod = visibilityObject?.aboveThresholdPeriods
	.map(({ start, end }) => `${periodDate.format(new Date(`${start}T00:00:00Z`))} – ${periodDate.format(new Date(`${end}T00:00:00Z`))}`)
	.join(', ');
---

<article class="photo-card">
	<a class="photo-card__link" href={photoHref(lang, foto.id, base)} aria-label={`${t.viewPhoto} ${text.objecte}`}>
		<img src={withBase(`imagenes/cielo-profundo/${foto.data.imatge}`, base)} alt={`${t.astroPhoto} ${text.objecte}`} loading="lazy" decoding="async" />
		<div class="photo-card__body">
			<h2>{text.objecte}</h2>
			<p><b>{t.constellation}:</b> {technical.constellacio}</p>
			<p><b>{t.exposure}:</b> {technical.tempsTotal}</p>
			<p>{date}</p>
		</div>
	</a>
	{(hasProcess || hasVisibility) && <span class="photo-card__features">
		{processImage && <span class="context-tooltip context-tooltip--feature">
			<button class="photo-feature-badge photo-feature-badge--process" type="button" aria-label={`${t.openDirect}: ${t.processIndicator} — ${text.objecte}`} aria-describedby={`process-tip-${foto.id}`} data-feature-preview data-preview-src={withBase(`imagenes/cielo-profundo/${processImage.fitxer}`, base)} data-preview-alt={`${t.processIndicator}: ${text.objecte}`} data-preview-title={`${t.processIndicator} — ${text.objecte}`}>{t.processing}</button>
			<span class="context-tooltip__bubble" id={`process-tip-${foto.id}`} role="tooltip">{t.processTooltip}</span>
		</span>}
		{foto.data.visibilitat && visibilityPeriod && <span class="context-tooltip context-tooltip--feature">
			<button class="photo-feature-badge photo-feature-badge--visibility" type="button" aria-label={`${t.openDirect}: ${t.visibilityIndicator} — ${text.objecte}`} aria-describedby={`visibility-tip-${foto.id}`} data-feature-preview data-preview-src={withBase(`imagenes/visibilidad/${foto.data.visibilitat.imatge}`, base)} data-preview-alt={`${t.visibilityIndicator}: ${text.objecte}`} data-preview-title={`${t.visibilityIndicator} — ${text.objecte}`}>{t.visibilityPlanner}</button>
			<span class="context-tooltip__bubble" id={`visibility-tip-${foto.id}`} role="tooltip">{t.visibilityTooltip(visibilityPeriod)}</span>
		</span>}
	</span>}
</article>
