---
import { getCollection } from 'astro:content';
import ArticleDetail from '../../components/ArticleDetail.astro';

export async function getStaticPaths() {
	const allArticles = await getCollection('articulos');
	return allArticles
		.filter((article) => article.data.idioma === 'ca')
		.map((article) => ({ params: { slug: article.data.slug }, props: { article, allArticles } }));
}
const { article, allArticles } = Astro.props;
---
<ArticleDetail lang="ca" article={article} allArticles={allArticles} />
